#pragma once

#include "BindlessResources.hsh"
#include "MathUtils.hsh"

// The allowed wave sizes that an HLSL shader may specify are the powers of 2 between 4 and 128, inclusive.
#ifndef MIN_WAVE_SIZE_SUPPORTED
#define MIN_WAVE_SIZE_SUPPORTED 32
#endif

// @see https://en.wikipedia.org/wiki/Middle_gray for more infomation.
static const float MiddleGray = 0.18f;

/**
 * Building an orthonormal basis from a 3D unit vector.
 *
 * @see Tom Duff, James Burgess, Per Christensen, Christophe Hery, Andrew Kensler, Max Liani, and Ryusuke Villemin, Building an Orthonormal Basis, Revisited, Journal of Computer Graphics Techniques (JCGT), vol. 6, no. 1, 1-8, 2017
 */
void BuildOrthonormalBasis(in float3 n, out float3 b1, out float3 b2)
{
    const float sign = n.z >= 0.0f ? 1.0f : -1.0f;
    const float a = -1.0f / (sign + n.z);
    const float b = n.x * n.y * a;
    b1 = float3(1.0f + sign * n.x * n.x * a, sign * b, -sign * n.x);
    b2 = float3(b, sign + n.y * n.y * a, -n.y);
}

float3x3 CreateTangentSpaceBasis(float3 n)
{
    float3 t, b;
    BuildOrthonormalBasis(n, t, b);

    // TODO: remove transpose
    float3x3 tangentToWorld = transpose(float3x3(t, b, n));
    return tangentToWorld;
}

static const float3x3 CUBE_ROTATIONS[6] =
{
    float3x3(float3(0.0, 0.0, -1.0), float3(0.0, -1.0, 0.0), float3(-1.0, 0.0, 0.0)),
    float3x3(float3(0.0, 0.0, 1.0),  float3(0.0, -1.0, 0.0), float3(1.0, 0.0, 0.0)),
    float3x3(float3(1.0, 0.0, 0.0),  float3(0.0, 0.0, 1.0),  float3(0.0, -1.0, 0.0)),
    float3x3(float3(1.0, 0.0, 0.0),  float3(0.0, 0.0, -1.0), float3(0.0, 1.0, 0.0)),
    float3x3(float3(1.0, 0.0, 0.0),  float3(0.0, -1.0, 0.0), float3(0.0, 0.0, -1.0)),
    float3x3(float3(-1.0, 0.0, 0.0), float3(0.0, -1.0, 0.0), float3(0.0, 0.0, 1.0))
};

float3 CalculateCubemapVector(float2 uv, uint face)
{
    //return normalize(mul(CUBE_ROTATIONS[face], float3(uv * 2.0 - 1.0, 1.0)));
    uv = 2.0 * float2(uv.x, uv.y) - 1.0;
    switch (face)
    {
    case 0: return normalize(float3(  1.0, -uv.y, -uv.x));
    case 1: return normalize(float3( -1.0, -uv.y,  uv.x));
    case 2: return normalize(float3( uv.x,   1.0,  uv.y));
    case 3: return normalize(float3( uv.x,  -1.0, -uv.y));
    case 4: return normalize(float3( uv.x, -uv.y,   1.0));
    case 5: return normalize(float3(-uv.x, -uv.y,  -1.0));
    }
    return 0;
}

float2 ScreenSpaceUVToNDCSpaceXY(float2 uv)
{
    float2 xy = uv * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f);
    return xy;
}

float2 NDCSpaceXYToScreenSpaceUV(float2 xy)
{
    float2 uv = xy * float2(0.5f, -0.5f) + float2(0.5f, 0.5f);
    return uv;
}

float3 ViewSpaceToClipSpacePosition(float3 position, float4x4 viewToClipMatrix)
{
    float4 clipSpacePosition = mul(viewToClipMatrix, float4(position, 1.0));
    return float3(clipSpacePosition.xyz / clipSpacePosition.w);
}

float4x4 ConvertFloat3x3To4x4(float3x3 m)
{
    return float4x4(
        m[0][0], m[0][1], m[0][2], 0,
        m[1][0], m[1][1], m[1][2], 0,
        m[2][0], m[2][1], m[2][2], 0,
        0,       0,       0,       1);
}

float3x3 ConvertFloat4x4To3x3(float4x4 m)
{
    return float3x3(
        m[0][0], m[0][1], m[0][2],
        m[1][0], m[1][1], m[1][2],
        m[2][0], m[2][1], m[2][2]);
}

// FAST_SRGB_APPROXIMATION path form: http://chilliant.blogspot.com.au/2012/08/srgb-approximations-for-hlsl.html?m=1

float sRGBToLinear(float sRGB)
{
#if FAST_SRGB_APPROXIMATION
    return sRGB * (sRGB * (sRGB * 0.305306011 + 0.682171111) + 0.012522878);
#else
    return sRGB <= 0.04045 ? sRGB / 12.92 : pow((sRGB + 0.055) / 1.055, 2.4);
#endif
}

float3 sRGBToLinear(float3 sRGB)
{
#if FAST_SRGB_APPROXIMATION
    return sRGB * (sRGB * (sRGB * 0.305306011 + 0.682171111) + 0.012522878);
#else
    return select(sRGB <= 0.04045, sRGB / 12.92, pow((sRGB + 0.055) / 1.055, 2.4));
#endif
}

float LinearTosRGB(float linearRGB)
{
#if FAST_SRGB_APPROXIMATION
    return max(1.055 * pow(linearRGB, 0.416666667) - 0.055, 0.0);
#else
    return linearRGB < 0.0031308 ? linearRGB * 12.92 : pow(linearRGB, (1.0 / 2.4)) * 1.055 - 0.055;
#endif
}

half3 LinearTosRGB(half3 linearRGB)
{
#if FAST_SRGB_APPROXIMATION
    return max(1.055 * pow(linearRGB, 0.416666667) - 0.055, 0.0);
#else
    return select(linearRGB < 0.0031308, linearRGB * 12.92, pow(linearRGB, (1.0 / 2.4)) * 1.055 - 0.055);
#endif
}

float GammaCorrection(float linearColor)
{
    if (linearColor < 0.00313067) return linearColor * 12.92;
    return pow(linearColor, (1.0 / 2.4)) * 1.055 - 0.055;
}

float3 GammaCorrection(float3 linearColor)
{
    return float3(GammaCorrection(linearColor.r), GammaCorrection(linearColor.g), GammaCorrection(linearColor.b));
}

// https://en.wikipedia.org/wiki/Relative_luminance
// form the middle row of the RGB-to-XYZ color transformation matrix: http://brucelindbloom.com/index.html?Eqn_RGB_XYZ_Matrix.html
float RelativeLuminance(float3 linearRGB)
{
    return dot(linearRGB, float3(0.2126729, 0.7151522, 0.0721750));
}

float RelativeLuminance(float4 linearRGBA)
{
    return RelativeLuminance(linearRGBA.rgb);
}

float3 HSV2RGB(float3 hsv)
{
    float r = abs(hsv.x * 6 - 3) - 1;
    float g = 2 - abs(hsv.x * 6 - 2);
    float b = 2 - abs(hsv.x * 6 - 4);
    float3 rgb = saturate(float3(r, g, b));
    return ((rgb - 1) * hsv.y + 1) * hsv.z;
}

 // Convert luminance (cd·m−2) to EV100
float LuminanceToEV100(float luminance)
{
#if 1
    return log2(luminance);
#else // ISO standard: 12232:2019
    return log2(luminance / 1.2);
#endif
}

// Convert EV100 to luminance (cd·m−2)
float EV100ToLuminance(float EV100)
{
#if 1
    return pow(2.0f, EV100);
#else // ISO standard: 12232:2019
    return 1.2 * pow(2.0f, EV100);
#endif
}

/** Remap function. */
float Remap(float value, float srcMin, float srcMax, float dstMin, float dstMax)
{
    return dstMin + (((value - srcMin) / (srcMax - srcMin)) * (dstMax - dstMin));
}

float2 RaySphereIntersection(float3 r0, float3 rd, float3 s0, float sR)
{
    float a = dot(rd, rd);
    float3 s0_r0 = r0 - s0;
    float b = 2.0f * dot(rd, s0_r0);
    float c = dot(s0_r0, s0_r0) - (sR * sR);
    float delta = b * b - 4.0f * a * c;
    float2 sol = -1.0f;
    [flatten]
    if (delta >= 0)
    {
        sol = (-b + float2(-1.0f, 1.0f) * sqrt(delta)) / (2.0f * a);
    }
    return sol;
}

float3 UniformSampleSphere(float2 Xi)
{
    float phi = 2.0f * PI * Xi.y;
    float cosTheta = 1.0f - 2.0f * Xi.x;
    float sinTheta = sqrt(1.0f - cosTheta * cosTheta);
    return float3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}

float3 UniformSampleHemisphere(float2 Xi)
{
    float phi = 2.0 * PI * Xi.y;
    float cosTheta = Xi.x;
    float sinTheta = sqrt(1.0f - cosTheta * cosTheta);
    return float3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}

float3 CosineSampleHemisphere(float2 Xi)
{
    float phi = 2.0 * PI * Xi.y;
    float cosTheta = sqrt(Xi.x);
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
    return float3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}