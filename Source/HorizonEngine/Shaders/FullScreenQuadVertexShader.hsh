#pragma once

#define FULL_SCREEN_QUAD_VS()                                                                         \
    [shader("vertex")]                                                                                \
    void FullScreenQuadVS(uint vertexID : SV_VertexID, out float4 outPosition : SV_Position)          \
    {                                                                                                 \
        outPosition = float4(float2((vertexID << 1) & 2, vertexID & 2) * 2.0f - 1.0f, 0.0f, 1.0f);    \
    }
