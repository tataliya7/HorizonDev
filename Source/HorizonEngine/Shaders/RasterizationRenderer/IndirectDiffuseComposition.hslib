SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, GBuffer0SRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, GBuffer1SRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(3, GBuffer2SRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(4, IrradianceEnvironmentMapBufferSRV);
SHADER_CONSTANTS_TEXTURE_CUBE_DEFAULT_SRV(5, IrradianceEnvironmentMapTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(6, AmbientOcclusionTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(7, IndirectDiffuseTextureSRV);
SHADER_CONSTANTS_STRUCT_END();

// Calculates approximate multi-bounce visibility
// Practical Realtime Strategies for Accurate Indirect Occlusion
float3 MultiBounceAmbientOcclusion(float visibility, float3 albedo)
{
    float3 a =  2.0404 * albedo - 0.3324;
    float3 b = -4.7951 * albedo + 0.6417;
    float3 c =  2.7552 * albedo + 0.6903;

    const float x = visibility;
    return max(x, ((x * a + b) * x + c) * x);
}

[shader("pixel")]
void IndirectDiffuseCompositionPS(in float4 position : SV_Position, out float4 outColor : SV_Target0)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D gbuffer0 = ShaderConstants.GetGBuffer0SRV();
    Texture2D gbuffer1 = ShaderConstants.GetGBuffer1SRV();
    Texture2D gbuffer2 = ShaderConstants.GetGBuffer2SRV();
    ByteAddressBuffer irradianceEnvironmentMapBuffer = ShaderConstants.GetIrradianceEnvironmentMapBufferSRV();
    TextureCube irradianceEnvironmentMapTexture = ShaderConstants.GetIrradianceEnvironmentMapTextureSRV();
    Texture2D ambientOcclusionTexture = ShaderConstants.GetAmbientOcclusionTextureSRV();
    Texture2D indirectDiffuseTexture = ShaderConstants.GetIndirectDiffuseTextureSRV();

    const uint2 pixelCoord = uint2(position.xy);
    const float2 uv = (float2(pixelCoord) + 0.5f) * frameShaderParameters.renderResolution.zw;

    float4 gbuffer0Data = gbuffer0[pixelCoord];
    float4 gbuffer1Data = gbuffer1[pixelCoord];
    float4 gbuffer2Data = gbuffer2[pixelCoord];
    float ambientOcclusion = ambientOcclusionTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;
    float indirectDiffuseColor = indirectDiffuseTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;

    indirectDiffuseColor *= frameShaderParameters.preExposureCorrection;
    //indirectDiffuseColor *= frameShaderParameters.inversePreExposure;
    indirectDiffuseColor = 0;

    float3 normal = DecodeNormalFromGBuffer(gbuffer0Data.xyz);
    float metallic = gbuffer1Data.x;
    float specular = gbuffer1Data.y;
    float roughness = gbuffer1Data.z;
    float4 baseColor = gbuffer2Data;

    /* Use luminance. Because colored multibounce looks bad. */
    ambientOcclusion *= MultiBounceAmbientOcclusion(ambientOcclusion.r, RelativeLuminance(baseColor.rgb)).r;

    float3 diffuseBRDF = baseColor.rgb * (1.0f / PI) * (1.0f - metallic);

#if 1//USE_IRRADIANCE_ENVIRONMENT_MAP_APRROXIMATION
    SH3CoefficientsRGB irradianceEnvironmentMapSH = irradianceEnvironmentMapBuffer.Load<SH3CoefficientsRGB>(0);
    float3 irradiance = EvaluateSHCosineWeighted(irradianceEnvironmentMapSH, normal);
#else
    float3 irradiance = irradianceEnvironmentMapTexture.SampleLevel(GlobalSamplerLinearClamp, normal, 0).rgb;
#endif
    //irradiance *= frameShaderParameters.inversePreExposure;

    float3 indirectDiffuse = diffuseBRDF * (irradiance * 500 + indirectDiffuseColor) * ambientOcclusion;
    indirectDiffuse *= frameShaderParameters.indirectLightingMultiplier;
    indirectDiffuse *= frameShaderParameters.preExposure;

    outColor = 0;
    outColor.rgb += indirectDiffuse;
}