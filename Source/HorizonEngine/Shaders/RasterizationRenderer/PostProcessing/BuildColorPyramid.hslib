#include "../../ShaderCommon.hsh"
#include "../RasterizationRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(0, InputTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(1, float3, OutputTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

float Luma4(float3 color)
{
    return (color.g * 2) + (color.r + color.b);
}

float HdrWeight4(float3 color)
{
    return rcp(Luma4(color) + 4.0f);
}

float HdrWeightInv4(float3 Color)
{
    return 4.0f * rcp(1.0f - Luma4(Color));
}

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void BuildColorPyramidCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    Texture2D inputTexture = ShaderConstants.GetInputTextureSRV();
    RWTexture2D<float3> outputTexture = ShaderConstants.GetOutputTextureUAV();

    uint width, height;
    outputTexture.GetDimensions(width, height);

    uint2 pixelCoord = dispatchThreadID.xy;
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    float2 inverseOutputTextureSize = 1.0f / float2(width, height);
    float2 uv = (pixelCoord + 0.5f) * inverseOutputTextureSize;

    float2 uv0 = uv + inverseOutputTextureSize * float2(-1.0f, -1.0f);
    float2 uv1 = uv + inverseOutputTextureSize * float2(-1.0f,  1.0f);
    float2 uv2 = uv + inverseOutputTextureSize * float2( 1.0f, -1.0f);
    float2 uv3 = uv + inverseOutputTextureSize * float2( 1.0f,  1.0f);

    float3 color0 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv0, 0).rgb;
    float3 color1 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv1, 0).rgb;
    float3 color2 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv2, 0).rgb;
    float3 color3 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv3, 0).rgb;

    color0 *= HdrWeight4(color0);
    color1 *= HdrWeight4(color1);
    color2 *= HdrWeight4(color2);
    color3 *= HdrWeight4(color3);

    float3 result = (color0 * 0.25f) + (color1 * 0.25f) + (color2 * 0.25f) + (color3 * 0.25f);
    result *= HdrWeightInv4(result);

    outputTexture[pixelCoord] = max(result, 0.0f);
}