[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void DepthOfFieldSetupCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    uint width = frameShaderParameters.targetWidth;
    uint height = frameShaderParameters.targetHeight;
    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5) / float2(width, height);

    Texture2D sceneColorTexture = GetSceneColorTextureSRV();
    Texture2D sceneDepthTexture = GetSceneDepthTextureSRV();
    RWTexture2D<float> cocTexture = GetDOFCoCTextureUAV();

    float focalDistance = (0);
    float focalRegion = (1);
    float nearTransitionRegion = (2);
    float farTransitionRegion = (3);

    float4 color = sceneColorTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0);
    float depth = sceneDepthTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;
    float linearDepth = ComputeCameraSpaceDepth(depth, frameShaderParameters.nearClippingPlane, frameShaderParameters.farClippingPlane);

    // float nearRegionMask = ComputeNearRegionMask(linearDepth, focalDistance, focalRegion, nearTransitionRegion);
    // float farRegionMask = ComputeFarRegionMask(linearDepth, focalDistance, focalRegion, farTransitionRegion);
    float coc = ComputeCoC(linearDepth, focalDistance, focalRegion, nearTransitionRegion, farTransitionRegion);

    cocTexture[pixelCoord] = coc;
}
