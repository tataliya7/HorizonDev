#include "../../ShaderCommon.hsh"
#include "../RasterizationRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_TEXTURE_2D_SRV(1, SceneColorTexture);
BIND_TEXTURE_2D_SRV(2, SceneDepthTexture);
BIND_TEXTURE_2D_UAV(3, float, DOFCoCTexture);
BIND_TEXTURE_2D_UAV(4, float4, DOFNearRegionTexture);
BIND_TEXTURE_2D_UAV(5, float4, DOFFarRegionTexture);

float ComputeNearRegionMask(float depth, float focalDistance, float focalRegion, float nearTransitionRegion)
{
    return saturate((focalDistance - 0.5 * focalRegion - depth) / nearTransitionRegion);
}

float ComputeFarRegionMask(float depth, float focalDistance, float focalRegion, float farTransitionRegion)
{
    return saturate((depth - focalDistance - 0.5 * focalRegion) / farTransitionRegion);
}

float ComputeCoC(float linearDepth, float focalDistance, float focalRegion, float nearTransitionRegion, float farTransitionRegion)
{
    float N = ComputeNearRegionMask(linearDepth, focalDistance, focalRegion, nearTransitionRegion);
    float F = ComputeFarRegionMask(linearDepth, focalDistance, focalRegion, farTransitionRegion);
    if (F > N)
    {
        return (F * 0.5) + 0.5;
    }
    return (1.0 - N) * 0.5;
}

