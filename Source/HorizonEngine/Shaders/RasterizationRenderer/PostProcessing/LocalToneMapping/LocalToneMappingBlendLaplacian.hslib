#include "../../../ShaderCommon.hsh"
#include "../../RasterizationRendererCommon.hsh"
#include "../PostProcessingCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, InputTexture1SRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, InputTexture2SRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(3, InputTexture3SRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(4, float4, OutputTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void LocalToneMappingBlendLaplacianCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RWTexture2D<float4> outputTexture = ShaderConstants.GetOutputTextureUAV();
    uint width, height;
    outputTexture.GetDimensions(width, height);
    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5) / float2(width, height);

    Texture2D inputTexture1 = ShaderConstants.GetInputTexture1SRV();
    Texture2D inputTexture2 = ShaderConstants.GetInputTexture2SRV();
    Texture2D inputTexture3 = ShaderConstants.GetInputTexture3SRV();

    float srcMip = (0);

    float boostLocalContrast = 1;

    // Blend the Laplacians based on exposure weights.
    float accumSoFar = inputTexture3.SampleLevel(GlobalSamplerLinearClamp, uv, srcMip).x;
    float3 laplacians = inputTexture1.SampleLevel(GlobalSamplerLinearClamp, uv, srcMip - 1).xyz - inputTexture1.SampleLevel(GlobalSamplerLinearClamp, uv, srcMip - 1).xyz;
    float3 weights = inputTexture2.SampleLevel(GlobalSamplerLinearClamp, uv, srcMip - 1).xyz * (boostLocalContrast > 0.0 ? abs(laplacians) + 0.00001 : 1.0);
    weights /= dot(weights, 1.0) + 0.00001;
    float laplac = dot(laplacians * weights, 1.0);

    float3 r = accumSoFar + laplac;
    outputTexture[pixelCoord] = float4(r, 1.0);
}
