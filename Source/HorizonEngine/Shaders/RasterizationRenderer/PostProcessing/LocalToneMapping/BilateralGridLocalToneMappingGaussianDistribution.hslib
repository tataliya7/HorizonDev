#include "../../../ShaderCommon.hsh"
#include "../../RasterizationRendererCommon.hsh"
#include "../PostProcessingCommon.hsh"
#include "BilateralGridLocalToneMappingCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(0, GaussianDistributionBufferUAV);
SHADER_CONSTANTS_SCALAR(1, uint, GaussianFilterKernelSize);
SHADER_CONSTANTS_SCALAR(2, float, GaussianFilterSigma);
SHADER_CONSTANTS_STRUCT_END();

static const uint GaussianFilterMaxRadius = 32;
static const uint GaussianFilterMaxKernelSize = 2 * GaussianFilterMaxRadius + 1;

groupshared float2 SharedData[GaussianFilterMaxKernelSize];

[shader("compute")]
[numthreads(1, 1, 1)]
void BilateralGridLocalToneMappingGaussianDistributionCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RWByteAddressBuffer gaussianDistributionBuffer = ShaderConstants.GetGaussianDistributionBufferUAV();

    uint kernelSize = ShaderConstants.GetGaussianFilterKernelSize();
    float sigma = ShaderConstants.GetGaussianFilterSigma();

    uint radius = (kernelSize - 1) >> 1;

    float offset = -1.0f * float(radius);
    float weightSum = 0.0f;

    for (uint sampleIndex = 0; sampleIndex < kernelSize; sampleIndex++)
    {
        // float constant = 1.0f / (2.0f * M_PI * sigma * sigma);
        // float weight = constant * exp(-0.5f * float(sampleIndex * sampleIndex) / (sigma * sigma));
        float weight = exp(-0.5f * (offset * offset) / (sigma * sigma));
        weightSum += weight;

        float2 offsetAndWeight = float2(offset, weight);
        offset += 1.0f;

        SharedData[sampleIndex] = offsetAndWeight;
    }

    for (uint sampleIndex = 0; sampleIndex < kernelSize; sampleIndex++)
    {
        float2 offsetAndWeight = SharedData[sampleIndex];

        offsetAndWeight.y /= weightSum;

        gaussianDistributionBuffer.Store<float2>(sizeof(float2) * sampleIndex, offsetAndWeight);
    }
}