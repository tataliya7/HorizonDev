#include "../../../ShaderCommon.hsh"
#include "../../RasterizationRendererCommon.hsh"
#include "../PostProcessingCommon.hsh"
#include "../ToneMappingCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, ColorTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_SRV(2, float, ExposureTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(3, float3, OutputLuminanceTextureUAV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(4, float3, OutputWeightTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

// From the paper: We weight each intensity 'i' based on how close it is to 0.5 using a Gauss curve: exp(-(i - 0.5)^2 / (2 * sigma^2)).
float3 ExposureFusionComputeWellExposedness(float3 i, float sigma)
{
    return exp(-0.5f * (i - 0.5f) * (i - 0.5f) / (sigma * sigma));
}

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void ExposureFusionComputeLuminanceAndWeightCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D colorTexture = ShaderConstants.GetColorTextureSRV();
    Texture2D<float> exposureTexture = ShaderConstants.GetExposureTextureSRV();
    RWTexture2D<float3> outputLuminanceTextureUAV = ShaderConstants.GetOutputLuminanceTextureUAV();
    RWTexture2D<float3> outputWeightTextureUAV = ShaderConstants.GetOutputWeightTextureUAV();

    uint width, height;
    outputLuminanceTextureUAV.GetDimensions(width, height);

    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5f) / float2(width, height);

    float exposure = exposureTexture[uint2(0, 0)];

    float highlights = 1;
    float shadows = 1;

    float3 inputColor = colorTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).rgb * exposure;

    float highlightLuminance = sqrt(dot(saturate(FastToneMapping(inputColor * highlights)), float3(0.1, 0.7, 0.2)));
    float midtoneLuminance = sqrt(dot(saturate(FastToneMapping(inputColor)), float3(0.1, 0.7, 0.2)));
    float shadowLuminance = sqrt(dot(saturate(FastToneMapping(inputColor * shadows)), float3(0.1, 0.7, 0.2)));

    float3 luminance = float3(highlightLuminance, midtoneLuminance, shadowLuminance);

    float sigma = 0.2f;

    float3 weights = ExposureFusionComputeWellExposedness(luminance, sigma);

    weights /= dot(weights, 1.0f);

    outputLuminanceTextureUAV[pixelCoord] = luminance;
    outputWeightTextureUAV[pixelCoord] = weights;
}