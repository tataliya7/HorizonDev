    {
        shadowFactor += sampleWeights[i] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[i], cascadeIndex), receiverDepth);
    }
#else
    shadowFactor += sampleWeights[0] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[0], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[1] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[1], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[2] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[2], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[3] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[3], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[4] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[4], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[5] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[5], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[6] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[6], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[7] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[7], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[8] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[8], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[9] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[9], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[10] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[10], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[11] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[11], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[12] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[12], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[13] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[13], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[14] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[14], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[15] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[15], cascadeIndex), receiverDepth);
#endif
    return PCFShadowBlur(shadowFactor);
}

float PercentageCloserFiltering(Texture2DArray shadowMapTexture, float2 shadowMapTextureSize, uint cascadeIndex, float2 shadowMapTextureUV, float receiverDepth)
{
#if PCF_QUALITY == 0 // No filtering
    return ShadowFilteringHardShadow(shadowMapTexture, cascadeIndex, shadowMapTextureUV, receiverDepth);
#elif PCF_QUALITY == 1 // 3x3 PCF
    return PercentageCloserFiltering3x3(shadowMapTexture, shadowMapTextureSize, cascadeIndex, shadowMapTextureUV, receiverDepth);
#elif PCF_QUALITY == 2 // 5x5 PCF
    return PercentageCloserFiltering5x5(shadowMapTexture, shadowMapTextureSize, cascadeIndex, shadowMapTextureUV, receiverDepth);
#else // 7x7 PCF
    return PercentageCloserFiltering7x7(shadowMapTexture, shadowMapTextureSize, cascadeIndex, shadowMapTextureUV, receiverDepth);
#endif
}