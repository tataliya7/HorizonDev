#pragma once

#define PCF_QUALITY 3

#define PCF_KERNEL_SHAPE 1

#define PCF_SHADOW_BLUR 1

float PCFShadowBlur(float shadowFactor)
{
#if PCF_SHADOW_BLUR == 0
    return shadowFactor;
#else
    return shadowFactor * shadowFactor;
#endif
}

void PCFComputeSampleUVsAndWeights_3x3_BoxFilter(in float2 shadowMapTextureUV, in float2 shadowMapTextureSize, out float2 sampleUVs[4], out float sampleWeights[4])
{
    float2 texelPosition = shadowMapTextureUV * shadowMapTextureSize.x + 0.5f;
    float2 centerCoordinate = floor(texelPosition);
    float2 centerOffset = frac(texelPosition) - 0.5f;
    float2 centerUV = centerCoordinate * shadowMapTextureSize.y;

    float2 sampleWeightsU = float2(1.5f - centerOffset.x, 1.5f + centerOffset.x) * (1.0f / 3.0f);
    float2 sampleWeightsV = float2(1.5f - centerOffset.y, 1.5f + centerOffset.y) * (1.0f / 3.0f);

    float2 sampleOffsetsU = float2(-0.75f + 0.5f * centerOffset.x, 0.75f + 0.5f * centerOffset.x) * shadowMapTextureSize.y;
    float2 sampleOffsetsV = float2(-0.75f + 0.5f * centerOffset.y, 0.75f + 0.5f * centerOffset.y) * shadowMapTextureSize.y;

    sampleUVs[0] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.x);
    sampleUVs[1] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.y);
    sampleUVs[2] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.x);
    sampleUVs[3] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.y);

    sampleWeights[0] = sampleWeightsU.x * sampleWeightsV.x;
    sampleWeights[1] = sampleWeightsU.x * sampleWeightsV.y;
    sampleWeights[2] = sampleWeightsU.y * sampleWeightsV.x;
    sampleWeights[3] = sampleWeightsU.y * sampleWeightsV.y;
}

void PCFComputeTexelWeights_3x3_TentFilter(in float offset, out float weights[4])
{
    float offsetLeft = min(offset, 0.0f);
    float offsetRight = max(offset, 0.0f);

    float s0 = (0.5f - offset) * (0.5f - offset) * 0.5f;
    float s1 = 1.0f - offset - offsetLeft * offsetLeft;
    float s2 = 1.0f + offset - offsetRight * offsetRight;
    float s3 = s0 + offset; // (0.5f + offset) * (0.5f + offset) * 0.5f

    float inverseTriangleArea = 0.444444f; // 1 / (3 * 1.5 * 0.5)

    weights[0] = s0 * inverseTriangleArea;
    weights[1] = s1 * inverseTriangleArea;
    weights[2] = s2 * inverseTriangleArea;
    weights[3] = s3 * inverseTriangleArea;
}

void PCFComputeSampleUVsAndWeights_3x3_TentFilter(in float2 shadowMapTextureUV, in float2 shadowMapTextureSize, out float2 sampleUVs[4], out float sampleWeights[4])
{
    float2 texelPosition = shadowMapTextureUV * shadowMapTextureSize.x + 0.5f;
    float2 centerCoordinate = floor(texelPosition);
    float2 centerOffset = frac(texelPosition) - 0.5f;
    float2 centerUV = centerCoordinate * shadowMapTextureSize.y;

    float texelWeightsU[4]; float texelWeightsV[4];
    PCFComputeTexelWeights_3x3_TentFilter(centerOffset.x, texelWeightsU);
    PCFComputeTexelWeights_3x3_TentFilter(centerOffset.y, texelWeightsV);

    float2 sampleWeightsU = float2(texelWeightsU[0] + texelWeightsU[1], texelWeightsU[2] + texelWeightsU[3]);
    float2 sampleWeightsV = float2(texelWeightsV[0] + texelWeightsV[1], texelWeightsV[2] + texelWeightsV[3]);

    float2 sampleOffsetsU = (float2(texelWeightsU[1], texelWeightsU[3]) / sampleWeightsU + float2(-1.5f, 0.5f)) * shadowMapTextureSize.y;
    float2 sampleOffsetsV = (float2(texelWeightsV[1], texelWeightsV[3]) / sampleWeightsV + float2(-1.5f, 0.5f)) * shadowMapTextureSize.y;

    sampleUVs[0] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.x);
    sampleUVs[1] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.y);
    sampleUVs[2] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.x);
    sampleUVs[3] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.y);

    sampleWeights[0] = sampleWeightsU.x * sampleWeightsV.x;
    sampleWeights[1] = sampleWeightsU.x * sampleWeightsV.y;
    sampleWeights[2] = sampleWeightsU.y * sampleWeightsV.x;
    sampleWeights[3] = sampleWeightsU.y * sampleWeightsV.y;
}

void PCFComputeSampleUVsAndWeights_5x5_BoxFilter(in float2 shadowMapTextureUV, in float2 shadowMapTextureSize, out float2 sampleUVs[9], out float sampleWeights[9])
{
    float2 texelPosition = shadowMapTextureUV * shadowMapTextureSize.x + 0.5f;
    float2 centerCoordinate = floor(texelPosition);
    float2 centerOffset = frac(texelPosition) - 0.5f;
    float2 centerUV = centerCoordinate * shadowMapTextureSize.y;

    float3 sampleWeightsU = float3(1.5f - centerOffset.x, 2.0f, 1.5f + centerOffset.x) * (1.0f / 4.0f);
    float3 sampleWeightsV = float3(1.5f - centerOffset.y, 2.0f, 1.5f + centerOffset.y) * (1.0f / 4.0f);

    float3 sampleOffsetsU = float3(-1.75f + 0.5f * centerOffset.x, 0.0f, 1.75f + 0.5f * centerOffset.x) * shadowMapTextureSize.y;
    float3 sampleOffsetsV = float3(-1.75f + 0.5f * centerOffset.y, 0.0f, 1.75f + 0.5f * centerOffset.y) * shadowMapTextureSize.y;

    sampleUVs[0] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.x);
    sampleUVs[1] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.y);
    sampleUVs[2] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.z);
    sampleUVs[3] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.x);
    sampleUVs[4] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.y);
    sampleUVs[5] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.z);
    sampleUVs[6] = centerUV + float2(sampleOffsetsU.z, sampleOffsetsV.x);
    sampleUVs[7] = centerUV + float2(sampleOffsetsU.z, sampleOffsetsV.y);
    sampleUVs[8] = centerUV + float2(sampleOffsetsU.z, sampleOffsetsV.z);

    sampleWeights[0] = sampleWeightsU.x * sampleWeightsV.x;
    sampleWeights[1] = sampleWeightsU.x * sampleWeightsV.y;
    sampleWeights[2] = sampleWeightsU.x * sampleWeightsV.z;
    sampleWeights[3] = sampleWeightsU.y * sampleWeightsV.x;
    sampleWeights[4] = sampleWeightsU.y * sampleWeightsV.y;
    sampleWeights[5] = sampleWeightsU.y * sampleWeightsV.z;
    sampleWeights[6] = sampleWeightsU.z * sampleWeightsV.x;
    sampleWeights[7] = sampleWeightsU.z * sampleWeightsV.y;
    sampleWeights[8] = sampleWeightsU.z * sampleWeightsV.z;
}

void PCFComputeTexelWeights_5x5_TentFilter(in float offset, out float weights[6])
{
    float offsetLeft = min(offset, 0.0f);
    float offsetRight = max(offset, 0.0f);

    float s0 = (0.5f - offset) * (0.5f - offset) * 0.5f;
    float s1 = 1.0f - offset;
    float s2 = 2.0f - offset - offsetLeft * offsetLeft;
    float s3 = 2.0f + offset - offsetRight * offsetRight;
    float s4 = 1.0f + offset; 
    float s5 = s0 + offset; // (0.5f + offset) * (0.5f + offset) * 0.5f

    float inverseTriangleArea = 0.16f; // 1 / (5 * 2.5 * 0.5)

    weights[0] = s0 * inverseTriangleArea;
    weights[1] = s1 * inverseTriangleArea;
    weights[2] = s2 * inverseTriangleArea;
    weights[3] = s3 * inverseTriangleArea;
    weights[4] = s4 * inverseTriangleArea;
    weights[5] = s5 * inverseTriangleArea;
}

void PCFComputeSampleUVsAndWeights_5x5_TentFilter(in float2 shadowMapTextureUV, in float2 shadowMapTextureSize, out float2 sampleUVs[9], out float sampleWeights[9])
{
#if 0
    float2 centerUV = shadowMapTextureUV;
    sampleUVs[0] = centerUV + float2(-shadowMapTextureSize.y, -shadowMapTextureSize.y);
    sampleUVs[1] = centerUV + float2(-shadowMapTextureSize.y,  0);
    sampleUVs[2] = centerUV + float2(-shadowMapTextureSize.y,  shadowMapTextureSize.y);
    sampleUVs[3] = centerUV + float2( 0                     , -shadowMapTextureSize.y);
    sampleUVs[4] = centerUV + float2( 0                     ,  0);
    sampleUVs[5] = centerUV + float2( 0                     ,  shadowMapTextureSize.y);
    sampleUVs[6] = centerUV + float2( shadowMapTextureSize.y, -shadowMapTextureSize.y);
    sampleUVs[7] = centerUV + float2( shadowMapTextureSize.y,  0);
    sampleUVs[8] = centerUV + float2( shadowMapTextureSize.y,  shadowMapTextureSize.y);

    sampleWeights[0] = 1.0f / 9.0f;
    sampleWeights[1] = 1.0f / 9.0f;
    sampleWeights[2] = 1.0f / 9.0f;
    sampleWeights[3] = 1.0f / 9.0f;
    sampleWeights[4] = 1.0f / 9.0f;
    sampleWeights[5] = 1.0f / 9.0f;
    sampleWeights[6] = 1.0f / 9.0f;
    sampleWeights[7] = 1.0f / 9.0f;
    sampleWeights[8] = 1.0f / 9.0f;
#else
    float2 texelPosition = shadowMapTextureUV * shadowMapTextureSize.x + 0.5f;
    float2 centerCoordinate = floor(texelPosition);
    float2 centerOffset = frac(texelPosition) - 0.5f;
    float2 centerUV = centerCoordinate * shadowMapTextureSize.y;

    float texelWeightsU[6]; float texelWeightsV[6];
    PCFComputeTexelWeights_5x5_TentFilter(centerOffset.x, texelWeightsU);
    PCFComputeTexelWeights_5x5_TentFilter(centerOffset.y, texelWeightsV);

    float3 sampleWeightsU = float3(texelWeightsU[0] + texelWeightsU[1], texelWeightsU[2] + texelWeightsU[3], texelWeightsU[4] + texelWeightsU[5]);
    float3 sampleWeightsV = float3(texelWeightsV[0] + texelWeightsV[1], texelWeightsV[2] + texelWeightsV[3], texelWeightsV[4] + texelWeightsV[5]);

    float3 sampleOffsetsU = (float3(texelWeightsU[1], texelWeightsU[3], texelWeightsU[5]) / sampleWeightsU + float3(-2.5f, -0.5f, 1.5f)) * shadowMapTextureSize.y;
    float3 sampleOffsetsV = (float3(texelWeightsV[1], texelWeightsV[3], texelWeightsV[5]) / sampleWeightsV + float3(-2.5f, -0.5f, 1.5f)) * shadowMapTextureSize.y;

    sampleUVs[0] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.x);
    sampleUVs[1] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.y);
    sampleUVs[2] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.z);
    sampleUVs[3] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.x);
    sampleUVs[4] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.y);
    sampleUVs[5] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.z);
    sampleUVs[6] = centerUV + float2(sampleOffsetsU.z, sampleOffsetsV.x);
    sampleUVs[7] = centerUV + float2(sampleOffsetsU.z, sampleOffsetsV.y);
    sampleUVs[8] = centerUV + float2(sampleOffsetsU.z, sampleOffsetsV.z);

    sampleWeights[0] = sampleWeightsU.x * sampleWeightsV.x;
    sampleWeights[1] = sampleWeightsU.x * sampleWeightsV.y;
    sampleWeights[2] = sampleWeightsU.x * sampleWeightsV.z;
    sampleWeights[3] = sampleWeightsU.y * sampleWeightsV.x;
    sampleWeights[4] = sampleWeightsU.y * sampleWeightsV.y;
    sampleWeights[5] = sampleWeightsU.y * sampleWeightsV.z;
    sampleWeights[6] = sampleWeightsU.z * sampleWeightsV.x;
    sampleWeights[7] = sampleWeightsU.z * sampleWeightsV.y;
    sampleWeights[8] = sampleWeightsU.z * sampleWeightsV.z;
#endif
}

void PCFComputeTexelWeights_7x7_TentFilter(in float offset, out float weights[8])
{
    float offsetLeft = min(offset, 0.0f);
    float offsetRight = max(offset, 0.0f);

    float s0 = (0.5f - offset) * (0.5f - offset) * 0.5f;
    float s1 = 1.0f - offset;
    float s2 = 2.0f - offset;
    float s3 = 3.0f - offset - offsetLeft * offsetLeft;
    float s4 = 3.0f + offset - offsetRight * offsetRight;
    float s5 = 2.0f + offset;
    float s6 = 1.0f + offset; 
    float s7 = s0 + offset; // (0.5f + offset) * (0.5f + offset) * 0.5f

    float inverseTriangleArea = 0.081633f; // 1 / (7 * 3.5 * 0.5)

    weights[0] = s0 * inverseTriangleArea;
    weights[1] = s1 * inverseTriangleArea;
    weights[2] = s2 * inverseTriangleArea;
    weights[3] = s3 * inverseTriangleArea;
    weights[4] = s4 * inverseTriangleArea;
    weights[5] = s5 * inverseTriangleArea;
    weights[6] = s6 * inverseTriangleArea;
    weights[7] = s7 * inverseTriangleArea;
}

void PCFComputeSampleUVsAndWeights_7x7_TentFilter(in float2 shadowMapTextureUV, in float2 shadowMapTextureSize, out float2 sampleUVs[16], out float sampleWeights[16])
{
    float2 texelPosition = shadowMapTextureUV * shadowMapTextureSize.x + 0.5f;
    float2 centerCoordinate = floor(texelPosition);
    float2 centerOffset = frac(texelPosition) - 0.5f;
    float2 centerUV = centerCoordinate * shadowMapTextureSize.y;

    float texelWeightsU[8]; float texelWeightsV[8];
    PCFComputeTexelWeights_7x7_TentFilter(centerOffset.x, texelWeightsU);
    PCFComputeTexelWeights_7x7_TentFilter(centerOffset.y, texelWeightsV);

    float4 sampleWeightsU = float4(texelWeightsU[0] + texelWeightsU[1], texelWeightsU[2] + texelWeightsU[3], texelWeightsU[4] + texelWeightsU[5], texelWeightsU[6] + texelWeightsU[7]);
    float4 sampleWeightsV = float4(texelWeightsV[0] + texelWeightsV[1], texelWeightsV[2] + texelWeightsV[3], texelWeightsV[4] + texelWeightsV[5], texelWeightsV[6] + texelWeightsV[7]);

    float4 sampleOffsetsU = (float4(texelWeightsU[1], texelWeightsU[3], texelWeightsU[5], texelWeightsU[7]) / sampleWeightsU + float4(-3.5f, -1.5f, 0.5f, 2.5f)) * shadowMapTextureSize.y;
    float4 sampleOffsetsV = (float4(texelWeightsV[1], texelWeightsV[3], texelWeightsV[5], texelWeightsV[7]) / sampleWeightsV + float4(-3.5f, -1.5f, 0.5f, 2.5f)) * shadowMapTextureSize.y;

    sampleUVs[0] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.x);
    sampleUVs[1] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.y);
    sampleUVs[2] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.z);
    sampleUVs[3] = centerUV + float2(sampleOffsetsU.x, sampleOffsetsV.w);
    sampleUVs[4] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.x);
    sampleUVs[5] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.y);
    sampleUVs[6] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.z);
    sampleUVs[7] = centerUV + float2(sampleOffsetsU.y, sampleOffsetsV.w);
    sampleUVs[8] = centerUV + float2(sampleOffsetsU.z, sampleOffsetsV.x);
    sampleUVs[9] = centerUV + float2(sampleOffsetsU.z, sampleOffsetsV.y);
    sampleUVs[10] = centerUV + float2(sampleOffsetsU.z, sampleOffsetsV.z);
    sampleUVs[11] = centerUV + float2(sampleOffsetsU.z, sampleOffsetsV.w);
    sampleUVs[12] = centerUV + float2(sampleOffsetsU.w, sampleOffsetsV.x);
    sampleUVs[13] = centerUV + float2(sampleOffsetsU.w, sampleOffsetsV.y);
    sampleUVs[14] = centerUV + float2(sampleOffsetsU.w, sampleOffsetsV.z);
    sampleUVs[15] = centerUV + float2(sampleOffsetsU.w, sampleOffsetsV.w);

    sampleWeights[0] = sampleWeightsU.x * sampleWeightsV.x;
    sampleWeights[1] = sampleWeightsU.x * sampleWeightsV.y;
    sampleWeights[2] = sampleWeightsU.x * sampleWeightsV.z;
    sampleWeights[3] = sampleWeightsU.x * sampleWeightsV.w;
    sampleWeights[4] = sampleWeightsU.y * sampleWeightsV.x;
    sampleWeights[5] = sampleWeightsU.y * sampleWeightsV.y;
    sampleWeights[6] = sampleWeightsU.y * sampleWeightsV.z;
    sampleWeights[7] = sampleWeightsU.y * sampleWeightsV.w;
    sampleWeights[8] = sampleWeightsU.z * sampleWeightsV.x;
    sampleWeights[9] = sampleWeightsU.z * sampleWeightsV.y;
    sampleWeights[10] = sampleWeightsU.z * sampleWeightsV.z;
    sampleWeights[11] = sampleWeightsU.z * sampleWeightsV.w;
    sampleWeights[12] = sampleWeightsU.w * sampleWeightsV.x;
    sampleWeights[13] = sampleWeightsU.w * sampleWeightsV.y;
    sampleWeights[14] = sampleWeightsU.w * sampleWeightsV.z;
    sampleWeights[15] = sampleWeightsU.w * sampleWeightsV.w;
}

float ShadowFilteringHardShadow(Texture2DArray shadowMapTexture, uint cascadeIndex, float2 shadowMapTextureUV, float receiverDepth)
{
    float shadowMapDepthValue = shadowMapTexture.SampleLevel(GlobalSamplerPointClamp, float3(shadowMapTextureUV, cascadeIndex), 0).r;
    float shadowFactor = (receiverDepth > shadowMapDepthValue) ? 1.0f : 0.0f;
    return shadowFactor;
}

float PercentageCloserFiltering3x3(Texture2DArray shadowMapTexture, float2 shadowMapTextureSize, uint cascadeIndex, float2 shadowMapTextureUV, float receiverDepth)
{
    float2 sampleUVs[4]; float sampleWeights[4];
#if PCF_KERNEL_SHAPE == 0 // Box filter
    PCFComputeSampleUVsAndWeights_3x3_BoxFilter(shadowMapTextureUV, shadowMapTextureSize, sampleUVs, sampleWeights);
#else // Tent filter
    PCFComputeSampleUVsAndWeights_3x3_TentFilter(shadowMapTextureUV, shadowMapTextureSize, sampleUVs, sampleWeights);
#endif

    float shadowFactor = 0.0f;
#if 0
    for (uint i = 0; i < 4; i++)
    {
        shadowFactor += sampleWeights[i] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[i], cascadeIndex), receiverDepth);
    }
#else
    shadowFactor += sampleWeights[0] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[0], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[1] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[1], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[2] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[2], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[3] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[3], cascadeIndex), receiverDepth);
#endif
    return PCFShadowBlur(shadowFactor);
}

float PercentageCloserFiltering5x5(Texture2DArray shadowMapTexture, float2 shadowMapTextureSize, uint cascadeIndex, float2 shadowMapTextureUV, float receiverDepth)
{
    float2 sampleUVs[9]; float sampleWeights[9];
#if PCF_KERNEL_SHAPE == 0 // Box filter
    PCFComputeSampleUVsAndWeights_5x5_BoxFilter(shadowMapTextureUV, shadowMapTextureSize, sampleUVs, sampleWeights);
#else // Tent filter
    PCFComputeSampleUVsAndWeights_5x5_TentFilter(shadowMapTextureUV, shadowMapTextureSize, sampleUVs, sampleWeights);
#endif

    float shadowFactor = 0.0f;
#if 0
