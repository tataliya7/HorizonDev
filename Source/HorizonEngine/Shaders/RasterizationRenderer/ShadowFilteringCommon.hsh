    {
        shadowFactor += sampleWeights[i] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[i], cascadeIndex), receiverDepth);
    }
#else
    shadowFactor += sampleWeights[0] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[0], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[1] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[1], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[2] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[2], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[3] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[3], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[4] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[4], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[5] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[5], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[6] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[6], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[7] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[7], cascadeIndex), receiverDepth);
    shadowFactor += sampleWeights[8] * shadowMapTexture.SampleCmpLevelZero(GlobalSamplerComparisonGreaterLinearClamp, float3(sampleUVs[8], cascadeIndex), receiverDepth);
#endif
    return PCFShadowBlur(shadowFactor);
}

float PercentageCloserFiltering7x7(Texture2DArray shadowMapTexture, float2 shadowMapTextureSize, uint cascadeIndex, float2 shadowMapTextureUV, float receiverDepth)
{
    float2 sampleUVs[16]; float sampleWeights[16];
#if PCF_KERNEL_SHAPE == 0 // Box filter
    PCFComputeSampleUVsAndWeights_7x7_BoxFilter(shadowMapTextureUV, shadowMapTextureSize, sampleUVs, sampleWeights);
#else // Tent filter
    PCFComputeSampleUVsAndWeights_7x7_TentFilter(shadowMapTextureUV, shadowMapTextureSize, sampleUVs, sampleWeights);
#endif

    float shadowFactor = 0.0f;
#if 0
