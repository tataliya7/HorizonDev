#include "../ShaderCommon.hsh"
#include "../Random.hsh"
#include "RasterizationRendererCommon.hsh"
#include "ShadowMapCommon.hsh"

#define CSM_CASCADE_SELECTION_METHOD 1
#define CSM_CASCADE_BLENDING_METHOD 0

#define ENABLE_DEBUG_VISUALIZATION 1

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(1, CascadedShadowMapShaderParameters, CascadeShadowMapDataBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, DepthTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(3, NormalTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_ARRAY_DEFAULT_SRV(4, ShadowMapTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(5, float4, ShadowMaskTextureUAV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(6, float4, CascadedShadowMapDebugVisualizationTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

float CSMShadowMapSampling(
    CascadedShadowMapShaderParameters cascadedShadowMapShaderParameters,
    Texture2DArray shadowMapTexture,
    float3 worldSpacePosition,
    uint cascadeIndex)
{
    float shadowFactor = 1.0f;

    if (cascadeIndex < cascadedShadowMapShaderParameters.cascadeCount)
    {
        float4 shadowMapTextureCoord = mul(cascadedShadowMapShaderParameters.worldToClipMatrix[cascadeIndex], float4(worldSpacePosition, 1.0f));
        shadowMapTextureCoord /= shadowMapTextureCoord.w;
        shadowMapTextureCoord.xy = NDCSpaceXYToScreenSpaceUV(shadowMapTextureCoord.xy);

        bool valid = shadowMapTextureCoord.x > 0.0f && shadowMapTextureCoord.x < 1.0f &&
                     shadowMapTextureCoord.y > 0.0f && shadowMapTextureCoord.y < 1.0f &&
                     shadowMapTextureCoord.z > 0.0f && shadowMapTextureCoord.z < 1.0f;

        if (valid)
        {
            shadowFactor = PercentageCloserFiltering(
                shadowMapTexture,
                cascadedShadowMapShaderParameters.shadowMapSize,
                cascadeIndex,
                shadowMapTextureCoord.xy,
                shadowMapTextureCoord.z,
                DEFAULT_CONSTANT_SHADOW_DEPTH_BIAS);
        }
    }

    return shadowFactor;
}

float CSMEvaluateShadowFactor_SlicePlaneSelection_Dither(
    in CascadedShadowMapShaderParameters cascadedShadowMapShaderParameters,
    in Texture2DArray shadowMapTexture,
    in float2 pixelPosition,
    in float3 worldSpacePosition,
    in float3 worldSpaceNormal,
    in float cameraSpaceDepth,
    out uint outCascadeIndex)
{
    uint cascadeIndex = ComputeCascadeIndexSlicePlaneSelection(cascadedShadowMapShaderParameters, cameraSpaceDepth);
    outCascadeIndex = cascadeIndex;

    const float transitionStartDistance = cascadedShadowMapShaderParameters.transitionStartDistance[cascadeIndex];
    const float inverseTransitionRange = cascadedShadowMapShaderParameters.inverseTransitionRange[cascadeIndex];

    float noise = InterleavedGradientNoise(pixelPosition);
    float alpha = saturate((cameraSpaceDepth - transitionStartDistance) * inverseTransitionRange);

    bool evaluateNextCascade = (cameraSpaceDepth > transitionStartDistance) && step(noise, alpha);

    if (evaluateNextCascade)
    {
        cascadeIndex = min(cascadeIndex + 1, cascadedShadowMapShaderParameters.cascadeCount - 1);
    }

    float shadowFactor = CSMShadowMapSampling(
        cascadedShadowMapShaderParameters,
        shadowMapTexture,
        worldSpacePosition,
        cascadeIndex);

    return shadowFactor;
}

float CSMEvaluateShadowFactor_SlicePlaneSelection_Blend(
    in CascadedShadowMapShaderParameters cascadedShadowMapShaderParameters,
    in Texture2DArray shadowMapTexture,
    in float2 pixelPosition,
    in float3 worldSpacePosition,
    in float3 worldSpaceNormal,
    in float cameraSpaceDepth,
    out uint outCascadeIndex)
{
    uint cascadeIndex = ComputeCascadeIndexSlicePlaneSelection(cascadedShadowMapShaderParameters, cameraSpaceDepth);
    outCascadeIndex = cascadeIndex;

    const float transitionStartDistance = cascadedShadowMapShaderParameters.transitionStartDistance[cascadeIndex];
    const float inverseTransitionRange = cascadedShadowMapShaderParameters.inverseTransitionRange[cascadeIndex];

    float shadowFactor = CSMShadowMapSampling(
        cascadedShadowMapShaderParameters,
        shadowMapTexture,
        worldSpacePosition,
        cascadeIndex);

    bool evaluateNextCascade = (cameraSpaceDepth > transitionStartDistance) && ((cascadeIndex + 1) < cascadedShadowMapShaderParameters.cascadeCount);

    if (evaluateNextCascade)
    {
        float secondaryShadowFactor = CSMShadowMapSampling(
            cascadedShadowMapShaderParameters,
            shadowMapTexture,
            worldSpacePosition,
            cascadeIndex + 1);

        float alpha = saturate((cameraSpaceDepth - transitionStartDistance) * inverseTransitionRange);
        shadowFactor = lerp(shadowFactor, secondaryShadowFactor, alpha);
    }

    return shadowFactor;
}

float CSMEvaluateShadowFactor_BoundingShpereSelection_Dither(
    in CascadedShadowMapShaderParameters cascadedShadowMapShaderParameters,
    in Texture2DArray shadowMapTexture,
    in float2 pixelPosition,
    in float3 worldSpacePosition,
    in float3 worldSpaceNormal,
    in float cameraSpaceDepth,
    out uint outCascadeIndex)
{
    uint cascadeIndex = ComputeCascadeIndexBoundingSphereSelection(cascadedShadowMapShaderParameters, worldSpacePosition);
    outCascadeIndex = cascadeIndex;

    const float transitionStartDistance = cascadedShadowMapShaderParameters.transitionStartDistance[cascadeIndex];
    const float inverseTransitionRange = cascadedShadowMapShaderParameters.inverseTransitionRange[cascadeIndex];

    float noise = InterleavedGradientNoise(pixelPosition);

    float3 cascadeVector = worldSpacePosition - cascadedShadowMapShaderParameters.cascadeBoundingSphere[cascadeIndex].xyz;
    float boundingSphereRadius = cascadedShadowMapShaderParameters.cascadeBoundingSphere[cascadeIndex].w;
    float distanceFactor = sqrt(saturate(dot(cascadeVector, cascadeVector) / (boundingSphereRadius * boundingSphereRadius)));

    float blendScale = 1 - cascadedShadowMapShaderParameters.cascadeBlendScale[cascadeIndex];
    float alpha = saturate((distanceFactor - blendScale) / (1 - blendScale));

    bool evaluateNextCascade = (alpha > 0) && step(noise, alpha);

    if (evaluateNextCascade)
    {
        cascadeIndex = min(cascadeIndex + 1, cascadedShadowMapShaderParameters.cascadeCount - 1);
    }

    float shadowFactor = CSMShadowMapSampling(
        cascadedShadowMapShaderParameters,
        shadowMapTexture,
        worldSpacePosition,
        cascadeIndex);

    return shadowFactor;
}

float CSMEvaluateShadowFactor_BoundingShpereSelection_Blend(
    in CascadedShadowMapShaderParameters cascadedShadowMapShaderParameters,
    in Texture2DArray shadowMapTexture,
    in float2 pixelPosition,
    in float3 worldSpacePosition,
    in float3 worldSpaceNormal,
    in float cameraSpaceDepth,
    out uint outCascadeIndex)
{
    uint cascadeIndex = ComputeCascadeIndexBoundingSphereSelection(cascadedShadowMapShaderParameters, worldSpacePosition);
    outCascadeIndex = cascadeIndex;

    float shadowFactor = CSMShadowMapSampling(
        cascadedShadowMapShaderParameters,
        shadowMapTexture,
        worldSpacePosition,
        cascadeIndex);

    float3 cascadeVector = worldSpacePosition - cascadedShadowMapShaderParameters.cascadeBoundingSphere[cascadeIndex].xyz;
    float boundingSphereRadius = cascadedShadowMapShaderParameters.cascadeBoundingSphere[cascadeIndex].w;
    float distanceFactor = sqrt(saturate(dot(cascadeVector, cascadeVector) / (boundingSphereRadius * boundingSphereRadius)));

    float blendScale = 1 - cascadedShadowMapShaderParameters.cascadeBlendScale[cascadeIndex];
    float alpha = saturate((distanceFactor - blendScale) / (1 - blendScale));

    bool evaluateNextCascade = (distanceFactor > blendScale) && ((cascadeIndex + 1) < cascadedShadowMapShaderParameters.cascadeCount);

    if (evaluateNextCascade)
    {
        float secondaryShadowFactor = CSMShadowMapSampling(
            cascadedShadowMapShaderParameters,
            shadowMapTexture,
            worldSpacePosition,
            cascadeIndex + 1);

        shadowFactor = lerp(shadowFactor, secondaryShadowFactor, alpha);
    }

    return shadowFactor;
}

[shader("compute")]
[numthreads(8, 8, 1)]
void ShadowMapProjectionForDistantLightCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];

    uint width = frameShaderParameters.renderWidth;
    uint height = frameShaderParameters.renderHeight;
    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5f) * frameShaderParameters.renderResolution.zw;

    StructuredBuffer<CascadedShadowMapShaderParameters> cascadedShadowMapDataBuffer = ShaderConstants.GetCascadeShadowMapDataBufferSRV();
    Texture2D depthTexture = ShaderConstants.GetDepthTextureSRV();
    Texture2D normalTexture = ShaderConstants.GetNormalTextureSRV();
    Texture2DArray shadowMapTexture = ShaderConstants.GetShadowMapTextureSRV();
    RWTexture2D<float4> shadowMaskTexture = ShaderConstants.GetShadowMaskTextureUAV();

    CascadedShadowMapShaderParameters cascadedShadowMapShaderParameters = cascadedShadowMapDataBuffer[0];
    float depth = depthTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;
    float3 worldSpaceNormal = DecodeNormalFromGBuffer(normalTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).rgb);
    float3 worldSpacePosition = ReconstructWorldSpacePositionFromUVZ(uv, depth, frameShaderParameters.clipToWorldMatrix);
    float4 cameraSpacePosition = mul(frameShaderParameters.worldToViewMatrix, float4(worldSpacePosition, 1.0f));

    // TODO
    float cameraSpaceDepth = -cameraSpacePosition.z;

    if ((depth == FAR_CLIPPING_PLANE_DEPTH_VALUE) ||
        (cameraSpaceDepth > cascadedShadowMapShaderParameters.maxShadowDistance))
    {
        shadowMaskTexture[pixelCoord] = float4(1.0f, 0.0f, 0.0f, 0.0f);
        return;
    }

    uint cascadeIndex;

    float shadowFactor = 1.0f;

#if CSM_CASCADE_SELECTION_METHOD == 0
    #if CSM_CASCADE_BLENDING_METHOD == 0
        shadowFactor = CSMEvaluateShadowFactor_SlicePlaneSelection_Dither(
            cascadedShadowMapShaderParameters,
            shadowMapTexture,
            pixelCoord,
            worldSpacePosition,
            worldSpaceNormal,
            cameraSpaceDepth,
            cascadeIndex);
    #else
        shadowFactor = CSMEvaluateShadowFactor_SlicePlaneSelection_Blend(
            cascadedShadowMapShaderParameters,
            shadowMapTexture,
            pixelCoord,
            worldSpacePosition,
            worldSpaceNormal,
            cameraSpaceDepth,
            cascadeIndex);
    #endif
#else
    #if CSM_CASCADE_BLENDING_METHOD == 0
        shadowFactor = CSMEvaluateShadowFactor_BoundingShpereSelection_Dither(
            cascadedShadowMapShaderParameters,
            shadowMapTexture,
            pixelCoord,
            worldSpacePosition,
            worldSpaceNormal,
            cameraSpaceDepth,
            cascadeIndex);
    #else
        shadowFactor = CSMEvaluateShadowFactor_BoundingShpereSelection_Blend(
            cascadedShadowMapShaderParameters,
            shadowMapTexture,
            pixelCoord,
            worldSpacePosition,
            worldSpaceNormal,
            cameraSpaceDepth,
            cascadeIndex);
    #endif
#endif

    float fadeOut = saturate((cameraSpaceDepth - cascadedShadowMapShaderParameters.shadowFadeOutParameters.x) * cascadedShadowMapShaderParameters.shadowFadeOutParameters.y);
    shadowFactor = lerp(shadowFactor, 1.0f, fadeOut * fadeOut);

    shadowMaskTexture[pixelCoord] = float4(EncodeShadowFactor(shadowFactor), 0.0f, 0.0f, 0.0f);

#if ENABLE_DEBUG_VISUALIZATION
    RWTexture2D<float4> debugVisualizationTextureUAV = ShaderConstants.GetCascadedShadowMapDebugVisualizationTextureUAV();
    float3 color = UintToColor(cascadeIndex + 4);
    debugVisualizationTextureUAV[pixelCoord] = float4(color + 0.2f * shadowFactor, 1.0f);
#endif
}