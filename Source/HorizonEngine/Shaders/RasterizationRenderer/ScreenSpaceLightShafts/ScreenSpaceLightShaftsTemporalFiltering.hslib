{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D inputColorTexture = ShaderConstants.GetInputColorTextureSRV();
    Texture2D inputDepthTexture = ShaderConstants.GetInputColorTextureSRV();
    Texture2D historyColorTexture = ShaderConstants.GetHistoryColorTextureSRV();
    RWTexture2D<float3> outputColorTexture = ShaderConstants.GetOutputColorTextureUAV();

    uint outputColorTextureWidth, outputColorTextureHeight;
    outputColorTexture.GetDimensions(outputColorTextureWidth, outputColorTextureHeight);
    if (dispatchThreadID.x >= outputColorTextureWidth || dispatchThreadID.y >= outputColorTextureHeight)
    {
        return;
    }

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (float2(pixelCoord.x, pixelCoord.y) + 0.5f) * float2(1.0f / outputColorTextureWidth, 1.0f / outputColorTextureHeight);
    float2 jitteredUV = (float2(pixelCoord.x, pixelCoord.y) + 0.5f + frameShaderParameters.cameraJitterOffset) * float2(1.0f / outputColorTextureWidth, 1.0f / outputColorTextureHeight);

