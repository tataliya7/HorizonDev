#if __SHADER_TARGET_STAGE == __SHADER_STAGE_AMPLIFICATION

[shader("amplification")]
[numthreads(TASK_SHADER_WORKGROUP_SIZE, 1, 1)]
void VisibilityBufferAS(uint dispatchThreadID : SV_DispatchThreadID)
{
    bool visible = false;

    ByteAddressBuffer vertexBuffer0 = GetVertexBuffer0SRV();

    if (dispatchThreadID.x < MeshInfo.meshletCount)
    {
        // visible = IsVisible(MeshletCullData[dtid], Instance.World, Instance.Scale, Constants.CullViewPosition);
        visible = true;
    }

    if (visible)
    {
        uint visibleMeshletIndex = WavePrefixCountBits(visible);
        SharedPayload.meshletIndices[visibleMeshletIndex] = dispatchThreadID;
    }

    uint visibleMeshletCount = WaveActiveCountBits(visible);

    DispatchMesh(visibleMeshletCount, 1, 1, SharedPayload);
}

#endif

#if __SHADER_TARGET_STAGE == __SHADER_STAGE_MESH

[shader("mesh")]
[outputtopology("triangle")]
[numthreads(128, 1, 1)]
void VisibilityBufferMS(
    uint groupThreadID : SV_GroupThreadID,
    uint groupID : SV_GroupID,
    in payload MeshPayload payload,
    out vertices VertexAttributes outVertices[256],
    out indices uint3 outIndices[128],
    out primitives PrimitiveAttributes outPrimitives[128])
{
    uint meshletIndex = payload.meshletIndices[groupID];
    uint triangleIndex = groupThreadID;

    // TODO
    uint meshletCount = 1;

    if (meshletIndex >= meshletCount)
    {
        return;
    }

    StructuredBuffer<RasterizationRendererUniformVariables> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    RasterizationRendererUniformVariables frameShaderParameters = frameShaderParameterBuffer[0];
    //ByteAddressBuffer meshletDescBuffer = GetMeshletDescBufferSRV();

    MeshletDesc meshletDesc;// = GetMeshletDesc(meshletDescBuffer, meshletIndex);

    uint vertexCount = meshletDesc.vertexCount;
    uint triangleCount = meshletDesc.triangleCount;
    SetMeshOutputCounts(vertexCount, triangleCount);

    //
    {
        uint vertexOutputIndex = groupThreadID;
        if (vertexOutputIndex < vertexCount)
        {
            VertexAttributes vertex = GetVertexAttributes(frameShaderParameters, meshletDesc, vertexOutputIndex);
            outVertices[vertexOutputIndex] = vertex;
        }
        vertexOutputIndex += 128;
        if (vertexOutputIndex < vertexCount)
        {
            VertexAttributes vertex = GetVertexAttributes(frameShaderParameters, meshletDesc, vertexOutputIndex);
            outVertices[vertexOutputIndex] = vertex;
        }
    }

    if (triangleIndex < triangleCount)
    {
        uint3 indices = DecodeTriangleIndices(meshletDesc, triangleIndex);
        outIndices[triangleIndex] = indices;

        PrimitiveAttributes primitive;
        primitive.packedData.x = meshletIndex;
        primitive.packedData.y = triangleIndex;
        primitive.packedData.z = 0;
        primitive.packedData.w = 0;
        outPrimitives[triangleIndex] = primitive;
    }
}

#endif

#if __SHADER_TARGET_STAGE == __SHADER_STAGE_PIXEL

[shader("pixel")]
void VisibilityBufferPS(
    VertexAttributes vertexAttributes,
    PrimitiveAttributes primitiveAttributes,
    out uint vbuffer0 : SV_Target0,
    out float3 vbuffer1 : SV_Target1)
{
    uint meshletIndex = primitiveAttributes.packedData.x;

    vbuffer0 = 0;
    vbuffer1 = 0;
    // Per-meshlet color shading
    {
        vbuffer1 = float3(
            float(meshletIndex & 1),
            float(meshletIndex & 3) / 4,
            float(meshletIndex & 7) / 8);
    }
}

