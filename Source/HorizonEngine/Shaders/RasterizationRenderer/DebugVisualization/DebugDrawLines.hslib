#include "../../ShaderCommon.hsh"
#include "../RasterizationRendererCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, RasterizationRendererUniformVariables, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(1, LineVertexBufferSRV);
SHADER_CONSTANTS_STRUCT_END();

[shader("vertex")]
void DebugDrawLinesVS(uint vertexIndex : SV_VertexID, out float4 color : COLOR, out float4 position : SV_Position)
{
    StructuredBuffer<RasterizationRendererUniformVariables> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    RasterizationRendererUniformVariables frameShaderParameters = frameShaderParameterBuffer[0];

    ByteAddressBuffer vertexBuffer = ShaderConstants.GetLineVertexBufferSRV();
    float3 vertexPosition = vertexBuffer.Load<float3>(vertexIndex * sizeof(float3));
    float4 clipSpacePosition = mul(frameShaderParameters.nonJitteredWorldToClipMatrix, float4(vertexPosition, 1.0f));

    color = float4(1, 1, 1, 1);
    if (vertexIndex % 2 == 1)
    {
        color = float4(0, 0, 1, 1);
    }
    position = clipSpacePosition;
}

[shader("pixel")]
void DebugDrawLinesPS(in float4 color : COLOR, out float4 result : SV_Target0)
{
    result = color;
}