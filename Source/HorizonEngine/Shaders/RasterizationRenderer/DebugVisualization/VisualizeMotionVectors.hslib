#include "../../ShaderCommon.hsh"
#include "../RasterizationRendererCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, MotionVectorTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(2, float4, OutputTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(8, 8, 1)]
void VisualizeMotionVectorsCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D motionVectorTexture = ShaderConstants.GetMotionVectorTextureSRV();
    RWTexture2D<float4> outputTexture = ShaderConstants.GetOutputTextureUAV();

    uint2 pixelCoord = dispatchThreadID.xy;

    uint width, height;
    outputTexture.GetDimensions(width, height);
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    float2 uv = (pixelCoord + 0.5f) * float2(1.0f / width, 1.0f / height);

    // TODO: process motion vectors at lower resolution
    float2 motionVector = motionVectorTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).xy;
    motionVector *= float2(frameShaderParameters.renderWidth, frameShaderParameters.renderHeight);

    float angle = atan2(motionVector.y, motionVector.x) * 180.0f / PI;
    if (angle < 0)
    {
        angle += 360.0f;
    }

    // TODO: promote to parameter
    float maxVisibleMotionVectorLength = 30.0f;
    float magnitude = length(motionVector) / maxVisibleMotionVectorLength; // normalize to [0, 1]

    float hue = angle / 360.0f;
    float saturation = magnitude;
    float value = 1.0f;

    float3 hsv = float3(hue, saturation, value);
    float3 rgb = HSV2RGB(hsv);

    outputTexture[pixelCoord] = float4(rgb, 1.0f);
}