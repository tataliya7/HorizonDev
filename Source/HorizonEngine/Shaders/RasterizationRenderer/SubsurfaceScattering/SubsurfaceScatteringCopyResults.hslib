#include "../../ShaderCommon.hsh"
#include "../RasterizationRendererCommon.hsh"
#include "SubsurfaceScatteringCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(1, SubsurfaceScatteringTileDataBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, SubsurfaceScatteringTextureSRV);
SHADER_CONSTANTS_STRUCT_END();

struct SubsurfaceScatteringCopyResultsVSOutput
{
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
};

[shader("vertex")]
void SubsurfaceScatteringCopyResultsVS(uint VertexID : SV_VertexID, uint InstanceID : SV_InstanceID, out SubsurfaceScatteringCopyResultsVSOutput vsOutput)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    ByteAddressBuffer tileDataBuffer = ShaderConstants.GetSubsurfaceScatteringTileDataBufferSRV();

    uint2 tileIndex = tileDataBuffer.Load<uint2>(InstanceID * sizeof(uint2));
    uint2 vertexPosition = tileIndex * SUBSURFACE_SCATTERING_TILE_SIZE + SubsurfaceScatteringTileVertexPositionOffsets[VertexID];

    vsOutput.uv = float2(vertexPosition) * frameShaderParameters.renderResolution.zw;
    vsOutput.position = float4(ScreenSpaceUVToNDCSpaceXY(vsOutput.uv), 0.0f, 1.0f);
}

[shader("pixel")]
void SubsurfaceScatteringCopyResultsPS(SubsurfaceScatteringCopyResultsVSOutput vsOutput, out float4 outColor : SV_Target0)
{
    Texture2D subsurfaceScatteringTexture = ShaderConstants.GetSubsurfaceScatteringTextureSRV();

    const float2 uv = vsOutput.uv;

    outColor = subsurfaceScatteringTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0.0f);
}