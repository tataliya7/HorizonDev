#include "../../ShaderCommon.hsh"
#include "../RasterizationRendererCommon.hsh"
#include "SubsurfaceScatteringCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(1, SubsurfaceScatteringTileDataBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, ColorTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(3, ConvolvedSurfaceScatteringTextureSRV);
SHADER_CONSTANTS_STRUCT_END();

struct SubsurfaceScatteringLightingCompositionVSOutput
{
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
};

[shader("vertex")]
void SubsurfaceScatteringLightingCompositionVS(uint vertexID : SV_VertexID, uint instanceID : SV_InstanceID, out SubsurfaceScatteringLightingCompositionVSOutput output)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    ByteAddressBuffer tileDataBuffer = ShaderConstants.GetSubsurfaceScatteringTileDataBufferSRV();

    uint2 tileIndex = tileDataBuffer.Load<uint2>(instanceID * sizeof(uint2));
    uint2 vertexPosition = tileIndex * SUBSURFACE_SCATTERING_TILE_SIZE + SubsurfaceScatteringTileVertexPositionOffsets[vertexID];

    float2 uv = float2(vertexPosition) * frameShaderParameters.renderResolution.zw;

    output.position = float4(ScreenSpaceUVToNDCSpaceXY(uv), 0.0f, 1.0f);
    output.uv = uv;
}

[shader("pixel")]
void SubsurfaceScatteringLightingCompositionPS(SubsurfaceScatteringLightingCompositionVSOutput input, out float4 outColor : SV_Target0)
{
    Texture2D colorTexture = ShaderConstants.GetColorTextureSRV();
    Texture2D convolvedSurfaceScatteringTextureSRV = ShaderConstants.GetConvolvedSurfaceScatteringTextureSRV();

    float2 uv = input.uv;

    float4 color = colorTexture.SampleLevel(GlobalSamplerPointBorder, uv, 0);

    bool useSubsurfaceScattering = true;
    if (!useSubsurfaceScattering)
    {
        outColor = color;
        return;
    }

    float3 baseColor = 1.0f;

    float3 subsurfaceScatteringColor = convolvedSurfaceScatteringTextureSRV.SampleLevel(GlobalSamplerPointBorder, uv, 0).rgb;

    SubsurfaceScatteringDiffuseAndSpecluar diffuseAndSpecluar = ReconstructDiffuseAndSpecluar(color.rgb, color.a);

    outColor = float4(subsurfaceScatteringColor * baseColor + diffuseAndSpecluar.specular, 0.0f);
    outColor = float4(diffuseAndSpecluar.diffuse + diffuseAndSpecluar.specular, 0.0f);
}