#include "../../ShaderCommon.hsh"
#include "../RasterizationRendererCommon.hsh"
#include "SubsurfaceScatteringCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(0, SubsurfaceScatteringTileCountBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(1, SubsurfaceScatteringDrawIndirectArgumentBufferUAV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(2, SubsurfaceScatteringDispatchIndirectArgumentBufferUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(1, 1, 1)]
void SubsurfaceScatteringBuildIndirectArgumentsCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    ByteAddressBuffer tileCountBuffer = ShaderConstants.GetSubsurfaceScatteringTileCountBufferSRV();
    RWByteAddressBuffer drawIndirectArgumentBuffer = ShaderConstants.GetSubsurfaceScatteringDrawIndirectArgumentBufferUAV();
    RWByteAddressBuffer dispatchIndirectArgumentBuffer = ShaderConstants.GetSubsurfaceScatteringDispatchIndirectArgumentBufferUAV();

    const uint tileCount = tileCountBuffer.Load<uint>(0);

    // DrawIndirectArgumens(verticeCount, instanceCount, firstVertex, firstInstance)
    drawIndirectArgumentBuffer.Store<uint4>(0, uint4(6, tileCount, 0, 0));

    // DispatchIndirectArgumens(threadGroupCountX, threadGroupCountY, threadGroupCountZ)
    dispatchIndirectArgumentBuffer.Store<uint3>(0, uint3(tileCount, 1, 1));
}