static const float SSR_ROUGHNESS_THRESHOLD_CHEAP_RAY_TRACING = 0.6f;
static const float SSR_ROUGHNESS_THRESHOLD_EXPENSIVE_RAY_TRACING = 0.35f;

static const uint SSR_THREAD_GROUP_SIZE = 8;
static const uint SSR_TILE_SIZE = 32;

static const uint SSR_RAY_ALLOCATION_BUFFER_OFFSET_EARLY_EXIT_TILE_COUNT                         = 0;
static const uint SSR_RAY_ALLOCATION_BUFFER_OFFSET_CHEAP_RAY_TRACING_TILE_COUNT                  = SSR_RAY_ALLOCATION_BUFFER_OFFSET_EARLY_EXIT_TILE_COUNT + 4;
static const uint SSR_RAY_ALLOCATION_BUFFER_OFFSET_EXPENSIVE_RAY_TRACING_TILE_COUNT              = SSR_RAY_ALLOCATION_BUFFER_OFFSET_CHEAP_RAY_TRACING_TILE_COUNT + 4;
static const uint SSR_RAY_ALLOCATION_BUFFER_OFFSET_INDIRECT_ARGUMENTS_EARLY_EXIT_PASS            = SSR_RAY_ALLOCATION_BUFFER_OFFSET_EXPENSIVE_RAY_TRACING_TILE_COUNT + 4;
static const uint SSR_RAY_ALLOCATION_BUFFER_OFFSET_INDIRECT_ARGUMENTS_CHEAP_RAY_TRACING_PASS     = SSR_RAY_ALLOCATION_BUFFER_OFFSET_INDIRECT_ARGUMENTS_EARLY_EXIT_PASS + 4 * 3;
static const uint SSR_RAY_ALLOCATION_BUFFER_OFFSET_INDIRECT_ARGUMENTS_EXPENSIVE_RAY_TRACING_PASS = SSR_RAY_ALLOCATION_BUFFER_OFFSET_INDIRECT_ARGUMENTS_CHEAP_RAY_TRACING_PASS + 4 * 3;
static const uint SSR_RAY_ALLOCATION_BUFFER_SIZE                                                 = SSR_RAY_ALLOCATION_BUFFER_OFFSET_INDIRECT_ARGUMENTS_EXPENSIVE_RAY_TRACING_PASS + 4 * 3;

// Bias used on GGX importance sample when denoising, to remove part of the tale that create a lot more noise.
#define GGX_IMPORTANCE_SAMPLE_BIAS 0.1f

bool ShouldComputeReflections(float depth, float roughness, float roughnessThreshold)
{
    return (depth > 0.0) && (roughness < roughnessThreshold);
}

// Brian Karis, Epic Games "Real Shading in Unreal Engine 4"
float4 SSRImportanceSampleGGX(float2 Xi, float Roughness)
{
    float m = Roughness * Roughness;
    float m2 = m * m;

    float Phi = 2 * M_PI * Xi.x;

    float CosTheta = sqrt((1.0 - Xi.y) / (1.0 + (m2 - 1.0) * Xi.y));
    float SinTheta = sqrt(max(1e-5, 1.0 - CosTheta * CosTheta));

    float3 H;
    H.x = SinTheta * cos(Phi);
    H.y = SinTheta * sin(Phi);
    H.z = CosTheta;

    float d = (CosTheta * m2 - CosTheta) * CosTheta + 1;
    float D = m2 / (M_PI * d * d);
    float pdf = D * CosTheta;

    return float4(H, pdf);
}

// [ Duff et al. 2017, "Building an Orthonormal Basis, Revisited" ]
// http://jcgt.org/published/0006/01/01/
float3x3 GetTangentBasis(float3 TangentZ)
{
    const float Sign = TangentZ.z >= 0 ? 1 : -1;
    const float a = -rcp(Sign + TangentZ.z);
    const float b = TangentZ.x * TangentZ.y * a;

    float3 TangentX = { 1 + Sign * a * pow(TangentZ.x, 2), Sign * b, -Sign * TangentZ.x };
    float3 TangentY = { b, Sign + a * pow(TangentZ.y, 2), -TangentZ.y };

    return float3x3(TangentX, TangentY, TangentZ);
}

float2 SampleDisk(float2 Xi)
{
    float theta = 2 * M_PI * Xi.x;
    float radius = sqrt(Xi.y);
    return radius * float2(cos(theta), sin(theta));
}

