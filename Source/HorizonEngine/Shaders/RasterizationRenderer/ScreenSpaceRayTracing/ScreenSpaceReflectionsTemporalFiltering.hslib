#include "../ShaderCommon.hsh"
#include "RasterizationRendererCommon.hsh"
#include "ScreenSpaceReflectionsCommon.hsh"

BIND_BUFFER_CBV(0, RasterizationRendererUniformVariables);
BIND_TEXTURE_2D_SRV(1, SceneDepth);
BIND_TEXTURE_2D_SRV(2, GBuffer1);
BIND_TEXTURE_2D_SRV(3, VelocityBuffer);
BIND_TEXTURE_2D_SRV(4, ResolveTexture);
BIND_TEXTURE_2D_SRV(5, ResolveVariance);
BIND_TEXTURE_2D_SRV(6, ReprojectionDepth);
BIND_TEXTURE_2D_SRV(7, HistoryOutputTexture);
BIND_TEXTURE_2D_SRV(8, HistoryTemporalVariance);
BIND_TEXTURE_2D_SRV(9, HistoryDepthBuffer);
BIND_TEXTURE_2D_UAV(10, float4, OutputTexture);
BIND_TEXTURE_2D_UAV(11, float, TemporalVariance);

static const float temporalResponse = 0.95;
static const float temporalScale = 2.0;
static const float disocclusionDepthWeight = 1.0f;
static const float disocclusionThreshold = 0.9f;
static const float varianceTemporalResponse = 0.9f;

inline bool is_saturated(float a) { return a == saturate(a); }
inline bool is_saturated(float2 a) { return all(a == saturate(a)); }
inline bool is_saturated(float3 a) { return all(a == saturate(a)); }
inline bool is_saturated(float4 a) { return all(a == saturate(a)); }

float2 CalculateReprojectionBuffer(float2 uv, float depth, float4x4 clipToWorldMatrix, float4x4 previousWorldToClipMatrix)
{
    float2 screenPosition = ScreenSpaceUVToNDCSpaceXY(uv);
    float4 currClipPosition = float4(screenPosition, depth, 1);
    float4 worldPosition = mul(currClipPosition, clipToWorldMatrix);
    float4 prevClipPosition = mul(worldPosition, previousWorldToClipMatrix);
    float2 prevScreenPosition = prevClipPosition.xy / prevClipPosition.w;
    return NDCSpaceXYToScreenSpaceUV(prevScreenPosition);
}

float GetDisocclusion(float depth, float depthHistory, float near, float far)
{
    float linearDepthCurrent = LinearDepth01(depth, near, far);
    float linearDepthHistory = LinearDepth01(depthHistory, near, far);
    float disocclusion = 1.0
        //* exp(-abs(1.0 - max(0.0, dot(normal, normalHistory))) * disocclusionNormalWeight) // Potential normal check if necessary
        * exp(-abs(linearDepthHistory - linearDepthCurrent) / linearDepthCurrent * disocclusionDepthWeight);

    return disocclusion;
}

float4 SamplePreviousColor(RasterizationRendererUniformVariables frameShaderParameters, Texture2D historyOutputTexture, Texture2D historyDepthBuffer, float2 prevUV, float2 size, float depth, out float disocclusion, out float2 prevUVSample)
{
    prevUVSample = prevUV;

    float4 previousColor = historyOutputTexture.SampleLevel(GlobalSamplerLinearClamp, prevUVSample, 0);
    float previousDepth = historyDepthBuffer.SampleLevel(GlobalSamplerLinearClamp, prevUVSample, 0).r;

    disocclusion = GetDisocclusion(depth, previousDepth, frameShaderParameters.nearClippingPlane, frameShaderParameters.farClippingPlane);
    if (disocclusion > disocclusionThreshold) // Good enough
    {
        return previousColor;
    }

    // Try to find the closest sample in the vicinity if we are not convinced of a disocclusion
    if (disocclusion < disocclusionThreshold)
    {
        float2 closestUV = prevUVSample;
        float2 dudv = rcp(size);

        const int searchRadius = 1;
        for (int y = -searchRadius; y <= searchRadius; y++)
        {
            for (int x = -searchRadius; x <= searchRadius; x++)
            {
                int2 offset = int2(x, y);
                float2 sampleUV = prevUVSample + offset * dudv;

                float samplePreviousDepth = historyDepthBuffer.SampleLevel(GlobalSamplerPointClamp, sampleUV, 0).r;

                float weight = GetDisocclusion(depth, samplePreviousDepth, frameShaderParameters.nearClippingPlane, frameShaderParameters.farClippingPlane);
                if (weight > disocclusion)
                {
                    disocclusion = weight;
                    closestUV = sampleUV;
                    prevUVSample = closestUV;
                }
            }
        }

        previousColor = historyOutputTexture.SampleLevel(GlobalSamplerLinearClamp, prevUVSample, 0);
    }

    // Bilinear interpolation on fallback - near edges
    if (disocclusion < disocclusionThreshold)
    {
        float2 weight = frac(prevUVSample * size + 0.5);

        // Bilinear weights
        float weights[4] =
        {
            (1 - weight.x) * (1 - weight.y),
            weight.x * (1 - weight.y),
            (1 - weight.x) * weight.y,
            weight.x * weight.y
        };

        float4 previousColorResult = 0;
        float previousDepthResult = 0;
        float weightSum = 0;

        uint2 prevCoord = uint2(size * prevUVSample - 0.5);
        uint2 offsets[4] = { uint2(0, 0), uint2(1, 0), uint2(0, 1), uint2(1, 1) };

        for (uint i = 0; i < 4; i++)
        {
            uint2 sampleCoord = prevCoord + offsets[i];

            previousColorResult += weights[i] * historyOutputTexture[sampleCoord];
            previousDepthResult += weights[i] * historyDepthBuffer[sampleCoord].r;

            weightSum += weights[i];
        }

        previousColorResult /= max(weightSum, 0.00001);
        previousDepthResult /= max(weightSum, 0.00001);

        previousColor = previousColorResult;
        disocclusion = GetDisocclusion(depth, previousDepthResult, frameShaderParameters.nearClippingPlane, frameShaderParameters.farClippingPlane);
    }

    disocclusion = disocclusion < disocclusionThreshold ? 0.0 : disocclusion;
    return previousColor;
}

[shader("compute")]
[numthreads(SSR_THREAD_GROUP_SIZE, SSR_THREAD_GROUP_SIZE, 1)]
void SSRTemporalFilteringCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<RasterizationRendererUniformVariables> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    RasterizationRendererUniformVariables frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D sceneDepth = GetSceneDepthSRV();
    Texture2D gbuffer1 = GetGBuffer1SRV();
    Texture2D velocityBuffer = GetVelocityBufferSRV();
    Texture2D resolveTexture = GetResolveTextureSRV();
    Texture2D resolveVariance = GetResolveVarianceSRV();
    Texture2D reprojectionDepthTexture = GetReprojectionDepthSRV();
    Texture2D historyOutputTexture = GetHistoryOutputTextureSRV();
    Texture2D historyTemporalVariance = GetHistoryTemporalVarianceSRV();
    Texture2D historyDepthBuffer = GetHistoryDepthBufferSRV();

    RWTexture2D<float4> outputTexture = GetOutputTextureUAV();
    RWTexture2D<float> temporalVariance = GetTemporalVarianceUAV();

    float2 resolution = float2(frameShaderParameters.renderWidth, frameShaderParameters.renderHeight);

    if (frameShaderParameters.frameIndex == 0)
    {
        outputTexture[dispatchThreadID.xy] = resolveTexture[dispatchThreadID.xy];
        temporalVariance[dispatchThreadID.xy] = 0.0;
        return;
    }

    const float depth = sceneDepth[dispatchThreadID.xy].r;
    const float roughness = gbuffer1[dispatchThreadID.xy].w;

    if (!ShouldComputeReflections(roughness, depth, SSR_ROUGHNESS_THRESHOLD_CHEAP_RAY_TRACING))
    {
        outputTexture[dispatchThreadID.xy] = resolveTexture[dispatchThreadID.xy];
        temporalVariance[dispatchThreadID.xy] = 0.0;
        return;
    }

    // Welford's online algorithm: https://en.wikipedia.org/wiki/Algorithms_for_calculating_variance
    float4 m1 = 0.0;
    float4 m2 = 0.0;
    for (int x = -1; x <= 1; x++)
    {
        for (int y = -1; y <= 1; y++)
        {
            int2 offset = int2(x, y);
            int2 coord = dispatchThreadID.xy + offset;

            float4 sampleColor = resolveTexture[coord];

            m1 += sampleColor;
            m2 += sampleColor * sampleColor;
        }
    }

    float4 mean = m1 / 9.0;
    float4 variance = (m2 / 9.0) - (mean * mean);
    float4 stddev = sqrt(max(variance, 0.0f));

    // Secondary reprojection based on ray lengths: https://www.ea.com/seed/news/seed-dd18-presentation-slides-raytracing (Slide 45)

    float2 velocity = velocityBuffer[dispatchThreadID.xy].rg;
    float reprojectionDepth = reprojectionDepthTexture[dispatchThreadID.xy].r;

    float2 uv = (dispatchThreadID.xy + 0.5f) * float2(1.0 / resolution.x, 1.0 / resolution.y);

    float2 prevUVVelocity = uv + velocity;
    float2 prevUVReflectionHit = CalculateReprojectionBuffer(uv, reprojectionDepth, frameShaderParameters.clipToWorldMatrix, frameShaderParameters.previousWorldToClipMatrix);

    float4 previousColorVelocity = historyOutputTexture.SampleLevel(GlobalSamplerLinearClamp, prevUVVelocity, 0);
    float4 previousColorReflectionHit = historyOutputTexture.SampleLevel(GlobalSamplerLinearClamp, prevUVReflectionHit, 0);

    float previousDistanceVelocity = abs(RelativeLuminance(previousColorVelocity.rgb) - RelativeLuminance(mean.rgb));
    float previousDistanceReflectionHit = abs(RelativeLuminance(previousColorReflectionHit.rgb) - RelativeLuminance(mean.rgb));

    float2 prevUV = previousDistanceVelocity < previousDistanceReflectionHit ? prevUVVelocity : prevUVReflectionHit;

    float disocclusion = 0.0;
    float2 prevUVSample = 0.0;
    float4 previousColor = SamplePreviousColor(frameShaderParameters, historyOutputTexture, historyDepthBuffer, prevUV, resolution, depth, disocclusion, prevUVSample);

    float4 currentColor = resolveTexture[dispatchThreadID.xy];
    float4 resultColor = currentColor;

    // Disocclusion fallback: color
    if (disocclusion > disocclusionThreshold && is_saturated(prevUVSample))
    {
        // Color box clamp
        float4 colorMin = mean - temporalScale * stddev;
        float4 colorMax = mean + temporalScale * stddev;
        previousColor = clamp(previousColor, colorMin, colorMax);

        resultColor = lerp(currentColor, previousColor, temporalResponse);
    }

    float currentVariance = resolveVariance[dispatchThreadID.xy].r;
    float varianceResponse = varianceTemporalResponse;

    // Disocclusion fallback: variance
    if (disocclusion < disocclusionThreshold || !is_saturated(prevUVSample))
    {
        // Apply white for variance on occlusion. This helps to hide artifacts from temporal
        varianceResponse = 0.0f;
        currentVariance = 1.0f;
    }

    float previousVariance = historyTemporalVariance.SampleLevel(GlobalSamplerLinearClamp, prevUVSample, 0).r;
    float resultVariance = lerp(currentVariance, previousVariance, varianceResponse);

    outputTexture[dispatchThreadID.xy] = max(0, resultColor);
    temporalVariance[dispatchThreadID.xy] = max(0, resultVariance);
}
