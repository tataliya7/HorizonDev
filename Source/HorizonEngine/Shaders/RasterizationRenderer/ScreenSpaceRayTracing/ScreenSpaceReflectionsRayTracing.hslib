#if SSR_QUALITY == 0 // Low
    #define SSR_RAY_TRACING_RAY_COUNT 1
    #define SSR_RAY_TRACING_STEP_COUNT 8
#elif SSR_QUALITY == 1 // Medium
    #define SSR_RAY_TRACING_RAY_COUNT 2
    #define SSR_RAY_TRACING_STEP_COUNT 8
#elif SSR_QUALITY == 2 // High
    #define SSR_RAY_TRACING_RAY_COUNT 4
    #define SSR_RAY_TRACING_STEP_COUNT 4
#elif SSR_QUALITY == 3 // Ultra
    #define SSR_RAY_TRACING_RAY_COUNT 4
    #define SSR_RAY_TRACING_STEP_COUNT 8
#else
    #error "Invalid SSR_QUALITY"
#endif

static const float DepthBufferThickness = 1.5f;
static const float SSRScreenEdgeVignettingFactor = 5.0f;

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, ColorTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, DepthTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(3, DepthPyramidTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(4, GBuffer0SRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(5, GBuffer1SRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(6, float4, SSRRayHitTextureUAV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(7, float4, SSRRayColorTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

