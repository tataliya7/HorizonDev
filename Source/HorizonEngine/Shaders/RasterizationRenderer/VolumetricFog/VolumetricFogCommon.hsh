#pragma once

#include "../VolumetricRenderingCommon.hsh"

struct VolumetricFogShaderParameters
{
    uint3 volumeResolution;
    float4 tileCountAndInverseTileCount;
    float2 sliceCountAndInverseSliceCount;
    uint localFogVolumeInstanceCount;
    float startingDistance;
    float endingDistance;
    float3 scattering;
    float3 absorption;
    float3 emission;
    float phaseG;
    float3 jitterOffsets[8];
};
DECLARE_ALIASED_ARRAY_STRUCTURED_BUFFER_SRV(VolumetricFogShaderParameters);

struct LocalFogVolumeInstanceData
{
    float4x4 localToWorldMatrix;
    float3 scattering;
    float3 absorption;
    float3 emission;
};
DECLARE_ALIASED_ARRAY_STRUCTURED_BUFFER_SRV(LocalFogVolumeInstanceData);

float ComputeViewSpaceDepth(float slice, float sliceCount, float near, float far)
{
    // Logarithmical depth distribution
    float z = near * pow(far / near, slice / sliceCount);
    return z;
}

float ComputeNormalizedSliceIndex(float z, float near, float far)
{
    float slice = log2(z / near) / log2(far / near);
    return saturate(slice);
}

float3 ComputeVoxelWorldPosition(PerFrameShaderParameters frameShaderParameters, VolumetricFogShaderParameters volumetricFogShaderParameters, uint3 voxelCoordinate, float3 offset)
{
    float viewSpaceDepth = ComputeViewSpaceDepth(voxelCoordinate.z + offset.z, volumetricFogShaderParameters.sliceCountAndInverseSliceCount.x, volumetricFogShaderParameters.startingDistance, volumetricFogShaderParameters.endingDistance);
    float ndcSpaceDepth = ConvertViewSpaceDepthToNDCSpaceDepth(-viewSpaceDepth, frameShaderParameters.viewSpaceDepthToNDCSpaceDepthTransform);

    float2 uv = (voxelCoordinate.xy + offset.xy) * volumetricFogShaderParameters.tileCountAndInverseTileCount.zw;
    float4 clipSpacePosition = float4(ScreenSpaceUVToNDCSpaceXY(uv), ndcSpaceDepth, 1.0f);
    float4 worldSpacePosition = mul(frameShaderParameters.nonJitteredClipToWorldMatrix, clipSpacePosition);
    worldSpacePosition /= worldSpacePosition.w;

    return worldSpacePosition.xyz;
}