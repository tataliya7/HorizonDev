#include "../../ShaderCommon.hsh"
#include "../RasterizationRendererCommon.hsh"
#include "VolumetricFogCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(1, VolumetricFogShaderParameters, VolumetricFogShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_3D_SRV(2, float4, VolumetricFogLightScatteringTextureSRV);
SHADER_CONSTANTS_TEXTURE_3D_UAV(3, float4, VolumetricFogFinalIntegrationTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(8, 8, 1)]
void VolumetricFogFinalIntegrationCS(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID, uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    StructuredBuffer<VolumetricFogShaderParameters> volumetricFogShaderParameterBuffer = ShaderConstants.GetVolumetricFogShaderParameterBufferSRV();
    Texture3D<float4> lightScatteringTexture = ShaderConstants.GetVolumetricFogLightScatteringTextureSRV();
    RWTexture3D<float4> finalIntegrationTexture = ShaderConstants.GetVolumetricFogFinalIntegrationTextureUAV();

    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    VolumetricFogShaderParameters volumetricFogShaderParameters = volumetricFogShaderParameterBuffer[0];

    if (any(dispatchThreadID.xy >= volumetricFogShaderParameters.volumeResolution.xy))
    {
        return;
    }

    float3 previousVoxelCenterWorldPosition = ComputeVoxelWorldPosition(frameShaderParameters, volumetricFogShaderParameters, uint3(dispatchThreadID.xy, 0), float3(0.5f, 0.5f, 0.5f));

    float3 accumulatedRadiance = float3(0.0f, 0.0f, 0.0f);
    float accumulatedTransmittance = 1.0f;

    for (uint sliceIndex = 0; sliceIndex < volumetricFogShaderParameters.volumeResolution.z; sliceIndex++)
    {
        uint3 voxelCoordinate = uint3(dispatchThreadID.xy, sliceIndex);
        float4 lightScatteringTextureData = lightScatteringTexture[voxelCoordinate];
        float3 sourceTerm = lightScatteringTextureData.xyz;
        float extinction = lightScatteringTextureData.w;

        float3 voxelCenterWorldPosition = ComputeVoxelWorldPosition(frameShaderParameters, volumetricFogShaderParameters, voxelCoordinate, float3(0.5f, 0.5f, 0.5f));
        float d = max(length(voxelCenterWorldPosition - previousVoxelCenterWorldPosition), 0.0f);
        previousVoxelCenterWorldPosition = voxelCenterWorldPosition;

        float rho_t = extinction;

        float transmittance = exp(-rho_t * d); // Beer's law

        #if 0 // Wrong
            // Integrating scattering and then transmittance is not energy-conservative.
            accumulatedRadiance += sourceTerm * accumulatedTransmittance;
            accumulatedTransmittance *= transmittance;
        #else // Energy-conserving integration
            // The analytical integration of constant scattered light over a definite range according to one extinction sample can be reduced this equation.
            float3 t = (sourceTerm - sourceTerm * transmittance) / max(rho_t, 0.00001f);
            accumulatedRadiance += t * accumulatedTransmittance;
            accumulatedTransmittance *= transmittance;
        #endif

        finalIntegrationTexture[voxelCoordinate] = float4(accumulatedRadiance, accumulatedTransmittance);
    }
}