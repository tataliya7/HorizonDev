#include "../../ShaderCommon.hsh"
#include "../../SphericalHarmonics.hsh"
#include "../RasterizationRendererCommon.hsh"
#include "../ShadowMapCommon.hsh"
#include "../GPUScene.hsh"
#include "../ManyLightRendering/LightGrid/LightGridCommon.hsh"
#include "VolumetricFogCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(1, VolumetricFogShaderParameters, VolumetricFogShaderParameterBufferSRV);
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(2, DistantLightData, DistantLightDataBufferSRV);
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(3, CascadedShadowMapShaderParameters, CascadedShadowMapShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_ARRAY_DEFAULT_SRV(4, ShadowMapTextureSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(5, IrradianceEnvironmentMapBufferSRV);
SHADER_CONSTANTS_TEXTURE_3D_SRV(6, float4, PreviousVolumetricFogLightScatteringTextureSRV);
SHADER_CONSTANTS_TEXTURE_3D_SRV(7, float4, VolumetricFogParticipatingMediaPropertiesDataATextureSRV);
SHADER_CONSTANTS_TEXTURE_3D_SRV(8, float4, VolumetricFogParticipatingMediaPropertiesDataBTextureSRV);
SHADER_CONSTANTS_TEXTURE_3D_UAV(9, float4, VolumetricFogLightScatteringTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

#define SAMPLE_COUNT_PER_VOXEL 1

float ComputeDistantLightShadowFactorCSM(
    in PerFrameShaderParameters frameShaderParameters,
    in CascadedShadowMapShaderParameters cascadedShadowMapParameters,
    in Texture2DArray shadowMapTexture,
    in float3 worldSpacePosition)
{
    float shadowFactor = 1.0f;

    float4 viewSpacePosition = mul(frameShaderParameters.worldToViewMatrix, float4(worldSpacePosition, 1.0f));
    const uint cascadeCount = cascadedShadowMapParameters.cascadeCount;
    const uint cascadeIndex = ComputeCascadeIndexSlicePlaneSelection(cascadedShadowMapParameters, -viewSpacePosition.z);

    if (cascadeIndex < cascadeCount)
    {
        float4 shadowMapTextureCoord = mul(cascadedShadowMapParameters.worldToClipMatrix[cascadeIndex], float4(worldSpacePosition, 1.0f));
        shadowMapTextureCoord /= shadowMapTextureCoord.w;
        shadowMapTextureCoord.xy = NDCSpaceXYToScreenSpaceUV(shadowMapTextureCoord.xy);

        if (shadowMapTextureCoord.x > 0.0 && shadowMapTextureCoord.x < 1.0 &&
            shadowMapTextureCoord.y > 0.0 && shadowMapTextureCoord.y < 1.0 &&
            shadowMapTextureCoord.z > 0.0 && shadowMapTextureCoord.z < 1.0)
        {
            float shadowMapDepthValue = shadowMapTexture.SampleLevel(GlobalSamplerPointClamp, float3(shadowMapTextureCoord.xy, cascadeIndex), 0).r;
            shadowFactor = (shadowMapTextureCoord.z > shadowMapDepthValue) ? 1.0f : 0.0f;
        }
    }

    return shadowFactor;
}

[shader("compute")]
[numthreads(4, 4, 4)]
void VolumetricFogLightScatteringCS(uint3 groupID : SV_GroupID, uint3 groupThreadID : SV_GroupThreadID, uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    StructuredBuffer<VolumetricFogShaderParameters> volumetricFogShaderParameterBuffer = ShaderConstants.GetVolumetricFogShaderParameterBufferSRV();
    StructuredBuffer<DistantLightData> distantLightDataBuffer = ShaderConstants.GetDistantLightDataBufferSRV();
    StructuredBuffer<CascadedShadowMapShaderParameters> cascadedShadowMapShaderParameterBuffer = ShaderConstants.GetCascadedShadowMapShaderParameterBufferSRV();
    Texture2DArray shadowMapTexture = ShaderConstants.GetShadowMapTextureSRV();
    ByteAddressBuffer irradianceEnvironmentMapBuffer = ShaderConstants.GetIrradianceEnvironmentMapBufferSRV();
    Texture3D<float4> previousLightScatteringTexture = ShaderConstants.GetPreviousVolumetricFogLightScatteringTextureSRV();
    Texture3D<float4> participatingMediaPropertiesDataATexture = ShaderConstants.GetVolumetricFogParticipatingMediaPropertiesDataATextureSRV();
    Texture3D<float4> participatingMediaPropertiesDataBTexture = ShaderConstants.GetVolumetricFogParticipatingMediaPropertiesDataBTextureSRV();
    RWTexture3D<float4> lightScatteringTexture = ShaderConstants.GetVolumetricFogLightScatteringTextureUAV();

    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    VolumetricFogShaderParameters volumetricFogShaderParameters = volumetricFogShaderParameterBuffer[0];
    DistantLightData distantLightData = distantLightDataBuffer[0];
    CascadedShadowMapShaderParameters cascadedShadowMapParameters = cascadedShadowMapShaderParameterBuffer[0];

    uint3 voxelCoordinate = dispatchThreadID;
    if (any(voxelCoordinate >= volumetricFogShaderParameters.volumeResolution))
    {
        return;
    }

    float4 pmScatteringAndExtinction = participatingMediaPropertiesDataATexture[voxelCoordinate];
    float4 pmEmissionAndPhaseG = participatingMediaPropertiesDataBTexture[voxelCoordinate];

    float3 scattering = pmScatteringAndExtinction.xyz;
    float extinction = pmScatteringAndExtinction.w;
    float3 emission = pmEmissionAndPhaseG.xyz;
    float phaseG = pmEmissionAndPhaseG.w;

    const bool isDistantLightValid = true;
    const float3 distantLightColor = distantLightData.color;
    const float3 distantLightDirection = distantLightData.direction;

    float3 worldSpaceVoxelCenterPosition = ComputeVoxelWorldPosition(frameShaderParameters, volumetricFogShaderParameters, voxelCoordinate, float3(0.5f, 0.5f, 0.5f));
    float4 previousVoxelCenterPosition = mul(frameShaderParameters.previousWorldToClipMatrix, float4(worldSpaceVoxelCenterPosition, 1.0f));
    float3 previousVoxelCenterUVZ = previousVoxelCenterPosition.xyz / previousVoxelCenterPosition.w;
    previousVoxelCenterUVZ.xy = NDCSpaceXYToScreenSpaceUV(previousVoxelCenterUVZ.xy);
    previousVoxelCenterUVZ.z = ComputeNormalizedSliceIndex(previousVoxelCenterPosition.w, volumetricFogShaderParameters.startingDistance, volumetricFogShaderParameters.endingDistance);

    float historyWeight = 0.9f;
    if (any(previousVoxelCenterUVZ < 0.0f) || any(previousVoxelCenterUVZ > 1.0f))
    {
        historyWeight = 0.0f;
    }

    float3 radiance = 0.0f;
    for (uint sampleIndex = 0; sampleIndex < SAMPLE_COUNT_PER_VOXEL; sampleIndex++)
    {
        float3 jitterOffset = volumetricFogShaderParameters.jitterOffsets[sampleIndex];
        //jitterOffset = float3(0.5f, 0.5f, volumetricFogShaderParameters.jitterOffsets[sampleIndex].z);
        //jitterOffset = float3(0.5f, 0.5f, 0.5f);
        float3 worldSpacePosition = ComputeVoxelWorldPosition(frameShaderParameters, volumetricFogShaderParameters, voxelCoordinate, jitterOffset);
        float3 w = normalize(frameShaderParameters.cameraPosition - worldSpacePosition);

        [branch]
        if (isDistantLightValid)
        {
            float distantLightShadowFactor = ComputeDistantLightShadowFactorCSM(frameShaderParameters, cascadedShadowMapParameters, shadowMapTexture, worldSpacePosition);

            radiance += distantLightColor * distantLightShadowFactor * HenyeyGreensteinPhaseFunction(phaseG, dot(distantLightDirection, w));
        }

        // Sky lighting
        {
            SH3CoefficientsRGB irradianceEnvironmentMapSH = irradianceEnvironmentMapBuffer.Load<SH3CoefficientsRGB>(0);
            radiance += EvaluateSHCosineWeighted(irradianceEnvironmentMapSH, -w * phaseG);
        }
    }
    radiance /= float(SAMPLE_COUNT_PER_VOXEL);

    float3 sourceTerm = frameShaderParameters.preExposure * (scattering * radiance + emission);
    float4 sourceTermAndExtinction = float4(sourceTerm, extinction);

    if (historyWeight > 0.0f)
    {
        float4 previousSourceTermAndExtinction = previousLightScatteringTexture.SampleLevel(GlobalSamplerLinearClamp, previousVoxelCenterUVZ, 0);
        previousSourceTermAndExtinction.xyz *= frameShaderParameters.preExposureCorrection;
        sourceTermAndExtinction = lerp(sourceTermAndExtinction, previousSourceTermAndExtinction, historyWeight);
    }

    lightScatteringTexture[voxelCoordinate] = sourceTermAndExtinction;
}