#include "ShaderCommon.hsh"
#include "BRDFCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_TEXTURE_2D_UAV(0, float2, OutputTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

static const uint SampleCount = 1024;

float2 IntegrateBRDF(float NdotV, float roughness)
{
    float3 V = float3(sqrt(1.0f - NdotV * NdotV), 0.0f, NdotV);

    float3 T = 0.0f;
    float3 B = 0.0f;
    float3 N = float3(0.0f, 0.0f, 1.0f);
    CreateOrthonormalBasis(T, B, N);

    float2 result = 0.0f;
    for (uint sampleIndex = 0; sampleIndex < SampleCount; sampleIndex++)
    {
        float2 Xi = Hammersley2D(sampleIndex, SampleCount);
        float3 H = TangentToWorld(ImportanceSampleGGX(Xi, roughness), T, B, N);
        float3 L = 2.0f * dot(V, H) * H - V;

        float NdotL = clamp(dot(N, L), 0.0f, 1.0f);
        float NdotH = clamp(dot(N, H), 0.0f, 1.0f);
        float VdotH = clamp(dot(V, H), 0.0f, 1.0f);

        if (NdotL > 0.0)
        {
            float G = GeometrySchlicksmithGGX(NdotL, NdotV, roughness);
            float G_Vis = (G * VdotH) / (NdotH * NdotV);
            float Fc = pow5(1.0f - VdotH);
            result += float2((1.0f - Fc) * G_Vis, Fc * G_Vis);
        }
    }
    return result / float(SampleCount);
}

[shader("compute")]
[numthreads(8, 8, 1)]
void PreIntegratedBRDFCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RWTexture2D<float2> outputTexture = ShaderConstants.GetOutputTextureUAV();

    uint width, height;
    outputTexture.GetDimensions(width, height);
    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5f) / float2(width, height);
    float2 brdf = IntegrateBRDF(uv.x, uv.y);

    outputTexture[pixelCoord] = brdf;
}