#include "ShaderCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_TEXTURE_CUBE_DEFAULT_SRV(0, CubemapTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_ARRAY_UAV(1, float4, OutputTextureArrayUAV);
SHADER_CONSTANTS_SCALAR(2, uint, SourceMipLevel);
SHADER_CONSTANTS_STRUCT_END();

[numthreads(8, 8, 6)]
void DownsampleCubemapCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    RWTexture2DArray<float4> outputTextureArray = ShaderConstants.GetOutputTextureArrayUAV();

    uint width, height, faces;
    outputTextureArray.GetDimensions(width, height, faces);
    if (DispatchThreadID.x >= width || DispatchThreadID.y >= height)
    {
        return;
    }

    TextureCube cubemapTexture = ShaderConstants.GetCubemapTextureSRV();
    uint sourceMipLevel = ShaderConstants.GetSourceMipLevel();

    uint3 pixelCoord = DispatchThreadID;
    float2 uv = (float2(pixelCoord.xy) + 0.5f) / float2(width, height);
    float3 uvw = CalculateCubemapVector(uv, pixelCoord.z);

    float4 color = cubemapTexture.SampleLevel(GlobalSamplerLinearWarp, uvw, sourceMipLevel);

    outputTextureArray[pixelCoord] = color;
}