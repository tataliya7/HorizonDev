#pragma once

struct OneBandSHCoefficients
{
    float coeff;
};

struct OneBandSHCoefficientsRGB
{
    OneBandSHCoefficients r;
    OneBandSHCoefficients g;
    OneBandSHCoefficients b;
};

struct TwoBandSHCoefficients
{
    float4 coeff;
};

struct TwoBandSHCoefficientsRGB
{
    TwoBandSHCoefficients r;
    TwoBandSHCoefficients g;
    TwoBandSHCoefficients b;
};

struct ThreeBandSHCoefficients
{
    float4 coeff0;
    float4 coeff1;
    float  coeff2;
};

struct ThreeBandSHCoefficientsRGB
{
    ThreeBandSHCoefficients r;
    ThreeBandSHCoefficients g;
    ThreeBandSHCoefficients b;
};

ThreeBandSHCoefficientsRGB SampleSHCoefficientsRGB(float3 l, float3 n, float w)
{
    float y0 =  0.282095f;
    float y1 = -0.488603f * n.y;
    float y2 =  0.488603f * n.z;
    float y3 = -0.488603f * n.x;
    float y4 =  1.092548f * n.x * n.y;
    float y5 = -1.092548f * n.y * n.z;
    float y6 =  0.315392f * (3.0f * n.z * n.z - 1.0f);
    float y7 = -1.092548f * n.x * n.z;
    float y8 =  0.546274f * (n.x * n.x - n.y * n.y);

    ThreeBandSHCoefficientsRGB result;
    result.r.coeff0.x = w * l.r * y0;
    result.r.coeff0.y = w * l.r * y1;
    result.r.coeff0.z = w * l.r * y2;
    result.r.coeff0.w = w * l.r * y3;
    result.r.coeff1.x = w * l.r * y4;
    result.r.coeff1.y = w * l.r * y5;
    result.r.coeff1.z = w * l.r * y6;
    result.r.coeff1.w = w * l.r * y7;
    result.r.coeff2   = w * l.r * y8;
    result.g.coeff0.x = w * l.g * y0;
    result.g.coeff0.y = w * l.g * y1;
    result.g.coeff0.z = w * l.g * y2;
    result.g.coeff0.w = w * l.g * y3;
    result.g.coeff1.x = w * l.g * y4;
    result.g.coeff1.y = w * l.g * y5;
    result.g.coeff1.z = w * l.g * y6;
    result.g.coeff1.w = w * l.g * y7;
    result.g.coeff2   = w * l.g * y8;
    result.b.coeff0.x = w * l.b * y0;
    result.b.coeff0.y = w * l.b * y1;
    result.b.coeff0.z = w * l.b * y2;
    result.b.coeff0.w = w * l.b * y3;
    result.b.coeff1.x = w * l.b * y4;
    result.b.coeff1.y = w * l.b * y5;
    result.b.coeff1.z = w * l.b * y6;
    result.b.coeff1.w = w * l.b * y7;
    result.b.coeff2   = w * l.b * y8;
    return result;
}

float3 EvaluateSHCosineWeighted(ThreeBandSHCoefficientsRGB sh, float3 n)
{
    float y0 =  0.282095f;
    float y1 = -0.488603f * n.y;
    float y2 =  0.488603f * n.z;
    float y3 = -0.488603f * n.x;
    float y4 =  1.092548f * n.x * n.y;
    float y5 = -1.092548f * n.y * n.z;
    float y6 =  0.315392f * (3.0f * n.z * n.z - 1.0f);
    float y7 = -1.092548f * n.x * n.z;
    float y8 =  0.546274f * (n.x * n.x - n.y * n.y);

#if 1
    float L0ScalingFactor =    PI;
    float L1ScalingFactor =    2.0 * PI / 3.0;
    float L2ScalingFactor = PI / 4.0;
#else
    float L0ScalingFactor =    1;
    float L1ScalingFactor =    1;
    float L2ScalingFactor = 1;
#endif

    float3 result = 0;
    result.r =
        sh.r.coeff0.x * y0 * L0ScalingFactor +
        sh.r.coeff0.y * y1 * L1ScalingFactor +
        sh.r.coeff0.z * y2 * L1ScalingFactor +
        sh.r.coeff0.w * y3 * L1ScalingFactor +
        sh.r.coeff1.x * y4 * L2ScalingFactor +
        sh.r.coeff1.y * y5 * L2ScalingFactor +
        sh.r.coeff1.z * y6 * L2ScalingFactor +
        sh.r.coeff1.w * y7 * L2ScalingFactor +
        sh.r.coeff2   * y8 * L2ScalingFactor;
    result.g =
        sh.g.coeff0.x * y0 * L0ScalingFactor +
        sh.g.coeff0.y * y1 * L1ScalingFactor +
        sh.g.coeff0.z * y2 * L1ScalingFactor +
        sh.g.coeff0.w * y3 * L1ScalingFactor +
        sh.g.coeff1.x * y4 * L2ScalingFactor +
        sh.g.coeff1.y * y5 * L2ScalingFactor +
        sh.g.coeff1.z * y6 * L2ScalingFactor +
        sh.g.coeff1.w * y7 * L2ScalingFactor +
        sh.g.coeff2   * y8 * L2ScalingFactor;
    result.b =
        sh.b.coeff0.x * y0 * L0ScalingFactor +
        sh.b.coeff0.y * y1 * L1ScalingFactor +
        sh.b.coeff0.z * y2 * L1ScalingFactor +
        sh.b.coeff0.w * y3 * L1ScalingFactor +
        sh.b.coeff1.x * y4 * L2ScalingFactor +
        sh.b.coeff1.y * y5 * L2ScalingFactor +
        sh.b.coeff1.z * y6 * L2ScalingFactor +
        sh.b.coeff1.w * y7 * L2ScalingFactor +
        sh.b.coeff2   * y8 * L2ScalingFactor;

    return result;
}

ThreeBandSHCoefficients SHCoefficientsAdd(ThreeBandSHCoefficients a, ThreeBandSHCoefficients b)
{
    ThreeBandSHCoefficients result;
    result.coeff0 = a.coeff0 + b.coeff0;
    result.coeff1 = a.coeff1 + b.coeff1;
    result.coeff2 = a.coeff2 + b.coeff2;
    return result;
}

ThreeBandSHCoefficientsRGB SHCoefficientsAdd(ThreeBandSHCoefficientsRGB a, ThreeBandSHCoefficientsRGB b)
{
    ThreeBandSHCoefficientsRGB result;
    result.r = SHCoefficientsAdd(a.r, b.r);
    result.g = SHCoefficientsAdd(a.g, b.g);
    result.b = SHCoefficientsAdd(a.b, b.b);
    return result;
}

ThreeBandSHCoefficients SHCoefficientsMultiply(ThreeBandSHCoefficients sh, float value)
{
    ThreeBandSHCoefficients result;
    result.coeff0 = sh.coeff0 * value;
    result.coeff1 = sh.coeff1 * value;
    result.coeff2 = sh.coeff2 * value;
    return result;
}
