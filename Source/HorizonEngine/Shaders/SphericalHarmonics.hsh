#pragma once

struct SH1Coefficients
{
    float c;
};

struct SH1CoefficientsRGB
{
    SH1Coefficients r;
    SH1Coefficients g;
    SH1Coefficients b;
};

struct SH2Coefficients
{
    float4 c;
};

struct SH2CoefficientsRGB
{
    SH2Coefficients r;
    SH2Coefficients g;
    SH2Coefficients b;
};

struct SH3Coefficients
{
    float4 c0;
    float4 c1;
    float  c2;
};

struct SH3CoefficientsRGB
{
    SH3Coefficients r;
    SH3Coefficients g;
    SH3Coefficients b;
};

SH3CoefficientsRGB SampleSHCoefficientsRGB(float3 l, float3 n, float w)
{
    float y0 =  0.282095f;
    float y1 = -0.488603f * n.y;
    float y2 =  0.488603f * n.z;
    float y3 = -0.488603f * n.x;
    float y4 =  1.092548f * n.x * n.y;
    float y5 = -1.092548f * n.y * n.z;
    float y6 =  0.315392f * (3.0f * n.z * n.z - 1.0f);
    float y7 = -1.092548f * n.x * n.z;
    float y8 =  0.546274f * (n.x * n.x - n.y * n.y);

    SH3CoefficientsRGB result;
    result.r.c0.x = w * l.r * y0;
    result.r.c0.y = w * l.r * y1;
    result.r.c0.z = w * l.r * y2;
    result.r.c0.w = w * l.r * y3;
    result.r.c1.x = w * l.r * y4;
    result.r.c1.y = w * l.r * y5;
    result.r.c1.z = w * l.r * y6;
    result.r.c1.w = w * l.r * y7;
    result.r.c2   = w * l.r * y8;
    result.g.c0.x = w * l.g * y0;
    result.g.c0.y = w * l.g * y1;
    result.g.c0.z = w * l.g * y2;
    result.g.c0.w = w * l.g * y3;
    result.g.c1.x = w * l.g * y4;
    result.g.c1.y = w * l.g * y5;
    result.g.c1.z = w * l.g * y6;
    result.g.c1.w = w * l.g * y7;
    result.g.c2   = w * l.g * y8;
    result.b.c0.x = w * l.b * y0;
    result.b.c0.y = w * l.b * y1;
    result.b.c0.z = w * l.b * y2;
    result.b.c0.w = w * l.b * y3;
    result.b.c1.x = w * l.b * y4;
    result.b.c1.y = w * l.b * y5;
    result.b.c1.z = w * l.b * y6;
    result.b.c1.w = w * l.b * y7;
    result.b.c2   = w * l.b * y8;
    return result;
}

// @todo Add a fast version
// @todo Add a version that only does the first 3 components
float3 EvaluateSHCosineWeighted(SH3CoefficientsRGB sh, float3 n)
{
    float y0 =  0.282095f;
    float y1 = -0.488603f * n.y;
    float y2 =  0.488603f * n.z;
    float y3 = -0.488603f * n.x;
    float y4 =  1.092548f * n.x * n.y;
    float y5 = -1.092548f * n.y * n.z;
    float y6 =  0.315392f * (3.0f * n.z * n.z - 1.0f);
    float y7 = -1.092548f * n.x * n.z;
    float y8 =  0.546274f * (n.x * n.x - n.y * n.y);

    float L0ScalingFactor = M_PI;
    float L1ScalingFactor = 2.0f * M_PI / 3.0f;
    float L2ScalingFactor = M_PI / 4.0f;

    float3 result;
    result.r =
        sh.r.c0.x * y0 * L0ScalingFactor +
        sh.r.c0.y * y1 * L1ScalingFactor +
        sh.r.c0.z * y2 * L1ScalingFactor +
        sh.r.c0.w * y3 * L1ScalingFactor +
        sh.r.c1.x * y4 * L2ScalingFactor +
        sh.r.c1.y * y5 * L2ScalingFactor +
        sh.r.c1.z * y6 * L2ScalingFactor +
        sh.r.c1.w * y7 * L2ScalingFactor +
        sh.r.c2   * y8 * L2ScalingFactor;
    result.g =
        sh.g.c0.x * y0 * L0ScalingFactor +
        sh.g.c0.y * y1 * L1ScalingFactor +
        sh.g.c0.z * y2 * L1ScalingFactor +
        sh.g.c0.w * y3 * L1ScalingFactor +
        sh.g.c1.x * y4 * L2ScalingFactor +
        sh.g.c1.y * y5 * L2ScalingFactor +
        sh.g.c1.z * y6 * L2ScalingFactor +
        sh.g.c1.w * y7 * L2ScalingFactor +
        sh.g.c2   * y8 * L2ScalingFactor;
    result.b =
        sh.b.c0.x * y0 * L0ScalingFactor +
        sh.b.c0.y * y1 * L1ScalingFactor +
        sh.b.c0.z * y2 * L1ScalingFactor +
        sh.b.c0.w * y3 * L1ScalingFactor +
        sh.b.c1.x * y4 * L2ScalingFactor +
        sh.b.c1.y * y5 * L2ScalingFactor +
        sh.b.c1.z * y6 * L2ScalingFactor +
        sh.b.c1.w * y7 * L2ScalingFactor +
        sh.b.c2   * y8 * L2ScalingFactor;

    return result;
}

SH1Coefficients SHCoefficientsAdd(SH1Coefficients a, SH1Coefficients b)
{
    SH1Coefficients result;
    result.c = a.c + b.c;
    return result;
}

SH2Coefficients SHCoefficientsAdd(SH2Coefficients a, SH2Coefficients b)
{
    SH2Coefficients result;
    result.c = a.c + b.c;
    return result;
}

SH3Coefficients SHCoefficientsAdd(SH3Coefficients a, SH3Coefficients b)
{
    SH3Coefficients result;
    result.c0 = a.c0 + b.c0;
    result.c1 = a.c1 + b.c1;
    result.c2 = a.c2 + b.c2;
    return result;
}

SH1CoefficientsRGB SHCoefficientsRGBAdd(SH1CoefficientsRGB a, SH1CoefficientsRGB b)
{
    SH1CoefficientsRGB result;
    result.r = SHCoefficientsAdd(a.r, b.r);
    result.g = SHCoefficientsAdd(a.g, b.g);
    result.b = SHCoefficientsAdd(a.b, b.b);
    return result;
}

SH2CoefficientsRGB SHCoefficientsRGBAdd(SH2CoefficientsRGB a, SH2CoefficientsRGB b)
{
    SH2CoefficientsRGB result;
    result.r = SHCoefficientsAdd(a.r, b.r);
    result.g = SHCoefficientsAdd(a.g, b.g);
    result.b = SHCoefficientsAdd(a.b, b.b);
    return result;
}

SH3CoefficientsRGB SHCoefficientsRGBAdd(SH3CoefficientsRGB a, SH3CoefficientsRGB b)
{
    SH3CoefficientsRGB result;
    result.r = SHCoefficientsAdd(a.r, b.r);
    result.g = SHCoefficientsAdd(a.g, b.g);
    result.b = SHCoefficientsAdd(a.b, b.b);
    return result;
}

SH1Coefficients SHCoefficientsMultiply(SH1Coefficients sh, float value)
{
    SH1Coefficients result;
    result.c = sh.c * value;
    return result;
}

SH2Coefficients SHCoefficientsMultiply(SH2Coefficients sh, float value)
{
    SH2Coefficients result;
    result.c = sh.c * value;
    return result;
}

SH3Coefficients SHCoefficientsMultiply(SH3Coefficients sh, float value)
{
    SH3Coefficients result;
    result.c0 = sh.c0 * value;
    result.c1 = sh.c1 * value;
    result.c2 = sh.c2 * value;
    return result;
}