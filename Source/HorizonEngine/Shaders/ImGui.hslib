#include "ShaderCommon.hsh"

#define IM_GUI_ONE_DRAW_CALL 0

struct ImGuiVertex
{
    float2 position;
    float2 uv;
    uint color;
};
DECLARE_ALIASED_ARRAY_STRUCTURED_BUFFER_SRV(ImGuiVertex);

#if IM_GUI_ONE_DRAW_CALL

struct ImGuiDrawData
{
    int textureID;
    int vertexOffset;
    int scissorOffset;
    int scissorSize;
    float2 scale;
    float2 translate;
};
DECLARE_ALIASED_ARRAY_STRUCTURED_BUFFER_SRV(ImGuiDrawData);

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, ImGuiVertex, VertexBufferSRV);
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(1, ImGuiDrawData, ImGuiDrawDataBufferSRV);
SHADER_CONSTANTS_STRUCT_END();

struct ImGuiVSOutput
{
    float4 color : COLOR0;
    float2 textureCoord0 : TEXCOORD0;
    nointerpolation int textureID: TEXCOORD1;
    nointerpolation float4 scissor: TEXCOORD2;
};

[shader("vertex")]
void ImGuiVS(
    [[vk::builtin("BaseInstance")]] in uint StartInstanceLocation : SV_StartInstanceLocation,
    in uint vertexID : SV_VertexID,
    out float4 position : SV_Position,
    out ImGuiVSOutput output)
{
    StructuredBuffer<ImGuiDrawData> drawDataBuffer = ShaderConstants.GetImGuiDrawDataBufferSRV();
    ImGuiDrawData drawData = drawDataBuffer[StartInstanceLocation];

    StructuredBuffer<ImGuiVertex> vertexBuffer = ShaderConstants.GetVertexBufferSRV();
    ImGuiVertex vertex = vertexBuffer.Load(drawData.vertexOffset + vertexID);

    uint4 packedColor = uint4(vertex.color & 0xff, (vertex.color >> 8) & 0xff, (vertex.color >> 16) & 0xff, (vertex.color >> 24) & 0xff);

    float4 scissor = float4(
        (drawData.scissorOffset >> 16) & 0xffff,
        (drawData.scissorOffset & 0xffff),
        (drawData.scissorSize >> 16) & 0xffff,
        (drawData.scissorSize & 0xffff));

    position = float4(vertex.position * drawData.scale + drawData.translate, 0.0f, 1.0f);

    output.color = float4(packedColor) / 255.0f;
    output.textureCoord0 = vertex.uv;
    output.textureID = drawData.textureID;
    output.scissor = scissor;
}

[shader("pixel")]
void ImGuiPS(
    in ImGuiVSOutput input,
    in float4 position : SV_Position,
    out float4 color : SV_Target)
{
    if (position.x < input.scissor.x ||
        position.x > input.scissor.x + input.scissor.z ||
        position.y < input.scissor.y ||
        position.y > input.scissor.y + input.scissor.w)
    {
        discard;
    }

    Texture2D texture = GetTexture2D(input.textureID);
    color = input.color * texture.SampleLevel(GlobalSamplerLinearWarp, input.textureCoord0, 0);
}

#else

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, ImGuiVertex, VertexBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, ImGuiTextureSRV);
SHADER_CONSTANTS_SCALAR(2, float, ScaleX);
SHADER_CONSTANTS_SCALAR(3, float, ScaleY);
SHADER_CONSTANTS_SCALAR(4, float, TranslateX);
SHADER_CONSTANTS_SCALAR(5, float, TranslateY);
SHADER_CONSTANTS_SCALAR(6, int, VertexOffset);
SHADER_CONSTANTS_STRUCT_END();

struct ImGuiVSOutput
{
    float4 color : COLOR0;
    float2 textureCoord0 : TEXCOORD0;
};

[shader("vertex")]
void ImGuiVS(
    in uint vertexID : SV_VertexID,
    out ImGuiVSOutput output,
    out float4 position : SV_Position)
{
    float2 scale = float2(ShaderConstants.GetScaleX(), ShaderConstants.GetScaleY());
    float2 translate = float2(ShaderConstants.GetTranslateX(), ShaderConstants.GetTranslateY());
    int vertexOffset = ShaderConstants.GetVertexOffset();

    StructuredBuffer<ImGuiVertex> vertexBuffer = ShaderConstants.GetVertexBufferSRV();
    ImGuiVertex vertex = vertexBuffer.Load(vertexOffset + vertexID);

    uint4 packedColor = uint4(vertex.color & 0xff, (vertex.color >> 8) & 0xff, (vertex.color >> 16) & 0xff, (vertex.color >> 24) & 0xff);

    output.color = float4(packedColor) / 255.0f;
    output.textureCoord0 = vertex.uv;

    position = float4(vertex.position * scale + translate, 0.0f, 1.0f);
}

[shader("pixel")]
void ImGuiPS(
    in ImGuiVSOutput input,
    out float4 color : SV_Target)
{
    Texture2D texture = ShaderConstants.GetImGuiTextureSRV();
    color = input.color * texture.SampleLevel(GlobalSamplerLinearWarp, input.textureCoord0, 0);
}

#endif