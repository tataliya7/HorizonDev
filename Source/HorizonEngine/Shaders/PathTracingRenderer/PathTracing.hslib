struct PathTracingRayPayload
{
    float3    ray_origin;
    float3    ray_direction;
    float     hitT;
    float3    light_eval;
    float3    emitted;
    float3    throughput;
    uint      primary_ray;
    uint      depth;
    uint      seed;
    uint      done;
};

struct PathTracingShadowRayPayload
{
    float     visibility;
};

struct RayState
{
    float t;
};

