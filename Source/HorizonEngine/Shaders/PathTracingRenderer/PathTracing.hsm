#include "../ShaderCommon.hsh"
#include "PathTracingRendererCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_ACCELERATION_STRUCTURE_SRV(1, TopLevelAccelerationStructureSRV);
SHADER_CONSTANTS_TEXTURE_CUBE_DEFAULT_SRV(2, SkyLightTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(3, float, ColorTextureUAV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(4, float, DepthTextureUAV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(5, float, NormalTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

struct PathTracingPrimaryRayPayload
{
    float3    ray_origin;
    float3    ray_direction;
    float3    light_eval;
    float3    emitted;
    float3    throughput;
    float     hitT;
    uint      seed;
    uint      primary_ray;
    uint      done;
}

struct PathTracingShadowRayPayload
{
    float     visibility;
};

// Ray CreateCameraRay()
// {
//     return ray;
// }

[shader("closesthit")]
void PathTracingDefaultOpaqueClosestHit(inout PathTracingPrimaryRayPayload payload : SV_RayPayload)
{
    const float3 ray_origin = WorldRayOrigin();
    const float3 ray_direction = WorldRayDirection();
    const float t = RayTCurrent();
    const int primitive_index = PrimitiveIndex();

    const uint vertex_index_offset = primitive_index * 3;
    const float3 v0 = launch_params.vertices[vertex_index_offset + 0];
    const float3 v1 = launch_params.vertices[vertex_index_offset + 1];
    const float3 v2 = launch_params.vertices[vertex_index_offset + 2];

    const float3 Ng = normalize(cross(v1 - v0, v2 - v0));
    const float3 N = faceforward(Ng, ray_direction, Ng);

    const float3 shading_point = ray_origin + t * ray_direction;

    if (payload->primary_ray == 1)
    {
        payload->emitted = rt_data->emission_color;
        payload->primary_ray = 0;
    }
    else
    {
        payload->emitted = float3(0.0f, 0.0f, 0.0f);
    }

    // BSDF bsdf = eval_bsdf();

    uint seed = payload->seed;
    {
        const float randu = randf(seed);
        const float randv = randf(seed);

        float3 wi;
        float pdf;
        sample_uniform_hemisphere(N, randu, randv, wi, pdf);

        // Secondary ray
        payload->ray_origin    = shading_point;
        payload->ray_direction = wi;
        payload->throughput   *= rt_data->diffuse_color;
    }

    const float randu = randf(seed);
    const float randv = randf(seed);

    const KernelLight& light = launch_params.light;

    LightSample light_sample;
    sample_light(light, randu, randv, shading_point, light_sample);

    float3 light_eval = light.emission;

    const float distance = light_sample.t;
    const float cos_theta = dot(N, light_sample.wi);
    const float cos_phi   = dot(light_sample.Ng, -light_sample.wi);

    float weight = 0.0f;
    if (cos_theta > 0.0f && cos_phi > 0.0f)
    {
        const float3 shadow_ray_origin = shading_point;
        const float3 shadow_ray_direction = light_sample.wi;
        const float shadow_ray_tmin = 0.01f;
        const float shadow_ray_tmax = light_sample.t - 0.01f;

        uint rayFlags = RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER;
        uint instanceInclusionMask = 0xff;

        RayDesc shadowRay;
        shadowRay.Origin = worldSpacePosition.xyz;
        shadowRay.Direction = randDirection;
        shadowRay.TMin = 0.001;
        shadowRay.TMax = 10000.0;

        ShadowRayPayload shadowRayPayload;
        shadowRayPayload.visibility = 1.0f;

        TraceRay(
            topLevelAccelerationStructure,
            rayFlags,
            instanceInclusionMask,
            1, // SBToffset
            2, // SBTstride
            1, // missSBTIndex
            shadowRay,
            shadowRayPayload);

        if (shadowRayPayload.visibility > 0.0f)
        {
            weight = cos_theta * cos_phi / (PI * distance * distance * light_sample.pdf);
        }
    }

    payload->light_eval = light_eval * weight;
}

[shader("miss")]
void PathTracingDefaultMiss(inout PathTracingPrimaryRayPayload payload : SV_RayPayload)
{
    TextureCube skyLightTexture = ShaderConstants.GetSkyLightTextureSRV();
    float3 skyColor = skyLightTexture.SampleLevel(GlobalSamplerLinearWarp, payload.rayDirection, 0).rgb;

    payload.light_eval = skyColor;
    payload.hitT = -1.0f;
}

[shader("raygeneration")]
void PathTracingRG()
{
    const uint3 dispatchRaysIndex = DispatchRaysIndex();
    const uint3 dispatchRaysDimensions = DispatchRaysDimensions();

    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    RaytracingAccelerationStructure topLevelAS = GetTopLevelAS();
    RWTexture2D<float4> radianceTexture = GetRadianceTextureUAV();

    uint maxBounces = 8;//frameShaderParameters.maxBounces;

    const uint seed = 0;
    float2 subpixelJitter = 0.5f;//float2(randf(seed), randf(seed));

    uint2 pixelCoord = dispatchRaysIndex.xy;
    float2 uv = (float2(pixelCoord) + subpixelJitter) * frameShaderParameters.renderResolution.zw;
    float2 position = ScreenSpaceUVToNDCSpaceXY(uv);

    float3 accumulated_color = float3(0.0f, 0.0f, 0.0f);
    float throughput = 1.0f;

    // Create camera ray
    float4 nearPoint = mul(frameShaderParameters.clipToWorldMatrix, float4(position, NEAR_CLIPPING_PLANE_DEPTH_VALUE, 1.0f));
    nearPoint = nearPoint / nearPoint.w;

    float4 farPoint = mul(frameShaderParameters.clipToWorldMatrix, float4(position, FAR_CLIPPING_PLANE_DEPTH_VALUE, 1.0f));
    farPoint = farPoint / farPoint.w;

    float3 rayOrigin = nearPoint.xyz;
    float3 rayDirection = normalize(farPoint.xyz - nearPoint.xyz);

    uint rayFlags = RAY_FLAG_FORCE_NON_OPAQUE;
    uint instanceInclusionMask = 0xff;

    PathTracingPrimaryRayPayload payload;
    payload.ray_origin    = rayOrigin;
    payload.ray_direction = rayDirection;
    payload.light_eval    = float3(0.0f, 0.0f, 0.0f);
    payload.emitted       = float3(0.0f, 0.0f, 0.0f);
    payload.throughput    = float3(1.0f, 1.0f, 1.0f);
    payload.hitT          = -1.0f;
    payload.seed          = seed;
    payload.primary_ray   = 1;
    payload.done          = 0;

    for (uint bounce = 0; bounce < maxBounces; bounce++)
    {
        RayDesc ray;
        ray.Origin = rayOrigin;
        ray.Direction = rayDirection;
        ray.TMin = 0.0f;
        ray.TMax = 100000.0f;

        TraceRay(
            topLevelAccelerationStructure,
            rayFlags,
            instanceInclusionMask,
            0,
            0,
            0,
            ray,
            payload);

        float3 L = payload.emitted + payload.light_eval * payload.throughput;
        accumulated_color += L;

        if (payload.done)
        {
            break;
        }

        rayOrigin = payload.rayOrigin;
        rayDirection = payload.rayDirection;
    }

    colorTexture[pixelCoord] = float4(accumulated_color, 0.0f);
}