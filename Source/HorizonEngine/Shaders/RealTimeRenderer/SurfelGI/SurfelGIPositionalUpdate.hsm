#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "SurfelGICommon.hsh"

BIND_BYTE_ADDRESS_BUFFER_UAV(0, SurfelGIConstantsBuffer);
BIND_BYTE_ADDRESS_BUFFER_UAV(1, SurfelGIIndirectArguments);
BIND_BYTE_ADDRESS_BUFFER_UAV(2, SurfelGIIndirectArguments);
BIND_BYTE_ADDRESS_BUFFER_UAV(3, SurfelGIIndirectArguments);

bool RecyclingHeuristic(uint totalLiveSurfels, uint framesSinceSeen, uint distance, float rand)
{
    if (totalLiveSurfels < (SurfelGIMaxSurfelCount - SurfelGIScreenTileSize * SurfelGIScreenTileSize))
    {
        return false;
    }

    // TODO
    float percentage = totalLiveSurfels / SurfelGIMaxSurfelCount;
    float probability = percentage;
    return probability > rand ? true : false;
}

[shader("compute")]
[numthreads(SurfelGIIndirectDispatchGroupThreadCount, 1, 1)]
void SurfelGIPositionUpdateCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RWByteAddressBuffer constantsBuffer = GetSurfelGIConstantsBufferUAV();
    uint liveSurfelCount = constantsBuffer.Load(SurfelGIConstantsBufferOffset_LiveSurfelCount);
    if (dispatchThreadID.x >= liveSurfelCount)
    {
        return;
    }

    RWByteAddressBuffer aliveSurfelBuffer = GetSurfelGILiveSurfelBufferUAV();
    RWByteAddressBuffer surfelBuffer = GetSurfelGISurfelBufferUAV();

    uint surfelIndex = aliveSurfelBuffer[dispatchThreadID.x];
    Surfel surfel = surfelBuffer[surfelIndex];

    Surface surface;
    surfel.recycle = true;
    surfel.position = surface.P;
    surfel.normal = pack_unitvector(surface.facenormal);

    RWByteAddressBuffer geometrysBuffer = GetGeometryBufferUAV();
    Geometry geometry = geometrysBuffer.Load<Geometry>(geometryID * sizeof(Geometry));
    float4x4 currWorldTransform = GetRWByteAddressBuffer(geometry.transformBuffer).Load<float4x4>(geometry.transformIndex * sizeof(float4x4));
    float4x4 prevWorldTransform = GetRWByteAddressBuffer(geometry.previousTransformBuffer).Load<float4x4>(geometry.transformIndex * sizeof(float4x4));

    bool meshRemoved = false;
    bool irrelevant = meshRemoved;
    bool recycle = irrelevant || RecyclingHeuristic();
    if (recycle)
    {

    }
    else
    {
        framesSinceSeen = 0;
    }
}