#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "SkyAtmosphereCommon.hsh"

BIND_BYTE_ADDRESS_BUFFER_SRV(0, PerFrameDataBuffer);
BIND_TEXTURE_2D_SRV(1, TransmittanceLutTexture);
BIND_TEXTURE_2D_SRV(2, SkyViewLutTexture);
BIND_TEXTURE_3D_SRV(3, AerialPerspectiveVolumeTexture);
BIND_TEXTURE_2D_SRV(4, SceneDepthTexture);

void SkyViewLutParamsToUv(in bool intersectGround, in float viewZenithCosAngle, in float3 viewDir, in float viewHeight, in float bottomRadius, in float4 skyViewLutSize, out float2 uv)
{
    float vhorizon = sqrt(viewHeight * viewHeight - bottomRadius * bottomRadius);
    float cosBeta = vhorizon / viewHeight;
    float beta = acos(cosBeta);
    float zenithHorizonAngle = PI - beta;
    float viewZenithAngle = acos(viewZenithCosAngle);

    if (!intersectGround)
    {
        //float coord = viewZenithAngle / zenithHorizonAngle;
        float coord = min(1.0f, viewZenithAngle / zenithHorizonAngle); // Avoid NaN
        coord = 1.0f - coord;
        coord = sqrt(coord);
        coord = 1.0f - coord;
        uv.y = coord * 0.5f;
    }
    else
    {
        //float coord = (viewZenithAngle - zenithHorizonAngle) / beta;
        float coord = max(0.0f, viewZenithAngle - zenithHorizonAngle) / beta; // Avoid NaN
        coord = sqrt(coord);
        uv.y = coord * 0.5f + 0.5f;
    }

    {
        uv.x = (atan2(-viewDir.y, -viewDir.x) + PI) / (2.0f * PI);
    }

    // Constrain uvs to valid sub texel range (avoid zenith derivative issue making LUT usage visible)
    uv = FromUnitToSubUvs(uv, skyViewLutSize);
}

float3 GetLightDiskLuminance(
    PerFrameShaderParameters perFrameParameters,
    Texture2D transmittanceLutTexture,
    float3 planetCenterToCamera,
    float3 worldDir,
    float bottomRadius,
    float topRadius)
{
    const float3 maxLightDiskLuminance = 64000.0f;
    const float3 atmosphericLightDirection = perFrameParameters.atmosphericLightDirection;
    const float3 atmosphericLightDiskLuminance = perFrameParameters.atmosphericLightDiskLuminance;
    const float atmosphericLightDiskCosHalfApexAngle = perFrameParameters.atmosphericLightDiskCosHalfApexAngle;
    const float preExposure = perFrameParameters.preExposure;
    const float viewDotLight = dot(worldDir, atmosphericLightDirection);
    const float cosHalfApex = atmosphericLightDiskCosHalfApexAngle;
    if (viewDotLight > cosHalfApex)
    {
        float t = RaySphereIntersectNearest(planetCenterToCamera, worldDir, float3(0.0f, 0.0f, 0.0f), bottomRadius);
        if (t < 0.0f) // No intersection with the planet
        {
            const float3 transmittanceToLight = GetAtmosphereTransmittance(
                transmittanceLutTexture,
                GlobalSamplerLinearClamp,
                planetCenterToCamera,
                worldDir,
                bottomRadius,
                topRadius);

            // GetLightDiskLuminance contains a tiny soft edge effect.
            // Soften out the sun disk to avoid bloom flickering at edge. The soften is applied on the outer part of the disk.
            const float softEdge = saturate(2.0f * (viewDotLight - cosHalfApex) / (1.0f - cosHalfApex));
            float3 lightDiskLuminance = transmittanceToLight * atmosphericLightDiskLuminance * softEdge;
            lightDiskLuminance *= preExposure;
            // Clamp to avoid crazy high values (and exposed 64000.0f luminance is already crazy high, solar system sun is 1.6x10^9). Also this removes +inf float and helps TAA.
            lightDiskLuminance = min(lightDiskLuminance, maxLightDiskLuminance);
            return lightDiskLuminance;
        }
        return 0.0f;
    }
    return 0.0f;
}

[shader("vertex")]
void SkyAtmosphereRayMarchingVS(uint vertexID : SV_VertexID, out float4 outPosition : SV_Position)
{
    outPosition = float4(float2((vertexID << 1) & 2, vertexID & 2) * 2.0f - 1.0f, 0.0f, 1.0f);
}

[shader("pixel")]
void SkyAtmosphereRayMarchingPS(float4 position : SV_Position, out float4 outLuminance : SV_Target0)
{
    ByteAddressBuffer perFrameDataBuffer = GetPerFrameDataBufferSRV();
    PerFrameShaderParameters perFrameParameters = perFrameDataBuffer.Load<PerFrameShaderParameters>(0);
    SkyAtmosphereShaderParameters skyAtmosphereParameters = GetSkyAtmosphereShaderParameters(perFrameParameters);
    Texture2D transmittanceLutTexture = GetTransmittanceLutTextureSRV();
    Texture2D skyViewLutTexture = GetSkyViewLutTextureSRV();
    Texture3D aerialPerspectiveVolumeTexture = GetAerialPerspectiveVolumeTextureSRV();
    Texture2D sceneDepthTexture = GetSceneDepthTextureSRV();

    float2 uv = position.xy * perFrameParameters.renderResolution.zw;

    float deviceDepth = sceneDepthTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;
    float3 worldSpacePixelPosition =  GetWorldSpacePositionFromUvAndDepth(uv, deviceDepth, perFrameParameters.clipToWorldMatrix);
    float3 worldSpacePixelPositionKm = worldSpacePixelPosition * M_TO_KM;
    float3 worldSpaceCameraPosition = perFrameParameters.cameraPosition;
    float3 worldSpaceCameraPositionKm = worldSpaceCameraPosition * M_TO_KM;
    float3 worldPos = worldSpaceCameraPositionKm - float3(0.0f, 0.0f, -skyAtmosphereParameters.bottomRadius);
    float3 worldDir = normalize(worldSpacePixelPosition - worldSpaceCameraPosition);
    float3 skyLuminanceFactor = 1.0f;
    float3 preExposedL = 0.0f;

    if (deviceDepth == FarClipPlaneDepthValue)
    {
        skyLuminanceFactor = perFrameParameters.skyAtmosphereSkyLuminanceFactor;
        preExposedL += GetLightDiskLuminance(perFrameParameters, transmittanceLutTexture, worldPos, worldDir, skyAtmosphereParameters.bottomRadius, skyAtmosphereParameters.topRadius);
    }

    float viewHeight = length(worldPos);
    if ((viewHeight < (skyAtmosphereParameters.topRadius + 0.01f)) && (deviceDepth == FarClipPlaneDepthValue))
    {
        float2 texCoord;

        float3x3 localReferencial = perFrameParameters.skyAtmosphereSkyViewLutReferential;

        float3 worldPosLocal = float3(0.0f, 0.0f, viewHeight);
        float3 upVectorLocal = float3(0.0f, 0.0f, 1.0f);
        float3 worldDirLocal = mul(localReferencial, worldDir);
        float viewZenithCosAngle = dot(worldDirLocal, upVectorLocal);

        bool intersectGround = (RaySphereIntersectNearest(worldPosLocal, worldDirLocal, float3(0.0f, 0.0f, 0.0f), skyAtmosphereParameters.bottomRadius) >= 0.0f);

        SkyViewLutParamsToUv(intersectGround, viewZenithCosAngle, worldDirLocal, viewHeight, skyAtmosphereParameters.bottomRadius, skyAtmosphereParameters.skyViewLutSize, texCoord);

        float3 skyLuminance = skyViewLutTexture.SampleLevel(GlobalSamplerLinearClamp, texCoord, 0).rgb;

        preExposedL += skyLuminanceFactor * skyLuminance;
        outLuminance = float4(preExposedL, 1.0);
        return;
    }

    float2 aerialPerspectiveVolumeSize = skyAtmosphereParameters.aerialPerspectiveVolumeSize;

    float4 AP = GetAerialPerspectiveLuminanceTransmittance(
        aerialPerspectiveVolumeTexture,
        aerialPerspectiveVolumeSize,
        uv,
        worldSpacePixelPositionKm,
        worldSpaceCameraPositionKm);

    preExposedL += skyLuminanceFactor * AP.rgb;

    float transmittance = AP.a;

    outLuminance = float4(preExposedL, transmittance);
}