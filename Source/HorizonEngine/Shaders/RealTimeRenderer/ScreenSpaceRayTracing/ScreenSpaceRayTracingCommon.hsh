#define SSR_FLOAT_MAX 3.402823466e+38

void PrintSample(RWTexture2D<float4> debugOutput, float2 uv, float4 color)
{
    uint w, h;
    debugOutput.GetDimensions(w, h);

    uint2 position = uint2(uv.x * w, uv.y * h);
    debugOutput[position] = color;
    debugOutput[position + uint2(0, 1)] = color;
    debugOutput[position + uint2(1, 0)] = color;
    debugOutput[position + uint2(1, 1)] = color;
}

float3 intersectDepthPlane(float3 o, float3 d, float z)
{
    return o + d * z;
}

float2 getCell(float2 pos, float2 cell_count)
{
    return float2(floor(pos * cell_count));
}

#if 1
float3 intersectCellBoundary(float3 pos, float3 dir, float2 cell_id, float2 cell_count, float2 cross_step, float2 cross_offset)
{
    float2 cell_size = 1.0 / cell_count;
    float2 planes = cell_id / cell_count + cell_size * cross_step;

    float2 solutions = (planes - pos.xy) / dir.xy;
    float3 intersection_pos = pos + dir * min(solutions.x, solutions.y);

    intersection_pos.xy += (solutions.x < solutions.y) ? float2(cross_offset.x, 0.0) : float2(0.0, cross_offset.y);

    return intersection_pos;
}
#else
float3 intersectCellBoundary(float3 o, float3 d, float2 cell, float2 cell_count, float2 crossStep, float2 crossOffset)
{
    float3 intersection = 0;

    float2 index = cell + crossStep;
    float2 boundary = index / cell_count;
    boundary += crossOffset;

    float2 delta = boundary - o.xy;
    delta /= d.xy;
    float t = min(delta.x, delta.y);

    intersection = intersectDepthPlane(o, d, t);

    return intersection;
}
#endif

bool crossedCellBoundary(float2 oldCellIndex, float2 newCellIndex)
{
    return (oldCellIndex.x != newCellIndex.x) || (oldCellIndex.y != newCellIndex.y);
}

void CastScreenSapceRay_HierarchicalTracing(
    Texture2D minDepthPyramidTexture,
    float startMipLevel,
    float maxMipLevel,
    float3 rayOrigin,
    float3 rayDirection,
    float tMax,
    float4x4 worldToClipMatrix,
    float4x4 viewToClipMatrix,
    uint stepCount,
    float dither,
    float4 hzbSizeAndInvSize,
    float4 hzbUVFactorAndInvFactor,
    out float3 hit,
    out float mipLevel,
    out bool foundHit,
    out bool uncertain)
{
    // Start on mip with highest detail.
    currentMipLevel = startMipLevel;

    hzbSizeAndInvSize.xy * pow(0.5f, mipLevel);

    float4 currentMipResolution = float4(, );

    float2 crossStep = float2(rayDirection.x >= 0 ? 1.0 : -1.0, rayDirection.y >= 0 ? 1.0 : -1.0);
    float2 crossOffset = crossStep * currentMipResolution.zw * 0.01;
    crossStep = saturate(crossStep);

    float2 startCellCount = currentMipResolution;
    //rayStartUVz.xy = (floor(rayStartUVz.xy * startCellCount) + 0.25) / startCellCount;

    float3 ray = rayStartUVz.xyz;
    float minZ = ray.z;
    float maxZ = 0;
    float deltaZ = (maxZ - minZ);

    float3 o = ray;
    float3 d = rayDirection;

    float2 rayCell = getCell(ray.xy, startCellCount);
    ray = intersectCellBoundary(o, d, rayCell, startCellCount, crossStep, crossOffset * 128);

    bool isBackwardRay = rayDirection.z > 0;
    float rayDir = isBackwardRay ? -1.0 : 1.0;

    float3 first = o;

    foundHit = false;
    uncertain = false;

    [loop]
    for (uint i = 0; i < stepCount; i++)
    {
        if (currentMipLevel < 0)
        {
            break;
        }

        if (any(ray.xy < 0.0) || any(ray.xy > 1.0))
        {
            break;
        }

        float t = ;
        float3 sampleUVZ = rayStartUVZ + rayStartToEndUVZ * t;

        float referenceMinDepth = minDepthPyramidTexture.SampleLevel(GlobalSamplerPointClamp, sampleUVZ.xy, mipLevel).r;

        const float2 cellCount = currentMipResolution;
        const float2 oldCellIdx = getCell(ray.xy, cellCount);
#if 1
        float3 tmpRay = ((cell_minZ < ray.z) && !isBackwardRay) ? intersectDepthPlane(o, d, (cell_minZ - minZ) / deltaZ) : ray;

        const float2 newCellIdx = getCell(tmpRay.xy, cellCount);
        float thickness = 0;

        float MAX_THICKNESS = 0.0001f;
        bool skip = (isBackwardRay && (cell_minZ < ray.z)) || (thickness > (MAX_THICKNESS)) || crossedCellBoundary(oldCellIdx, newCellIdx);

        sampleUVZ = skip ? intersectCellBoundary(o, d, oldCellIdx, cellCount, crossStep, crossOffset) : tmpRay;
        currentMipLevel += skip ? 1.0f : -1.0f;

        if (currentMipLevel > maxMipLevel)
        {
            currentMipLevel = maxMipLevel;
        }
        else
        {
            currentMipLevelSize *= skip ? float4(0.5f, 0.5f, 2.0f, 2.0f) : float4(2.0f, 2.0f, 0.5f, 0.5f);
        }
#else
        float3 tmp_ray = ray;
        float3 v = rayDirection;
        float2 cross_step = crossStep;
        float2 cross_offset = crossOffset;
        float2 current_cell_count = cellCount;
        float min_z = minZ;

        if (v.z < 0)
        {
            float min_minus_ray = min_z - ray.z;
            tmp_ray = min_minus_ray > 0 ? ray + v_z * min_minus_ray : tmp_ray;
            float2 new_cell_id = cell(tmp_ray.xy, current_cell_count);
            if (crossedCellBoundary(old_cell_id, new_cell_id))
            {
                tmp_ray = intersectCellBoundary(ray, v, old_cell_id, current_cell_count, cross_step, cross_offset);
                level = min(maxMipLevel, level + 1.0f);
            }
            else
            {
                if (level == 1 && abs(min_minus_ray) > 0.0001)
                {
                    tmp_ray = intersectCellBoundary(ray, v, old_cell_id, current_cell_count, cross_step, cross_offset);
                    level = 1;
                }
            }
        }
        else if (ray.z < min_z)
        {
            tmp_ray = intersectCellBoundary(ray, v, old_cell_id, current_cell_count, cross_step, cross_offset);
            level = min(maxMipLevel, level + 1.0f);
        }
        ray.xyz = tmp_ray.xyz;
#endif
        if (debug)
        {
            PrintSample(debugOutput, ray.xy, float4(0, 1, 0, 1));
        }
    }

    if (debug)
    {
        PrintSample(debugOutput, rayStartUVz.xy, float4(1, 0, 0, 1));
    }

    if (debug)
    {
        PrintSample(debugOutput, first.xy, float4(0, 0, 1, 1));
    }

    hit = ray;
    foundHit = (mipLevel < 0);
}
#endif

struct ScreenSpaceRay
{
    float3 rayStartUVZ;
    float3 rayStartToEndUVZ;
    float tolerance;
};

ScreenSpaceRay CreateScreenSpaceRay(
    float3 worldSpaceRayOrigin,
    float3 worldSpaceRayDirection, // must be normalized
    float tMax,
    float4x4 worldToClipMatrix,
    float4x4 viewToClipMatrix)
{
    float3 worldSpaceRayStart = worldSpaceRayOrigin;
    float3 worldSpaceRayEnd = worldSpaceRayOrigin + worldSpaceRayDirection * tMax;

    float4 clipSpaceRayStart = mul(worldToClipMatrix, float4(worldSpaceRayOrigin, 1.0f));
    float4 clipSpaceRayEnd = mul(worldToClipMatrix, float4(worldSpaceRayEnd, 1.0f));

#if 0
    float3 ndcSpaceRayStart = clipSpaceRayStart.xyz * rcp(clipSpaceRayStart.w);
    float3 ndcSpaceRayEnd = clipSpaceRayEnd.xyz * rcp(clipSpaceRayEnd.w);
#else
    float3 ndcSpaceRayStart = clipSpaceRayStart.xyz / clipSpaceRayStart.w;
    float3 ndcSpaceRayEnd = clipSpaceRayEnd.xyz / clipSpaceRayEnd.w;
#endif

    float3 rayStartUVZ = float3(NDCSpaceXYToScreenSpaceUV(ndcSpaceRayStart.xy), ndcSpaceRayStart.z);
    float3 rayEndUVZ = float3(NDCSpaceXYToScreenSpaceUV(ndcSpaceRayEnd.xy), ndcSpaceRayEnd.z);

    float3 rayStartToEndUVZ = rayEndUVZ - rayStartUVZ;

	float4 auxiliaryRayEnd = clipSpaceRayStart + mul(viewToClipMatrix, float4(0.0f, 0.0f, tMax, 0.0f));
	auxiliaryRayEnd = auxiliaryRayEnd / auxiliaryRayEnd.w;

    ScreenSpaceRay ray;
    ray.rayStartUVZ = rayStartUVZ;
    ray.rayStartToEndUVZ = rayStartToEndUVZ;
    ray.tolerance = abs(auxiliaryRayEnd.z - ndcSpaceRayStart.z);

    return ray;
}

void CastScreenSapceRay_LinearTracing(
    in Texture2D depthTexture,
    in ScreenSpaceRay ray,
    in uint stepCount,
    in float dither,
    out bool foundHit,
    out float3 hitPointUVZ)
{
    const float step = 1.0f / float(stepCount);
    const float compareThreshold = 0.001;//ray.tolerance * step;

    float offset = (dither - 0.5f) * step;
    float t = step + offset;

    [loop]
    for (uint i = 0; i < stepCount; i++)
    {
        float3 sampleUVZ = ray.rayStartUVZ + ray.rayStartToEndUVZ * t;

        bool invalidSample = any(sampleUVZ.xy < 0) || any(sampleUVZ.xy > 1) || (sampleUVZ.z <= 0) || (sampleUVZ.z >= 1);

        if (invalidSample)
        {
            break;
        }

        float referenceDepth = depthTexture.SampleLevel(GlobalSamplerPointClamp, sampleUVZ.xy, 0).r;

        float deltaDepth = referenceDepth - sampleUVZ.z;

        foundHit = deltaDepth > 0.0f && deltaDepth < compareThreshold;

        if (foundHit)
        {
            hitPointUVZ = sampleUVZ;
            break;
        }

        t += step;
    }
}

#define SCREEN_SPACE_SHADOW_RAY_FIXED_STEP_COUNT 4

float CastScreenSpaceShadowRay(
    Texture2D depthTexture,
    float3 rayOrigin,
    float3 rayDirection,
    float tMax,
    float4x4 worldToClipMatrix,
    float4x4 viewToClipMatrix,
    float dither)
{
    float3 worldSpaceRayStart = rayOrigin;
    float3 worldSpaceRayEnd = rayOrigin + rayDirection * tMax;

    float4 clipSpaceRayStart = mul(worldToClipMatrix, float4(worldSpaceRayStart, 1.0f));
    float4 clipSpaceRayEnd = mul(worldToClipMatrix, float4(worldSpaceRayEnd, 1.0f));

    float3 ndcSpaceRayStart = clipSpaceRayStart.xyz / clipSpaceRayStart.w;
    float3 ndcSpaceRayEnd = clipSpaceRayEnd.xyz / clipSpaceRayEnd.w;

    float3 rayStartUVZ = float3(NDCSpaceXYToScreenSpaceUV(ndcSpaceRayStart.xy), ndcSpaceRayStart.z);
    float3 rayEndUVZ = float3(NDCSpaceXYToScreenSpaceUV(ndcSpaceRayEnd.xy), ndcSpaceRayEnd.z);
    float3 rayStartToEndUVZ = rayEndUVZ - rayStartUVZ;

	float4 auxiliaryRayEnd = clipSpaceRayStart + mul(viewToClipMatrix, float4(0.0f, 0.0f, tMax, 0.0f));
	auxiliaryRayEnd = auxiliaryRayEnd / auxiliaryRayEnd.w;

    const uint stepCount = SCREEN_SPACE_SHADOW_RAY_FIXED_STEP_COUNT;
    const float step = 1.0f / float(stepCount);
    const float compareThreshold = abs(auxiliaryRayEnd.z - ndcSpaceRayStart.z) * step;

    float offset = (dither - 0.5f) * step;
    float t = step + offset;
    float shadowFactor = 1.0f;

#ifdef SCREEN_SPACE_SHADOW_RAY_FIXED_STEP_COUNT
    [unroll]
#endif
    for (uint i = 0; i < stepCount; i++)
    {
        float3 sampleUVZ = rayStartUVZ + rayStartToEndUVZ * t;

        bool invalidSample = any(sampleUVZ.xy < 0) || any(sampleUVZ.xy > 1) || (sampleUVZ.z <= 0) || (sampleUVZ.z >= 1);

        if (invalidSample)
        {
            break;
        }

        float referenceDepth = depthTexture.SampleLevel(GlobalSamplerPointClamp, sampleUVZ.xy, 0).r;

        float deltaDepth = referenceDepth - sampleUVZ.z;

        if (deltaDepth > 0.0f && deltaDepth < compareThreshold)
        {
            shadowFactor = 0.0f;
            break;
        }

        t += step;
    }

    return shadowFactor;
}