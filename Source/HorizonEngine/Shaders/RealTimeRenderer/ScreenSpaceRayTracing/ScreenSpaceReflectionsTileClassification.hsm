#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
//#include "ScreenSpaceRayTracingCommon.hsh"
#include "ScreenSpaceReflectionsCommon.hsh"

#if SSR_TILE_CLASSIFICATION_HORIZONTAL_PASS
SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, SceneDepthTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, GBuffer1SRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(3, float2, SSRTileClassificationHorizontalTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(SSR_THREAD_GROUP_SIZE, SSR_THREAD_GROUP_SIZE, 1)]
void SSRTileClassificationHorizontalCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    Texture2D sceneDepthTexture = ShaderConstants.GetSceneDepthTextureSRV();
    Texture2D gbuffer1 = ShaderConstants.GetGBuffer1SRV();
    RWTexture2D<float2> tileClassificationHorizontalTexture = ShaderConstants.GetSSRTileClassificationHorizontalTextureUAV();

    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];

    uint width, height;
    tileClassificationHorizontalTexture.GetDimensions(width, height);

    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    const uint2 tileUpperLeftCoord = uint2(dispatchThreadID.x * SSR_TILE_SIZE, dispatchThreadID.y);

    float minRoughness = 1.0f;
    float maxRoughness = 0.0f;

    [loop]
    for (uint i = 0; i < SSR_TILE_SIZE; i++)
    {
        const uint2 pixelCoord = uint2(tileUpperLeftCoord.x + i, tileUpperLeftCoord.y);
        if (pixelCoord.x >= 0 &&
            pixelCoord.y >= 0 &&
            pixelCoord.x < frameShaderParameters.renderWidth &&
            pixelCoord.y < frameShaderParameters.renderHeight)
        {
            float depth = sceneDepthTexture[pixelCoord].r;
            if (depth != FAR_CLIPPING_PLANE_DEPTH_VALUE)
            {
                float roughness = gbuffer1[pixelCoord].w;
                roughness = saturate(roughness);

                maxRoughness = max(maxRoughness, roughness);
                minRoughness = min(minRoughness, roughness);
            }
        }
    }

    tileClassificationHorizontalTexture[dispatchThreadID.xy] = float2(minRoughness, maxRoughness);
}
#endif // SSR_TILE_CLASSIFICATION_HORIZONTAL_PASS

#if SSR_TILE_CLASSIFICATION_VERTICAL_PASS
SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, SceneDepthTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, GBuffer1SRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(3, SSRTileClassificationHorizontalTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(4, float2, SSRTileClassificationTextureUAV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(5, SSRRayAllocationBufferUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(SSR_THREAD_GROUP_SIZE, SSR_THREAD_GROUP_SIZE, 1)]
void SSRTileClassificationVerticalCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    Texture2D sceneDepthTexture = ShaderConstants.GetSceneDepthTextureSRV();
    Texture2D gbuffer1 = ShaderConstants.GetGBuffer1SRV();
    Texture2D tileClassificationHorizontalTexture = ShaderConstants.GetSSRTileClassificationHorizontalTextureSRV();
    RWTexture2D<float2> tileClassificationTexture = ShaderConstants.GetSSRTileClassificationTextureUAV();
    RWByteAddressBuffer rayAllocationBuffer = ShaderConstants.GetSSRRayAllocationBufferUAV();

    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];

    uint width, height;
    tileClassificationTexture.GetDimensions(width, height);

    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    const uint2 tileUpperLeftCoord = uint2(dispatchThreadID.x, dispatchThreadID.y * SSR_TILE_SIZE);

    uint tileClassificationHorizontalTextureWidth, tileClassificationHorizontalTextureHeight;
    tileClassificationHorizontalTexture.GetDimensions(tileClassificationHorizontalTextureWidth, tileClassificationHorizontalTextureHeight);

    float minRoughness = 1.0f;
    float maxRoughness = 0.0f;

    [loop]
    for (uint i = 0; i < SSR_TILE_SIZE; i++)
    {
        const uint2 pixelCoord = uint2(tileUpperLeftCoord.x, tileUpperLeftCoord.y + i);
        if (pixelCoord.x >= 0 &&
            pixelCoord.y >= 0 &&
            pixelCoord.x < tileClassificationHorizontalTextureWidth &&
            pixelCoord.y < tileClassificationHorizontalTextureHeight)
        {
            float2 roughnessMinMax = tileClassificationHorizontalTexture[pixelCoord].xy;

            minRoughness = min(minRoughness, roughnessMinMax.x);
            maxRoughness = max(maxRoughness, roughnessMinMax.y);
        }
    }

    const uint tileCoord = (dispatchThreadID.x & 0xFFFF) | ((dispatchThreadID.y & 0xFFFF) << 16);

    uint tileIndex = 0;
    if (minRoughness < SSR_ROUGHNESS_THRESHOLD_CHEAP_RAY)
    {
        rayAllocationBuffer.InterlockedAdd(SSR_RAY_ALLOCATION_BUFFER_OFFSET_EXPENSIVE_TILES_COUNT, 1, tileIndex);
        //expensiveTilesBuffer[uint2(tileIndex, 0)] = tileCoord;
    }
    else if (maxRoughness > SSR_ROUGHNESS_THRESHOLD_CHEAP_RAY && minRoughness < SSR_ROUGHNESS_THRESHOLD_EARLY_EXIT)
    {
        rayAllocationBuffer.InterlockedAdd(SSR_RAY_ALLOCATION_BUFFER_OFFSET_CHEAP_TILES_COUNT, 1, tileIndex);
        //cheapTilesBuffer[uint2(tileIndex, 0)] = tileCoord;
    }
    else
    {
        rayAllocationBuffer.InterlockedAdd(SSR_RAY_ALLOCATION_BUFFER_OFFSET_EARLY_EXIT_TILES_COUNT, 1, tileIndex);
        //earlyExitTilesBuffer[uint2(tileIndex, 0)] = tileCoord;
    }

    tileClassificationTexture[dispatchThreadID.xy] = float2(minRoughness, maxRoughness);
}
#endif // SSR_TILE_CLASSIFICATION_VERTICAL_PASS