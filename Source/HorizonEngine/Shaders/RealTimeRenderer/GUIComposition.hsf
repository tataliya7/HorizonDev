#include "../ShaderCommon.hsh"

BIND_TEXTURE_2D_SRV(0, UIColorAndAlphaTexture);

void GUICompositionVS(uint vertexID : SV_VertexID, out float4 outPosition : SV_Position)
{
    outPosition = float4(float2((vertexID << 1) & 2, vertexID & 2) * 2.0f - 1.0f, 0.0f, 1.0f);
}

void GUICompositionPS(float4 position : SV_Position, out float4 outColor : SV_Target0)
{
    Texture2D uiColorAndAlphaTexture = GetUIColorAndAlphaTextureSRV();
    const uint2 pixelCoord = uint2(position.xy);
    outColor = uiColorAndAlphaTexture[pixelCoord];
}
