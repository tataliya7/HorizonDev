#define INTENSITY_MODE_PRIMITIVE_FLAG 0
#define INTENSITY_MODE_DEPTH_BASED_APPROXIMATION 1
#define INTENSITY_MODE_FORCE_CASTING_INTENSITY 2

#define WAVE_SIZE 64
#define SAMPLE_COUNT 60
#define HARD_SHADOW_SAMPLES 4
#define FADE_OUT_SAMPLES 8

#include "bend_sss_gpu.h"

#include "../../ShaderCommon.hsh"
#include "../../Random.hsh"
#include "../RealTimeRendererCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_TEXTURE_2D_SRV(0, float, DepthTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(1, float, OutputTextureUAV);
SHADER_CONSTANTS_SCALAR(2, float, SurfaceThickness);
SHADER_CONSTANTS_SCALAR(3, float, LightCoordinateX);
SHADER_CONSTANTS_SCALAR(4, float, LightCoordinateY);
SHADER_CONSTANTS_SCALAR(5, float, LightCoordinateZ);
SHADER_CONSTANTS_SCALAR(6, float, LightCoordinateW);
SHADER_CONSTANTS_SCALAR(7, int, WaveOffsetX);
SHADER_CONSTANTS_SCALAR(8, int, WaveOffsetY);
SHADER_CONSTANTS_SCALAR(9, float, InvDepthBufferSizeX);
SHADER_CONSTANTS_SCALAR(10, float, InvDepthBufferSizeY);
SHADER_CONSTANTS_STRUCT_END();

DispatchParameters CreateBendSSSDispatchParameters(
    in float SurfaceThickness,
    in float4 LightCoordinate,
    in int2 WaveOffset,
    in float FarDepthVal,
    in float NearDepthVal,
    in float2 InvDepthTextureSize,
    in Texture2D<float> DepthTexture,
    in RWTexture2D<float> OutputTexture)
{
    DispatchParameters Parameters;
    Parameters.SetDefaults();
    Parameters.SurfaceThickness = SurfaceThickness;
    Parameters.LightCoordinate = LightCoordinate;
    Parameters.WaveOffset = WaveOffset;
    Parameters.FarDepthValue = FarDepthVal;
    Parameters.NearDepthValue = NearDepthVal;
    Parameters.InvDepthTextureSize = InvDepthTextureSize;
    Parameters.DepthTexture = DepthTexture;
    Parameters.OutputTexture = OutputTexture;
    Parameters.PointBorderSampler = GlobalSamplerPointBorder;
    return Parameters;
}

[shader("compute")]
[numthreads(WAVE_SIZE, 1, 1)]
void ScreenSpaceShadowsBendCS(uint3 GroupID : SV_GroupID, uint3 GroupThreadID : SV_GroupThreadID)
{
    Texture2D<float> depthTexture = ShaderConstants.GetDepthTextureSRV();
    RWTexture2D<float> outputTexture = ShaderConstants.GetOutputTextureUAV();

    const float surfaceThickness = ShaderConstants.GetSurfaceThickness();
    const float4 lightCoordinate = float4(ShaderConstants.GetLightCoordinateX(), ShaderConstants.GetLightCoordinateY(), ShaderConstants.GetLightCoordinateZ(), ShaderConstants.GetLightCoordinateW());
    const int2 waveOffset = int2(ShaderConstants.GetWaveOffsetX(), ShaderConstants.GetWaveOffsetY());
    const float2 inverseDepthTextureSize = int2(ShaderConstants.GetInvDepthBufferSizeX(), ShaderConstants.GetInvDepthBufferSizeY());

    DispatchParameters parameters = CreateBendSSSDispatchParameters(
        surfaceThickness,
        lightCoordinate,
        waveOffset,
        FAR_CLIPPING_PLANE_DEPTH_VALUE,
        NEAR_CLIPPING_PLANE_DEPTH_VALUE,
        inverseDepthTextureSize,
        depthTexture,
        outputTexture);

    WriteScreenSpaceShadow(parameters, GroupID, GroupThreadID.x);
}