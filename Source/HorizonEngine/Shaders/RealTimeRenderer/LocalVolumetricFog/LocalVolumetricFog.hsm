#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "LocalVolumetricFogCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_CONSTANT_BUFFER_CBV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferCBV);
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(1, LocalVolumetricFogInstanceData, LocalVolumetricFogInstanceDataBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, DepthTextureSRV);
SHADER_CONSTANTS_STRUCT_END();

static float3 CubeVertices[8] =
{
    float3( 0.5f,  0.5f,  0.5f),
    float3(-0.5f,  0.5f,  0.5f),
    float3(-0.5f, -0.5f,  0.5f),
    float3( 0.5f, -0.5f,  0.5f),
    float3( 0.5f, -0.5f, -0.5f),
    float3( 0.5f,  0.5f, -0.5f),
    float3(-0.5f,  0.5f, -0.5f),
    float3(-0.5f, -0.5f, -0.5f)
};

static uint CubeIndices[36] =
{
    0, 1, 2, 0, 2, 3,
    0, 3, 4, 0, 4, 5,
    0, 5, 6, 0, 6, 1,
    1, 6, 7, 1, 7, 2,
    7, 4, 3, 7, 3, 2,
    4, 7, 6, 4, 6, 5
};

struct LocalVolumetricFogVertexShaderOutput
{

};

[shader("vertex")]
void LocalVolumetricFogVS(
	uint vertexID : SV_VertexID,
	uint instanceID : SV_InstanceID,
	out float4 position : SV_POSITION,
	out LocalVolumetricFogVertexShaderOutput vertexShaderOutput)
{
    ConstantBuffer<PerFrameShaderParameters> frameShaderParameters = ShaderConstants.GetPerFrameShaderParameterBufferCBV();

    StructuredBuffer<LocalVolumetricFogInstanceData> localVolumetricFogInstanceDataBuffer = ShaderConstants.GetLocalVolumetricFogInstanceDataBufferSRV();
    LocalVolumetricFogInstanceData instanceData = localVolumetricFogInstanceDataBuffer.Load(instanceID);

    uint vertexIndex = CubeIndices[vertexID];
    float3 vertexPosition = CubeVertices[vertexIndex];

    float3 worldSpaceVertexPosition = mul(instanceData.localToWorldMatrix, float4(vertexPosition, 1.0f)).xyz;
    float4 clipSpaceVertexPosition = mul(frameShaderParameters.worldToClipMatrix, float4(worldSpaceVertexPosition, 1.0f));

    position = clipSpaceVertexPosition;
}

[shader("pixel")]
void LocalVolumetricFogPS(float4 position : SV_Position, uint instanceID : SV_InstanceID)
{
    ConstantBuffer<PerFrameShaderParameters> frameShaderParameters = ShaderConstants.GetPerFrameShaderParameterBufferCBV();

    StructuredBuffer<LocalVolumetricFogInstanceData> localVolumetricFogInstanceDataBuffer = ShaderConstants.GetLocalVolumetricFogInstanceDataBufferSRV();
    LocalVolumetricFogInstanceData instanceData = localVolumetricFogInstanceDataBuffer.Load(instanceID);

    Texture2D depthTexture = ShaderConstants.GetDepthTextureSRV();

    const uint2 pixelCoord = uint2(position.xy);
    const float2 uv = (float2(pixelCoord) + 0.5f) / float2(frameShaderParameters.renderWidth, frameShaderParameters.renderHeight);

    float depth = depthTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;
    float3 worldSpacePosition = ReconstructWorldSpacePositionFromDepth(uv, depth, frameShaderParameters.clipToWorldMatrix);
}