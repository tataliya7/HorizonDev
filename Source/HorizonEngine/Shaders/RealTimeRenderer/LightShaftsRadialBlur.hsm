#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_TEXTURE_2D_SRV(1, InputTexture);
BIND_TEXTURE_2D_UAV(2, float3, OutputTexture);

// TODO: Promote to parameter
static const uint NumSamples = 16;

[shader("compute")]
[numthreads(8, 8, 1)]
void LightShaftsRadialBlurCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D inputTexture = GetInputTextureSRV();
    RWTexture2D<float3> outputTexture = GetOutputTextureUAV();

    uint width = 1920;//asuint((0));
    uint height = 1027;//asuint((1));
    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    float2 textureSpaceBlurOrigin;
    textureSpaceBlurOrigin.x = (2);
    textureSpaceBlurOrigin.y = (3);

    float passIndex = (4);
    float passScale = pow(0.4f * NumSamples, passIndex);

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5f) * float2(1.0 / width, 1.0 / height);
    float2 aspectCorrectedUV = uv;

    float GLightShaftFirstPassDistance = 0.1f;
    float2 blurDirection = (textureSpaceBlurOrigin.xy - aspectCorrectedUV) * min(GLightShaftFirstPassDistance * passScale, 1);

    float2 centerUV = 0;

    float3 blurredColor = 0;

    [unroll]
    for (uint sampleIndex = 0; sampleIndex < NumSamples; sampleIndex++)
    {
        float2 sampleOffset = blurDirection * sampleIndex / ((float)NumSamples);
        float2 sampleUV = centerUV + sampleOffset;
        float3 sampleColor = inputTexture.SampleLevel(GlobalSamplerLinearClamp, sampleUV, 0).rgb;

        blurredColor += sampleColor;
    }

    blurredColor /= (float)NumSamples;

    outputTexture[pixelCoord] = blurredColor;
}