#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_BYTE_ADDRESS_BUFFER_SRV(1, LineVertexBuffer);

struct DebugDrawLinesVSToPS
{
    float4 color : COLOR;
};

[shader("pixel")]
void DebugDrawLinesVS(uint vertexIndex : SV_VertexID, out float4 svPosition : SV_Position, out DebugDrawLinesVSToPS output)
{
    ConstantBuffer<PerFrameShaderParameters> frameShaderParameters = GetPerFrameShaderParameterBufferCBV();

    ByteAddressBuffer vertexBuffer = GetLineVertexBufferSRV();
    uint bufferIndex = GetShaderConstantValue(1);
    float3 vertexPosition = vertexBuffer.Load<float3>((bufferIndex & 0xffff) + vertexIndex * sizeof(float3));

    float4 clipPosition = mul(frameShaderParameters.nonJitteredWorldToClipMatrix, float4(vertexPosition, 1.0));

    output.color = float4(1, 0, 0, 1);
    // output.color = color;
    svPosition = clipPosition;
}

[shader("pixel")]
void DebugDrawLinesPS(in DebugDrawLinesVSToPS input, out float4 outColor : SV_Target0)
{
    outColor = input.color;
}