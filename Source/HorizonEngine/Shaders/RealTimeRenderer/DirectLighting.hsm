// Per pixel atmosphere transmittance
// See explanation in "Physically Based Sky, Atmosphere and Cloud Rendering in Frostbite" page 26
float3 ComputeAtmosphereTransmittance(float3 worldPosition, float3 lightDirection, float skyAtmosphereBottomRadiusInKilometers, float skyAtmosphereTopRadiusInKilometers)
{
    Texture2D skyAtmosphereTransmittanceLutTexture = ShaderConstants.GetSkyAtmosphereTransmittanceLutSRV();
    float3 planetCenterToPixel = (worldPosition * M_TO_KM) + float3(0.0f, 0.0f, skyAtmosphereBottomRadiusInKilometers);
    float3 atmosphereTransmittance = GetAtmosphereTransmittance(
        skyAtmosphereTransmittanceLutTexture,
        GlobalSamplerLinearClamp,
        planetCenterToPixel,
        lightDirection,
        skyAtmosphereBottomRadiusInKilometers,
        skyAtmosphereTopRadiusInKilometers);
    return atmosphereTransmittance;
}

float3 WorldSpaceDirectionToCubemapUvAndFaceIndex(float3 d)
{
    float faceIndex = 0;
    float3 absd = abs(d);
    float3 uvw = 0;
    if (absd.x > absd.y && absd.x > absd.z) // x major
    {
        float posx = step(d.x, 0.0);
        uvw = float3(d.yz, absd.x) * float3(lerp(-1.0, 1.0, posx), -1, 1);
        faceIndex = 0.0 + posx;
    }
    else if (absd.y > absd.z) // y major
    {
        float posy = step(d.y, 0.0);
        uvw = float3(d.xz, absd.y) * float3(lerp(1.0, -1.0, posy), -1, 1);
        faceIndex = 2.0 + posy;
    }
    else // z major
    {
        float posz = step(d.z, 0.0);
        uvw = float3(d.xy, absd.z) * float3(1, lerp(1.0, -1.0, posz), 1);
        faceIndex = 4.0 + posz;
    }
    float2 uv = (uvw.xy / uvw.z + 1) * 0.5;
    return float3(uv, faceIndex);
}

float3 ComputeDistantLightDirectLightingContribution(PerFrameShaderParameters frameShaderParameters, Surface surface)
{
    StructuredBuffer<DistantLightData> distantLightDataBuffer = ShaderConstants.GetDistantLightDataBufferSRV();
    DistantLightData distantLightData = distantLightDataBuffer[0];

    float3 result = 0.0f;
    float3 lightColor = distantLightData.color;
    float visibility = 1.0f;

    Texture2D shadowMaskTexture = ShaderConstants.GetScreenSpaceShadowMaskTextureSRV();
    visibility = shadowMaskTexture.SampleLevel(GlobalSamplerLinearClamp, surface.uv, 0).r;
    visibility = DecodeShadowFactor(visibility);

    float3 L = normalize(-distantLightData.direction);
    float3 N = normalize(surface.N);
    float3 V = normalize(surface.V);
    float3 H = normalize(L + V);

    float metallic = surface.metallic;
    float roughness = surface.roughness;
    float4 baseColor = surface.baseColor;

    float alpha = roughness * roughness;
    float alpha2 = alpha * alpha;

    float dielectricSpecular = 0.16f * surface.specular * surface.specular;
    float3 F0 = lerp(dielectricSpecular, baseColor.rgb, metallic);

    // TODO: Setup atmosphereTransmittanceFactor
    float atmosphereTransmittanceFactor = 1.0f;
    float3 atmosphereTransmittance = atmosphereTransmittanceFactor * ComputeAtmosphereTransmittance(
        surface.P,
        L,
        frameShaderParameters.skyAtmosphereBottomRadiusInKilometers,
        frameShaderParameters.skyAtmosphereTopRadiusInKilometers);

    float NdotV = max(0.0f, dot(N, V));
    float NdotL = max(0.0f, dot(N, L));
    float NdotH = max(0.0f, dot(N, H));
    float VdotH = max(0.0f, dot(V, H));

    //if (NdotL > 0.0)
    {
        // float3 F = FresnelSchlick(F0, VdotH);
        // float D = D_GGX(NdotH, roughness);
        // //float G = Vis_SmithJointApprox(alpha2, NdotV, NdotL);
        // float G = SchlickGGX(NdotL, NdotV, roughness);

        // float3 Kd = (1.0 - F) * (1.0 - metallic);
        // float3 diffuse = Kd * baseColor.rgb / PI;
        // //float3 diffuse = Kd * baseColor.rgb / PI;
        // float3 specular = (F * D * G) / (4.0 * max(0.001, NdotL * NdotV));
        // lightColor = lightColor * lightIntensity;

        result += visibility * lightColor * atmosphereTransmittance * NdotL * PrincipledBSDF(
            L, V, N,
            baseColor,
            metallic,
            roughness,
            /*subsurface =*/0,
            /*specular =*/0.5,
            /*specular =*/0,
            /*specularTint =*/0,
            0,
            0.5,
            0,
            1);
    }

    return result;
}

float3 ComputeLocalLightDirectLightingContribution(PerFrameShaderParameters frameShaderParameters, Surface surface)
{
    StructuredBuffer<LocalLightData> localLightDataBuffer = ShaderConstants.GetLocalLightDataBufferSRV();
    StructuredBuffer<uint2> lightGridCellDataBuffer = ShaderConstants.GetLightGridCellDataBufferSRV();
    StructuredBuffer<uint> lightGridLightListBuffer = ShaderConstants.GetLightGridLightListBufferSRV();

    const uint3 lightGridSize = uint3(ShaderConstants.GetLightGridSizeX(), ShaderConstants.GetLightGridSizeY(), ShaderConstants.GetLightGridSizeZ());

    const uint lightGridCellIndex = GetLightGridCellIndex(0, lightGridSize);
    const LightGridCellData lightGridCellData = GetLightGridCellData(lightGridCellDataBuffer, lightGridCellIndex);
    const uint relevantLocalLightCount = lightGridCellData.lightCount;

    // Early out if there are no lights in the cell.
    if (relevantLocalLightCount == 0)
    {
        return 0.0f;
    }

    float3 result = 0.0f;

    [loop]
    for (uint lightIndex = 0; lightIndex < relevantLocalLightCount; lightIndex++)
    {
        const uint localLightID = lightGridLightListBuffer[lightGridCellData.startOffset + lightIndex];
        const LocalLightData localLightData = GetLocalLightData(localLightDataBuffer, localLightID);

        float3 lightColor = localLightData.data3.xyz;
        float3 lightPosition = localLightData.data0.xyz;
        float lightRadius = localLightData.data0.w;

        float visibility = 1.0f;
        //if (light.type == LIGHT_TYPE_POINT)
        {
            float3 L = normalize(lightPosition - surface.P);

#if 0
            if (light.shadowMapIndex >= 0)
            {
                int cubeShadowMapIndex = light.shadowMapIndex;

                ByteAddressBuffer cubeShadowMapBuffer = ShaderConstants.GetLocalLightShadowMapDataBufferSRV();
                CubeShadowMapShaderParameters cubeShadowMapParameters = cubeShadowMapBuffer.Load<CubeShadowMapShaderParameters>(cubeShadowMapIndex * sizeof(CubeShadowMapShaderParameters));

                Texture2DArray<float> localLightShadowMapAtlas = ShaderConstants.GetLocalLightShadowMapAtlasSRV();
                float3 uvw = WorldSpaceDirectionToCubemapUvAndFaceIndex(-L);
                int faceIndex = (int)uvw.z;
                float4 shadowMapCoord = mul(cubeShadowMapParameters.worldToClipMatrix[faceIndex], float4(surface.P, 1.0));
                shadowMapCoord /= shadowMapCoord.w;
                shadowMapCoord.x = (1.0 + shadowMapCoord.x) * 0.5;
                shadowMapCoord.y = (1.0 - shadowMapCoord.y) * 0.5;

                float shadowMapDepthBias = 0.005;
                if (shadowMapCoord.x > 0.0 && shadowMapCoord.x < 1.0 &&
                    shadowMapCoord.y > 0.0 && shadowMapCoord.y < 1.0 &&
                    shadowMapCoord.z > 0.0 && shadowMapCoord.z < 1.0)
                {
                    float biasedDepth = shadowMapCoord.z + shadowMapDepthBias;
                    float2 uv = uvw.xy;
                    float cubeShadowMapSize = 256.0;
                    // Pull uv to the center to avoid sampling on the border
                    {
                        const float borderSize = 1.5;
                        uv *= cubeShadowMapSize - borderSize * 2;
                        uv += borderSize;
                    }
                    uv.x += faceIndex * cubeShadowMapSize;
                    uv.y += cubeShadowMapIndex * cubeShadowMapSize;
                    uv.x /= 4096.0f;
                    uv.y /= 4096.0f;

                    float3 texCoord = float3(uv, 0);

                    float shadowMapDepth = 0;
                    shadowMapDepth += localLightShadowMapAtlas.SampleCmpLevelZero(GlobalSamplerComparisonLessLinearClamp, texCoord, biasedDepth, int2( 0,  0)).r;
                    shadowMapDepth += localLightShadowMapAtlas.SampleCmpLevelZero(GlobalSamplerComparisonLessLinearClamp, texCoord, biasedDepth, int2(-1, -1)).r;
                    shadowMapDepth += localLightShadowMapAtlas.SampleCmpLevelZero(GlobalSamplerComparisonLessLinearClamp, texCoord, biasedDepth, int2(-1,  0)).r;
                    shadowMapDepth += localLightShadowMapAtlas.SampleCmpLevelZero(GlobalSamplerComparisonLessLinearClamp, texCoord, biasedDepth, int2(-1,  1)).r;
                    shadowMapDepth += localLightShadowMapAtlas.SampleCmpLevelZero(GlobalSamplerComparisonLessLinearClamp, texCoord, biasedDepth, int2( 0, -1)).r;
                    shadowMapDepth += localLightShadowMapAtlas.SampleCmpLevelZero(GlobalSamplerComparisonLessLinearClamp, texCoord, biasedDepth, int2( 0,  1)).r;
                    shadowMapDepth += localLightShadowMapAtlas.SampleCmpLevelZero(GlobalSamplerComparisonLessLinearClamp, texCoord, biasedDepth, int2( 1, -1)).r;
                    shadowMapDepth += localLightShadowMapAtlas.SampleCmpLevelZero(GlobalSamplerComparisonLessLinearClamp, texCoord, biasedDepth, int2( 1,  0)).r;
                    shadowMapDepth += localLightShadowMapAtlas.SampleCmpLevelZero(GlobalSamplerComparisonLessLinearClamp, texCoord, biasedDepth, int2( 1,  1)).r;
                    shadowMapDepth = shadowMapDepth / 9;

                    if (shadowMapDepth > biasedDepth)
                    {
                        visibility = 0.0;
                    }
                }
            }
#endif

            float distanceSqaure = dot(lightPosition - surface.P, lightPosition - surface.P);

            // Inverse squared falloff (1 is added here to avoid infinite intensity)
            float attenuation =  1.0 / (distanceSqaure + 1.0);

            // Ensure that the light intensity is 0 at a distance of the light's radius and the transition is smooth
            float smoothFactor = square(saturate(1.0 - square(distanceSqaure / max(0.0001, (lightRadius * lightRadius)))));
            attenuation *= smoothFactor;

            if (attenuation > 0)
            {
                float3 N = normalize(surface.N);
                float3 V = normalize(surface.V);
                float3 H = normalize(L + V);

                float NdotV = saturate(dot(N, V));
                float NdotL = saturate(dot(N, L));
                float NdotH = saturate(dot(N, H));
                float VdotH = saturate(dot(V, H));

                if (NdotL > 0.0)
                {
                    float metallic = surface.metallic;
                    float roughness = surface.roughness;
                    float4 baseColor = surface.baseColor;
                    float alpha = roughness * roughness;
                    float alpha2 = alpha * alpha;

                    float dielectricSpecular = 0.16 * surface.specular * surface.specular;
                    float3 F0 = lerp(dielectricSpecular, baseColor.rgb, metallic);

                    float3 F = FresnelSchlick(F0, VdotH);
                    float D = D_GGX(NdotH, roughness);
                    //float G = Vis_SmithJointApprox(alpha2, NdotV, NdotL);
                    float G = SchlickGGX(NdotL, NdotV, roughness);

                    float3 Kd = (1.0 - F) * (1.0 - metallic);
                    float3 diffuse = Kd * baseColor.rgb / PI * surface.ambientOcclusion;
                    float3 specular = (F * D * G) / (4.0 * max(0.001, NdotL * NdotV));
                    lightColor = lightColor * attenuation;

                    //result += (diffuse + specular) * lightColor * NdotL * visibility;

                    result += visibility * lightColor * NdotL * PrincipledBSDF(
                        L, V, N,
                        baseColor,
                        metallic,
                        roughness,
                        /*subsurface =*/0,
                        /*specular =*/0.5,
                        /*specularTint =*/0,
                        /*anisotropic =*/0,
                        0,
                        0.5,
                        0,
                        1);
                }
            }
        }
        // else if (light.type == LIGHT_TYPE_SPOT)
        // {

        // }
    }

    return result;
}

float3 F_Schlick(float3 f0, float f90, float VoH)
{
    // Schlick 1994, "An Inexpensive BRDF Model for Physically-Based Rendering"
    return f0 + (f90 - f0) * pow5(1.0 - VoH);
}

[shader("pixel")]
void DirectLightingPS(in float4 position : SV_Position, out float4 outColor : SV_Target0)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D<uint2> vbuffer0 = ShaderConstants.GetVBuffer0SRV();
    Texture2D vbuffer1 = ShaderConstants.GetVBuffer1SRV();
    Texture2D gbuffer0 = ShaderConstants.GetGBuffer0SRV();
    Texture2D gbuffer1 = ShaderConstants.GetGBuffer1SRV();
    Texture2D gbuffer2 = ShaderConstants.GetGBuffer2SRV();
    Texture2D sceneDepthTexture = ShaderConstants.GetSceneDepthTextureSRV();

    const uint2 pixelCoord = uint2(position.xy);
    const float2 uv = (float2(pixelCoord) + 0.5f) * frameShaderParameters.renderResolution.zw;

    uint2 visibilityID = vbuffer0[pixelCoord].rg;
    float3 barycentrics = vbuffer1[pixelCoord].rgb;
    uint geometryID = visibilityID.r;
    uint primitiveID = visibilityID.g;

    float4 gbuffer0Data = gbuffer0[pixelCoord];
    float4 gbuffer1Data =  gbuffer1[pixelCoord];
    float4 gbuffer2Data =  gbuffer2[pixelCoord];

    float sceneDepth = sceneDepthTexture[pixelCoord].r;

    if (visibilityID.x == INVALID_VISIBILIY_ID)
    {
        return;
    }

    ByteAddressBuffer geometryDataBuffer = ShaderConstants.GetGeometryDataBufferSRV();
    ByteAddressBuffer geometryInstanceDataBuffer = ShaderConstants.GetGeometryInstanceDataBufferSRV();

    GPUSceneGeometryInstanceData instanceData = GetGPUSceneGeometryInstanceData(geometryInstanceDataBuffer, 0);
    GPUSceneGeometryData geometryData = GetGPUSceneGeometryData(geometryDataBuffer, instanceData.geometryID);

    ByteAddressBuffer materialIndexBuffer = GetByteAddressBuffer(geometryData.materialIndexBuffer);
    uint materialIndex = materialIndexBuffer.Load<uint>(primitiveID * sizeof(uint));

    ByteAddressBuffer materialBuffer = GetByteAddressBuffer(geometryData.materialBuffer);
    Material material = materialBuffer.Load<Material>(materialIndex * sizeof(Material));

    float3 worldSpacePosition = ReconstructWorldSpacePositionFromUVZ(uv, sceneDepth, frameShaderParameters.clipToWorldMatrix);
    float3 normal = DecodeNormalFromGBuffer(gbuffer0Data.xyz);
    float metallic = gbuffer1Data.x;
    float specular = gbuffer1Data.y;
    float roughness = gbuffer1Data.z;
    float4 baseColor = gbuffer2Data;
    float3 emission = 0;
    float ambientOcclusion = 1.0f;

    Surface surface;
    surface.uv = uv;
    surface.P = worldSpacePosition;
    surface.N = normal;
    surface.V = normalize(frameShaderParameters.cameraPosition - worldSpacePosition);
    surface.R = normalize(reflect(-surface.V, surface.N));
    surface.baseColor = baseColor;
    surface.subsurface = 0.0;
    surface.metallic = saturate(metallic);
    surface.specular = saturate(specular);
    surface.specularTint = 0.0;
    surface.roughness = saturate(roughness);
    surface.anisotropic = 0.0;
    surface.sheen = 0.0;
    surface.sheenTint = 0.5;
    surface.clearcoat = 0.0;
    surface.clearcoatGloss = 1.0;
    surface.emission = 0;
    surface.emissionStrength = 1.0;
    surface.ambientOcclusion = ambientOcclusion;
    surface.specularOcclusion = 1.0;

    // surface.metallic = 1.0;
    // surface.roughness = 0.045;
    // surface.baseColor = 1;

    float NdotV = dot(surface.N, surface.V);

    float dielectricSpecular = 0.08 * specular;
    float3 F0 = lerp(dielectricSpecular, baseColor.rgb, metallic);
    float F90 = saturate(50.0 * dot(F0, 0.33));
    float3 F = F_Schlick(F0, F90, NdotV);

    float3 finalColor = 0.0f;

    finalColor += surface.emission * surface.emissionStrength;

    finalColor += ComputeDistantLightDirectLightingContribution(frameShaderParameters, surface) * frameShaderParameters.preExposure;

    //finalColor += ComputeLocalLightDirectLightingContribution(frameShaderParameters, surface) * frameShaderParameters.preExposure;

    outColor = float4(finalColor, 1.0f);
}