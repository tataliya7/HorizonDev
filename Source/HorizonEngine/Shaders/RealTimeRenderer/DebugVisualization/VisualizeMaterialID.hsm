#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "../GPUScene.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_CONSTANT_BUFFER_CBV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferCBV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(1, GeometryDataBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(2, GeometryInstanceDataBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_SRV(3, uint2, VBuffer0SRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(4, float4, OutputTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(8, 8, 1)]
void VisualizeMaterialIDCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    ConstantBuffer<PerFrameShaderParameters> frameShaderParameters = ShaderConstants.GetPerFrameShaderParameterBufferCBV();
    Texture2D<uint2> vbuffer0 = ShaderConstants.GetVBuffer0SRV();
    RWTexture2D<float4> outputTexture = ShaderConstants.GetOutputTextureUAV();

    uint2 pixelCoord = DispatchThreadID.xy;

    uint width, height;
    outputTexture.GetDimensions(width, height);
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    float2 uv = (pixelCoord + 0.5f) * float2(1.0f / width, 1.0f / height);

    uint2 vbufferData = vbuffer0.SampleLevel(GlobalSamplerPointClamp, uv, 0).xy;
    //uint2 vbufferData = vbuffer0[pixelCoord].xy;

    uint geometryID = vbufferData.r;
    uint primitiveID = vbufferData.g;

    if (geometryID == INVALID_VISIBILIY_ID)
    {
        outputTexture[pixelCoord] = float4(0, 0, 0, 1);
        return;
    }

    ByteAddressBuffer geometryDataBuffer = ShaderConstants.GetGeometryDataBufferSRV();
    ByteAddressBuffer geometryInstanceDataBuffer = ShaderConstants.GetGeometryInstanceDataBufferSRV();

    GPUSceneGeometryInstanceData instanceData = GetGPUSceneGeometryInstanceData(geometryInstanceDataBuffer, 0);
    GPUSceneGeometryData geometryData = GetGPUSceneGeometryData(geometryDataBuffer, instanceData.geometryID);

    ByteAddressBuffer materialIndexBuffer = GetByteAddressBuffer(geometryData.materialIndexBuffer);
    uint materialIndex = materialIndexBuffer.Load<uint>(primitiveID * sizeof(uint));

    // +1 to avoid zero
    float3 color = UintToColor(materialIndex + 1);

    outputTexture[pixelCoord] = float4(color, 1.0f);
}