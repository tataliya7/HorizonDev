#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameShaderParameters, PerFrameShaderParameters);
BIND_TEXTURE_2D_SRV(1, GBuffer0);
BIND_TEXTURE_2D_UAV(2, float4, OutputTexture);

[shader("compute")]
[numthreads(8, 8, 1)]
void VisualizeWorldSpaceNormalCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    PerFrameShaderParameters perFrameParameters = GetPerFrameShaderParameters();
    Texture2D gbuffer0 = GetGBuffer0SRV();
    RWTexture2D<float4> outputTexture = GetOutputTextureUAV();

    uint2 pixelCoord = DispatchThreadID.xy;

    uint width, height;
    outputTexture.GetDimensions(width, height);
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    float2 uv = (pixelCoord + 0.5) * float2(1.0 / width, 1.0 / height);

    float4 gbuffer0Data = gbuffer0.SampleLevel(GlobalSamplerPointClamp, uv, 0);
    float3 worldSpaceNormal = DecodeNormalFromGBuffer(gbuffer0Data.xyz);

    float3 rgb = worldSpaceNormal * 0.5 + 0.5;

    outputTexture[pixelCoord] = float4(rgb, 1.0);
}