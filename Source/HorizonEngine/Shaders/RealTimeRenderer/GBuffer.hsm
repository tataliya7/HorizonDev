#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_CONSTANT_BUFFER_CBV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferCBV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(1, GeometryDataBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(2, GeometryInstanceDataBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_SRV(3, uint2, VBuffer0SRV);
SHADER_CONSTANTS_TEXTURE_2D_SRV(4, float3, VBuffer1SRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(5, float4, GBuffer0UAV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(6, float4, GBuffer1UAV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(7, float4, GBuffer2UAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(8, 8, 1)]
void GBufferCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    ConstantBuffer<PerFrameShaderParameters> frameShaderParameters = ShaderConstants.GetPerFrameShaderParameterBufferCBV();

    Texture2D<uint2> vbuffer0 = ShaderConstants.GetVBuffer0SRV();
    Texture2D<float3> vbuffer1 = ShaderConstants.GetVBuffer1SRV();
    RWTexture2D<float4> gbuffer0 = ShaderConstants.GetGBuffer0UAV();
    RWTexture2D<float4> gbuffer1 = ShaderConstants.GetGBuffer1UAV();
    RWTexture2D<float4> gbuffer2 = ShaderConstants.GetGBuffer2UAV();

    uint2 pixelCoord = DispatchThreadID.xy;
    float2 uv = (pixelCoord.xy + 0.5f) * frameShaderParameters.renderResolution.zw;

    uint2 visibilityID = vbuffer0[pixelCoord];
    float3 barycentrics = vbuffer1[pixelCoord];

    // if (visibilityID.x != INVALID_VISIBILIY_ID)
    // {
    //     uint geometryID = visibilityID.r;
    //     uint primitiveID = visibilityID.g;

