#include "../ShaderCommon.hsh"
#include "../Random.hsh"
#include "RealTimeRendererCommon.hsh"
#include "ShadowMapCommon.hsh"
#include "ScreenSpaceRayTracing/ScreenSpaceRayTracingCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(1, CascadedShadowMapShaderParameters, CascadeShadowMapDataBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, SceneDepthTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_ARRAY_DEFAULT_SRV(3, ShadowMapTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(4, float4, ShadowMaskTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

float CSMShadow(
    CascadedShadowMapShaderParameters cascadedShadowMapShaderParameters,
    Texture2DArray shadowMapTexture,
    uint cascadeIndex,
    float3 worldSpacePosition,
    float2 rotation)
{
    float shadowFactor = 1.0f;

    if (cascadeIndex < cascadedShadowMapShaderParameters.cascadeCount)
    {
        float4 shadowMapTextureCoord = mul(cascadedShadowMapShaderParameters.worldToClipMatrix[cascadeIndex], float4(worldSpacePosition, 1.0f));
        shadowMapTextureCoord /= shadowMapTextureCoord.w;
        shadowMapTextureCoord.xy = NDCSpaceXYToScreenSpaceUV(shadowMapTextureCoord.xy);

        bool valid = shadowMapTextureCoord.x > 0.0f && shadowMapTextureCoord.x < 1.0f &&
                     shadowMapTextureCoord.y > 0.0f && shadowMapTextureCoord.y < 1.0f &&
                     shadowMapTextureCoord.z > 0.0f && shadowMapTextureCoord.z < 1.0f;

        if (valid)
        {
            shadowFactor = PCF3x3(
                shadowMapTexture,
                shadowMapTextureCoord.xy,
                cascadeIndex,
                shadowMapTextureCoord.z,
                5,
                cascadedShadowMapShaderParameters.shadowMapSize.y,
                rotation);

            shadowFactor = PCFSoftShadowsCorrection(shadowFactor);
        }
    }

    return shadowFactor;
}

[shader("compute")]
[numthreads(8, 8, 1)]
void ShadowMapProjectionForDistantLightCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];

    uint width = frameShaderParameters.renderWidth;
    uint height = frameShaderParameters.renderHeight;
    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5f) * frameShaderParameters.renderResolution.zw;

    StructuredBuffer<CascadedShadowMapShaderParameters> cascadedShadowMapDataBuffer = ShaderConstants.GetCascadeShadowMapDataBufferSRV();
    Texture2D sceneDepthTexture = ShaderConstants.GetSceneDepthTextureSRV();
    Texture2DArray shadowMapTexture = ShaderConstants.GetShadowMapTextureSRV();
    RWTexture2D<float4> shadowMaskTexture = ShaderConstants.GetShadowMaskTextureUAV();

    CascadedShadowMapShaderParameters cascadedShadowMapShaderParameters = cascadedShadowMapDataBuffer[0];
    float depth = sceneDepthTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;
    float3 worldSpacePosition = ReconstructWorldSpacePositionFromUVZ(uv, depth, frameShaderParameters.clipToWorldMatrix);
    float4 cameraSpacePosition = mul(frameShaderParameters.worldToViewMatrix, float4(worldSpacePosition, 1.0f));

	const float noise = InterleavedGradientNoiseEX(pixelCoord, frameShaderParameters.frameIndexMod8);

    float cameraSpaceDepth = -cameraSpacePosition.z;

    if (depth == FAR_CLIPPING_PLANE_DEPTH_VALUE)
    {
        shadowMaskTexture[pixelCoord] = float4(1.0f, 0.0f, 0.0f, 0.0f);
        return;
    }

    uint cascadeIndex = CalculateCascadeIndex(cameraSpaceDepth, cascadedShadowMapShaderParameters);

    uint randSeed = RandInit(pixelCoord.x + pixelCoord.y * width, frameShaderParameters.frameIndex);
    float random = Rand(randSeed);

    float rotationAngle = random * 3.1415926f;
    float2 rotation = float2(cos(rotationAngle), sin(rotationAngle));

    float shadowFactor = CSMShadow(
        cascadedShadowMapShaderParameters,
        shadowMapTexture,
        cascadeIndex,
        worldSpacePosition,
        rotation);

    float transitionStartDistance = cascadedShadowMapShaderParameters.transitionStartDistance[cascadeIndex];
    float inverseTransitionRange = cascadedShadowMapShaderParameters.inverseTransitionRange[cascadeIndex];

    bool transition = (cascadedShadowMapShaderParameters.useTransition > 0) &&
        (cameraSpaceDepth > transitionStartDistance) &&
        ((cascadeIndex + 1) < cascadedShadowMapShaderParameters.cascadeCount);

    if (transition)
    {
        float secondaryShadowFactor = CSMShadow(
            cascadedShadowMapShaderParameters,
            shadowMapTexture,
            cascadeIndex + 1,
            worldSpacePosition,
            rotation);

        float transitionFactor = saturate((cameraSpaceDepth - transitionStartDistance) * inverseTransitionRange);
        shadowFactor = lerp(shadowFactor, secondaryShadowFactor, transitionFactor);
    }

    float3 shadowRayOrigin = worldSpacePosition;
    float3 shadowRayDirection = -normalize(frameShaderParameters.atmosphericLightDirection);
    float shadowRayLength = 0.1f;

    if (shadowRayLength > 0.0f)
    {
        float screenSpaceShadow = CastScreenSpaceShadowRay(
            sceneDepthTexture,
            shadowRayOrigin,
            shadowRayDirection,
            shadowRayLength,
            frameShaderParameters.worldToClipMatrix,
            frameShaderParameters.viewToClipMatrix,
            noise);

        shadowFactor = screenSpaceShadow * shadowFactor;
    }

    float fadeout = saturate((cameraSpaceDepth - cascadedShadowMapShaderParameters.shadowFadeoutParameters.x) * cascadedShadowMapShaderParameters.shadowFadeoutParameters.y);
    shadowFactor = lerp(shadowFactor, 1.0f, fadeout * fadeout);

    shadowMaskTexture[pixelCoord] = float4(shadowFactor, 0.0f, 0.0f, 0.0f);
}