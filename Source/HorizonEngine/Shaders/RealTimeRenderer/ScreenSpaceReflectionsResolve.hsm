#include "../ShaderCommon.hsh"
#include "../BRDFCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "ScreenSpaceReflectionsCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_TEXTURE_2D_SRV(1, SceneDepth);
BIND_TEXTURE_2D_SRV(2, GBuffer1);
BIND_TEXTURE_2D_SRV(3, RayIndirectSpecular);
BIND_TEXTURE_2D_SRV(4, RayDirectionPDF);
BIND_TEXTURE_2D_SRV(5, RayLength);
BIND_TEXTURE_2D_UAV(6, float4, ResolveTexture);
BIND_TEXTURE_2D_UAV(7, float, ResolveVariance);
BIND_TEXTURE_2D_UAV(8, float, ReprojectionDepth);

static const float2 ResolveSpatialSizeMinMax = float2(2.0, 8.0); // Good to have a min size as downsample scale (2x in this case)
static const uint ResolveSpatialReconstructionCount = 4.0f;

uint baseHash(uint3 p)
{
    p = 1103515245u * ((p.xyz >> 1u) ^ (p.yzx));
    uint h32 = 1103515245u * ((p.x ^ p.z) ^ (p.y >> 3u));
    return h32 ^ (h32 >> 16);
}

// Great quality hash with 3D input
// based on: https://www.shadertoy.com/view/Xt3cDn
uint3 hash33(uint3 x)
{
    uint n = baseHash(x);
    return uint3(n, n * 16807u, n * 48271u); // @see: http://random.mat.sbg.ac.at/results/karl/server/node4.html
}

#define MEDIUMP_FLT_MAX    65504.0
#define saturateMediump(x) min(x, MEDIUMP_FLT_MAX)
float V_SmithGGXCorrelated(float roughness, float NoV, float NoL)
{
    // Heitz 2014, "Understanding the Masking-Shadowing Function in Microfacet-Based BRDFs"
    float a2 = roughness * roughness;
    // TODO: lambdaV can be pre-computed for all the lights, it should be moved out of this function
    float lambdaV = NoL * sqrt((NoV - a2 * NoV) * NoV + a2);
    float lambdaL = NoV * sqrt((NoL - a2 * NoL) * NoL + a2);
    float v = 0.5 / (lambdaV + lambdaL);
    // a2=0 => v = 1 / 4*NoL*NoV   => min=1/4, max=+inf
    // a2=1 => v = 1 / 2*(NoL+NoV) => min=1/4, max=+inf
    // clamp to the maximum value representable in mediump
    return saturateMediump(v);
}

float2 Hammersley2D_Random(uint index, uint samples, uint2 random)
{
    uint bits = index;
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    const float radicalInverse_VdC = float(bits ^ random.y) * 2.3283064365386963e-10;
    return float2(frac(float(index) / float(samples) + float(random.x & 0xffff) / (1 << 16)), radicalInverse_VdC);
}

[shader("compute")]
[numthreads(SSR_THREAD_GROUP_SIZE, SSR_THREAD_GROUP_SIZE, 1)]
void ScreenSpaceReflectionsResolveCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D sceneDepth = GetSceneDepthSRV();
    Texture2D gbuffer1 = GetGBuffer1SRV();
    Texture2D rayIndirectSpecular = GetRayIndirectSpecularSRV();
    Texture2D rayDirectionPDF = GetRayDirectionPDFSRV();
    Texture2D rayLength = GetRayLengthSRV();

    RWTexture2D<float4> resolveTexture = GetResolveTextureUAV();
    RWTexture2D<float> resolveVarianceTexture = GetResolveVarianceUAV();
    RWTexture2D<float> reprojectionDepthTexture = GetReprojectionDepthUAV();

    const uint2 coord = DispatchThreadID.xy;
    const float2 uv = (coord + 0.5f) * (1.0 / frameShaderParameters.renderWidth, 1.0 / frameShaderParameters.renderHeight); // Full resolution
    const uint2 tracingCoord = coord / SSR_DOWN_SAMPLE_FACTOR;

    const float depth = sceneDepth[coord].r;
    const float roughness = gbuffer1[coord].a;

    if (!NeedReflection(roughness, depth, SSRRoughnessCutoff))
    {
        resolveTexture[coord] = rayIndirectSpecular[tracingCoord];
        resolveVarianceTexture[coord] = 0.0;
        reprojectionDepthTexture[coord] = 0.0;
        return;
    }

    const float3 P = ReconstructWorldSpacePositionFromDepth(uv, depth, frameShaderParameters.clipToWorldMatrix);
    const float3 N = gbuffer1[coord].rgb;
    const float3 V = normalize(frameShaderParameters.cameraPosition - P);
    const float NdotV = saturate(dot(N, V));

    const float resolveSpatialScale = saturate(roughness * 5.0); // roughness 0.2 is destination
    const float2 resolveSpatialSize = lerp(ResolveSpatialSizeMinMax.x, ResolveSpatialSizeMinMax.y, resolveSpatialScale);

    float closestRayLength = 0.0;

    const uint sampleCount = ResolveSpatialReconstructionCount;
    const uint2 random = hash33(uint3(coord, frameShaderParameters.frameIndex)).xy;

    float mean = 0.0;
    float S = 0.0;
    float4 result = 0.0;
    float weightSum = 0.0;
    for (int i = 0; i < sampleCount; i++)
    {
        float2 offset = (Hammersley2D_Random(i, sampleCount, random) - 0.5) * resolveSpatialSize;

        int2 neighborTracingCoord = tracingCoord + offset;
        int2 neighborCoord = coord + offset;

        float neighborDepth = sceneDepth[neighborCoord].r;
        if (neighborDepth > 0.0)
        {
            // Sample local pixel information
            float4 directionPDF = rayDirectionPDF[neighborTracingCoord];
            float4 sampleColor = rayIndirectSpecular[neighborTracingCoord];
            float neighborRayLength = rayLength[neighborTracingCoord].r;

            float3 rayDirection = directionPDF.xyz;
            float pdf = directionPDF.w;

            float3 sampleL = normalize(rayDirection);
            float3 sampleH = normalize(sampleL + V);

            float sampleNdotH = saturate(dot(N, sampleH));
            float sampleNdotL = saturate(dot(N, sampleL));

            float roughness2 = roughness * roughness;

            float Vis = V_SmithGGXCorrelated(roughness2, NdotV, sampleNdotL);
            float D = D_GGX(roughness, sampleNdotH);
            float localBRDF = Vis * D * sampleNdotL;

            float weight = localBRDF / max(pdf, 0.00001f);

            sampleColor.rgb *= rcp(1 + RelativeLuminance(sampleColor.rgb));

            result += sampleColor * weight;
            weightSum += weight;

            // Weighted incremental variance
            // https://en.wikipedia.org/wiki/Algorithms_for_calculating_variance
            float luminance = RelativeLuminance(sampleColor.rgb);
            float oldMean = mean;
            mean += weight / weightSum * (luminance - oldMean);
            S += weight * (luminance - oldMean) * (luminance - mean);

            if (weight > 0.001)
            {
                closestRayLength = max(closestRayLength, neighborRayLength);
            }
        }
    }

    result /= weightSum;
    result.rgb *= rcp(1 - RelativeLuminance(result.rgb));

    // Population variance
    float resolveVariance = S / weightSum;

    // Convert to post-projection depth so we can construct dual source reprojection buffers later
    float linearDepth = ComputeCameraSpaceDepth(depth, frameShaderParameters.nearClippingPlane, frameShaderParameters.farClippingPlane);
    float reprojectionDepth = ComputeDepthFromComputeCameraSpaceDepth(linearDepth + closestRayLength, frameShaderParameters.nearClippingPlane, frameShaderParameters.farClippingPlane);

    resolveTexture[coord] = max(result, 0.00001f);
    resolveVarianceTexture[coord] = resolveVariance;
    reprojectionDepthTexture[coord] = reprojectionDepth;
}
