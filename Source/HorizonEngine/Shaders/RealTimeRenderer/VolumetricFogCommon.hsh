#pragma once

#include "VolumitricRenderingCommon.hsh"

struct VolumetricFogShaderParameters
{
    uint3 volumeResolution;
    float4 tileCountAndInverseTileCount;
    float2 sliceCountAndInverseSliceCount;
    uint localFogVolumeInstanceCount;
};
DECLARE_ALIASED_ARRAY_STRUCTURED_BUFFER_SRV(VolumetricFogShaderParameters);

struct LocalFogVolumeInstanceData
{
	float4x4 localToWorldMatrix;
	float3 scattering;
	float3 absorption;
	float3 emission;
};
DECLARE_ALIASED_ARRAY_STRUCTURED_BUFFER_SRV(LocalFogVolumeInstanceData);

float ComputeViewSpaceDepth(float slice, float sliceCount, float near, float far)
{
    // Logarithmical depth distribution
	float ZSlice = near * pow(far / near, slice / sliceCount);
	return ZSlice;
}

float ComputeDepthSliceUV(float ZSlice, float sliceCount, float near, float far)
{
	float sliceUV = log2(ZSlice / near) / log2(far / near);
	return sliceUV;
}

float3 ComputeVoxelWorldPosition(PerFrameShaderParameters frameShaderParameters, VolumetricFogShaderParameters volumetricFogShaderParameters, uint3 voxelCoordinate, float3 offset)
{
	float viewDepth = ComputeViewSpaceDepth(voxelCoordinate.z + offset.z, volumetricFogShaderParameters.sliceCountAndInverseSliceCount.x, frameShaderParameters.nearClippingPlane, 60.0f);

    float4 centerPosition = float4(0.0f, viewDepth, 0.0f, 1.0f);
    centerPosition = mul(frameShaderParameters.worldToClipMatrix, centerPosition);
    centerPosition /= centerPosition.w;

	float2 uv = (voxelCoordinate.xy + offset.xy) * volumetricFogShaderParameters.tileCountAndInverseTileCount.zw;
    float4 clipPosition = float4(UVSpaceToClipSpace(uv), centerPosition.z, 1.0f);
	float4 worldPosition = mul(frameShaderParameters.nonJitteredClipToWorldMatrix, clipPosition);
    worldPosition /= worldPosition.w;

	return worldPosition.xyz;
}