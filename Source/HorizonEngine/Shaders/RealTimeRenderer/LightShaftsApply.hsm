#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"

BIND_BYTE_ADDRESS_BUFFER_SRV(0, PerFrameDataBuffer);
BIND_TEXTURE_2D_SRV(1, LightShaftsTexture);

[shader("vertex")]
void LightShaftsApplyVS(uint vertexID : SV_VertexID, out float4 outPosition : SV_Position)
{
    outPosition = float4(float2((vertexID << 1) & 2, vertexID & 2) * 2.0f - 1.0f, 0.0f, 1.0f);
}

[shader("pixel")]
void LightShaftsApplyPS(float4 position : SV_Position, out float4 outColor : SV_Target0)
{
    ByteAddressBuffer perFrameDataBuffer = GetPerFrameDataBufferSRV();
    PerFrameShaderParameters perFrameParameters = perFrameDataBuffer.Load<PerFrameShaderParameters>(0);
    Texture2D lightShaftsTexture = GetLightShaftsTextureSRV();

    float2 uv = position.xy * perFrameParameters.renderResolution.zw;
    float3 lightShaftsColor = lightShaftsTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).rgb;

    outColor = float4(lightShaftsColor, 1.0f);
}