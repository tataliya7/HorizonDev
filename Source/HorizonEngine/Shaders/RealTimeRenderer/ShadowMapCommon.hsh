/**
 * Use sqrt() to encode shadow factor to alleviate banding artifacts.
 */
float EncodeShadowFactor(float x)
{
    return sqrt(x);
}

/**
 * Decode shadow factor.
 * @see EncodeShadowFactor()
 */
float DecodeShadowFactor(float x)
{
    return x * x;
}