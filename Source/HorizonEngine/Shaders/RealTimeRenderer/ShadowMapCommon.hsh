#pragma once

#define MAX_SHADOW_CASCADE_COUNT 4

struct CascadedShadowMapShaderParameters
{
    float4x4 worldToClipMatrix[MAX_SHADOW_CASCADE_COUNT];
    float cascadeEndDistance[MAX_SHADOW_CASCADE_COUNT];
    float cascadeBlendScale[MAX_SHADOW_CASCADE_COUNT];
    float transitionStartDistance[MAX_SHADOW_CASCADE_COUNT];
    float inverseTransitionRange[MAX_SHADOW_CASCADE_COUNT];
    float4 depthBiasParameters[MAX_SHADOW_CASCADE_COUNT];
    float4 cascadeBoundingSphere[MAX_SHADOW_CASCADE_COUNT];
    float2 shadowMapSize;
    float2 shadowFadeOutParameters;
    float maxShadowDistance;
    uint cascadeCount;
};
DECLARE_ALIASED_ARRAY_STRUCTURED_BUFFER_SRV(CascadedShadowMapShaderParameters);

struct CubeShadowMapShaderParameters
{
    float4x4 worldToClipMatrix[6];
};

uint ComputeCascadeIndexSlicePlaneSelection(CascadedShadowMapShaderParameters parameters, float cameraSpacePositionZ)
{
    const float4 depths = cameraSpacePositionZ.xxxx;
    const float4 distances = float4(parameters.cascadeEndDistance[0], parameters.cascadeEndDistance[1], parameters.cascadeEndDistance[2], parameters.cascadeEndDistance[3]);

    uint4 count = uint4(depths >= distances);
    uint cascadeIndex = uint(count.x + count.y + count.z + count.w);

    return cascadeIndex;
}

uint ComputeCascadeIndexBoundingSphereSelection(CascadedShadowMapShaderParameters parameters, float3 worldSpacePosition)
{
    float3 fromCenter0 = worldSpacePosition - parameters.cascadeBoundingSphere[0].xyz;
    float3 fromCenter1 = worldSpacePosition - parameters.cascadeBoundingSphere[1].xyz;
    float3 fromCenter2 = worldSpacePosition - parameters.cascadeBoundingSphere[2].xyz;
    float3 fromCenter3 = worldSpacePosition - parameters.cascadeBoundingSphere[3].xyz;

    float4 distanceSquared = float4(
        dot(fromCenter0, fromCenter0),
        dot(fromCenter1, fromCenter1),
        dot(fromCenter2, fromCenter2),
        dot(fromCenter3, fromCenter3));

    float4 radiusSquared = float4(
        parameters.cascadeBoundingSphere[0].w * parameters.cascadeBoundingSphere[0].w,
        parameters.cascadeBoundingSphere[1].w * parameters.cascadeBoundingSphere[1].w,
        parameters.cascadeBoundingSphere[2].w * parameters.cascadeBoundingSphere[2].w,
        parameters.cascadeBoundingSphere[3].w * parameters.cascadeBoundingSphere[3].w);

    float4 t = float4(distanceSquared < radiusSquared);
    t.yzw = saturate(t.yzw - t.xyz);

    uint cascadeIndex = uint(dot(t, float4(0, 1, 2, 3)));

    return cascadeIndex;
}

