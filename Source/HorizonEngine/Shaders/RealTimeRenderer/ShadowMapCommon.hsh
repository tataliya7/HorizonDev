#pragma once

#define MAX_SHADOW_CASCADE_COUNT 4

struct CascadedShadowMapShaderParameters
{
    float4x4 worldToClipMatrix[MAX_SHADOW_CASCADE_COUNT];
    float cascadeEndDistance[MAX_SHADOW_CASCADE_COUNT];
    float transitionStartDistance[MAX_SHADOW_CASCADE_COUNT];
    float inverseTransitionRange[MAX_SHADOW_CASCADE_COUNT];
    float4 depthBiasParameters[MAX_SHADOW_CASCADE_COUNT];
    float4 cascadeBoundingSphere[MAX_SHADOW_CASCADE_COUNT];
    float2 shadowMapSize;
    float2 shadowFadeOutParameters;
    float maxShadowDistance;
    uint cascadeCount;
};
DECLARE_ALIASED_ARRAY_STRUCTURED_BUFFER_SRV(CascadedShadowMapShaderParameters);

struct CubeShadowMapShaderParameters
{
    float4x4 worldToClipMatrix[6];
};

uint ComputeCascadeIndex(float cameraSpacePositionZ, CascadedShadowMapShaderParameters parameters)
{
    const float4 depths = cameraSpacePositionZ.xxxx;
    const float4 distances = float4(parameters.cascadeEndDistance[0], parameters.cascadeEndDistance[1], parameters.cascadeEndDistance[2], parameters.cascadeEndDistance[3]);

    uint4 count = uint4(depths >= distances);
    uint cascadeIndex = uint(count.x + count.y + count.z + count.w);

    return cascadeIndex;
}

uint ComputeCascadeIndexBoundingSphereSelection(float3 worldSpacePosition, CascadedShadowMapShaderParameters parameters)
{
    float3 distances[4];
    distances[0] = worldSpacePosition - parameters.cascadeBoundingSphere[0].xyz;
    distances[1] = worldSpacePosition - parameters.cascadeBoundingSphere[1].xyz;
    distances[2] = worldSpacePosition - parameters.cascadeBoundingSphere[2].xyz;
    distances[3] = worldSpacePosition - parameters.cascadeBoundingSphere[3].xyz;

    float4 d;
    d.x = dot(distances[0], distances[0]);
    d.y = dot(distances[1], distances[1]);
    d.z = dot(distances[2], distances[2]);
    d.w = dot(distances[3], distances[3]);

    float4 f;
    f.x = parameters.cascadeBoundingSphere[0].w * parameters.cascadeBoundingSphere[0].w;
    f.y = parameters.cascadeBoundingSphere[1].w * parameters.cascadeBoundingSphere[1].w;
    f.z = parameters.cascadeBoundingSphere[2].w * parameters.cascadeBoundingSphere[2].w;
    f.w = parameters.cascadeBoundingSphere[3].w * parameters.cascadeBoundingSphere[3].w;

    int4 count = int4(d <= f);
    int4 count_ = int4(0, count.x, count.x + count.y, count.x + count.y + count.z);

    count = count - count_;
    count = max(count, int4(0, 0, 0, 0));

    int cascadeIndex = count.y + count.z * 2 + count.w * 3;
    cascadeIndex = min(cascadeIndex, 3);

    return uint(cascadeIndex);
}

