#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_SRV(1, float3, InputTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(2, float3, OutputTextureUAV);
SHADER_CONSTANTS_SCALAR(3, float, LightShaftsOriginX);
SHADER_CONSTANTS_SCALAR(4, float, LightShaftsOriginY);
SHADER_CONSTANTS_SCALAR(5, uint, PassIndex);
SHADER_CONSTANTS_SCALAR(6, uint, SampleCount);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(8, 8, 1)]
void ScreenSpaceLightShaftsRadialBlurCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D<float3> inputTexture = ShaderConstants.GetInputTextureSRV();
    RWTexture2D<float3> outputTexture = ShaderConstants.GetOutputTextureUAV();

    uint outputTextureWidth, outputTextureHeight;
    outputTexture.GetDimensions(outputTextureWidth, outputTextureHeight);
    if (dispatchThreadID.x >= outputTextureWidth || dispatchThreadID.y >= outputTextureHeight)
    {
        return;
    }

    float2 lightShaftsOrigin = float2(ShaderConstants.GetLightShaftsOriginX(), ShaderConstants.GetLightShaftsOriginY());
    uint passIndex = ShaderConstants.GetPassIndex();
    uint sampleCount = ShaderConstants.GetSampleCount();
    sampleCount = 8;

    float passScale = pow(0.4f * sampleCount, passIndex);

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (float2(pixelCoord.x, pixelCoord.y) + 0.5f) * float2(1.0f / outputTextureWidth, 1.0f / outputTextureHeight);

    // @todo Aspect Ratio Correction
    float2 aspectRatioCorrectedUV = uv;

    float GLightShaftFirstPassDistance = 0.1f;
    float2 blurVector = (lightShaftsOrigin - uv) * 0.2;//* min(GLightShaftFirstPassDistance * passScale, 1);

    float2 sampleCenterUV = uv;

    float3 color = float3(0.0f, 0.0f, 0.0f);

    [loop]
    for (uint sampleIndex = 0; sampleIndex < sampleCount; sampleIndex++)
    {
        float2 sampleUVOffset = blurVector * sampleIndex / float(sampleCount);
        float2 sampleUV = sampleCenterUV + sampleUVOffset;

        float3 sampleColor = inputTexture.SampleLevel(GlobalSamplerLinearClamp, sampleUV, 0).rgb;

        color += sampleColor;
    }

    color /= float(sampleCount);

    outputTexture[pixelCoord] = color;
}