#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "VolumetricFogCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(1, VolumetricFogShaderParameters, VolumetricFogShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_3D_SRV(2, float4, VolumetricFogIntegratedLightScatteringTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_SRV(3, float, SceneDepthTextureSRV);
SHADER_CONSTANTS_STRUCT_END();

[shader("pixel")]
void VolumetricFogCompositionPS(float4 position : SV_Position, out float4 result : SV_Target0)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    StructuredBuffer<VolumetricFogShaderParameters> volumetricFogShaderParameterBuffer = ShaderConstants.GetVolumetricFogShaderParameterBufferSRV();
    Texture2D<float> sceneDepthTexture = ShaderConstants.GetSceneDepthTextureSRV();
    Texture3D<float4> volumetricFogIntegratedLightScatteringTextureSRV = ShaderConstants.GetVolumetricFogIntegratedLightScatteringTextureSRV();

    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    VolumetricFogShaderParameters volumetricFogShaderParameters = volumetricFogShaderParameterBuffer[0];

    float2 uv = position.xy * frameShaderParameters.renderResolution.zw;

    float sceneDepth = sceneDepthTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;
    float ZSlice = ComputeCameraSpaceDepth(sceneDepth, frameShaderParameters.nearClippingPlane, frameShaderParameters.farClippingPlane);
    float sliceUV = ComputeSliceUV(ZSlice, volumetricFogShaderParameters.sliceCountAndInverseSliceCount.x, frameShaderParameters.nearClippingPlane, frameShaderParameters.farClippingPlane);

    float3 volumetricFogVolumeUV = float3(uv, sliceUV);
    float4 volumetricFogIntegratedLightScattering = volumetricFogIntegratedLightScatteringTextureSRV.SampleLevel(GlobalSamplerLinearClamp, volumetricFogVolumeUV, 0).r;
    volumetricFogIntegratedLightScattering.rgb *= frameShaderParameters.inversePreExposure;

    float3 fogColor = volumetricFogIntegratedLightScattering.rgb;

    fogColor *= frameShaderParameters.preExposure;

    result = float4(fogColor, 1.0f);
}