/*-------------------------------------------------------------------------------------
 * Physically Based Bloom
 * Core features:
 * - Filtering both when downsampling and upsampling
 * - Non-thresholed
 * - Anti-fireflies
 * References:
 * - https://www.iryoku.com/next-generation-post-processing-in-call-of-duty-advanced-warfare/
 * - https://www.froyok.fr/blog/2021-12-ue4-custom-bloom/
 * - https://learnopengl.com/Guest-Articles/2022/Phys.-Based-Bloom
 *-------------------------------------------------------------------------------------*/

#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, InputTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(2, float3, OutputTextureUAV);
SHADER_CONSTANTS_SCALAR(3, float, OutputTextureInvSizeX);
SHADER_CONSTANTS_SCALAR(4, float, OutputTextureInvSizeY);
SHADER_CONSTANTS_SCALAR(5, int, UseKarisAverage);
SHADER_CONSTANTS_STRUCT_END();

// 4  x  5  x  6
// x  0  x  1  x
// 7  x  8  x  9
// x  2  x  3  x
// 10 x  11 x  12

#define COD_METHOD 1

static const float2 GaussianBloomDownsampleOffsets[13] =
{
    float2(-1.0f, -1.0f),
    float2( 1.0f, -1.0f),
    float2(-1.0f,  1.0f),
    float2( 1.0f,  1.0f),
    float2(-2.0f, -2.0f),
    float2( 0.0f, -2.0f),
    float2( 2.0f, -2.0f),
    float2(-2.0f,  0.0f),
    float2( 0.0f,  0.0f),
    float2( 2.0f,  0.0f),
    float2(-2.0f,  2.0f),
    float2( 0.0f,  2.0f),
    float2( 2.0f,  2.0f)
};

#if COD_METHOD == 0
static const float GaussianBloomDownsampleWeights[13] =
{
    0.125f,
    0.125f,
    0.125f,
    0.125f,
    0.0555555f,
    0.0555555f,
    0.0555555f,
    0.0555555f,
    0.0555555f,
    0.0555555f,
    0.0555555f,
    0.0555555f,
    0.0555555f
};
#else // COD_METHOD == 1
static const float GaussianBloomDownsampleWeights[13] =
{
    0.125f,
    0.125f,
    0.125f,
    0.125f,
    0.03125f,
    0.0625f,
    0.03125f,
    0.0625f,
    0.125f,
    0.0625f,
    0.03125f,
    0.0625f,
    0.03125f,
};
#endif

float KarisAverage(float3 color)
{
    float luma = RelativeLuminance(color);
    return 1.0f / (1.0f + luma);
}

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void GaussianBloomDownsampleCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D inputTexture = ShaderConstants.GetInputTextureSRV();
    RWTexture2D<float3> outputTexture = ShaderConstants.GetOutputTextureUAV();

    float2 outputTextureInvSize = float2(ShaderConstants.GetOutputTextureInvSizeX(), ShaderConstants.GetOutputTextureInvSizeY());
    bool useKarisAverage = ShaderConstants.GetUseKarisAverage() > 0;

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (float2(pixelCoord) + 0.5f) * outputTextureInvSize;

    float3 color = 0.0f;

    // TODO: Apply pre-exposure
    // float preExposure = frameShaderParameters.preExposure;
    // float inversePreExposure = frameShaderParameters.inversePreExposure;

    // @todo Anti-fireflies

#if COD_METHOD == 0
    [unroll]
    for (uint sampleIndex = 0; sampleIndex < 13; sampleIndex++)
    {
        float2 sampleUV = uv + GaussianBloomDownsampleOffsets[sampleIndex] * outputTextureInvSize * 0.5f;
        float3 sampleColor = inputTexture.SampleLevel(GlobalSamplerLinearBorder, sampleUV, 0).rgb;
        color += GaussianBloomDownsampleWeights[sampleIndex] * sampleColor;
    }
#else
    // TODO: Use shader permutation
    // TODO: Use Karis HDR Weight
    [branch]
    if (useKarisAverage)
    {
        float3 sample0 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[0] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample1 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[1] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample2 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[2] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample3 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[3] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample4 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[4] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample5 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[5] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample6 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[6] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample7 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[7] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample8 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[8] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample9 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[9] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample10 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[10] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample11 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[11] * outputTextureInvSize * 0.5f, 0).rgb;
        float3 sample12 = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv + GaussianBloomDownsampleOffsets[12] * outputTextureInvSize * 0.5f, 0).rgb;

        // Apply the Partial Karis Average on the mip0 to mip1 downsample to alleviate fireflys
        // See page 168 of Next-Generation-Post-Processing-in-Call-of-Duty-Advanced-Warfare-v18.pptx
        float3 block0 = (sample0 + sample1 + sample2 + sample3) * 0.25f;
        float3 block1 = (sample4 + sample5 + sample7 + sample8) * 0.25f;
        float3 block2 = (sample5 + sample6 + sample8 + sample9) * 0.25f;
        float3 block3 = (sample7 + sample8 + sample10 + sample11) * 0.25f;
        float3 block4 = (sample8 + sample9 + sample11 + sample12) * 0.25f;
#if 0
        float totalWeight = 0.0f;
        [unroll]
        for (uint sampleIndex = 0; sampleIndex < 13; sampleIndex++)
        {
            float2 sampleUV = uv + GaussianBloomDownsampleOffsets[sampleIndex] * outputTextureInvSize * 0.5f;
            float3 sampleColor = inputTexture.SampleLevel(GlobalSamplerPointClamp, sampleUV, 0).rgb;
            float sampleWeight = KarisAverage(sampleColor);
            //color += GaussianBloomDownsampleWeights[sampleIndex] * sampleWeight * sampleColor;
            color += sampleWeight * sampleColor;
            totalWeight += sampleWeight;
        }
        color /= totalWeight;
#elif 1
        float weight0 = 0.5f * KarisAverage(block0);
        float weight1 = 0.125f * KarisAverage(block1);
        float weight2 = 0.125f * KarisAverage(block2);
        float weight3 = 0.125f * KarisAverage(block3);
        float weight4 = 0.125f * KarisAverage(block4);
        color = (weight0 * block0 + weight1 * block1 + weight2 * block2 + weight3 * block3 + weight4 * block4) / (weight0 + weight1 + weight2 + weight3 + weight4);
#else
        float weight0 = KarisAverage(block0);
        float weight1 = KarisAverage(block1);
        float weight2 = KarisAverage(block2);
        float weight3 = KarisAverage(block3);
        float weight4 = KarisAverage(block4);
        color = (weight0 * block0 + weight1 * block1 + weight2 * block2 + weight3 * block3 + weight4 * block4) / (weight0 + weight1 + weight2 + weight3 + weight4);
#endif
    }
    else
    {
        [unroll]
        for (uint sampleIndex = 0; sampleIndex < 13; sampleIndex++)
        {
            float2 sampleUV = uv + GaussianBloomDownsampleOffsets[sampleIndex] * outputTextureInvSize * 0.5f;
            float3 sampleColor = inputTexture.SampleLevel(GlobalSamplerLinearBorder, sampleUV, 0).rgb;
            color += GaussianBloomDownsampleWeights[sampleIndex] * sampleColor;
        }
    }
#endif

    outputTexture[pixelCoord] = color;
}