#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, SceneColorTextureSRV);
SHADER_CONSTANTS_SCALAR(2, float, InverseOutputTextureSizeX);
SHADER_CONSTANTS_SCALAR(3, float, InverseOutputTextureSizeY);
SHADER_CONSTANTS_STRUCT_END();

// https://www.shadertoy.com/view/tstBDl
float2 ComputeFisheyeUV(float2 uv, float f, float zoom)
{
    float2 ndcPos = 2.0f * uv - 1.0f;
    float scale = f * atan(1.0f / f);
    float r_d = length(ndcPos) * scale;
    float r_u = f * tan(r_d / f) * zoom;
    float phi = atan2(ndcPos.y, ndcPos.x);
    return float2(r_u * cos(phi) + 1.0f, r_u * sin(phi) + 1.0f) * 0.5f;
}

static const float GhostIntensity = 1.0f;
static const float GhostChromaShift = 1.0f;
static const float4 GhostColorAndScale[8] =
{
    float4(1.0f, 0.8f, 0.4f, -1.5f),
    float4(1.0f, 1.0f, 0.6f,  2.5f),
    float4(0.8f, 0.8f, 1.0f, -5.0f),
    float4(0.5f, 1.0f, 0.4f, 10.0f),
    float4(0.5f, 0.8f, 1.0f,  0.7f),
    float4(0.9f, 1.0f, 0.8f, -0.4f),
    float4(1.0f, 0.8f, 0.4f, -0.2f),
    float4(0.9f, 0.7f, 0.7f, -0.1f),
};

static const float2 HaloCenterUV = float2(0.5f, 0.5f);

/*
 * Reference: https://www.froyok.fr/blog/2021-09-ue4-custom-lens-flare/
 */

[shader("pixel")]
void LensFlareGhostPS(in float4 position : SV_Position, out float3 result : SV_Target)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D SceneColorTexture = ShaderConstants.GetSceneColorTextureSRV();
    float2 inverseOutputTextureSize = float2(ShaderConstants.GetInverseOutputTextureSizeX(), ShaderConstants.GetInverseOutputTextureSizeY());

    float2 uv = position.xy * inverseOutputTextureSize;

    uint ghostCount = 8;

    result = float3(0.0f, 0.0f, 0.0f);

    [loop]
    for (uint ghostIndex = 0; ghostIndex < ghostCount; ghostIndex++)
    {
        if (abs(GhostColorAndScale[ghostIndex].a) > 0.0001f)
        {
            float2 sampleUV = (uv - 0.5f) * GhostColorAndScale[ghostIndex].a;

            // Local mask
            float distanceMask = 1.0f - distance(float2(0.0f, 0.0f), sampleUV);
            float Mask1 = smoothstep(0.5f, 0.9f, distanceMask);
            float Mask2 = smoothstep(0.75f, 1.0f, distanceMask) * 0.95f + 0.05f;

            float3 sampleColor = SceneColorTexture.SampleLevel(GlobalSamplerLinearBorder, sampleUV + 0.5f, 0.0f).rgb;
            result += sampleColor * GhostColorAndScale[ghostIndex].rgb * Mask1 * Mask2;
        }
    }

    float haloCompression = 0.65f;
    float haloIntensity = frameShaderParameters.lensFlareHaloIntensity;
    float haloWidth = frameShaderParameters.lensFlareHaloWidth;
    float chromaticAberrationOffset = frameShaderParameters.lensFlareHaloChromaticAberrationOffset;

    float2 fisheyeUV = ComputeFisheyeUV(uv, haloCompression , 1.0f);

    float2 haloVector = normalize(HaloCenterUV - fisheyeUV) * haloWidth;

#if 1
    float haloMask = distance(fisheyeUV, HaloCenterUV);
    haloMask = saturate(2.0f * haloMask);
    haloMask = smoothstep(0.5f, 1.0f, haloMask);
#else
    float haloMask = length(HaloCenterUV - frac(fisheyeUV + haloVector)) / length(HaloCenterUV);
    haloMask = pow(1.0f - haloMask, 5.0f);
#endif

    float2 ndcPos = ScreenSpaceUVToNDCSpaceXY(uv);
    float vignette = Vignette(ndcPos);
    vignette *= Vignette(ndcPos * 0.8f);
    vignette = vignette * 0.95 + 0.05;

    float2 chromaticAberrationUV_R = (fisheyeUV - HaloCenterUV) * (1.0f + chromaticAberrationOffset) + haloVector + HaloCenterUV;
    float2 chromaticAberrationUV_G = fisheyeUV + haloVector;
    float2 chromaticAberrationUV_B = (fisheyeUV - HaloCenterUV) * (1.0f - chromaticAberrationOffset) + haloVector + HaloCenterUV;

    float3 haloColor = 0.0f;
    haloColor.r = SceneColorTexture.SampleLevel(GlobalSamplerLinearClamp, chromaticAberrationUV_R, 0).r;
    haloColor.g = SceneColorTexture.SampleLevel(GlobalSamplerLinearClamp, chromaticAberrationUV_G, 0).g;
    haloColor.b = SceneColorTexture.SampleLevel(GlobalSamplerLinearClamp, chromaticAberrationUV_B, 0).b;

    result = 0;
    result += haloColor * haloIntensity * haloMask * vignette;

    result.rgb *= GhostIntensity;
}