#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"
#include "MotionBlurCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_CONSTANT_BUFFER_CBV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferCBV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, VelocityTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, DepthTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(3, float4, VelocityRangeTextureUAV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(4, float3, VelocityAndDepthTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

float4 CombineVelocityRange(float4 r0, float4 r1)
{
    float2 minLengthVelocityVector = r0.x < r1.x ? r0.xy : r1.xy;
    float2 maxLengthVelocityVector = r0.z > r1.z ? r0.zw : r1.zw;
	return float4(minLengthVelocityVector, maxLengthVelocityVector);
}

float2 EncodeVelocity(float2 velocity)
{
    // Normalize the polar angle from (-π, π] to (0, 1].
	float2 encodedVelocity = float2(velocity.x, velocity.y * INV_PI * 0.5f + 0.5f);
	return encodedVelocity;
}

groupshared float4 SharedTileData[MOTION_BLUR_TILE_SIZE * MOTION_BLUR_TILE_SIZE];

[shader("compute")]
[numthreads(MOTION_BLUR_TILE_SIZE, MOTION_BLUR_TILE_SIZE, 1)]
void MotionBlurSetupCS(uint3 DispatchThreadID : SV_DispatchThreadID, uint3 GroupID : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
    ConstantBuffer<PerFrameShaderParameters> frameShaderParameters = ShaderConstants.GetPerFrameShaderParameterBufferCBV();
    Texture2D velocityTexture = ShaderConstants.GetVelocityTextureSRV();
    Texture2D depthTexture = ShaderConstants.GetDepthTextureSRV();
    RWTexture2D<float4> velocityRangeTexture = ShaderConstants.GetVelocityRangeTextureUAV();
    RWTexture2D<float3> velocityAndDepthTexture = ShaderConstants.GetVelocityAndDepthTextureUAV();

    uint2 pixelCoord = DispatchThreadID.xy;

    float2 velocity = velocityTexture[pixelCoord].xy;
    float depth = depthTexture[pixelCoord].x;

    float2 velocityScale = frameShaderParameters.motionVectorScale;

    velocity *= velocityScale;
	velocity = CartesianToPolar(velocity);
	if (any(isnan(velocity)))
	{
		velocity = float2(0.0f, 0.0f);
	}
	velocity.x = min(velocity.x, frameShaderParameters.motionBlurMaxVelocityLengthInPixels);

    float4 velocityRange = float4(velocity, velocity);

    // Write the velocity range to LDS.
	SharedTileData[GroupIndex] = velocityRange;
	GroupMemoryBarrierWithGroupSync();

	if (GroupIndex < 128)
    {
        SharedTileData[GroupIndex] = CombineVelocityRange(SharedTileData[GroupIndex], SharedTileData[GroupIndex + 128]);
    }
	GroupMemoryBarrierWithGroupSync();
	if (GroupIndex < 64)
    {
        SharedTileData[GroupIndex] = CombineVelocityRange(SharedTileData[GroupIndex], SharedTileData[GroupIndex + 64]);
    }
    GroupMemoryBarrierWithGroupSync();
	if (GroupIndex < 32)
    {
        SharedTileData[GroupIndex] = CombineVelocityRange(SharedTileData[GroupIndex], SharedTileData[GroupIndex + 32]);
    }
    // It is safe to omit group synchronization when the wave size is greater than or equal to 32.
    // NVIDIA and AMD GPUs have a wave size of 32 or at least.
    if (GroupIndex < 16)
    {
        SharedTileData[GroupIndex] = CombineVelocityRange(SharedTileData[GroupIndex], SharedTileData[GroupIndex + 16]);
    }
    if (GroupIndex < 8)
    {
        SharedTileData[GroupIndex] = CombineVelocityRange(SharedTileData[GroupIndex], SharedTileData[GroupIndex + 8]);
    }
    if (GroupIndex < 4)
    {
        SharedTileData[GroupIndex] = CombineVelocityRange(SharedTileData[GroupIndex], SharedTileData[GroupIndex + 4]);
    }
    if (GroupIndex < 2)
    {
        SharedTileData[GroupIndex] = CombineVelocityRange(SharedTileData[GroupIndex], SharedTileData[GroupIndex + 2]);
    }
    if (GroupIndex < 1)
    {
        SharedTileData[GroupIndex] = CombineVelocityRange(SharedTileData[GroupIndex], SharedTileData[GroupIndex + 1]);
    }

    velocityRange = SharedTileData[GroupIndex];

    // Tile not only the maximum velocity, but also the minimum.
    if (GroupIndex == 0)
    {
        uint2 tileID = GroupID.xy;
        velocityRangeTexture[tileID] = float4(PolarToCartesian(velocityRange.xy), PolarToCartesian(velocityRange.zw));
    }

    // Pack velocity and depth to a R11G11B10 texture.
    // Reduces taps per sample from 3 (color, velocity, depth) to 2 (color, velocity/depth).
    float3 encodedVelocityAndDepth = float3(EncodeVelocity(velocity), ComputeCameraSpaceDepth(depth, frameShaderParameters.nearClippingPlane, frameShaderParameters.farClippingPlane));

    velocityAndDepthTexture[pixelCoord] = encodedVelocityAndDepth;
}