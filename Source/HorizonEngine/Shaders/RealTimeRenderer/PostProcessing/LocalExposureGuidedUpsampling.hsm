#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"
#include "ToneMappingCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, ColorTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, LuminanceTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(3, AssembleTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_SRV(5, float, AutoExposureTexture);
SHADER_CONSTANTS_TEXTURE_2D_UAV(4, float4, OutputTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void LocalExposureGuidedUpsamplingCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D colorTexture = ShaderConstants.GetColorTextureSRV();
    Texture2D luminanceTexture = ShaderConstants.GetLuminanceTextureSRV();
    Texture2D assembleTexture = ShaderConstants.GetAssembleTextureSRV();
    //Texture2D<float> autoExposureTexture = GetAutoExposureTextureSRV();
    RWTexture2D<float4> outputTexture = ShaderConstants.GetOutputTextureUAV();

    uint width, height;
    outputTexture.GetDimensions(width, height);

    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5) / float2(width, height);

    //float exposure = autoExposureTexture[uint2(1, 0)];
    float exposure = 1;//frameShaderParameters.exposure;

    float displayMipLevel = (0);

    float4 mipPixelSize;
    mipPixelSize.x = (1);
    mipPixelSize.y = (2);
    mipPixelSize.z = (3);
    mipPixelSize.w = (4);

    // See https://bartwronski.com/2019/09/22/local-linear-models-guided-filter/
    float momentX = 0.0;
    float momentY = 0.0;
    float momentX2 = 0.0;
    float momentXY = 0.0;
    float ws = 0.0;
    for (int dy = -1; dy <= 1; dy += 1)
    {
        for (int dx = -1; dx <= 1; dx += 1)
        {
            float x = luminanceTexture.SampleLevel(GlobalSamplerLinearClamp, uv + float2(dx, dy) * mipPixelSize.zw, displayMipLevel).y;
            float y = assembleTexture.SampleLevel(GlobalSamplerLinearClamp, uv + float2(dx, dy) * mipPixelSize.zw, displayMipLevel).x;
            float w = exp(-0.5 * float(dx*dx + dy*dy) / (0.7 * 0.7));
            momentX += x * w;
            momentY += y * w;
            momentX2 += x * x * w;
            momentXY += x * y * w;
            ws += w;
        }
    }
    momentX /= ws;
    momentY /= ws;
    momentX2 /= ws;
    momentXY /= ws;
    float A = (momentXY - momentX * momentY) / (max(momentX2 - momentX * momentX, 0.0) + 0.00001);
    float B = momentY - A * momentX;

    // Apply local exposure adjustment as a crude multiplier on all RGB channels.
    // This is... generally pretty wrong, but enough for the demo purpose.
    float3 texelOriginal = sqrt(max(FastToneMapping(colorTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).rgb * exposure), 0.0));
    float luminance = dot(texelOriginal.xyz, float3(0.1, 0.7, 0.2)) + 0.00001;
    float finalMultiplier = max(A * luminance + B, 0.0) / luminance;
    // This is a hack to prevent super dark pixels getting boosted by a lot and showing compression artifacts.
    float lerpToUnityThreshold = 0.007;
    finalMultiplier = luminance > lerpToUnityThreshold ? finalMultiplier :
        lerp(1.0, finalMultiplier, (luminance / lerpToUnityThreshold) * (luminance / lerpToUnityThreshold));
    //float3 texelFinal = sqrt(max(FastToneMapping(texture2D(tOriginal, vUv).xyz * exposure * finalMultiplier), 0.0));

    outputTexture[pixelCoord] = finalMultiplier;
}
