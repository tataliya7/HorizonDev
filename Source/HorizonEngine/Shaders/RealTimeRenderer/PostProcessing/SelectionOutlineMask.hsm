#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"
#include "SelectionOutlineCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameShaderParameters, PerFrameShaderParameters);
BIND_BUFFER_ELEMENT(1, Geometry, Geometry);
BIND_BYTE_ADDRESS_BUFFER_SRV(2, VertexBuffer0);

float3 GetVertexPosition(uint vertexIndex)
{
    ByteAddressBuffer vertexBuffer0 = GetVertexBuffer0SRV();
    return vertexBuffer0.Load<float3>(vertexIndex * sizeof(float3));
}

[shader("vertex")]
void SelectionOutlineMaskVS(uint vertexIndex : SV_VertexID, out float4 svPosition : SV_Position)
{
    PerFrameShaderParameters perFrameParameters = GetPerFrameShaderParameters();
    Geometry geometry = GetGeometry();
    float3 vertexPosition = GetVertexPosition(vertexIndex);
    float4x4 worldMatrix = GetRWByteAddressBuffer(geometry.transformBuffer).Load<float4x4>(geometry.transformIndex * sizeof(float4x4));
    float3 worldPosition = mul(worldMatrix, float4(vertexPosition, 1.0)).xyz;
    float4 clipPosition = mul(perFrameParameters.nonJitteredViewProjectionMatrix, float4(worldPosition, 1.0));
    svPosition = clipPosition;
}

[shader("pixel")]
void SelectionOutlineMaskPS(out float4 output : SV_Target0)
{
    output = 1.0f;
}