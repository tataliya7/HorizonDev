#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

BIND_TEXTURE_2D_SRV(0, DownsampledInputTexture);
BIND_TEXTURE_2D_SRV(1, LowResolutionInputTexture);
BIND_TEXTURE_2D_UAV(2, float3, OutputTexture);

static const float2 GaussianBloomUpsampleOffset[9] = {
    float2(-1.0f,  1.0f), float2( 0.0f,  1.0f), float2( 1.0f,  1.0f),
    float2(-1.0f,  0.0f), float2( 0.0f,  0.0f), float2( 1.0f,  0.0f),
    float2(-1.0f, -1.0f), float2( 0.0f, -1.0f), float2( 1.0f, -1.0f)
};

static const float GaussianBloomUpsampleWeights[9] = {
    0.0625f, 0.125f, 0.0625f,
    0.125f,  0.25f,  0.125f,
    0.0625f, 0.125f, 0.0625f
};

[numthreads(POST_PROCESSING_THREAD_GROUP_COUNT_X, POST_PROCESSING_THREAD_GROUP_COUNT_Y, 1)]
void GaussianBloomUpsampleCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    Texture2D downsampledInputTexture = GetDownsampledInputTextureSRV();
    Texture2D lowResolutionInputTexture = GetLowResolutionInputTextureSRV();
    RWTexture2D<float3> outputTexture = GetOutputTextureUAV();

    float outputTextureInvWidth = SHADER_ARGUMENTS_DATA(0);
    float outputTextureInvHeight = SHADER_ARGUMENTS_DATA(1);
    float radius = SHADER_ARGUMENTS_DATA(2);

    float2 outputTextureInvSize = float2(outputTextureInvWidth, outputTextureInvHeight);

    uint2 pixelCoord = DispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5f) * outputTextureInvSize;

    float3 downsampledColor = downsampledInputTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).rgb;
    float3 upsampledColor = 0.0f;

#define COD_METHOD 0
#if COD_METHOD == 0
    [unroll]
    for(uint sampleIndex = 0; sampleIndex < 9; sampleIndex++)
    {
        float2 sampleUV = uv + GaussianBloomUpsampleOffset[sampleIndex] * outputTextureInvSize * 2.0f;
        upsampledColor += GaussianBloomUpsampleWeights[sampleIndex] * lowResolutionInputTexture.SampleLevel(GlobalSamplerLinearClamp, sampleUV, 0).rgb;
    }
    outputTexture[pixelCoord] = lerp(downsampledColor, upsampledColor, radius);
#else
    [unroll]
    for(uint sampleIndex = 0; sampleIndex < 9; sampleIndex++)
    {
        float2 sampleUV = uv + GaussianBloomUpsampleOffset[sampleIndex] * outputTextureInvSize * 2.0f * radius;
        upsampledColor += GaussianBloomUpsampleWeights[sampleIndex] * lowResolutionInputTexture.SampleLevel(GlobalSamplerLinearClamp, sampleUV, 0).rgb;
    }
    outputTexture[pixelCoord] = upsampledColor + downsampledColor;
#endif
}