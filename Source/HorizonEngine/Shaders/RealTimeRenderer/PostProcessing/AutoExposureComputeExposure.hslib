#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"
#include "AutoExposureCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_SRV(1, uint, AutoExposureHistogramTextureSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(2, PreviousAutoExposureBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(3, CurrentAutoExposureBufferUAV);
SHADER_CONSTANTS_STRUCT_END();

float ComputeAverageSceneLuminance(Texture2D<uint> histogramTexture, float lowerPercentage, float higherPercentage, float histogramMinEV100, float histogramMaxEV100)
{
    uint i;

    float totalPixels = 0.0f;

    [unroll]
    for (i = 0; i < AUTO_EXPOSURE_HISTOGRAM_BIN_COUNT; i++)
    {
        totalPixels += AutoExposureHistogramUnpackFloat(histogramTexture[uint2(i, 0)].r);
    }

    float numPixelsBelowLowerBound = totalPixels * lowerPercentage;
    float numPexelsBelowUpperBound = totalPixels * higherPercentage;

    float logLuminanceSum = 0.0f;
    float weightSum = 0.0f;

    float minLogLuminance = histogramMinEV100;
    float logLuminanceRange = histogramMaxEV100 - histogramMinEV100;

    [unroll]
    for (i = 0; i < AUTO_EXPOSURE_HISTOGRAM_BIN_COUNT; i++)
    {
        float numPixels = AutoExposureHistogramUnpackFloat(histogramTexture[uint2(i, 0)].r);

        float numPixelsDiscard = min(numPixels, numPixelsBelowLowerBound);
        numPixels -= numPixelsDiscard;
        numPixelsBelowLowerBound -= numPixelsDiscard;
        numPexelsBelowUpperBound -= numPixelsDiscard;

        numPixels = min(numPixels, numPexelsBelowUpperBound);
        numPexelsBelowUpperBound -= numPixels;

        // log2(RelativeLuminance) at this bin
        float logLuminance = (float(i) / float(AUTO_EXPOSURE_HISTOGRAM_BIN_COUNT - 1)) * logLuminanceRange + minLogLuminance;

        logLuminanceSum += logLuminance * numPixels;
        weightSum += numPixels;
    }

    float averageLogLuminance = logLuminanceSum / max(0.0001f, weightSum);

    return exp2(averageLogLuminance);
}

float InterpolateExposure(float srcExposure, float dstExposure, float deltaTimeInSeconds, float speedDarkToBright, float speedBrightToDark)
{
    float delta = dstExposure - srcExposure;
    float speed = (delta > 0.0f) ? speedBrightToDark : speedDarkToBright;
    float exposure = srcExposure + delta * (1.0f - exp2(-deltaTimeInSeconds * speed)); // Exponential decay
    return exposure;
}

[shader("compute")]
[numthreads(1, 1, 1)]
void AutoExposureComputeExposureCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];

    float deltaTimeInSeconds = frameShaderParameters.deltaTimeInSeconds;
    float exposureCompensation = frameShaderParameters.autoExposureExposureCompensation;
    float minExposureValue = frameShaderParameters.autoExposureMinExposureValue;
    float maxExposureValue = frameShaderParameters.autoExposureMaxExposureValue;
    float histogramLowPercent = frameShaderParameters.autoExposureHistogramLowerPercentage;
    float histogramHighPercent = frameShaderParameters.autoExposureHistogramHigherPercentage;
    float speedDarkToBright = frameShaderParameters.autoExposureSpeedDarkToBright;
    float speedBrightToDark = frameShaderParameters.autoExposureSpeedBrightToDark;
    float histogramMinEV100 = frameShaderParameters.autoExposureHistogramMinEV100;
    float histogramMaxEV100 = frameShaderParameters.autoExposureHistogramMaxEV100;
    bool useTargetExposure = frameShaderParameters.autoExposureUseTargetExposure > 0.0f;

    float minExposure = (EV100ToLuminance(minExposureValue) / MiddleGray);
    float maxExposure = (EV100ToLuminance(maxExposureValue) / MiddleGray);
    exposureCompensation = pow(2.0f, exposureCompensation);

    Texture2D<uint> histogramTexture = ShaderConstants.GetAutoExposureHistogramTextureSRV();
    ByteAddressBuffer previousAutoExposureBuffer = ShaderConstants.GetPreviousAutoExposureBufferSRV();
    RWByteAddressBuffer currentAutoExposureBuffer = ShaderConstants.GetCurrentAutoExposureBufferUAV();

    float averageSceneLuminance = ComputeAverageSceneLuminance(histogramTexture, histogramLowPercent, histogramHighPercent, histogramMinEV100, histogramMaxEV100);

    float targetExposure = averageSceneLuminance / MiddleGray;
    targetExposure = clamp(targetExposure, minExposure, maxExposure);

    float adaptedExposure = targetExposure;
    if (!useTargetExposure)
    {
        // TODO: Initialize previousAutoExposureBuffer with some default values.
        float sourceExposure = previousAutoExposureBuffer.Load<float>(0);
        sourceExposure = exposureCompensation / (sourceExposure != 0.0f ? sourceExposure : 1.0f);
        adaptedExposure = InterpolateExposure(sourceExposure, targetExposure, deltaTimeInSeconds, speedDarkToBright, speedBrightToDark);
        adaptedExposure = clamp(adaptedExposure, minExposure, maxExposure);
    }

    currentAutoExposureBuffer.Store<float4>(0, float4(exposureCompensation / max(0.0001f, adaptedExposure), exposureCompensation / max(0.0001f, targetExposure), exposureCompensation, averageSceneLuminance));
}