#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, ExposureTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, WeightTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(3, float4, OutputTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void LocalExposureBlendExposuresCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    Texture2D exposureTexture = ShaderConstants.GetExposureTextureSRV();
    Texture2D weightTexture = ShaderConstants.GetWeightTextureSRV();
    RWTexture2D<float4> outputTexture = ShaderConstants.GetOutputTextureUAV();

    uint width, height;
    outputTexture.GetDimensions(width, height);
    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5f) / float2(width, height);

    float coarsestMipLevel = (0);

    // Blend the exposures based on the blend weights.
    float3 exposures = exposureTexture.SampleLevel(GlobalSamplerLinearClamp, uv, coarsestMipLevel).rgb;
    float3 weights = weightTexture.SampleLevel(GlobalSamplerLinearClamp, uv, coarsestMipLevel).rgb;
    weights /= dot(weights, 1.0) + 0.0001;

    float3 result = dot(exposures * weights, 1.0);
    outputTexture[pixelCoord] = float4(result, 1.0);
}
