#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"
#include "SelectionOutlineCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_TEXTURE_2D_SRV(1, InputTexture);
BIND_TEXTURE_2D_UAV(2, float4, OutputTexture);

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void SelectionOutlineCompositeCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    ConstantBuffer<PerFrameShaderParameters> perFrameConstants = GetPerFrameShaderParametersCBV();
    uint2 pixelCoord = DispatchThreadID.xy;
    uint width = perFrameConstants.targetWidth;
    uint height = perFrameConstants.targetHeight;
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    float outlineWidth = 1.0f;
    float4 outlineColor = float4(1.0f, 0.5f, 0.0f, 1.0f);

    Texture2D inputTexture = GetInputTextureSRV();
    RWTexture2D<float4> outputTexture = GetOutputTextureUAV();

    float4 input = inputTexture[pixelCoord];
    if (input.z == SELECTION_OUTLINE_JUMP_FLOOD_INVALID_VALUE || input.w > 0.99) // early out if null nearest position or in interior region
    {
        return;
    }

    float dist = sqrt(input.z);

    // calculate outline
    // + 1.0 is because encoded nearest position is half a pixel inset
    // not + 0.5 because we want the anti-aliased edge to be aligned between pixels
    // distance is already in pixels, so this is already perfectly anti-aliased!
    float outline = saturate(outlineWidth - dist + 1.0);

    // apply outline to alpha
    float4 color = outlineColor;
    color.a *= outline;

    outputTexture[pixelCoord] = color;
}