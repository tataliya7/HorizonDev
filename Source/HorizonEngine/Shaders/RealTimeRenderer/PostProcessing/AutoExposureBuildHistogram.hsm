#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"
#include "AutoExposureCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, SceneColorTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(2, uint, AutoExposureHistogramTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

// https://bruop.github.io/exposure/
// https://en.wikipedia.org/wiki/Exposure_value

groupshared uint SharedHistogram[AUTO_EXPOSURE_HISTOGRAM_BIN_COUNT];

float ComputeSceneColorLuminance(float3 sceneColor)
{
    return dot(sceneColor, float3(1.0f, 1.0f, 1.0f) / 3.0f);
}

[shader("compute")]
[numthreads(AUTO_EXPOSURE_BUILD_HISTOGRAM_CS_NUM_THREADS_X, AUTO_EXPOSURE_BUILD_HISTOGRAM_CS_NUM_THREADS_Y, 1)]
void AutoExposureBuildHistogramCS(uint3 DispatchThreadID : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];

    uint width = frameShaderParameters.renderWidth;
    uint height = frameShaderParameters.renderHeight;
    if ((DispatchThreadID.x) >= width || (DispatchThreadID.y) >= height)
    {
        return;
    }

    Texture2D sceneColorTexture = ShaderConstants.GetSceneColorTextureSRV();
    RWTexture2D<uint> histogramTexture = ShaderConstants.GetAutoExposureHistogramTextureUAV();

    // Clears the shared memory
    SharedHistogram[GroupIndex] = 0;

    GroupMemoryBarrierWithGroupSync();

    // Accumulate histogram
    {
        float histogramMinEV100 = frameShaderParameters.autoExposureHistogramMinEV100;
        float histogramMaxEV100 = frameShaderParameters.autoExposureHistogramMaxEV100;

        uint2 pixelCoord = DispatchThreadID.xy;
        float2 uv = (float2(pixelCoord) + 0.5f) / float2(width, height);

        float3 sceneColor = sceneColorTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).rgb;
        sceneColor.rgb *= frameShaderParameters.oneOverPreExposure;

        float sceneColorLuminance = ComputeSceneColorLuminance(sceneColor);

        float logSceneColorLuminance = log2(sceneColorLuminance);

        float inverseLogLuminanceRange = 1.0f / (histogramMaxEV100 - histogramMinEV100);

        // Calculate the log_2 luminance and express it as a value in [0, 1]
        float histogramPosition = (logSceneColorLuminance - histogramMinEV100) * inverseLogLuminanceRange;
        histogramPosition = saturate(histogramPosition);

        // Map [0, 1] to [0, AUTO_EXPOSURE_HISTOGRAM_BIN_COUNT - 1]
        histogramPosition = histogramPosition * (AUTO_EXPOSURE_HISTOGRAM_BIN_COUNT - 1);

        uint histogramBinIndex0 = min(uint(histogramPosition), AUTO_EXPOSURE_HISTOGRAM_BIN_COUNT - 1);
        uint histogramBinIndex1 = min(uint(histogramPosition) + 1, AUTO_EXPOSURE_HISTOGRAM_BIN_COUNT - 1);

        float histogramBinWeight0 = 1.0f - frac(histogramPosition);
        float histogramBinWeight1 = 1.0f - histogramBinWeight0;

        InterlockedAdd(SharedHistogram[histogramBinIndex0], AutoExposureHistogramPackFloat(histogramBinWeight0));
        InterlockedAdd(SharedHistogram[histogramBinIndex1], AutoExposureHistogramPackFloat(histogramBinWeight1));
    }

    GroupMemoryBarrierWithGroupSync();

    InterlockedAdd(histogramTexture[uint2(GroupIndex, 0)], SharedHistogram[GroupIndex]);
}