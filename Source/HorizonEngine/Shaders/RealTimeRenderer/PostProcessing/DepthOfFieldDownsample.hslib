#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_TEXTURE_2D_SRV(1, SceneColor);
BIND_TEXTURE_2D_SRV(2, SceneDepth);
BIND_TEXTURE_2D_UAV(3, float, DOFCoCTexture);
BIND_TEXTURE_2D_UAV(4, float4, DOFNearRegionTexture);
BIND_TEXTURE_2D_UAV(5, float4, DOFFarRegionTexture);

float ComputeNearRegionMask(float depth, float focalDistance, float focalRegion, float nearTransitionRegion)
{
    return saturate((focalDistance - 0.5 * focalRegion - depth) / nearTransitionRegion);
}

float ComputeFarRegionMask(float depth, float focalDistance, float focalRegion, float farTransitionRegion)
{
    return saturate((depth - focalDistance - 0.5 * focalRegion) / farTransitionRegion);
}

float ComputeCoC(float linearDepth, float focalDistance, float focalRegion)
{
    float focusNear = focalDistance - 0.5 * focalRegion;
    float focusFar = focalDistance + 0.5 * focalRegion;

    float clampedDepth = clamp(linearDepth, focalDistance, focalDistance);
    float coc = ((linearDepth - clampedDepth) / linearDepth);
    return saturate(coc + 0.5);
}

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void DepthOfFieldSetupCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    uint width = frameShaderParameters.targetWidth / 2;
    uint height = frameShaderParameters.targetHeight / 2;
    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5) / float2(width, height);

    Texture2D sceneColor = GetSceneColorSRV();
    Texture2D sceneDepth = GetSceneDepthSRV();
    RWTexture2D<float> cocTexture = GetDOFCoCTextureUAV();
    RWTexture2D<float4> nearRegionTexture = GetDOFNearRegionTextureUAV();
    RWTexture2D<float4> farRegionTexture = GetDOFFarRegionTextureUAV();

    float focalDistance = (0);
    float focalRegion = (1);
    float nearTransitionRegion = (2);
    float farTransitionRegion = (3);

    float4 color = sceneColor.SampleLevel(GlobalSamplerLinearClamp, uv, 0);
    float depth = sceneDepth.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;
    float linearDepth = ComputeCameraSpaceDepth(depth, frameShaderParameters.nearClippingPlane, frameShaderParameters.farClippingPlane);

    float nearRegionMask = ComputeNearRegionMask(linearDepth, focalDistance, focalRegion, nearTransitionRegion);
    float farRegionMask = ComputeFarRegionMask(linearDepth, focalDistance, focalRegion, farTransitionRegion);
    float coc = ComputeCoC(linearDepth, focalDistance, focalRegion);

    cocTexture[pixelCoord] = coc;
    nearRegionTexture[pixelCoord] = float4(color.rgb, nearRegionMask);
    farRegionTexture[pixelCoord] = float4(color.rgb, farRegionMask);
}
