[numthreads(POST_PROCESSING_THREAD_GROUP_COUNT_X, POST_PROCESSING_THREAD_GROUP_COUNT_Y, 1)]
void DepthOfFieldGatherCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    PerFrameData perFrameData = GetPerFrameData();
    uint width = perFrameData.targetResolutionX / 2;
    uint height = perFrameData.targetResolutionY / 2;
    if (DispatchThreadID.x >= width || DispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = DispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5) / float2(width, height);

    Texture2D sceneColorTexture = GetSceneColorTextureSRV();
    Texture2D cocTexture = GetDOFCoCTextureSRV();
    RWTexture2D<float4> gatherTexture = GetDOFGatherTextureUAV();

    float farRegionBlurRadius = SHADER_ARGUMENTS_DATA(0);

    float4 center = sceneColorTexture[pixelCoord];
    float coc = cocTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).r;
    coc = abs(coc * 2 - 1);

    float3 result = center.rgb;
    float weightSum = 1;
    if (coc > 0)
    {
        if (coc < 0.2)
        {
            for (uint sampleIndex = 1; sampleIndex < DOFOctawebKernel9SampleCount; sampleIndex++)
            {
                float2 uvOffset = float2(1.0 / float(width), 1.0 / float(height)) * coc * DOFOctawebKernel9[sampleIndex] * farRegionBlurRadius;
                float sampleCoC = cocTexture.SampleLevel(GlobalSamplerLinearClamp, uv + uvOffset, 0).r;
                sampleCoC = abs(sampleCoC * 2 - 1);
                if (sampleCoC > 0 && sampleCoC >= coc)
                {
                    float sampleAlpha = 1.0 / (PI * sampleCoC * sampleCoC);
                    sampleAlpha = 1;
                    result += sampleAlpha * sceneColorTexture.SampleLevel(GlobalSamplerLinearClamp, uv + uvOffset, 0).rgb;
                    weightSum += sampleAlpha;
                }
            }
        }
        else if (coc < 0.6)
        {
            for (uint sampleIndex = 1; sampleIndex < DOFOctawebKernel25SampleCount; sampleIndex++)
            {
                float2 uvOffset = float2(1.0 / float(width), 1.0 / float(height)) * coc * DOFOctawebKernel25[sampleIndex] * farRegionBlurRadius;
                float sampleCoC = cocTexture.SampleLevel(GlobalSamplerLinearClamp, uv + uvOffset, 0).r;
                sampleCoC = abs(sampleCoC * 2 - 1);
                if (sampleCoC > 0 && sampleCoC >= coc)
                {
                    float sampleAlpha = 1.0 / (PI * sampleCoC * sampleCoC);
                    sampleAlpha = 1;
                    result += sampleAlpha * sceneColorTexture.SampleLevel(GlobalSamplerLinearClamp, uv + uvOffset, 0).rgb;
                    weightSum += sampleAlpha;
                }
            }
        }
        else
        {
            float sharpeness = 1;
            for (uint sampleIndex = 1; sampleIndex < DOFOctawebKernel49SampleCount; sampleIndex++)
            {
                float2 uvOffset = float2(1.0 / float(width), 1.0 / float(height)) * coc * DOFOctawebKernel49[sampleIndex] * farRegionBlurRadius;
                float sampleCoC = cocTexture.SampleLevel(GlobalSamplerLinearClamp, uv + uvOffset, 0).r;
                sampleCoC = abs(sampleCoC * 2 - 1);
                if (sampleCoC > 0 && sampleCoC >= coc)
                {
                    float sampleAlpha = 1.0 / (PI * sampleCoC * sampleCoC);
                    float3 sampleColor = sceneColorTexture.SampleLevel(GlobalSamplerLinearClamp, uv + uvOffset, 0).rgb;
                    sampleAlpha = 1.0 / (1.0 + (1.0 - sharpeness) * RelativeLuminance(sampleColor));
                    //sampleAlpha = 1;
                    result += sampleAlpha * sampleColor;
                    weightSum += sampleAlpha;
                }
            }
        }
    }
    result /= weightSum;

    gatherTexture[pixelCoord] = float4(result.rgb, center.a);
}
