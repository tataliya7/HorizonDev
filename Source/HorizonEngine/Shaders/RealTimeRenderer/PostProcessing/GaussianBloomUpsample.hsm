/*-------------------------------------------------------------------------------------
 * Physically Based Bloom
 * Core features:
 * - Filtering both when downsampling and upsampling
 * - Non-thresholed
 * - Anti-fireflies
 * References:
 * - https://www.iryoku.com/next-generation-post-processing-in-call-of-duty-advanced-warfare/
 * - https://www.froyok.fr/blog/2021-12-ue4-custom-bloom/
 * - https://learnopengl.com/Guest-Articles/2022/Phys.-Based-Bloom
 *-------------------------------------------------------------------------------------*/

#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, DownsampledInputTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, LowResolutionInputTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(3, float3, OutputTextureUAV);
SHADER_CONSTANTS_SCALAR(4, float, OutputTextureInvSizeX);
SHADER_CONSTANTS_SCALAR(5, float, OutputTextureInvSizeY);
SHADER_CONSTANTS_STRUCT_END();

static const float2 GaussianBloomUpsampleOffset[9] =
{
    float2(-1.0f,  1.0f), float2( 0.0f,  1.0f), float2( 1.0f,  1.0f),
    float2(-1.0f,  0.0f), float2( 0.0f,  0.0f), float2( 1.0f,  0.0f),
    float2(-1.0f, -1.0f), float2( 0.0f, -1.0f), float2( 1.0f, -1.0f)
};

static const float GaussianBloomUpsampleWeights[9] =
{
    0.0625f, 0.125f, 0.0625f,
    0.125f,  0.25f,  0.125f,
    0.0625f, 0.125f, 0.0625f
};

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void GaussianBloomUpsampleCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D downsampledInputTexture = ShaderConstants.GetDownsampledInputTextureSRV();
    Texture2D lowResolutionInputTexture = ShaderConstants.GetLowResolutionInputTextureSRV();
    RWTexture2D<float3> outputTexture = ShaderConstants.GetOutputTextureUAV();

    float radius = frameShaderParameters.bloomRadius;
    float2 outputTextureInvSize = float2(ShaderConstants.GetOutputTextureInvSizeX(), ShaderConstants.GetOutputTextureInvSizeY());

    uint2 pixelCoord = dispatchThreadID.xy;
    float2 uv = (float2(pixelCoord) + 0.5f) * outputTextureInvSize;

    // There is no need to apply pre-exposure because the result color is the same as when we don't use it.
    // float preExposure = frameShaderParameters.preExposure;
    // float inversePreExposure = frameShaderParameters.inversePreExposure;

    float3 downsampledColor = downsampledInputTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).rgb;
    float3 upsampledColor = 0.0f;

#define COD_METHOD 0
#if COD_METHOD == 0
    [unroll]
    for(uint sampleIndex = 0; sampleIndex < 9; sampleIndex++)
    {
        float2 sampleUV = uv + GaussianBloomUpsampleOffset[sampleIndex] * outputTextureInvSize * 2.0f;
        upsampledColor += GaussianBloomUpsampleWeights[sampleIndex] * lowResolutionInputTexture.SampleLevel(GlobalSamplerLinearClamp, sampleUV, 0).rgb;
    }
    outputTexture[pixelCoord] = lerp(downsampledColor, upsampledColor, radius);
#else
    [unroll]
    for(uint sampleIndex = 0; sampleIndex < 9; sampleIndex++)
    {
        float2 sampleUV = uv + GaussianBloomUpsampleOffset[sampleIndex] * outputTextureInvSize * 2.0f * radius;
        upsampledColor += GaussianBloomUpsampleWeights[sampleIndex] * lowResolutionInputTexture.SampleLevel(GlobalSamplerLinearClamp, sampleUV, 0).rgb;
    }
    outputTexture[pixelCoord] = upsampledColor + downsampledColor;
#endif
}