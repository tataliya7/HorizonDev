#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"
#include "SelectionOutlineCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_TEXTURE_2D_SRV(1, InputTexture);
BIND_TEXTURE_2D_UAV(2, float4, OutputTexture);

static const int2 JumpFloodSampleOffsets3x3[8] =
{
    int2(-1, -1),
    int2( 0, -1),
    int2( 1, -1),
    int2(-1,  0),
    int2( 1,  0),
    int2(-1,  1),
    int2( 0,  1),
    int2( 1,  1),
};

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void SelectionOutlineJumpFloodCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    ConstantBuffer<PerFrameShaderParameters> perFrameConstants = GetPerFrameShaderParametersCBV();
    uint2 pixelCoord = DispatchThreadID.xy;
    uint width = perFrameConstants.targetWidth;
    uint height = perFrameConstants.targetHeight;
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    Texture2D inputTexture = GetInputTextureSRV();
    RWTexture2D<float4> outputTexture = GetOutputTextureUAV();

    float stepWidth = SHADER_ARGUMENTS_DATA(0);
    uint2 size = uint2(perFrameConstants.targetWidth, perFrameConstants.targetHeight);

    float4 center = inputTexture[pixelCoord];
    [unroll] for(int sampleIndex = 0; sampleIndex < 8; sampleIndex++)
    {
        int2 sampleCoord = int2(pixelCoord) + JumpFloodSampleOffsets3x3[sampleIndex] * stepWidth;
        sampleCoord = clamp(sampleCoord, int2(0, 0), int2(size) - int2(1, 1));

        float4 sampleInfo = inputTexture[sampleCoord];
        if (sampleInfo.z != SELECTION_OUTLINE_JUMP_FLOOD_INVALID_VALUE)
        {
            float2 offsetPos = sampleInfo.xy * size;
            float dist = dot(float2(pixelCoord) - offsetPos, float2(pixelCoord) - offsetPos);

            if (center.z == SELECTION_OUTLINE_JUMP_FLOOD_INVALID_VALUE)
            {
                center.xyz = sampleInfo.xyz;
            }
            else if (dist < center.z)
            {
                center.xyz = sampleInfo.xyz;
            }
        }
    }

    outputTexture[pixelCoord] = center;
}