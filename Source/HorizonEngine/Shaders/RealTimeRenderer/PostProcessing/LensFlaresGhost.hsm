#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameData, PerFrameData);
BIND_TEXTURE_2D_SRV(1, SceneColorTexture);

static const float GhostIntensity = 1.0f;
static const float GhostChromaShift = 1.0f;
static const float4 GhostColorAndScale[8] = {
    float4(1.0f, 0.8f, 0.4f, -1.5f),
    float4(1.0f, 1.0f, 0.6f,  2.5f),
    float4(0.8f, 0.8f, 1.0f, -5.0f),
    float4(0.5f, 1.0f, 0.4f, 10.0f),
    float4(0.5f, 0.8f, 1.0f,  0.7f),
    float4(0.9f, 1.0f, 0.8f, -0.4f),
    float4(1.0f, 0.8f, 0.4f, -0.2f),
    float4(0.9f, 0.7f, 0.7f, -0.1f),
};

[shader("pixel")]
void LensFlaresGhostPS(float4 position : SV_Position, out float3 outColor : SV_Target)
{
    PerFrameData perFrameData = GetPerFrameData();
    Texture2D SceneColorTexture = GetSceneColorTextureSRV();
    float outputTextureWidth = SHADER_ARGUMENTS_DATA(0);
    float outputTextureHeight = SHADER_ARGUMENTS_DATA(1);
    float2 outputTextureInvSize = 1.0f / float2(outputTextureWidth, outputTextureHeight);

    float2 uv = position.xy * outputTextureInvSize;

    outColor = float3(0.0f, 0.0f, 0.0f);
    for (uint sampleIndex = 0; sampleIndex < 8; sampleIndex++)
    {
        if (abs(GhostColorAndScale[sampleIndex].a) > 0.0001f)
        {
            float2 sampleUV = (uv - 0.5f) * GhostColorAndScale[sampleIndex].a;

            // Local mask
            float distanceMask = 1.0f - distance(float2(0.0f, 0.0f), sampleUV);
            float Mask  = smoothstep(0.5f, 0.9f, distanceMask);
            float Mask2 = smoothstep(0.75f, 1.0f, distanceMask) * 0.95f + 0.05f;

            float3 sampleColor = SceneColorTexture.SampleLevel(GlobalSamplerLinearBorder, sampleUV + 0.5f, 0.0f).rgb;
            outColor += sampleColor * GhostColorAndScale[sampleIndex].rgb * Mask * Mask2;
        }
    }
    outColor.rgb *= GhostIntensity;
}