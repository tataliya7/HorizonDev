#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

BIND_BYTE_ADDRESS_BUFFER_SRV(0, AutoExposureBuffer);
BIND_TEXTURE_2D_UAV(1, float, ExposureTexture);

[shader("compute")]
[numthreads(1, 1, 1)]
void CopyExposureCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    ByteAddressBuffer autoExposureBuffer = GetAutoExposureBufferSRV();
    RWTexture2D<float> exposureTexture = GetExposureTextureUAV();

    exposureTexture[uint2(0, 0)] = autoExposureBuffer.Load<float>(0);
}