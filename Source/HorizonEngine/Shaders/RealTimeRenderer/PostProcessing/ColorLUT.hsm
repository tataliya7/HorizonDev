SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_3D_UAV(1, float4, ColorLUTTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

// Accurate for 4000K < Temp < 25000K
// Calculates chromaticity from temperature
float2 IlluminantChromaticity(float temp)
{
    temp *= 1.4388 / 1.438;
    float x = temp <= 7000 ? 0.244063 + (0.09911e3 + (2.9678e6 - 4.6070e9 / temp) / temp) / temp : 0.237040 + (0.24748e3 + (1.9018e6 - 2.0064e9 / temp) / temp) / temp;
    float y = -3 * x * x + 2.87 * x - 0.275;
    return float2(x, y);
}

// Accurate for 1000K < temp < 15000K
// [Krystek 1985, "An algorithm to calculate correlated colour temperature"]
float2 PlanckianLocusChromaticity(float temp)
{
    float u = (0.860117757f + 1.54118254e-4f * temp + 1.28641212e-7f * temp * temp) / (1.0f + 8.42420235e-4f * temp + 7.08145163e-7f * temp * temp);
    float v = (0.317398726f + 4.22806245e-5f * temp + 4.20481691e-8f * temp * temp) / (1.0f - 2.89741816e-5f * temp + 1.61456053e-7f * temp * temp);
    float x = 3 * u / (2 * u - 8 * v + 4);
    float y = 2 * v / (2 * u - 8 * v + 4);
    return float2(x, y);
}

// [McCamy 1992, "Correlated color temperature as an explicit function of chromaticity coordinates"]
float2 PlanckianIsothermal(float temp, float tint)
{
    float u = (0.860117757f + 1.54118254e-4f * temp + 1.28641212e-7f * temp * temp) / (1.0f + 8.42420235e-4f * temp + 7.08145163e-7f * temp * temp);
    float v = (0.317398726f + 4.22806245e-5f * temp + 4.20481691e-8f * temp * temp) / (1.0f - 2.89741816e-5f * temp + 1.61456053e-7f * temp * temp);
    float ud = (-1.13758118e9f - 1.91615621e6f * temp - 1.53177f * temp * temp) / Square(1.41213984e6f + 1189.62f * temp + temp * temp);
    float vd = (1.97471536e9f - 705674.0f * temp - 308.607f * temp * temp) / Square(6.19363586e6f - 179.456f * temp + temp * temp);
    float2 uvd = normalize(float2(u, v));
    u += -uvd.y * tint * 0.05f;
    v +=  uvd.x * tint * 0.05f;
    float x = 3 * u / (2 * u - 8 * v + 4);
    float y = 2 * v / (2 * u - 8 * v + 4);
    return float2(x, y);
}

float3 WhiteBalance(float3 linearColor, float correlatedColorTemperature)
{
    float2 srcWhitePointDaylight = IlluminantChromaticity(correlatedColorTemperature);
    float2 srcWhitePointPlankian = PlanckianLocusChromaticity(correlatedColorTemperature);

    float2 whitePoint_src = correlatedColorTemperature < 4000 ? srcWhitePointPlankian : srcWhitePointDaylight;
    float2 whitePoint_D65 = float2(0.31270, 0.32900);

    float2 Isothermal = PlanckianIsothermal(correlatedColorTemperature, 0) - srcWhitePointPlankian;
    whitePoint_src += Isothermal;

    float3x3 chromaticAdaptationMatrix = ChromaticAdaptation(whitePoint_src, whitePoint_D65);
    float3x3 whiteBalanceMatrix = mul(XYZ_2_sRGB_MAT, mul(chromaticAdaptationMatrix, sRGB_2_XYZ_MAT));

    return max(0.0f, mul(whiteBalanceMatrix, linearColor));
}

float4 rgb_to_lmsr(float3 c)
{
    const float4x3 m = float4x3(
        0.31670331, 0.70299344, 0.08120592,
        0.10129085, 0.72118661, 0.12041039,
        0.01451538, 0.05643031, 0.53416779,
        0.01724063, 0.60147464, 0.40056206);
    return mul(m, c);
}

float3 lms_to_rgb(float3 c)
{
    const float3x3 m = float3x3(
         4.57829597, -4.48749114,  0.31554848,
        -0.63342362,  2.03236026, -0.36183302,
        -0.05749394, -0.09275939,  1.90172089);
    return mul(m, c);
}

float3 PurkinjeShift(float3 linearRGB)
{
    // maximal cone sensitivity
    const float3 m = float3(0.63721, 0.39242, 1.6064);
    const float K = 45.0;
    const float S = 10.0;
    const float k3 = 0.6;
    const float k5 = 0.2;
    const float k6 = 0.29;
    const float rw = 0.139;
    const float p = 0.6189;

    float4 lmsr = rgb_to_lmsr(linearRGB);

    float3 g = 1.0 / sqrt(1.0 + (0.33 / m) * (lmsr.xyz + float3(k5, k5, k6) * lmsr.w));

    float rc_gr = (K / S) * ((1.0 + rw * k3) * g.y / m.y - (k3 + rw) * g.x / m.x) * k5 * lmsr.w;
    float rc_by = (K / S) * (k6 * g.z / m.z - k3 * (p * k5 * g.x / m.x + (1.0 - p) * k5 * g.y / m.y)) * lmsr.w;
    float rc_lm = K * (p * g.x / m.x + (1.0 - p) * g.y / m.y) * k5 * lmsr.w;

    float3 lms_gain = float3(-0.5 * rc_gr + 0.5 * rc_lm, 0.5 * rc_gr + 0.5 * rc_lm, rc_by + rc_lm);
    float3 rgb_gain = lms_to_rgb(lms_gain);

    // float4 lmsr = rgb_to_lmsr(linearRGB);
    // float3 lms_gain = rsqrt(1.0f + lmsr.xyz);
    // float3 rgb_gain = lms_to_rgb(lms_gain) * lmsr.w;
    return linearRGB + rgb_gain;
}

[shader("compute")]
[numthreads(8, 8, 8)]
void ColorLUTCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    RWTexture3D<float4> colorLUTTexture = ShaderConstants.GetColorLUTTextureUAV();

    float whiteBalance = frameShaderParameters.whiteBalance;

    uint3 pixelCoord = dispatchThreadID;

    float3 encodedColor = float3(pixelCoord) / float(ColorLUTSize - 1);
    float3 linearColor = LogToLinear(encodedColor.rgb) - LogToLinear(0);

    //linearColor = PurkinjeShift(linearColor);

    linearColor = WhiteBalance(linearColor, whiteBalance);

    const float3x3 sRGB_2_AP1_MAT = mul(XYZ_2_AP1_MAT, mul(D65_2_D60_CAT, sRGB_2_XYZ_MAT));
    const float3x3 AP1_2_sRGB_MAT = mul(XYZ_2_sRGB_MAT, mul(D60_2_D65_CAT, AP1_2_XYZ_MAT));

    float3 acescg = mul(sRGB_2_AP1_MAT, linearColor);

    float3 outputColor = max(0.0f, mul(AP1_2_sRGB_MAT, acescg));

    // uint toneMappingOperator = (uint)(0);
    // if (toneMappingOperator == 0)
    // {
    //     outputColor = saturate(linearColor);
    //     outputColor = GammaCorrection(outputColor);
    // }
    // if (toneMappingOperator == 1)
    {
        // TODO: Middle Gray
        // TODO: Adjustable curve shape
        // TODO: ACES 2.0: RRT+ODT to SSTS
        // https://community.acescentral.com/t/ssts-in-ue4/4117
        // https://gist.github.com/simco50/0479885c946b88d2d271b0c64579d934#file-aces_ssts-hlsl-L1694
        float3 aces = mul(AP1_2_AP0_MAT, acescg);
        float3 oces = RRT(aces);
        float3 odt = ODT_sRGB_100nits_dim(oces);
        outputColor = odt;
    }
    // if (toneMappingOperator == 2)
    // {
    //     acescg = ToneMappingOperatorHable();
    // }
    // if (toneMappingOperator == 3)
    // {
    //     // acescg = ToneMappingOperatorCustom();
    // }

    float4 outColor = float4(outputColor / 1.05, 1.0f);

    colorLUTTexture[pixelCoord] = outColor;
}