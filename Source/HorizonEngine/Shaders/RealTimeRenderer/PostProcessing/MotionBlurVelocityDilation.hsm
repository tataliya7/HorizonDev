#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"
#include "MotionBlurCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(1, VelocityRangeTextureSRV);
SHADER_CONSTANTS_SCALAR(4, uint, ScatterPassIndex);
SHADER_CONSTANTS_STRUCT_END();

static const uint VertexCountPerQuad = 6;

/**
 *  0/3X X X X X 1
 *   X X         X
 *   X   X       X
 *   X     O     X
 *   X       X   X
 *   X         X X
 *   5 X X X X X2/4
 */
static float2 QuadCornerOffsets[6] =
{
    float2(-1.0f, -1.0f),
    float2( 1.0f, -1.0f),
    float2( 1.0f,  1.0f),
    float2(-1.0f, -1.0f),
    float2( 1.0f,  1.0f),
    float2(-1.0f,  1.0f),
};

[shader("vertex")]
void MotionBlurVelocityDilationScatterVS(
    uint vertexID : SV_VertexID,
    uint instanceID : SV_InstanceID,
    out nointerpolation float4 velocity : TEXCOORD0,
    out float4 position : SV_Position)
{
    Texture2D velocityRangeTexture = ShaderConstants.GetVelocityRangeTextureSRV();
    uint scatterPassIndex = ShaderConstants.GetScatterPassIndex();

    uint width, height;
    velocityRangeTexture.GetDimensions(width, height);
    uint totalTileCount = width * height;

    uint quadIndex = instanceID * MOTION_BLUR_VELOCITY_DILATION_QUAD_COUNT_PER_INSTANCE + vertexID / VertexCountPerQuad;
    uint vertexIndex = vertexID % VertexCountPerQuad;

    uint2 pixelCoord = uint2(quadIndex % width, quadIndex / width);
    float2 pixelPosition = float2(pixelCoord) + 0.5f;

    float4 velocityRange = velocityRangeTexture[pixelCoord];
    float2 maxVelocity = velocityRange.zw;

    velocity = velocityRange;

    float maxVelocityLengthSqaure = dot(maxVelocity, maxVelocity);

    // Perform early-exit when the length of velocity is less than or equal to 0.5 tiles.
    bool earlyExit = maxVelocityLengthSqaure <= ((MOTION_BLUR_TILE_SIZE * 0.5f) * (MOTION_BLUR_TILE_SIZE * 0.5f));
    if (earlyExit)
    {
        float2 vertexPosition = pixelPosition + QuadCornerOffsets[vertexIndex] * 0.5f;
        position = float4(vertexPosition.xy / float2(width, height) * 2.0f - 1.0f, 0.0f, 1.0f);
    }
    else
    {
        float maxVelocityLength = sqrt(maxVelocityLengthSqaure);
        float minVelocityLength = length(velocityRange.xy);
        float2 velocityDirection = maxVelocity * rcp(maxVelocityLength);

        float quadBaseExtent = abs(velocityDirection.x) + abs(velocityDirection.y); // dot(abs(velocityDirection), float2(1.0f, 1.0f))
        float2 quadScale = float2(maxVelocityLength, 0.0f) + float2(quadBaseExtent, quadBaseExtent) * 0.99f;
        float2 quadCornerOffset = QuadCornerOffsets[vertexIndex] * quadScale;

        float2 axisX = velocityDirection;
        float2 axisY = float2(-velocityDirection.y, velocityDirection.x);
        quadCornerOffset = axisX * quadCornerOffset.x + axisY * quadCornerOffset.y;

        float2 vertexPosition = pixelPosition + quadCornerOffset;
        position.xy = vertexPosition.xy / float2(width, height) * 2.0f - 1.0f;
        position.z = scatterPassIndex == 0 ? minVelocityLength : maxVelocityLength;
        position.w = 1.0f;
    }
    position.y = -position.y;
}

[shader("pixel")]
void MotionBlurVelocityDilationScatterPS(
    nointerpolation float4 input : TEXCOORD0,
    out float4 output : SV_Target0)
{
    output = input;
}