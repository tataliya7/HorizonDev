#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameData, PerFrameData);
BIND_TEXTURE_2D_SRV(1, InputTexture1);
BIND_TEXTURE_2D_SRV(2, InputTexture2);
BIND_TEXTURE_2D_SRV(3, InputTexture3);
BIND_TEXTURE_2D_UAV(4, float4, OutputTexture);

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_COUNT_X, POST_PROCESSING_THREAD_GROUP_COUNT_Y, 1)]
void LocalExposureBlendLaplacianCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    RWTexture2D<float4> outputTexture = GetOutputTextureUAV();
    uint width, height;
    outputTexture.GetDimensions(width, height);
    if (DispatchThreadID.x >= width || DispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = DispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5) / float2(width, height);

    Texture2D inputTexture1 = GetInputTexture1SRV();
    Texture2D inputTexture2 = GetInputTexture2SRV();
    Texture2D inputTexture3 = GetInputTexture3SRV();

    float srcMip = SHADER_ARGUMENTS_DATA(0);

    float boostLocalContrast = 1;

    // Blend the Laplacians based on exposure weights.
    float accumSoFar = inputTexture3.SampleLevel(GlobalSamplerLinearClamp, uv, srcMip).x;
    float3 laplacians = inputTexture1.SampleLevel(GlobalSamplerLinearClamp, uv, srcMip - 1).xyz - inputTexture1.SampleLevel(GlobalSamplerLinearClamp, uv, srcMip - 1).xyz;
    float3 weights = inputTexture2.SampleLevel(GlobalSamplerLinearClamp, uv, srcMip - 1).xyz * (boostLocalContrast > 0.0 ? abs(laplacians) + 0.00001 : 1.0);
    weights /= dot(weights, 1.0) + 0.00001;
    float laplac = dot(laplacians * weights, 1.0);

    float3 r = accumSoFar + laplac;
    outputTexture[pixelCoord] = float4(r, 1.0);
}
