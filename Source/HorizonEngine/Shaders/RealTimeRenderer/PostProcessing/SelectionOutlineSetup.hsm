#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"
#include "SelectionOutlineCommon.hsh"

BIND_BYTE_ADDRESS_BUFFER_SRV(0, PerFrameDataBuffer);
BIND_TEXTURE_2D_SRV(1, InputTexture);
BIND_TEXTURE_2D_UAV(2, float4, OutputTexture);

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void SelectionOutlineSetupCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    ByteAddressBuffer perFrameDataBuffer = GetPerFrameDataBufferSRV();
    PerFrameShaderParameters perFrameParameters = perFrameDataBuffer.Load<PerFrameShaderParameters>(0);
    uint2 pixelCoord = DispatchThreadID.xy;
    uint width = perFrameParameters.targetWidth;
    uint height = perFrameParameters.targetHeight;
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    Texture2D inputTexture = GetInputTextureSRV();
    RWTexture2D<float4> outputTexture = GetOutputTextureUAV();

    float mask = inputTexture[pixelCoord].r;

    if (mask < 0.99) // exterior
    {
        outputTexture[pixelCoord] = float4(
            SELECTION_OUTLINE_JUMP_FLOOD_INVALID_VALUE,
            SELECTION_OUTLINE_JUMP_FLOOD_INVALID_VALUE,
            SELECTION_OUTLINE_JUMP_FLOOD_INVALID_VALUE,
            mask);
        return;
    }

    float2 invSize = perFrameParameters.targetResolution.zw;
    float2 uv = (pixelCoord + 0.5f) * invSize;
    outputTexture[pixelCoord] = float4(uv, 0, mask);
}