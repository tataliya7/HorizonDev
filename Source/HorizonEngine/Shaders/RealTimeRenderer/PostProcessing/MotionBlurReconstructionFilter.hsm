#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"
#include "MotionBlurCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_TEXTURE_2D_SRV(1, SceneColorTexture);
BIND_TEXTURE_2D_SRV(2, VelocityAndDepthTexture);
BIND_TEXTURE_2D_SRV(3, DilatedVelocityRangeTexture);
BIND_TEXTURE_2D_UAV(4, float3, OutputTexture);

[shader("compute")]
[numthreads(MOTION_BLUR_TILE_SIZE, MOTION_BLUR_TILE_SIZE, 1)]
void MotionBlurReconstructionFilterCS(uint3 DispatchThreadID : SV_DispatchThreadID, uint3 GroupID : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
    Texture2D sceneColorTexture = GetSceneColorTextureSRV();
    Texture2D velocityAndDepthTexture = GetVelocityAndDepthTextureSRV();
    Texture2D dilatedVelocityRangeTexture = GetDilatedVelocityRangeTextureSRV();
    RWTexture2D<float3> outputTexture = GetOutputTextureUAV();

    uint2 pixelCoord = DispatchThreadID.xy;

    float4 sceneColor = sceneColorTexture[pixelCoord];
    float3 encodedVelocityAndDepth = velocityAndDepthTexture[pixelCoord].xyz;
    float4 velocityRange = dilatedVelocityRangeTexture[pixelCoord];

    outputTexture[pixelCoord] = sceneColor.rgb;
}