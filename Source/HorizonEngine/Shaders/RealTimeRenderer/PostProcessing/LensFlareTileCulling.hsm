#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

BIND_TEXTURE_2D_SRV(0, InputTexture);
BIND_TEXTURE_2D_UAV(1, float3, OutputTexture);

static const float2 LensFlareTileCullingSampleOffsets[5] = {
    float2(-1, -1),
    float2( 1, -1),
    float2( 0,  0),
    float2(-1,  1),
    float2( 1,  1)
};

static const float LensFlareTileCullingSampleWeights[5] = {
    0.175f,
    0.175f,
    0.3f,
    0.175f,
    0.175f
};

[shader("compute")]
[numthreads(POST_PROCESSING_THREAD_GROUP_SIZE_X, POST_PROCESSING_THREAD_GROUP_SIZE_Y, 1)]
void LensFlareTileCullingCS(uint2 DispatchThreadID : SV_DispatchThreadID)
{
    Texture2D inputTexture = GetInputTextureSRV();
    RWTexture2D<float3> outputTexture = GetOutputTextureUAV();

    uint inputTextureWidth, inputTextureHeight;
    inputTexture.GetDimensions(inputTextureWidth, inputTextureHeight);
    float2 inputeTextureInvSize = 1.0f / float2(inputTextureWidth, inputTextureHeight);

    uint2 tileID = DispatchThreadID.xy;
    uint2 centerPixelCoord = tileID * 2 + 1;
    float2 centerUV = float2(centerPixelCoord) * inputeTextureInvSize;

    float3 color = 0.0f;
    [unroll]
    for (uint sampleIndex = 0; sampleIndex < 5; sampleIndex++)
    {
#if 1
        float2 sampleUV = centerUV + LensFlareTileCullingSampleOffsets[sampleIndex] * inputeTextureInvSize;
        color += LensFlareTileCullingSampleWeights[sampleIndex] * inputTexture.SampleLevel(GlobalSamplerLinearBorder, sampleUV, 0).rgb;
#else
        color += LensFlareTileCullingSampleWeights[sampleIndex] * inputTexture.SampleLevel(GlobalSamplerLinearBorder, centerUV, 0, LensFlareTileCullingSampleOffsets[sampleIndex]).rgb;
#endif
    }
    //float luminance = dot(color, 1.0f);

    //outputTexture[tileID] = luminance;
    outputTexture[tileID] = color;
}
