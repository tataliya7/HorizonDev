#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "GPUScene.hsh"

#if INDIRECT_ARGUMENT_INITIALIZATION

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(0, ArgumentBuffer0UAV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(1, ArgumentBuffer1UAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(1, 1, 1)]
void IndirectArgumentInitializationCS()
{
    RWByteAddressBuffer argumentBuffer0 = ShaderConstants.GetArgumentBuffer0UAV();
    RWByteAddressBuffer argumentBuffer1 = ShaderConstants.GetArgumentBuffer1UAV();

    argumentBuffer0.Store<uint>(0 * sizeof(uint), 0);
    argumentBuffer0.Store<uint>(1 * sizeof(uint), 1);
    argumentBuffer0.Store<uint>(2 * sizeof(uint), 1);

    argumentBuffer1.Store<uint>(0 * sizeof(uint), GPU_SCENE_INDEX_COUNT_PER_MESHLET);
    argumentBuffer1.Store<uint>(1 * sizeof(uint), 0);
    argumentBuffer1.Store<uint>(2 * sizeof(uint), 0);
    argumentBuffer1.Store<uint>(3 * sizeof(uint), 0);
}

#endif

#if INSTANCE_CULLING

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(1, GeometryDataBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(2, GeometryInstanceDataBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(3, MeshletCullingArgumentBufferUAV);
SHADER_CONSTANTS_SCALAR(4, uint, GeometryInstanceCount);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(64, 1, 1)]
void InstanceCullingCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    const uint geometryInstanceID = dispatchThreadID.x;
    const uint geometryInstanceCount = ShaderConstants.GetGeometryInstanceCount();

    if (geometryInstanceID >= geometryInstanceCount)
    {
        return;
    }

    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    ByteAddressBuffer geometryDataBuffer = ShaderConstants.GetGeometryDataBufferSRV();
    ByteAddressBuffer geometryInstanceDataBuffer = ShaderConstants.GetGeometryInstanceDataBufferSRV();

    GPUSceneGeometryInstanceData geometryInstanceData = GetGPUSceneGeometryInstanceData(geometryInstanceDataBuffer, geometryInstanceID);
    GPUSceneGeometryData geometryData = GetGPUSceneGeometryData(geometryDataBuffer, geometryInstanceData.geometryID);

    if (true)
    {
        RWByteAddressBuffer argumentBuffer = ShaderConstants.GetMeshletCullingArgumentBufferUAV();

        uint meshletCount = (geometryData.indexCount + GPU_SCENE_INDEX_COUNT_PER_MESHLET - 1) / GPU_SCENE_INDEX_COUNT_PER_MESHLET;

        uint unused;
        argumentBuffer.InterlockedAdd(0, (meshletCount + 64 - 1) / 64, unused);
    }
}

#endif

#if MESHLET_CULLING

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(1, GeometryDataBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(2, GeometryInstanceDataBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(3, VisibileMeshletBufferUAV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(4, VisibileMeshletCounterBufferUAV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(5, DrawIndirectArgumentBufferUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(64, 1, 1)]
void MeshletCullingCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    ByteAddressBuffer geometryDataBuffer = ShaderConstants.GetGeometryDataBufferSRV();
    ByteAddressBuffer geometryInstanceDataBuffer = ShaderConstants.GetGeometryInstanceDataBufferSRV();
    RWByteAddressBuffer visibileMeshletBuffer = ShaderConstants.GetVisibileMeshletBufferUAV();
    RWByteAddressBuffer visibileMeshletCounterBuffer = ShaderConstants.GetVisibileMeshletCounterBufferUAV();
    RWByteAddressBuffer drawIndirectArgumentBuffer = ShaderConstants.GetDrawIndirectArgumentBufferUAV();

    const uint candidateVisibleMeshlet = dispatchThreadID.x;
    const uint geometryInstanceID = 0;

    if  (candidateVisibleMeshlet >= 2623)
    {
        return;
    }

    GPUSceneGeometryInstanceData geometryInstanceData = GetGPUSceneGeometryInstanceData(geometryInstanceDataBuffer, geometryInstanceID);
    GPUSceneGeometryData geometryData = GetGPUSceneGeometryData(geometryDataBuffer, geometryInstanceData.geometryID);
    GPUSceneMeshletData meshletData = GetGPUSceneMeshletData(geometryData, candidateVisibleMeshlet);

    VisibleMeshletEntry visibleMeshlet;
    visibleMeshlet.geometryInstanceID = geometryInstanceID;
    visibleMeshlet.meshletID = candidateVisibleMeshlet;

    if (true)
    {
        uint visibleMeshletIndex;
        visibileMeshletCounterBuffer.InterlockedAdd(0, 1, visibleMeshletIndex);

        visibileMeshletBuffer.Store<VisibleMeshletEntry>(visibleMeshletIndex * sizeof(VisibleMeshletEntry), visibleMeshlet);

        uint originVisibleMeshletCount;
        drawIndirectArgumentBuffer.InterlockedAdd(sizeof(uint), 1, originVisibleMeshletCount);
    }
}

#endif