#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "VirtualShadowMapCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, VirtualShadowMapShaderParameters, VirtualShadowMapShaderParameterBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(1, VirtualShadowMapActivePhysicalPageIndexBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_ARRAY_UAV(2, uint, VirtualShadowMapDepthTextureUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(1, 128, 1)]
void VirtualShadowMapClearPhysicalMemoryCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<VirtualShadowMapShaderParameters> virtualShadowMapShaderParameterBuffer = ShaderConstants.GetVirtualShadowMapShaderParameterBufferSRV();
    ByteAddressBuffer virtualShadowMapActivePhysicalPageIndexBuffer = ShaderConstants.GetVirtualShadowMapActivePhysicalPageIndexBufferSRV();
    RWTexture2DArray<uint> virtualShadowMapDepthTexture = ShaderConstants.GetVirtualShadowMapDepthTextureUAV();
    VirtualShadowMapShaderParameters virtualShadowMapShaderParameters = virtualShadowMapShaderParameterBuffer[0];

    uint physicalPageIndex = virtualShadowMapActivePhysicalPageIndexBuffer.Load<uint>(dispatchThreadID.x / 32 * sizeof(uint));

    uint2 physicalPageCoordinate2D = uint2(physicalPageIndex % 128, physicalPageIndex / 128);
    uint3 basePhysicalAddress = uint3(physicalPageCoordinate2D * 128, 0);

    uint x = (dispatchThreadID.x % 32) * 4;
    uint y = dispatchThreadID.y;

    virtualShadowMapDepthTexture[basePhysicalAddress + uint3(x + 0, y, 0)] = 0;
    virtualShadowMapDepthTexture[basePhysicalAddress + uint3(x + 1, y, 0)] = 0;
    virtualShadowMapDepthTexture[basePhysicalAddress + uint3(x + 2, y, 0)] = 0;
    virtualShadowMapDepthTexture[basePhysicalAddress + uint3(x + 3, y, 0)] = 0;
}