#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "VirtualShadowMapCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, VirtualShadowMapShaderParameters, VirtualShadowMapShaderParameterBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(1, VirtualShadowMapPageRequestBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(2, VirtualShadowMapPhysicalPageListBufferUAV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(3, VirtualShadowMapPageTableBufferUAV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(4, VirtualShadowMapPhysicalPageDataBufferUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(64, 1, 1)]
void VirtualShadowMapPhysicalPageAllocationCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<VirtualShadowMapShaderParameters> virtualShadowMapShaderParameterBuffer = ShaderConstants.GetVirtualShadowMapShaderParameterBufferSRV();
    ByteAddressBuffer virtualShadowMapPageRequestBuffer = ShaderConstants.GetVirtualShadowMapPageRequestBufferSRV();
    RWByteAddressBuffer virtualShadowMapPhysicalPageListBuffer = ShaderConstants.GetVirtualShadowMapPhysicalPageListBufferUAV();
    RWByteAddressBuffer virtualShadowMapPageTableBuffer = ShaderConstants.GetVirtualShadowMapPageTableBufferUAV();
    RWByteAddressBuffer virtualShadowMapPhysicalPageDataBuffer = ShaderConstants.GetVirtualShadowMapPhysicalPageDataBufferUAV();
    VirtualShadowMapShaderParameters virtualShadowMapShaderParameters = virtualShadowMapShaderParameterBuffer[0];

    uint globalPageIndex = dispatchThreadID.x;

    if (globalPageIndex >= virtualShadowMapShaderParameters.physicalPageCount)
    {
        return;
    }

    uint requestPage = virtualShadowMapPageRequestBuffer.Load<uint>(globalPageIndex * sizeof(uint));

    if (requestPage != 0)
    {
        // @todo Use wave operations.
        uint physicalPageIndex = 0;
        virtualShadowMapPhysicalPageListBuffer.InterlockedAdd(0, 1, physicalPageIndex);

        //if (physicalPageIndex >= 0) // @todo
        {
            VirtualShadowMapPageTableEntry pageTableEntry;
            pageTableEntry.physicalPageAddress = PhysicalPageIndexToPhysicalPageAddress(physicalPageIndex);
            pageTableEntry.valid = true;

            uint encodedPageTableEntry = EncodePageTableEntry(pageTableEntry);

            virtualShadowMapPageTableBuffer.Store<uint>(globalPageIndex * sizeof(uint), encodedPageTableEntry);

            VirtualShadowMapPhysicalPageData physicalPageData;
            physicalPageData.flags |= VIRTUAL_SHADOW_MAP_PHYSICAL_PAGE_DATA_FLAG_BIT_USED;

            virtualShadowMapPhysicalPageDataBuffer.Store<VirtualShadowMapPhysicalPageData>(physicalPageIndex * sizeof(uint), physicalPageData);
        }
    }
}