#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "VirtualShadowMapCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, VirtualShadowMapShaderParameters, VirtualShadowMapShaderParameterBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_UAV(1, VirtualShadowMapPageTableBufferUAV);
SHADER_CONSTANTS_STRUCT_END();

[shader("compute")]
[numthreads(64, 1, 1)]
void VirtualShadowMapClearPageTableCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    StructuredBuffer<VirtualShadowMapShaderParameters> virtualShadowMapShaderParameterBuffer = ShaderConstants.GetVirtualShadowMapShaderParameterBufferSRV();
    RWByteAddressBuffer virtualShadowMapPageTableBuffer = ShaderConstants.GetVirtualShadowMapPageTableBufferUAV();
    VirtualShadowMapShaderParameters virtualShadowMapShaderParameters = virtualShadowMapShaderParameterBuffer[0];

    uint globalVirtualPageIndex = dispatchThreadID.x;
    if (globalVirtualPageIndex >= virtualShadowMapShaderParameters.maximumVirtualPageCount)
    {
        return;
    }

    VirtualShadowMapPageTableEntry pageTableEntry;
    pageTableEntry.physicalPageAddress = 0;
    pageTableEntry.valid = false;

    uint encodedPageTableEntry = EncodePageTableEntry(pageTableEntry);

    virtualShadowMapPageTableBuffer.Store<uint>(globalVirtualPageIndex * sizeof(uint), encodedPageTableEntry);
}