#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "LocalFogVolumeCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferSRV);
SHADER_CONSTANTS_STRUCTURED_BUFFER_SRV(1, LocalFogVolumeInstanceData, LocalFogVolumeInstanceDataBufferSRV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, DepthTextureSRV);
SHADER_CONSTANTS_STRUCT_END();

static float3 CubeVertices[8] =
{
    float3( 0.5f,  0.5f,  0.5f),
    float3(-0.5f,  0.5f,  0.5f),
    float3(-0.5f, -0.5f,  0.5f),
    float3( 0.5f, -0.5f,  0.5f),
    float3( 0.5f, -0.5f, -0.5f),
    float3( 0.5f,  0.5f, -0.5f),
    float3(-0.5f,  0.5f, -0.5f),
    float3(-0.5f, -0.5f, -0.5f)
};

static uint CubeIndices[36] =
{
    0, 1, 2, 0, 2, 3,
    0, 3, 4, 0, 4, 5,
    0, 5, 6, 0, 6, 1,
    1, 6, 7, 1, 7, 2,
    7, 4, 3, 7, 3, 2,
    4, 7, 6, 4, 6, 5
};

struct LocalFogVolumeVSOutput
{
    nointerpolation uint instanceID : TEXCOORD0;
};

[shader("vertex")]
void LocalFogVolumeVS(
    in uint vertexID : SV_VertexID,
    in uint instanceID : SV_InstanceID,
    out LocalFogVolumeVSOutput output,
    out float4 position : SV_Position)
{
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];

    StructuredBuffer<LocalFogVolumeInstanceData> localFogVolumeInstanceDataBuffer = ShaderConstants.GetLocalFogVolumeInstanceDataBufferSRV();
    LocalFogVolumeInstanceData instanceData = localFogVolumeInstanceDataBuffer.Load(instanceID);

    uint vertexIndex = CubeIndices[vertexID];
    float3 vertexPosition = CubeVertices[vertexIndex];

    float3 worldSpaceVertexPosition = mul(instanceData.localToWorldMatrix, float4(vertexPosition, 1.0f)).xyz;
    float4 clipSpaceVertexPosition = mul(frameShaderParameters.worldToClipMatrix, float4(worldSpaceVertexPosition, 1.0f));

    output.instanceID = instanceID;
    position = clipSpaceVertexPosition;
}

[shader("pixel")]
void LocalFogVolumePS(
    in LocalFogVolumeVSOutput input,
    in float4 position : SV_Position,
    out float4 outputColor : SV_Target0)
{
    uint instanceID = input.instanceID;
    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];

    StructuredBuffer<LocalFogVolumeInstanceData> localFogVolumeInstanceDataBuffer = ShaderConstants.GetLocalFogVolumeInstanceDataBufferSRV();
    LocalFogVolumeInstanceData instanceData = localFogVolumeInstanceDataBuffer.Load(instanceID);

    Texture2D depthTexture = ShaderConstants.GetDepthTextureSRV();

    const uint2 pixelCoord = uint2(position.xy);
    const float2 uv = (float2(pixelCoord) + 0.5f) / float2(frameShaderParameters.renderWidth, frameShaderParameters.renderHeight);

    float depth = depthTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;
    float3 worldSpacePosition = ReconstructWorldSpacePositionFromUVZ(uv, depth, frameShaderParameters.clipToWorldMatrix);

    outputColor = float4(instanceData.emission, 1.0f);
}