#pragma once

struct GPUSceneGeometryData
{
    int vertexBuffer0;
    int vertexBuffer1;
    int vertexBuffer2;
    int vertexBuffer3;
    int previousVertexBuffer0;
    int indexBuffer;
    int materialBuffer;
    int materialIndexBuffer;
    uint vertexCount;
    uint indexCount;
};

GPUSceneGeometryData GetGPUSceneGeometryData(ByteAddressBuffer geometryBuffer, uint geometryID)
{
    GPUSceneGeometryData geometryData = (GPUSceneGeometryData)0;

    uint offset = geometryID * sizeof(GPUSceneGeometryData);
    geometryData = geometryBuffer.Load<GPUSceneGeometryData>(offset);

    return geometryData;
}

struct GPUSceneGeometryInstanceData
{
    float4x4 localToWorldMatrix;
    float4x4 worldToLocalMatrix;
    float4x4 previousLocalToWorldMatrix;
    float4x4 previousWorldToLocalMatrix;
    uint geometryID;
};

GPUSceneGeometryInstanceData GetGPUSceneGeometryInstanceData(ByteAddressBuffer geometryInstanceBuffer, uint instanceID)
{
    GPUSceneGeometryInstanceData instanceData = (GPUSceneGeometryInstanceData)0;

    uint offset = instanceID * sizeof(GPUSceneGeometryInstanceData);
    instanceData = geometryInstanceBuffer.Load<GPUSceneGeometryInstanceData>(offset);

    return instanceData;
}