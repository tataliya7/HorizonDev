#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "ShadowMapCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_BYTE_ADDRESS_BUFFER_SRV(1, Geometry, Geometry);
BIND_BYTE_ADDRESS_BUFFER_SRV(2, MaterialBuffer);
BIND_BYTE_ADDRESS_BUFFER_SRV(3, CascadedShadowMapShaderParameters, CascadedShadowMapShaderParameters);
BIND_BYTE_ADDRESS_BUFFER_SRV(4, CubeShadowMapShaderParameters, CubeShadowMapShaderParameters);

struct ShadowMapVSToPS
{
    float4 svPosition : SV_Position;
    float2 texCoord0 : TEXCOORD0;
};

[shader("vertex")]
void ShadowMapVS(uint vertexIndex : SV_VertexID, out ShadowMapVSToPS output)
{
    ConstantBuffer<PerFrameShaderParameters> frameShaderParameters = GetPerFrameShaderParameterBufferCBV();
    Geometry geometry = GetGeometry();

    float3 vertexPosition = GetRWByteAddressBuffer(geometry.vertexBuffer0).Load<float3>(vertexIndex * sizeof(float3));
    float3 vertexNormal = GetRWByteAddressBuffer(geometry.vertexBuffer1).Load<float3>(vertexIndex * sizeof(float3));
    float2 vertexTexCoord0 = GetRWByteAddressBuffer(geometry.vertexBuffer3).Load<float2>(vertexIndex * sizeof(float2));

    float4x4 worldTransform = GetRWByteAddressBuffer(geometry.transformBuffer).Load<float4x4>(geometry.transformIndex * sizeof(float4x4));
    float3 worldPosition = mul(worldTransform, float4(vertexPosition, 1.0)).xyz;
    float3 worldNormal = normalize(mul((float3x3)worldTransform, vertexNormal));

    CascadedShadowMapShaderParameters shadowMapShaderParameters = GetCascadedShadowMapShaderParameters();
    float cascadeIndex = (0);
    float4x4 worldToClipMatrix = shadowMapShaderParameters.worldToClipMatrix[cascadeIndex];

    output.svPosition = mul(worldToClipMatrix, float4(worldPosition, 1.0));
    output.texCoord0 = vertexTexCoord0;
}

[shader("pixel")]
void ShadowMapPS(in ShadowMapVSToPS input, in uint primitiveID : SV_PrimitiveID)
{
    ConstantBuffer<PerFrameShaderParameters> frameShaderParameters = GetPerFrameShaderParameterBufferCBV();
    Geometry geometry = GetGeometry();

    float2 texCoord0 = input.texCoord0;

    ByteAddressBuffer materialBuffer = GetMaterialBufferSRV();
    ByteAddressBuffer materialIndexBuffer = GetByteAddressBuffer(geometry.materialIndexBuffer);

    uint materialIndex = materialIndexBuffer.Load<uint>(primitiveID * sizeof(uint));
    Material material = materialBuffer.Load<Material>(geometry.materialBufferOffset + (materialIndex * sizeof(Material)));

    float4 baseColor = material.baseColor;
    if (material.GetBaseColorMapIndex() > 0)
    {
        Texture2D baseColorMap = GetBindlessResourceTexture2D(material.GetBaseColorMapIndex());
        baseColor = baseColorMap.Sample(GlobalSamplerLinearWarp, texCoord0);
    }

    float alphaCutoff = 0.2;
    clip(baseColor.a - alphaCutoff);
}
