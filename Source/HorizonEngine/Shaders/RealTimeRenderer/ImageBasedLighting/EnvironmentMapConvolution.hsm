#include "../../ShaderCommon.hsh"
#include "../../BRDFCommon.hsh"
#include "../../Random.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_TEXTURE_CUBE_DEFAULT_SRV(0, EnvironmentMapTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_ARRAY_UAV(1, float4, ConvolvedEnvironmentMapTextureUAV);
SHADER_CONSTANTS_SCALAR(2, float, Roughness);
SHADER_CONSTANTS_STRUCT_END();

// Based on https://placeholderart.wordpress.com/2015/07/28/implementation-notes-runtime-environment-map-filtering-for-image-based-lighting/
float3 ConvolveEnvironmentMap(TextureCube environmentMapTexture, float3 N, float roughness, uint numSamples)
{
    float3 R = N;
    float3 V = R;

    float3x3 TBN = CreateTangentSpaceBasis(N);

    // Solid angle of 1 pixel across all cube faces
    uint cubemapSize = 32;

    // Convolve environment map using GGX NDF importance sampling
    float weight = 0.0f;
    float3 radiance = 0.0f;
    for (uint i = 0; i < numSamples; i++)
    {
        float2 lowDiscrepancyPoint2D = HammersleySequence2D(i, numSamples);
        float3 H = TangentToWorld(ImportanceSampleGGX(lowDiscrepancyPoint2D, roughness), TBN);
        float3 L = normalize(2.0f * dot(V, H) * H - V);

        float NdotL = dot(N, L);
        if (NdotL > 0.0f)
        {
            float NdotH = max(1e-8, dot(N, H));
            float VdotH = max(1e-8, dot(V, H));

            // Probability Distribution Function
            float pdf = D_GGX(NdotH, roughness) * NdotH / (4.0f * VdotH) + 0.00001f;

            // Solid angle of current sample
            float omegaS = 1.0f / (float(numSamples) * pdf);
            float omegaP = 4.0f * PI / (6.0f * cubemapSize * cubemapSize);

            float mipLevel = 0.5f * log2(omegaS / omegaP);

            float3 color = environmentMapTexture.SampleLevel(GlobalSamplerLinearWarp, L, mipLevel).rgb;

            radiance += color * NdotL;
            weight   += NdotL;
        }
    }

    return radiance / weight;
}

[shader("compute")]
[numthreads(8, 8, 6)]
void EnvironmentMapConvolutionCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RWTexture2DArray<float4> convolvedEnvironmentMapTexture = ShaderConstants.GetConvolvedEnvironmentMapTextureUAV();

    uint width, height, faces;
    convolvedEnvironmentMapTexture.GetDimensions(width, height, faces);
    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    uint3 coord = dispatchThreadID;
    float2 uv = (float2(coord.xy) + 0.5f) / float2(width, height);
    float3 N = CalculateCubemapVector(uv, coord.z);

    TextureCube environmentMapTexture = ShaderConstants.GetEnvironmentMapTextureSRV();
    float roughness = ShaderConstants.GetRoughness();

    if (roughness < 0.01f)
    {
        convolvedEnvironmentMapTexture[coord] = environmentMapTexture.SampleLevel(GlobalSamplerLinearWarp, N, 0);
        return;
    }

    const uint sampleCount = 256;
    //const uint sampleCount = roughness < 0.1 ? 32 : 64;

    float3 result = ConvolveEnvironmentMap(environmentMapTexture, N, roughness, sampleCount);

    convolvedEnvironmentMapTexture[coord] = float4(result, 1.0f);
}