#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"

const static uint TASK_SHADER_WORKGROUP_SIZE = 32; // Assumes availability of wave size of 32 threads

BIND_BYTE_ADDRESS_BUFFER_SRV(0, PerFrameDataBuffer);
BIND_BYTE_ADDRESS_BUFFER_SRV(1, GeometryDataBuffer);
BIND_BYTE_ADDRESS_BUFFER_SRV(2, MeshletDescBuffer);

struct MeshPayload
{
    uint meshletIndices[TASK_SHADER_WORKGROUP_SIZE];
};

struct MeshletDesc
{
    uint vertexCount;
    uint vertexOffset;
    uint triangleCount;
    uint indexOffset;
    uint geometryIndex;
};

struct VertexAttributes
{
    float4 position : SV_Position;
};

struct PrimitiveAttributes
{
    // x: meshlet index, y: triangle index, z: unused, w: unused
    nointerpolation uint4 packedData : TEXCOORD0;
};

#if __SHADER_TARGET_STAGE == __SHADER_STAGE_AMPLIFICATION
groupshared MeshPayload SharedPayload;
#endif

MeshletDesc GetMeshletDesc(ByteAddressBuffer meshletDescBuffer, uint meshletIndex)
{
    //MeshletDesc meshletDesc = meshletDescBuffer.Load<MeshletDesc>(meshletIndex * sizeof(MeshletDesc));
    MeshletDesc meshletDesc;
    return meshletDesc;
}

