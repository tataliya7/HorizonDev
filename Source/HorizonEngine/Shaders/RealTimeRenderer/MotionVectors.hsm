#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_BYTE_ADDRESS_BUFFER_SRV(1, GeometryBuffer);
BIND_TEXTURE_2D_TYPED_SRV(2, uint2, VisibilityBuffer);
BIND_TEXTURE_2D_UAV(3, float2, MotionVectors);

inline float3 BarycentricInterpolation(in float3 a0, in float3 a1, in float3 a2, in float3 bary)
{
    return mad(a0, bary.z, mad(a1, bary.x, a2 * bary.y));
}

float3 RayTriangleIntersectionBarycentrics3D(float3 rayOrigin, float3 rayDirection, float3 v0, float3 v1, float3 v2, out float t)
{
    float3 v0v1 = v1 - v0;
    float3 v0v2 = v2 - v0;
    float3 pvec = cross(rayDirection, v0v2);
    float det = dot(v0v1, pvec);
    det = det > 0.0 ? max(0.0000001, det) : min(-0.0000001, det);
    float det_rcp = 1.0 / det;//rcp(det);
    float3 tvec = rayOrigin - v0;
    float3 qvec = cross(tvec, v0v1);
    float u = dot(tvec, pvec) * det_rcp;
    float v = dot(rayDirection, qvec) * det_rcp;
    t = dot(v0v2, qvec) * det_rcp;
    return float3(u, v, 1.0 - u - v);
}

[shader("compute")]
[numthreads(8, 8, 1)]
void MotionVectorsCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    ConstantBuffer<PerFrameShaderParameters> perFrameConstants = GetPerFrameShaderParametersCBV();
    uint width = perFrameConstants.renderWidth;
    uint height = perFrameConstants.renderHeight;
    if (DispatchThreadID.x >= width || DispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = DispatchThreadID.xy;
    float2 invSize = perFrameConstants.renderResolution.zw;
    float2 uv = (pixelCoord + 0.5f) * invSize;
    float2 jitteredUV = (pixelCoord + 0.5f + perFrameConstants.cameraJitterOffset) * invSize;

    // TODO: move this to per frame shader paramters
    float2 motionVectorJitterCancellation = perFrameConstants.previousCameraJitterOffset - perFrameConstants.cameraJitterOffset;
    // Transform to screen UV space
    motionVectorJitterCancellation = motionVectorJitterCancellation * invSize;

    Texture2D<uint2> visibilityBuffer = GetVisibilityBufferSRV();

    uint2 visibilityID = visibilityBuffer[pixelCoord];
    uint geometryID = visibilityID.r;
    uint primitiveID = visibilityID.g;

    float4 unprojected = mul(perFrameConstants.clipToWorldMatrix, float4(uv_to_clipspace(uv), 0.0, 1.0));
    unprojected.xyz /= unprojected.w;
    float3 cameraRayOrigin = perFrameConstants.cameraPosition;
    float3 cameraRayDirection = normalize(unprojected.xyz - cameraRayOrigin);

    float3 hitPointPrevWorldPosition;

#if 0
    [branch]
    if (visibilityID.x != INVALID_VISIBILIY_ID)
    {
        ByteAddressBuffer geometryBuffer = GetGeometryBufferSRV();
        Geometry geometry = geometryBuffer.Load<Geometry>(geometryID * sizeof(Geometry));

        uint index0 = GetRWByteAddressBuffer(geometry.indexBuffer).Load<uint>((geometry.baseIndex + primitiveID * 3 + 0) * sizeof(uint));
        uint index1 = GetRWByteAddressBuffer(geometry.indexBuffer).Load<uint>((geometry.baseIndex + primitiveID * 3 + 1) * sizeof(uint));
        uint index2 = GetRWByteAddressBuffer(geometry.indexBuffer).Load<uint>((geometry.baseIndex + primitiveID * 3 + 2) * sizeof(uint));

        float3 vertex0 = GetRWByteAddressBuffer(geometry.vertexBuffer0).Load<float3>(index0 * sizeof(float3));
        float3 vertex1 = GetRWByteAddressBuffer(geometry.vertexBuffer0).Load<float3>(index1 * sizeof(float3));
        float3 vertex2 = GetRWByteAddressBuffer(geometry.vertexBuffer0).Load<float3>(index2 * sizeof(float3));

        float4x4 worldTransform = GetRWByteAddressBuffer(geometry.transformBuffer).Load<float4x4>(geometry.transformIndex * sizeof(float4x4));
        float4x4 prevWorldTransform = (geometry.previousTransformIndex >= 0) ? GetRWByteAddressBuffer(geometry.previousTransformBuffer).Load<float4x4>(geometry.previousTransformIndex * sizeof(float4x4)) : worldTransform;

        float3 worldPosition0 = mul(worldTransform, float4(vertex0, 1.0)).xyz;
        float3 worldPosition1 = mul(worldTransform, float4(vertex1, 1.0)).xyz;
        float3 worldPosition2 = mul(worldTransform, float4(vertex2, 1.0)).xyz;

        float t = 0.0;
        float3 bary = RayTriangleIntersectionBarycentrics3D(cameraRayOrigin, cameraRayDirection, worldPosition0, worldPosition1, worldPosition2, t);

        float3 prevVertex0 = vertex0;
        float3 prevVertex1 = vertex1;
        float3 prevVertex2 = vertex2;

        if (geometry.prevVertexBuffer0 >= 0) // Skinned mesh
        {
            prevVertex0 = GetRWByteAddressBuffer(geometry.prevVertexBuffer0).Load<float3>((geometry.baseVertex + index0) * sizeof(float3));
            prevVertex1 = GetRWByteAddressBuffer(geometry.prevVertexBuffer0).Load<float3>((geometry.baseVertex + index1) * sizeof(float3));
            prevVertex2 = GetRWByteAddressBuffer(geometry.prevVertexBuffer0).Load<float3>((geometry.baseVertex + index2) * sizeof(float3));
        }

        float3 prevWorldPosition0 = mul(prevWorldTransform, float4(prevVertex0, 1.0)).xyz;
        float3 prevWorldPosition1 = mul(prevWorldTransform, float4(prevVertex1, 1.0)).xyz;
        float3 prevWorldPosition2 = mul(prevWorldTransform, float4(prevVertex2, 1.0)).xyz;

        hitPointPrevWorldPosition = BarycentricInterpolation(prevWorldPosition0, prevWorldPosition1, prevWorldPosition2, bary);

        // RWTexture2D<float4> motionVectors = GetMotionVectorsUAV();
        // float3 curw = cameraRayOrigin + t * cameraRayDirection;
        // motionVectors[pixelCoord] = float4(curw, t);
        // return;

        RWTexture2D<float2> motionVectors = GetMotionVectorsUAV();
        float2 currPosition = uv;
        float4 prevClipPosition = mul(perFrameConstants.previousWorldToClipMatrix, float4(hitPointPrevWorldPosition, 1.0));
        float2 prevPosition = clipspace_to_uv(prevClipPosition.xy / prevClipPosition.w);
        float2 motionVector = prevPosition - currPosition;
        motionVector -= motionVectorJitterCancellation;
        if (isnan(motionVector.x) || isnan(motionVector.y))
        {
            // motionVector = float2(1.0, 1.0);
            motionVector = 0;
        }
        motionVectors[pixelCoord] = motionVector;
    }
    else
#endif
    {
        // -0.01 to prevent division by zero in perspective division
        hitPointPrevWorldPosition = cameraRayOrigin + cameraRayDirection * (perFrameConstants.farClippingPlane - 0.0001f);
        hitPointPrevWorldPosition = hitPointPrevWorldPosition - perFrameConstants.cameraPosition + perFrameConstants.previousCameraPosition;
        RWTexture2D<float2> motionVectors = GetMotionVectorsUAV();
        float2 currPosition = uv;
        float4 prevClipPosition = mul(perFrameConstants.previousWorldToClipMatrix, float4(hitPointPrevWorldPosition, 1.0f));
        float2 prevPosition = clipspace_to_uv(prevClipPosition.xy / prevClipPosition.w);
        float2 motionVector = prevPosition - currPosition;
        motionVector -= motionVectorJitterCancellation;
        if (isnan(motionVector.x) || isnan(motionVector.y))
        {
            motionVector = 0;
        }
        motionVectors[pixelCoord] = motionVector;

        // RWTexture2D<float2> motionVectors = GetMotionVectorsUAV();
        // motionVectors[pixelCoord] = float2(0.0, 0.0);
    }
}
