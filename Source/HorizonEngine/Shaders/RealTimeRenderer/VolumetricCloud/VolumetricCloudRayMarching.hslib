
BIND_TEXTURE_2D_SRV(2, CloudMap);

float GetNormalizedHeightInCloudLayer(float3 worldSpacePosition, float minAltitude, float maxAltitude)
{

    float height_fraction = (worldSpacePosition.z - minAltitude) / (maxAltitude - minAltitude);
    return saturate(height_fraction);
}

float3 SampleCloudMap(float3 worldSpacePosition)
{
    Texture2D cloudMap = GetCloudMapSRV();
    float2 uv = ;

    return cloudMap.SampleLevel(GlobalSamplerLinearWarp, uv, 0).rgb;
}

