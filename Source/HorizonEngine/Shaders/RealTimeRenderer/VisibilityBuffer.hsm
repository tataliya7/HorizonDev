#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "GPUScene.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_CONSTANT_BUFFER_CBV(0, PerFrameShaderParameters, PerFrameShaderParameterBufferCBV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(1, GeometryDataBufferSRV);
SHADER_CONSTANTS_BYTE_ADDRESS_BUFFER_SRV(2, GeometryInstanceDataBufferSRV);
SHADER_CONSTANTS_STRUCT_END();

struct VisibilityBufferVextexShaderOutput
{
    float2 textureCoord0 : TEXCOORD0;
};

[shader("vertex")]
void VisibilityBufferVS(
    in uint vertexID : SV_VertexID,
    in uint instanceID : SV_InstanceID,
    out float4 position : SV_Position,
    out VisibilityBufferVextexShaderOutput output)
{
    ConstantBuffer<PerFrameShaderParameters> frameShaderParameters = ShaderConstants.GetPerFrameShaderParameterBufferCBV();
    ByteAddressBuffer geometryDataBuffer = ShaderConstants.GetGeometryDataBufferSRV();
    ByteAddressBuffer geometryInstanceDataBuffer = ShaderConstants.GetGeometryInstanceDataBufferSRV();

    GPUSceneGeometryInstanceData instanceData = GetGPUSceneGeometryInstanceData(geometryInstanceDataBuffer, 0);
    GPUSceneGeometryData geometryData = GetGPUSceneGeometryData(geometryDataBuffer, instanceData.geometryID);

    VertexAttributes vertexAttributes = GetVertexAttributes(geometryData, vertexID);

    float3 worldSpaceVertexPosition = mul(instanceData.localToWorldMatrix, float4(vertexAttributes.position, 1.0f)).xyz;
    float4 clipSpaceVertexPosition = mul(frameShaderParameters.worldToClipMatrix, float4(worldSpaceVertexPosition, 1.0f));

    position = clipSpaceVertexPosition;

    output.textureCoord0 = vertexAttributes.textureCoord0;
}

// TODO: Turning on [earlydepthstencil] will cause alpha cutoff to work inproperly
// [earlydepthstencil]

[shader("pixel")]
void VisibilityBufferPS(
