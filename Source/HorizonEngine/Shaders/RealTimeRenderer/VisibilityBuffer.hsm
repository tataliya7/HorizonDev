    ByteAddressBuffer vertexBuffer0 = GetByteAddressBuffer(geometryData.vertexBuffer0);

    uint vertexIndex0 = indexBuffer.Load<uint>((/*geometryData.baseIndex + */primitiveID * 3 + 0) * sizeof(uint));
    uint vertexIndex1 = indexBuffer.Load<uint>((/*geometryData.baseIndex + */primitiveID * 3 + 1) * sizeof(uint));
    uint vertexIndex2 = indexBuffer.Load<uint>((/*geometryData.baseIndex + */primitiveID * 3 + 2) * sizeof(uint));

    float3 vertexPosition0 = vertexBuffer0.Load<float3>(vertexIndex0 * sizeof(float3));
    float3 vertexPosition1 = vertexBuffer0.Load<float3>(vertexIndex1 * sizeof(float3));
    float3 vertexPosition2 = vertexBuffer0.Load<float3>(vertexIndex2 * sizeof(float3));

    float3 worldSpaceVertexPosition0 = mul(instanceData.localToWorldMatrix, float4(vertexPosition0, 1.0f)).xyz;
    float3 worldSpaceVertexPosition1 = mul(instanceData.localToWorldMatrix, float4(vertexPosition1, 1.0f)).xyz;
    float3 worldSpaceVertexPosition2 = mul(instanceData.localToWorldMatrix, float4(vertexPosition2, 1.0f)).xyz;

    float4 clipSpaceVertexPosition0 = mul(frameShaderParameters.worldToClipMatrix, float4(worldSpaceVertexPosition0, 1.0f));
    float4 clipSpaceVertexPosition1 = mul(frameShaderParameters.worldToClipMatrix, float4(worldSpaceVertexPosition1, 1.0f));
    float4 clipSpaceVertexPosition2 = mul(frameShaderParameters.worldToClipMatrix, float4(worldSpaceVertexPosition2, 1.0f));

    float2 uv = position.xy * frameShaderParameters.renderResolution.zw;
    float3 perspectiveCorrectBarycentrics = CalculatePerspectiveCorrectBarycentric(clipSpaceVertexPosition0, clipSpaceVertexPosition1, clipSpaceVertexPosition2, UVSpaceToClipSpace(uv));
#endif
#endif

    // float2 vertexTexCoord0 = GetRWByteAddressBuffer(geometry.vertexBuffer3).Load<float2>((primitiveID * 3 + 0) * sizeof(float2));
