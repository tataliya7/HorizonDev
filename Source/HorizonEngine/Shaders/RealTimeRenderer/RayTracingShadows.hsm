#include "../ShaderCommon.hsh"
#include "../Random.hsh"
#include "RealTimeRendererCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_TLAS_SRV(1, TopLevelAS);
BIND_TEXTURE_2D_SRV(2, SceneDepth);
BIND_TEXTURE_2D_UAV(3, float, ShadowMask);
BIND_TEXTURE_2D_UAV(4, float, RayDistance);

struct ShadowRayPayload
{
    float visibility;
};

float3 UniformSampleCone(float2 randVal, float cosThetaMax)
{
    float cosTheta = (1.0 - randVal.x) + randVal.x * cosThetaMax;
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
    float phi = randVal.y * 2.0 * PI;
    return float3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}

[shader("raygeneration")]
void RayTracingShadowsRayGen()
{
    uint3 launchIndex = DispatchRaysIndex();
    uint3 launchDimensions = DispatchRaysDimensions();

    StructuredBuffer<PerFrameShaderParameters> frameShaderParameterBuffer = ShaderConstants.GetPerFrameShaderParameterBufferSRV();
    PerFrameShaderParameters frameShaderParameters = frameShaderParameterBuffer[0];
    Texture2D sceneDepth = GetSceneDepthSRV();
    RWTexture2D<float> shadowMask = GetShadowMaskUAV();
    RWTexture2D<float> rayDistance = GetRayDistanceUAV();

    RaytracingAccelerationStructure topLevelAS = GetTopLevelAS();

    const uint2 pixelCoord = launchIndex.xy;

    // Skip background pixels
    const float depth = sceneDepth[pixelCoord].r;
    if (depth == FarClipPlaneDepthValue)
    {
        shadowMask[pixelCoord] = 1.0;
        rayDistance[pixelCoord] = -1.0;
        return;
    }

    // Reconstruct world position from the depth buffer
    float2 pixelCenter = pixelCoord + 0.5;
    float2 uv = pixelCenter / float2(launchDimensions.xy);
    float3 worldSpacePosition = ReconstructWorldSpacePositionFromDepth(uv, depth, frameShaderParameters.clipToWorldMatrix);

    uint randSeed = RandInit(launchIndex.x + launchIndex.y * launchDimensions.x, frameShaderParameters.frameIndex);

    float cosThetaMax = 0.999;
    // Generate a random direction based on the cone angle.
    // @see UniformSampleCone in [pbrt]
    float3 randDirection = UniformSampleCone(float2(Rand(randSeed), Rand(randSeed)), cosThetaMax);

    float3 N = -normalize(float3((0), (1), (2)));
    //float3 N = -frameShaderParameters.sunDirection;
    //float3 B = GetPerpendicularVector(N);
    //float3 T = cross(B, N);

    float3 T; float3 B;
    CreateOrthonormalBasis(T, B, N);

    float3x3 TBN = float3x3(T, B, N);
    TBN = transpose(TBN);
    randDirection = mul(TBN, randDirection);
    //randDirection = N;

    // Prepare a shadow ray.
    RayDesc ray;
    ray.Origin = worldSpacePosition.xyz;
    ray.Direction = randDirection;
    ray.TMin = 0.01;
    ray.TMax = 10000.0;

    uint rayFlags = RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_SKIP_CLOSEST_HIT_SHADER;

    ShadowRayPayload payload;
    payload.visibility = 0.0;

    TraceRay(
        topLevelAS,
        rayFlags,
        0xff,
        0,
        0,
        0,
        ray,
        payload);

    shadowMask[pixelCoord] = payload.visibility;
}

[shader("miss")]
void RayTracingShadowsMiss(inout ShadowRayPayload payload : SV_RayPayload)
{
    payload.visibility = 1.0;
}