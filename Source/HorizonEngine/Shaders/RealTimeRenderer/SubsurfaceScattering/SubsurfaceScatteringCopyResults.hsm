#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "SubsurfaceScatteringCommon.hsh"

BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_BYTE_ADDRESS_BUFFER_SRV(1, SubsurfaceScatteringTileDataBuffer);
BIND_TEXTURE_2D_SRV(2, SubsurfaceScatteringTexture);

struct SubsurfaceScatteringCopyResultsVSOutput
{
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
};

[shader("vertex")]
void SubsurfaceScatteringCopyResultsVS(uint VertexID : SV_VertexID, uint InstanceID : SV_InstanceID, out SubsurfaceScatteringCopyResultsVSOutput vsOutput)
{
    ConstantBuffer<PerFrameShaderParameters> perFrameConstants = GetPerFrameShaderParametersCBV();
    ByteAddressBuffer tileDataBuffer = GetSubsurfaceScatteringTileDataBufferSRV();

    uint2 tileIndex = tileDataBuffer.Load<uint2>(InstanceID * sizeof(uint2));
    uint2 vertexPosition = tileIndex * SUBSURFACE_SCATTERING_TILE_SIZE + SubsurfaceScatteringTileVertexPositionOffets[VertexID];

    vsOutput.uv = float2(vertexPosition) * perFrameConstants.renderResolution.zw;
    vsOutput.position = float4(UVSpaceToClipSpace(vsOutput.uv), 0.0f, 1.0f);
}

[shader("pixel")]
void SubsurfaceScatteringCopyResultsPS(SubsurfaceScatteringCopyResultsVSOutput vsOutput, out float4 outColor : SV_Target0)
{
    Texture2D subsurfaceScatteringTexture = GetSubsurfaceScatteringTextureSRV();

    const float2 uv = vsOutput.uv;

    outColor = subsurfaceScatteringTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0.0f);
}