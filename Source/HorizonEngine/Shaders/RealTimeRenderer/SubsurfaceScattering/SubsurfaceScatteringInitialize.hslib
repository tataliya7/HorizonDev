#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "SubsurfaceScatteringCommon.hsh"

BIND_BYTE_ADDRESS_BUFFER_UAV(0, SubsurfaceScatteringTileCountBuffer);

[shader("compute")]
[numthreads(1, 1, 1)]
void SubsurfaceScatteringInitializeCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RWByteAddressBuffer tileCountBuffer = GetSubsurfaceScatteringTileCountBufferUAV();
    tileCountBuffer.Store<uint>(0, 0);
}