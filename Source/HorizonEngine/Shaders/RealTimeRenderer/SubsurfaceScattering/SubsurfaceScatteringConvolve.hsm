BIND_BUFFER_CBV(0, PerFrameShaderParameters);
BIND_TEXTURE_2D_SRV(1, SceneColorTexture);
BIND_TEXTURE_2D_SRV(2, SceneDepthTexture);
BIND_TEXTURE_2D_SRV(3, GBuffer0);
BIND_BYTE_ADDRESS_BUFFER_UAV(3, SubsurfaceScatteringTileCountBuffer);
BIND_BYTE_ADDRESS_BUFFER_SRV(1, SubsurfaceScatteringTileDataBuffer);
BIND_TEXTURE_2D_UAV(5, float4, OutputTexture);

struct SubsurfaceScatteringSample
{
	float radius; // expressed in millimeters
	float pdf;
	float cosTheta;
	float sinTheta;
};

[shader("compute")]
[numthreads(SUBSURFACE_SCATTERING_TILE_SIZE * SUBSURFACE_SCATTERING_TILE_SIZE, 1, 1)]
void SubsurfaceScatteringConvolveCS(uint3 GroupID : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
    // PerFrameShaderParameters perFrameConstants = perFrameDataBuffer.Load<PerFrameShaderParameters>(0);
    // Texture2D gbuffer0 = GetGBuffer0SRV();
    // ByteAddressBuffer tileDataBuffer = GetSubsurfaceScatteringTileDataBufferSRV();
    // RWTexture2D<float4> outputTexture = GetOutputTextureUAV();

    // uint width, height;
    // outputTexture.GetDimensions(width, height);

    // uint2 tileIndex = tileDataBuffer.Load<uint2>(GroupID * sizeof(uint2));
    uint2 pixelCoord = tileIndex * uint2(SUBSURFACE_SCATTERING_TILE_SIZE, SUBSURFACE_SCATTERING_TILE_SIZE) + uint2(GroupIndex / 8, GroupIndex % 8);
    float2 centerUV = (pixelCoord + 0.5f) * perFrameConstants.renderResolution.zw;

    // if (pixelCoord.x >= width || pixelCoord.y >= height)
    // {
    //     return;
    // }

    // float3 worldSpaceNormal = DecodeNormalFromONV(gbuffer0.SampleLevel(GlobalSamplerPointClamp, uv, 0).xy);

    uint sampleCount = 32; // TODO
    // sampleCount = clamp(sampleCount, 8, SUBSURFACE_SCATTERING_MAX_SAMPLE_COUNT);
    float oneOverSampleCount = 1.0f / float(sampleCount);

    float3 totalWeight = 0.0f;
    float3 totalIrradiance = 0.0f;

    // Monte carlo integration
    // Perform disk sampling in the screen space (the disk is parallel to the screen plane).
    for (uint sampleIndex = 0; sampleIndex < numSamples; sampleIndex++)
    {
        float2 uvOffset =  * float2(cosTheta, sinTheta);

        float2 sampleUV = centerUV + uvOffset;

        float4 irradianceAndDepth = ;

        float3 irradiance = irradianceAndDepth.rgb;

    //     float mipLevel = 0;

    //     burleySample = 0;

    //     float3 sampleWorldSpaceNormal = DecodeNormalFromONV(gbuffer0.SampleLevel(GlobalSamplerPointClamp, sampleUV, 0).xy);
    //     float normalWeight = sqrt(saturate(dot(sampleWorldSpaceNormal, worldSpaceNormal) * 0.5 + 0.5));

        float3 rR = ComputeBurleyNormalizedDiffusionProfile(BurleyParameter.DiffuseMeanFreePath.xyz, S3D.xyz, RadiusSampledInMM);
        float3 weight = rR / pdf;

        totalWeight += weight;
        totalIrradiance += weight * irradiance;
    }

    // TODO: energy conservation
    float3 irradiance = totalIrradiance * select(totalWeight == 0.0f, 0.0f, 1.0f / totalWeight);
    // //radiance = select(weightSum == 0, 0, radiance / weightSum);
    // radiance *= invNumSamples;

    // outputTexture[pixelCoord] = float4(radiance, float(numSamples));
}