#include "../../ShaderCommon.hsh"
#include "../RealTimeRendererCommon.hsh"
#include "SubsurfaceScatteringCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameData, PerFrameData);
BIND_BYTE_ADDRESS_BUFFER_SRV(1, SubsurfaceScatteringTileDataBuffer);
BIND_TEXTURE_2D_SRV(2, SceneColorTexture);
BIND_TEXTURE_2D_SRV(3, BurleyNormalizedTexture);

struct SubsurfaceScatteringRecombineVSOutput
{
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
};

[shader("vertex")]
void SubsurfaceScatteringRecombineVS(uint VertexID : SV_VertexID, uint InstanceID : SV_InstanceID, out SubsurfaceScatteringRecombineVSOutput output)
{
    PerFrameData perFrameData = GetPerFrameData();
    ByteAddressBuffer tileDataBuffer = GetSubsurfaceScatteringTileDataBufferSRV();

    uint2 tileIndex = tileDataBuffer.Load<uint2>(InstanceID * sizeof(uint2));
    uint2 vertexPosition = tileIndex * SUBSURFACE_SCATTERING_TILE_SIZE + SubsurfaceScatteringTileVertexPositionOffets[VertexID];

    output.position = float4(output.uv * float2(2.0f, -2.0f) + float2(-1.0, 1.0f), 0.0f, 1.0f);
    output.uv = float2(vertexPosition) * perFrameData.renderResolution.zw;
}

[shader("pixel")]
void SubsurfaceScatteringRecombinePS(SubsurfaceScatteringRecombineVSOutput vsOutput, out float4 outColor : SV_Target0)
{
    Texture2D sceneColorTexture = GetSceneColorTextureSRV();
    Texture2D burleyNormalizedTexture = GetBurleyNormalizedTextureSRV();

    float2 uv = vsOutput.uv;

    float4 sceneColor = sceneColorTexture.SampleLevel(GlobalSamplerPointBorder, uv, 0);

    bool useSubsurfaceScattering = true;
    if (!useSubsurfaceScattering)
    {
        outColor = sceneColor;
        return;
    }

    float3 subsurfaceScatteringColor = burleyNormalizedTexture.SampleLevel(GlobalSamplerPointBorder, uv, 0).rgb;

    SubsurfaceScatteringDiffuseAndSpecluar diffuseAndSpecluar = ReconstructDiffuseAndSpecluar(sceneColor.rgb, sceneColor.a);

    outColor = float4(subsurfaceScatteringColor * baseColor + diffuseAndSpecluar.specular, 0.0f);
}
