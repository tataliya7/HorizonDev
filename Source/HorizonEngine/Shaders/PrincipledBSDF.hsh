#pragma once

#include "BRDFCommon.hsh"

float SchlickFresnel(float u)
{
    float m = saturate(1 - u);
    float m2 = m * m;
    return m2 * m2 * m; // pow(m, 5)
}

float GTR1(float NdotH, float a)
{
    if (a >= 1) return 1/M_PI;
    float a2 = a*a;
    float t = 1 + (a2-1)*NdotH*NdotH;
    return (a2-1) / (M_PI*log(a2)*t);
}

float GTR2(float NdotH, float a)
{
    float a2 = a*a;
    float t = 1 + (a2-1)*NdotH*NdotH;
    return a2 / (M_PI * t*t);
}

float GTR2_aniso(float NdotH, float HdotX, float HdotY, float ax, float ay)
{
    return 1 / (M_PI * ax*ay * sqr( sqr(HdotX/ax) + sqr(HdotY/ay) + NdotH*NdotH ));
}

float smithG_GGX(float NdotV, float alphaG)
{
    float a = alphaG*alphaG;
    float b = NdotV*NdotV;
    return 1 / (NdotV + sqrt(a + b - a*b));
}

float smithG_GGX_aniso(float NdotV, float VdotX, float VdotY, float ax, float ay)
{
    return 1 / (NdotV + sqrt( sqr(VdotX*ax) + sqr(VdotY*ay) + sqr(NdotV) ));
}

float3 mon2lin(float3 x)
{
    return float3(pow(x.x, 2.2), pow(x.y, 2.2), pow(x.z, 2.2));
}

float3 PrincipledBSDF(
    float3 L, float3 V, float3 N,
    float4 baseColor,
    float metallic,
    float roughness,
    float subsurface,
    float specular,
    float specularTint,
    float anisotropic,
    float sheen,
    float sheenTint,
    float clearcoat,
    float clearcoatGloss)
{
    metallic = saturate(metallic);
    roughness = saturate(roughness);
    //ior = max(ior, 1e-5);

    float3 X;
    float3 Y;
    BuildOrthonormalBasis(N, X, Y);

    float NdotL = dot(N, L);
    float NdotV = dot(N, V);
    if (NdotL < 0.0f || NdotV < 0.0f)
    {
        return float3(0.0f, 0.0f, 0.0f);
    }

    float3 H = normalize(L + V);
    float NdotH = dot(N, H);
    float LdotH = dot(L, H);
    float FH = SchlickFresnel(LdotH);

#if 1
    float3 Cdlin = baseColor.rgb;
#else
    float3 Cdlin = mon2lin(baseColor.rgb);
#endif
    float Cdlum = 0.3f * Cdlin.x + 0.6f * Cdlin.y  + 0.1f * Cdlin.z; // luminance approx.

    float3 Ctint = Cdlum > 0.0f ? Cdlin / Cdlum : float3(1.0f, 1.0f, 1.0f); // normalize lum. to isolate hue+sat

    // Sheen
    float3 sheenTerm = float3(0.0f, 0.0f, 0.0f);
    if (sheen > 0.0f)
    {
        float3 sheenColor = lerp(float3(1.0f, 1.0f, 1.0f), Ctint, sheenTint);
        sheenTerm = FH * sheen * sheenColor;
    }

    // Clearcoat (ior = 1.5 -> F0 = 0.04)
    float clearcoatTerm = 0.0f;
    if (clearcoat > 0.0f)
    {
        float Dr = GTR1(NdotH, lerp(0.1f, 0.001f, clearcoatGloss));
        float Fr = lerp(0.04f, 1.0f, FH);
        float Gr = smithG_GGX(NdotL, 0.25f) * smithG_GGX(NdotV, 0.25f);
        clearcoatTerm = 0.25f * clearcoat * Gr * Fr * Dr;
    }

    // Diffuse fresnel - go from 1 at normal incidence to 0.5 at grazing
    // and mix in diffuse retro-reflection based on roughness
    float FL = SchlickFresnel(NdotL);
    float FV = SchlickFresnel(NdotV);
    float Fd90 = 0.5f + 2.0f * LdotH * LdotH * roughness;
    float Fd = lerp(1.0f, Fd90, FL) * lerp(1.0f, Fd90, FV);

    // Based on Hanrahan-Krueger brdf approximation of isotropic bssrdf
    // 1.25 scale is used to (roughly) preserve albedo
    // Fss90 used to "flatten" retroreflection based on roughness
    float Fss90 = LdotH * LdotH * roughness;
    float Fss = lerp(1.0f, Fss90, FL) * lerp(1.0f, Fss90, FV);
    float ss = 1.25f * (Fss * (1.0f / (NdotL + NdotV) - 0.5f) + 0.5f);

    // Specular
    float3 Cspec0 = lerp(specular * 0.08f * lerp(float3(1.0f, 1.0f, 1.0f), Ctint, specularTint), Cdlin, metallic);
    float aspect = sqrt(1.0f - anisotropic * 0.9f);
    float ax = max(0.001f, sqr(roughness) / aspect);
    float ay = max(0.001f, sqr(roughness) * aspect);
    float Ds = GTR2_aniso(NdotH, dot(H, X), dot(H, Y), ax, ay);
    float3 Fs = lerp(Cspec0, float3(1.0f, 1.0f, 1.0f), FH);
    float Gs;
    Gs  = smithG_GGX_aniso(NdotL, dot(L, X), dot(L, Y), ax, ay);
    Gs *= smithG_GGX_aniso(NdotV, dot(V, X), dot(V, Y), ax, ay);

    return (INV_PI * lerp(Fd, ss, subsurface) * baseColor.rgb + sheenTerm)
        * (1.0f - metallic)
        + Gs * Fs * Ds + clearcoatTerm;
}

float EvalPrincipledBSDFDiffusePdf(float NdotL)
{
    if (NdotL <= 0.0) return 0.0;
    return NdotL * INV_PI;
}

float EvalPrincipledBSDFSpecularPdf(float NdotH, float VdotH, float roughness)
{
    if (NdotH <= 0.0 || VdotH <= 0.0) return 0.0;
    float alpha = max(roughness * roughness, 1e-4);
    float D = GTR2(NdotH, alpha);
    return D * NdotH / max(4.0 * VdotH, 1e-6);
}

float3 SamplePrincipledBSDFDiffuse(float2 Xi, float3 N, out float pdf)
{
    float3 localDir = CosineSampleHemisphere(Xi);
    float3 T, B;
    BuildOrthonormalBasis(N, T, B);
    float3 L = T * localDir.x + B * localDir.y + N * localDir.z;
    float NdotL = dot(N, L);
    pdf = EvalPrincipledBSDFDiffusePdf(max(NdotL, 0.0));
    return L;
}

float3 SamplePrincipledBSDFSpecular(float2 Xi, float3 V, float3 N, float roughness, out float pdf)
{
    float3 H = ImportanceSampleGGX(Xi, roughness);
    float3 T, B;
    BuildOrthonormalBasis(N, T, B);
    H = normalize(T * H.x + B * H.y + N * H.z);
    float3 L = reflect(-V, H);
    float NdotL = dot(N, L);
    float NdotH = saturate(dot(N, H));
    float VdotH = saturate(dot(V, H));
    if (NdotL <= 0.0)
    {
        pdf = 0.0;
        return L;
    }
    pdf = EvalPrincipledBSDFSpecularPdf(NdotH, VdotH, roughness);
    return L;
}

float3 SamplePrincipledBSDF(float2 Xi, float3 V, float3 N, float roughness, float metallic, out float pdf)
{
    metallic = saturate(metallic);
    roughness = max(roughness, 0.001);
    if (Xi.x < metallic)
    {
        float rXi = Xi.x / max(metallic, 1e-6);
        float2 remappedXi = float2(rXi, Xi.y);
        float specularPdf;
        float3 L = SamplePrincipledBSDFSpecular(remappedXi, V, N, roughness, specularPdf);
        pdf = specularPdf * metallic;
        return L;
    }
    else
    {
        float rXi = (Xi.x - metallic) / max(1.0 - metallic, 1e-6);
        float2 remappedXi = float2(rXi, Xi.y);
        float diffusePdf;
        float3 L = SamplePrincipledBSDFDiffuse(remappedXi, N, diffusePdf);
        pdf = diffusePdf * (1.0 - metallic);
        return L;
    }
}

float EvalPrincipledBSDF_PDF(float3 L, float3 V, float3 N, float roughness, float metallic)
{
    metallic = saturate(metallic);
    roughness = max(roughness, 0.001);
    float NdotL = saturate(dot(N, L));
    if (NdotL <= 0.0) return 0.0;
    float3 H = normalize(L + V);
    float NdotH = saturate(dot(N, H));
    float VdotH = saturate(dot(V, H));
    float specularPdf = EvalPrincipledBSDFSpecularPdf(NdotH, VdotH, roughness);
    float diffusePdf = EvalPrincipledBSDFDiffusePdf(NdotL);
    return specularPdf * metallic + diffusePdf * (1.0 - metallic);
}