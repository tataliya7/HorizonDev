#include "ShaderCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(0, InputTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(1, float4, OutputTextureUAV);
SHADER_CONSTANTS_SCALAR(2, uint, SourceMipLevel);
SHADER_CONSTANTS_SCALAR(3, float, DstWidth);
SHADER_CONSTANTS_SCALAR(4, float, DstHeight);
SHADER_CONSTANTS_STRUCT_END();

#if __SHADER_TARGET_STAGE == __SHADER_STAGE_COMPUTE

[shader("compute")]
[numthreads(8, 8, 1)]
void DownsampleTexture2DCS(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    RWTexture2D<float4> outputTexture = ShaderConstants.GetOutputTextureUAV();

    uint width, height;
    outputTexture.GetDimensions(width, height);
    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
    {
        return;
    }

    uint2 coord = dispatchThreadID.xy;
    float2 uv = (coord.xy + 0.5f) / float2(width, height);
    uint sourceMipLevel = ShaderConstants.GetSourceMipLevel();

    Texture2D inputTexture = ShaderConstants.GetInputTextureSRV();
    float4 color = inputTexture.SampleLevel(GlobalSamplerLinearWarp, uv, sourceMipLevel);

    outputTexture[coord] = color;
}
#else

[shader("vertex")]
void DownsampleTexture2DVS(uint vertexID : SV_VertexID, out float4 outPosition : SV_Position)
{
    outPosition = float4(float2((vertexID << 1) & 2, vertexID & 2) * 2.0f - 1.0f, 0.0f, 1.0f);
}

[shader("pixel")]
void DownsampleTexture2DPS(float4 position : SV_Position, out float4 outColor : SV_Target0)
{
    uint sourceMipLevel = ShaderConstants.GetSourceMipLevel();
    float width = ShaderConstants.GetDstWidth();
    float height = ShaderConstants.GetDstHeight();

    float2 uv = position.xy / float2(width, height);

    Texture2D inputTexture = ShaderConstants.GetInputTextureSRV();
    outColor = inputTexture.SampleLevel(GlobalSamplerLinearWarp, uv, sourceMipLevel);
}
#endif