#include "ShaderCommon.hsh"

BIND_TEXTURE_2D_SRV(0, InputTexture);
#if __SHADER_TARGET_STAGE == __SHADER_STAGE_COMPUTE
BIND_TEXTURE_2D_UAV(1, float4, OutputMip);
#endif

[shader("compute")]
[numthreads(8, 8, 1)]
void DownsampleTexture2DCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    RWTexture2D<float4> outputMip = GetOutputMipUAV();

    uint width, height;
    outputMip.GetDimensions(width, height);
    if (DispatchThreadID.x >= width || DispatchThreadID.y >= height)
    {
        return;
    }

    uint2 coord = DispatchThreadID.xy;
    float2 uv = (coord.xy + 0.5f) / float2(width, height);
    uint sourceMipLevel = (uint)SHADER_ARGUMENTS_DATA(0);

    Texture2D inputTexture = GetInputTextureSRV();
    float4 color = inputTexture.SampleLevel(GlobalSamplerLinearWarp, uv, sourceMipLevel);

    outputMip[coord] = color;
}

[shader("vertex")]
void DownsampleTexture2DVS(uint vertexID : SV_VertexID, out float4 outPosition : SV_Position)
{
    outPosition = float4(float2((vertexID << 1) & 2, vertexID & 2) * 2.0f - 1.0f, 0.0f, 1.0f);
}

[shader("pixel")]
void DownsampleTexture2DPS(float4 position : SV_Position, out float4 outColor : SV_Target0)
{
    uint sourceMipLevel = (uint)SHADER_ARGUMENTS_DATA(0);
    float width = SHADER_ARGUMENTS_DATA(1);
    float height = SHADER_ARGUMENTS_DATA(2);

    float2 uv = position.xy / float2(width, height);

    Texture2D inputTexture = GetInputTextureSRV();
    outColor = inputTexture.SampleLevel(GlobalSamplerLinearWarp, uv, sourceMipLevel);
}