#include "ShaderCommon.hsh"

#define Complex float2

#define TWO_FOR_ONE 0

#define SIGNAL_LENGTH 1024
#define RADIX 8

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(0, InputTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_UAV(1, float4, OutputTextureUAV);
SHADER_CONSTANTS_TEXTURE_2D_DEFAULT_SRV(2, KernelTextureSRV);
SHADER_CONSTANTS_STRUCT_END();

groupshared float2 v[SIGNAL_LENGTH];

Complex ComplexMultiply(in Complex z1, in Complex z2)
{
    return Complex(z1.x * z2.x - z1.y * z2.y, z1.x * z2.y + z1.y * z2.x);
}

Complex ComplexConjugate(in Complex z)
{
    return Complex(z.x, -z.y);
}

int Expand(int idxL, int N1, int N2)
{
    return (idxL / N1) * N1 * N2 + (idxL % N1);
}

