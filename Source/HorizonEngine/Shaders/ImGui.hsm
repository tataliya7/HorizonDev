#define TEST_BINDLESS 1

#include "ShaderCommon.hsh"

#if TEST_BINDLESS
struct ImGuiShaderArguments
{
    int indices[16];
    float2 scale;
    float2 translate;
    int vertexOffset;
};
PUSH_CONSTANT(ImGuiShaderArguments, ShaderArguments);
#define SHADER_ARGUMENTS_INDEX(slot) ShaderArguments.indices[slot]
#endif

struct ImGuiVertex
{
    float2 position;
    float2 uv;
    uint color;
};

BIND_TEXTURE_2D_SRV(0, ImGuiTexture);
BIND_STRUCTURED_BUFFER_SRV(1, ImGuiVertex, VertexBuffer);

struct ImGuiVSOutput
{
    float4 position : SV_Position;
    float4 color : COLOR0;
    float2 texCoord0 : TEXCOORD0;
};

[shader("vertex")]
void ImGuiVS(uint vertexID : SV_VertexID, out ImGuiVSOutput output)
{
    int vertexOffset = ShaderArguments.vertexOffset;
    float2 scale = ShaderArguments.scale;
    float2 translate = ShaderArguments.translate;

    StructuredBuffer<ImGuiVertex> vertexBuffer = GetVertexBufferSRV();
    ImGuiVertex vertex = vertexBuffer.Load(vertexOffset + vertexID);

    uint4 packedColor = uint4(vertex.color & 0xff, (vertex.color >> 8) & 0xff, (vertex.color >> 16) & 0xff, (vertex.color >> 24) & 0xff);

    output.color = float4(packedColor) / 255.0f;
    output.texCoord0 = vertex.uv;
    output.position = float4(vertex.position * scale + translate, 0.0f, 1.0f);
}

[shader("pixel")]
void ImGuiPS(ImGuiVSOutput input, out float4 color : SV_Target)
{
    Texture2D texture = GetImGuiTextureSRV();
    color = input.color * texture.SampleLevel(GlobalSamplerLinearWarp, input.texCoord0, 0);
}