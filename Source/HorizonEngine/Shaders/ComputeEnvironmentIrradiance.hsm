#include "ShaderCommon.hsh"
#include "BRDFCommon.hsh"

BIND_TEXTURE_CUBE_SRV(0, EnvironmentMap);
BIND_TEXTURE_2D_ARRAY_UAV(1, float4, IrradianceEnvironmentMap);

static const uint NumSamples = 1024;

[shader("compute")]
[numthreads(8, 8, 6)]
void ComputeEnvironmentIrradianceCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    RWTexture2DArray<float4> irradianceEnvironmentMap = GetIrradianceEnvironmentMapUAV();

    uint width, height, faces;
    irradianceEnvironmentMap.GetDimensions(width, height, faces);
    if (DispatchThreadID.x >= width || DispatchThreadID.y >= height)
    {
        return;
    }

    uint3 coord = DispatchThreadID;
    float2 uv = (coord.xy + 0.5) / float2(width, height);

    float3 N = CalculateCubemapVector(uv, coord.z);
    float3 T;
    float3 B;
    CreateOrthonormalBasis(T, B, N);

    TextureCube environmentMap = GetEnvironmentMapSRV();
    uint environmentMapMipLevel = (uint)SHADER_ARGUMENTS_DATA(0);

    // Monte carlo integration of hemispherical irradiance
    float3 irradiance = 0.0;
    for (uint i = 0; i < NumSamples; i++)
    {
        float2 Xi = Hammersley2D(i, NumSamples);
        float3 L = TangentToWorld(UniformSampleHemisphere(Xi), T, B, N);
        float NdotL = dot(N, L);
        if (NdotL > 0.0)
        {
            irradiance += environmentMap.SampleLevel(GlobalSamplerLinearWarp, L, environmentMapMipLevel).rgb * NdotL;
        }
    }

    // pdf = 1.0 / (2.0 * PI)
    irradiance = irradiance * 2.0 * PI / float(NumSamples);

    irradianceEnvironmentMap[coord] = float4(irradiance, 1.0);
}
