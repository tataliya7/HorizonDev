#include "ShaderCommon.hsh"
#include "BRDFCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_TEXTURE_CUBE_DEFAULT_SRV(0, EnvironmentMapTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_ARRAY_UAV(1, float4, IrradianceEnvironmentMapTextureUAV);
SHADER_CONSTANTS_SCALAR(2, uint, SourceMipLevel);
SHADER_CONSTANTS_STRUCT_END();

static const uint NumSamples = 1024;

[shader("compute")]
[numthreads(8, 8, 6)]
void ComputeEnvironmentIrradianceCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    RWTexture2DArray<float4> irradianceEnvironmentMapTexture = ShaderConstants.GetIrradianceEnvironmentMapTextureUAV();

    uint width, height, faces;
    irradianceEnvironmentMapTexture.GetDimensions(width, height, faces);
    if (DispatchThreadID.x >= width || DispatchThreadID.y >= height)
    {
        return;
    }

    TextureCube environmentMapTexture = ShaderConstants.GetEnvironmentMapTextureSRV();
    uint environmentMapMipLevel = ShaderConstants.GetSourceMipLevel();

    uint3 pixelCoord = DispatchThreadID;
    float2 uv = (pixelCoord.xy + 0.5f) / float2(width, height);

    float3 N = CalculateCubemapVector(uv, pixelCoord.z);
    float3 T;
    float3 B;
    CreateOrthonormalBasis(T, B, N);

    // Monte carlo integration of hemispherical irradiance
    float3 irradiance = 0.0f;
    for (uint i = 0; i < NumSamples; i++)
    {
        float2 Xi = Hammersley2D(i, NumSamples);
        float3 L = TangentToWorld(UniformSampleHemisphere(Xi), T, B, N);
        float NdotL = dot(N, L);
        if (NdotL > 0.0f)
        {
            irradiance += environmentMapTexture.SampleLevel(GlobalSamplerLinearWarp, L, environmentMapMipLevel).rgb * NdotL;
        }
    }

    // pdf = 1.0 / (2.0 * PI)
    irradiance = irradiance * 2.0f * PI / float(NumSamples);

    irradianceEnvironmentMapTexture[pixelCoord] = float4(irradiance, 1.0f);
}
