#include "ShaderCommon.hsh"

BIND_TEXTURE_2D_SRV(0, LatLongTexture);
BIND_TEXTURE_2D_ARRAY_UAV(1, float4, CubemapTexture);

[shader("compute")]
[numthreads(8, 8, 6)]
void LatLongToCubemapCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    Texture2D latLongTexture = GetLatLongTextureSRV();
    RWTexture2DArray<float4> cubemapTexture = GetCubemapTextureUAV();

    uint width, height, faces;
    cubemapTexture.GetDimensions(width, height, faces);

    if (DispatchThreadID.x >= width || DispatchThreadID.y >= height)
    {
        return;
    }

    uint3 coord = DispatchThreadID;
    float2 uv = (coord.xy + 0.5f) / float2(width, height);

    float3 uvw = CalculateCubemapVector(uv, coord.z);

    // https://en.wikipedia.org/wiki/Spherical_coordinate_system#Cartesian_coordinates
    float theta = atan2(uvw.x, uvw.y);
    float phi = -atan2(uvw.z, sqrt(uvw.x * uvw.x + uvw.y * uvw.y));
    float2 latLongTextureUV = float2(theta / (2.0f * PI) + 0.25f, phi / PI + 0.5f);

    float4 color = latLongTexture.SampleLevel(GlobalSamplerLinearWarp, latLongTextureUV, 0);

    cubemapTexture[coord] = color;
}