ByteAddressBuffer GetByteAddressBuffer(uint index)
{
    return BindlessResource_ByteAddressBuffer[index];
}

ByteAddressBuffer GetByteAddressBufferNonUniform(uint index)
{
    return BindlessResource_ByteAddressBuffer[NonUniformResourceIndex(index)];
}

RWByteAddressBuffer GetRWByteAddressBuffer(uint index)
{
    return BindlessResource_RWByteAddressBuffer[index];
}

RWByteAddressBuffer GetRWByteAddressBufferNonUniform(uint index)
{
    return BindlessResource_RWByteAddressBuffer[NonUniformResourceIndex(index)];
}

Texture2D GetTexture2D(uint index)
{
    return BindlessResource_Texture2D[index];
}

Texture2D GetTexture2DNonUniform(uint index)
{
    return BindlessResource_Texture2D[NonUniformResourceIndex(index)];
}

#define BIND_BUFFER_ELEMENT(slot, name, type) \
type Get##name() \
{ \
    uint bufferIndex = SHADER_ARGUMENTS_INDEX(slot); \
    return BindlessResource_RWByteAddressBuffer[(bufferIndex >> 16) & 0xffff].Load<type>(bufferIndex & 0xffff); \
}

#define BIND_BYTE_ADDRESS_BUFFER_SRV(slot, name) \
ByteAddressBuffer Get##name##SRV() \
{ \
    uint bufferIndex = SHADER_ARGUMENTS_INDEX(slot); \
    return BindlessResource_ByteAddressBuffer[(bufferIndex >> 16) & 0xffff]; \
}

#define BIND_BYTE_ADDRESS_BUFFER_UAV(slot, name) \
RWByteAddressBuffer Get##name##UAV() \
{ \
    uint bufferIndex = SHADER_ARGUMENTS_INDEX(slot); \
    return BindlessResource_RWByteAddressBuffer[(bufferIndex >> 16) & 0xffff]; \
}

