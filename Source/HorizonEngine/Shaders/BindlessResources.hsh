ByteAddressBuffer GetByteAddressBuffer(int index)
{
    return BindlessResources_ByteAddressBuffer[index];
}

ByteAddressBuffer GetByteAddressBufferNonUniform(int index)
{
    return BindlessResources_ByteAddressBuffer[NonUniformResourceIndex(index)];
}

RWByteAddressBuffer GetRWByteAddressBuffer(int index)
{
