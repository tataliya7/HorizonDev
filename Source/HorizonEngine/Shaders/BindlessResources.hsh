#define BIND_BUFFER_CBV(slot, type) \
ConstantBuffer<type> Get##type##CBV() \
{ \
    uint bufferIndex = GetShaderConstantValue(slot); \
    ConstantBuffer<type> buffer = ResourceDescriptorHeap[bufferIndex]; \
    return buffer; \
}

#define BIND_BYTE_ADDRESS_BUFFER_SRV(slot, name) \
ByteAddressBuffer Get##name##SRV() \
{ \
    uint bufferIndex = GetShaderConstantValue(slot); \
