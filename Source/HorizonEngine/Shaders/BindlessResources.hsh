#define DECLARE_ALIASED_ARRAY_CONSTANT_BUFFER_CBV(type)
#define DECLARE_ALIASED_ARRAY_STRUCTURED_BUFFER_SRV(type)

ByteAddressBuffer GetByteAddressBuffer(int index)
{
    return ResourceDescriptorHeap[index];
}

