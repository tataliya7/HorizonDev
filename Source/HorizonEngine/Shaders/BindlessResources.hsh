Texture1D Get##name##SRV() \
{ \
    return BindlessResource_Texture1D[SHADER_ARGUMENTS_INDEX(slot)]; \
}

#define BIND_TEXTURE_1D_TYPED_SRV(slot, type, name) \
Texture1D<type> Get##name##SRV() \
{ \
    return BindlessResource_Texture1D_##type[SHADER_ARGUMENTS_INDEX(slot)]; \
}

