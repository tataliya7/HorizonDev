#ifdef __spirv__
#define GlobalSamplerPointWarp                                   BindlessResource_SamplerState[0]
#define GlobalSamplerPointClamp                                  BindlessResource_SamplerState[1]
#define GlobalSamplerPointBorder                                 BindlessResource_SamplerState[2]
#define GlobalSamplerLinearWarp                                  BindlessResource_SamplerState[3]
#define GlobalSamplerLinearClamp                                 BindlessResource_SamplerState[4]
#define GlobalSamplerLinearBorder                                BindlessResource_SamplerState[5]
#define GlobalSamplerComparisonGreaterLinearClamp                BindlessResource_SamplerComparisonState[6]
#define GlobalSamplerComparisonLessLinearClamp                   BindlessResource_SamplerComparisonState[7]
#else // TODO: SamplerDescriptorHeap
SamplerState GlobalSamplerPointWarp                              : register(s100, space0);
SamplerState GlobalSamplerPointClamp                             : register(s101, space0);
SamplerState GlobalSamplerPointBorder                            : register(s102, space0);
SamplerState GlobalSamplerLinearWarp                             : register(s103, space0);
SamplerState GlobalSamplerLinearClamp                            : register(s104, space0);
SamplerState GlobalSamplerLinearBorder                           : register(s105, space0);
SamplerComparisonState GlobalSamplerComparisonGreaterLinearClamp : register(s106, space0);
SamplerComparisonState GlobalSamplerComparisonLessLinearClamp    : register(s107, space0);
#endif

#ifdef __spirv__
    #define PUSH_CONSTANT(type, name) [[vk::push_constant]] type name
#else // DXIL
    #define PUSH_CONSTANT(type, name) ConstantBuffer<type> name : register(b999, space0)
#endif

