#pragma once

#include "BindlessResources.hsh"

// It must match the values on the C++ side
//#define GPU_SCENE_MAXIMUM_TRIANGLE_COUNT_PER_MESHLET 128

#define GPU_SCENE_GEOMETRY_DATA_FLAG_USE_GPU_SKINNING 1

struct GPUSceneGeometryData
{
    int vertexBuffer0;
    int vertexBuffer1;
    int vertexBuffer2;
    int vertexBuffer3;
    int vertexBuffer;
    int previousVertexBuffer0;
    int indexBuffer;
    int meshletBuffer;
    int meshletVertexBuffer;
    int meshletTriangleBuffer;
    int materialBuffer;
    int materialIndexBuffer;
    int jointIndexBuffer;
    int jointWeightBuffer;
    int jointTransformBuffer;
    uint vertexCount;
    uint indexCount;
    uint meshletCount;
    uint relevantJointCountPerVertex;
    uint flags;
};

GPUSceneGeometryData GetGPUSceneGeometryData(ByteAddressBuffer geometryDataBuffer, uint geometryID)
{
    uint offset = geometryID * sizeof(GPUSceneGeometryData);

    GPUSceneGeometryData geometryData = (GPUSceneGeometryData)0;
    geometryData = geometryDataBuffer.Load<GPUSceneGeometryData>(0);

    return geometryData;
}

struct GPUSceneGeometryInstanceData
{
    float4x4 localToWorldMatrix;
    float4x4 worldToLocalMatrix;
    float4x4 previousLocalToWorldMatrix;
    float4x4 previousWorldToLocalMatrix;
    uint geometryID;
};

GPUSceneGeometryInstanceData GetGPUSceneGeometryInstanceData(ByteAddressBuffer geometryInstanceDataBuffer, uint instanceID)
{
    uint offset = instanceID * sizeof(GPUSceneGeometryInstanceData);

    GPUSceneGeometryInstanceData instanceData = (GPUSceneGeometryInstanceData)0;
    instanceData = geometryInstanceDataBuffer.Load<GPUSceneGeometryInstanceData>(offset);

    return instanceData;
}

struct VertexAttributes
{
    float3 position;
    float3 normal;
    float4 tangent;
    float2 textureCoord0;
};

VertexAttributes GetVertexAttributes(GPUSceneGeometryData geometryData, uint vertexIndex)
{
    //ByteAddressBuffer indexBuffer = GetByteAddressBufferNonUniform(geometryData.indexBuffer);
    ByteAddressBuffer vertexBuffer0 = GetByteAddressBufferNonUniform(geometryData.vertexBuffer0);
    ByteAddressBuffer vertexBuffer1 = GetByteAddressBufferNonUniform(geometryData.vertexBuffer1);
    ByteAddressBuffer vertexBuffer2 = GetByteAddressBufferNonUniform(geometryData.vertexBuffer2);
    ByteAddressBuffer vertexBuffer3 = GetByteAddressBufferNonUniform(geometryData.vertexBuffer3);

    VertexAttributes vertexAttributes = (VertexAttributes)0;
    vertexAttributes.position = vertexBuffer0.Load<float3>(vertexIndex * sizeof(float3));
    vertexAttributes.normal = vertexBuffer1.Load<float3>(vertexIndex * sizeof(float3));
    vertexAttributes.tangent = vertexBuffer2.Load<float4>(vertexIndex * sizeof(float4));
    vertexAttributes.textureCoord0 = vertexBuffer3.Load<float2>(vertexIndex * sizeof(float2));
    return vertexAttributes;
}

struct GPUSceneGeometryVertexAttributes
{
    float3 position;
    float padding0;
    float3 normal;
    float padding1;
    float4 tangent;
    float2 textureCoordinates[2];
};

GPUSceneGeometryVertexAttributes GetGPUSceneGeometryVertexAttributes(GPUSceneGeometryData geometryData, uint vertexIndex)
{
    ByteAddressBuffer vertexBuffer = GetByteAddressBufferNonUniform(geometryData.vertexBuffer);

    GPUSceneGeometryVertexAttributes vertexAttributes = (GPUSceneGeometryVertexAttributes)0;
    vertexAttributes = vertexBuffer.Load<GPUSceneGeometryVertexAttributes>(vertexIndex * sizeof(GPUSceneGeometryVertexAttributes));

    #if 1 // Linear blending skinning
    bool useGPUSkinning = geometryData.flags & GPU_SCENE_GEOMETRY_DATA_FLAG_USE_GPU_SKINNING;

    [branch]
    if (useGPUSkinning)
    {
        ByteAddressBuffer jointIndexBuffer = GetByteAddressBufferNonUniform(geometryData.jointIndexBuffer);
        ByteAddressBuffer jointWeightBuffer = GetByteAddressBufferNonUniform(geometryData.jointWeightBuffer);
        ByteAddressBuffer jointTransformBuffer = GetByteAddressBufferNonUniform(geometryData.jointTransformBuffer);
        uint jointTransformBufferOffset = 0;

        float3 skinnedPosition = float3(0.0f, 0.0f, 0.0f);
        float3 skinnedNormal = float3(0.0f, 0.0f, 0.0f);
        float3 skinnedTangent = float3(0.0f, 0.0f, 0.0f);

        const uint relevantJointCount = geometryData.relevantJointCountPerVertex;
        for (uint relevantJointIndex = 0; relevantJointIndex < relevantJointCount; relevantJointIndex++)
        {
            int jointIndex = jointIndexBuffer.Load<int>((vertexIndex * relevantJointCount + relevantJointIndex) * sizeof(int));
            float jointWeight = jointWeightBuffer.Load<float>((vertexIndex * relevantJointCount + relevantJointIndex) * sizeof(float));
            // @todo Use float4x3 instead?
            float4x4 jointTransform = jointTransformBuffer.Load<float4x4>(jointTransformBufferOffset + jointIndex * sizeof(float4x4));
            skinnedPosition += mul(jointTransform, float4(vertexAttributes.position, 1.0f)).xyz * jointWeight;
            skinnedNormal += mul((float3x3)jointTransform, vertexAttributes.normal.xyz) * jointWeight;
            skinnedTangent += mul((float3x3)jointTransform, vertexAttributes.tangent.xyz) * jointWeight;
        }

        vertexAttributes.position = skinnedPosition;
        vertexAttributes.normal = normalize(skinnedNormal);
        vertexAttributes.tangent.xyz = normalize(skinnedTangent);
    }
    #endif

    return vertexAttributes;
}

struct GPUSceneMeshletData
{
    uint vertexOffset;
    uint triangleOffset;
    uint vertexCount;
    uint triangleCount;
    float3 boundingBoxCenter;
    float padding0;
    float3 boundingBoxExtent;
    int isSkinned;
};

GPUSceneMeshletData GetGPUSceneMeshletData(GPUSceneGeometryData geometryData, uint meshletID)
{
    ByteAddressBuffer meshletDataBuffer = GetByteAddressBufferNonUniform(geometryData.meshletBuffer);

    uint offset = meshletID * sizeof(GPUSceneMeshletData);

    GPUSceneMeshletData meshletData = (GPUSceneMeshletData)0;
    meshletData = meshletDataBuffer.Load<GPUSceneMeshletData>(offset);

    return meshletData;
}

// @todo Move to other place
struct VisibleMeshletEntry
{
    uint geometryInstanceID;
    uint meshletID;
};

VisibleMeshletEntry GetVisibleMeshletEntry(ByteAddressBuffer buffer, uint visibleMeshletIndex)
{
    VisibleMeshletEntry data = (VisibleMeshletEntry)0;
    data = buffer.Load<VisibleMeshletEntry>(visibleMeshletIndex * sizeof(VisibleMeshletEntry));
    return data;
}

uint PackVisiblePrimitiveID(uint visibleMeshletID, uint triangleID)
{
    return ((visibleMeshletID + 1) << 7) | triangleID;
}

void UnpackVisiblePrimitiveID(out uint visibleMeshletID, out uint triangleID, in uint packedPrimitiveID)
{
    visibleMeshletID = (packedPrimitiveID >> 7) - 1;
    triangleID = packedPrimitiveID & 0x7f;
}

struct DistantLightData
{
    float3 direction;
    float3 tangent;
    float3 color;
};
DECLARE_ALIASED_ARRAY_STRUCTURED_BUFFER_SRV(DistantLightData);

#define LIGHT_TYPE_DIRECTIONAL 0
#define LIGHT_TYPE_POINT 1
#define LIGHT_TYPE_SPOT 2

struct LightData
{
    float3 color;
    float3 position;
    float3 direction;
    float3 tangent;
    float radius;
    uint type;
    int shadowMapIndex;
    int iesTextureIndex;
};
DECLARE_ALIASED_ARRAY_STRUCTURED_BUFFER_SRV(LightData);