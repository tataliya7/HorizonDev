#include "ShaderCommon.hsh"
#include "BRDFCommon.hsh"

SHADER_CONSTANTS_STRUCT_BEGIN();
SHADER_CONSTANTS_TEXTURE_CUBE_DEFAULT_SRV(0, EnvironmentMapTextureSRV);
SHADER_CONSTANTS_TEXTURE_2D_ARRAY_UAV(1, float4, FilteredEnvironmentMapTextureUAV);
SHADER_CONSTANTS_SCALAR(2, float, Roughness);
SHADER_CONSTANTS_STRUCT_END();

// Filtering based on https://placeholderart.wordpress.com/2015/07/28/implementation-notes-runtime-environment-map-filtering-for-image-based-lighting/
float3 FilterEnvironmentMap(TextureCube environmentMapTexture, float3 N, float roughness, uint numSamples)
{
    float3 T; float3 B;
    CreateOrthonormalBasis(T, B, N);

    float3 R = N;
    float3 V = R;

    // Solid angle of 1 pixel across all cube faces
    uint cubemapSize = 32;

    // Convolve environment map using GGX NDF importance sampling
    float weight = 0.0;
    float3 radiance = 0.0;
    for (uint i = 0; i < numSamples; i++)
    {
        float2 Xi = Hammersley2D(i, numSamples);
        float3 H = TangentToWorld(ImportanceSampleGGX(Xi, roughness), T, B, N);
        float3 L = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = dot(N, L);
        if (NdotL > 0.0)
        {
            float NdotH = max(1e-8, dot(N, H));
            float VdotH = max(1e-8, dot(V, H));

            // Probability Distribution Function
            float pdf = D_GGX(NdotH, roughness) * NdotH / (4.0 * VdotH) + 0.00001;

            // Solid angle of current sample
            float omegaS = 1.0 / (float(numSamples) * pdf);
            float omegaP = 4.0 * PI / (6.0 * cubemapSize * cubemapSize);

            float mipLevel = 0.5 * log2(omegaS / omegaP);

            float3 color = environmentMapTexture.SampleLevel(GlobalSamplerLinearWarp, L, mipLevel).rgb;

            radiance += color * NdotL;
            weight   += NdotL;
        }
    }

    return radiance / weight;
}

[shader("compute")]
[numthreads(8, 8, 6)]
void FilterEnvironmentMapCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    RWTexture2DArray<float4> filteredEnvironmentMapTexture = ShaderConstants.GetFilteredEnvironmentMapTextureUAV();

    uint width, height, faces;
    filteredEnvironmentMapTexture.GetDimensions(width, height, faces);
    if (DispatchThreadID.x >= width || DispatchThreadID.y >= height)
    {
        return;
    }

    uint3 coord = DispatchThreadID;
    float2 uv = (float2(coord.xy) + 0.5f) / float2(width, height);
    float3 N = CalculateCubemapVector(uv, coord.z);

    TextureCube environmentMapTexture = ShaderConstants.GetEnvironmentMapTextureSRV();
    float roughness = ShaderConstants.GetRoughness();

    if (roughness < 0.01f)
    {
        filteredEnvironmentMapTexture[coord] = environmentMapTexture.SampleLevel(GlobalSamplerLinearWarp, N, 0);
        return;
    }

    const uint NumSamples = 1024;
    //const uint NumSamples = roughness < 0.1 ? 32 : 64;

    float3 result = FilterEnvironmentMap(environmentMapTexture, N, roughness, NumSamples);

    filteredEnvironmentMapTexture[coord] = float4(result, 1.0f);
}