// BIND_TEXTURE_2D_SRV(0, ImGuiTexture);
// BIND_BYTE_ADDRESS_BUFFER_SRV(1, VertexBuffer);

struct ImGuiVertex
{
    float2 position;
    float2 uv;
    uint color;
};

struct ImGuiShaderConstants
{
    //BIND_TEXTURE_2D_SRV(0, ImGuiTexture);
    int ImGuiTexture;
    Texture2D GetImGuiTextureSRV()
    {
        return BindlessResource_Texture2D[ImGuiTexture];
    }

    //BIND_BYTE_ADDRESS_BUFFER_SRV(1, VertexBuffer);
    int VertexBuffer;
    ByteAddressBuffer GetVertexBufferSRV()
    {
        return BindlessResource_ByteAddressBuffer[(VertexBuffer >> 16) & 0xffff];
    }

    int padding2;
    int padding3;
    int padding4;
    int padding5;
    int padding6;
    int padding7;
    int padding8;
    int padding9;
    int padding10;
    int padding11;
    int padding12;
    int padding13;
    int padding14;
    int padding15;

    //BIND_SCALAR(2, float, ScaleX);
    float ScaleX;
    float GetScaleX()
    {
        return ScaleX;
    }

    //BIND_SCALAR(3, float, ScaleY);
    float ScaleY;
    float GetScaleY()
    {
        return ScaleY;
    }

    float TranslateX;
    float GetTranslateX()
    {
        return TranslateX;
    }

    float TranslateY;
    float GetTranslateY()
    {
        return TranslateY;
    }

    int VertexOffset;
    int GetVertexOffset()
    {
        return VertexOffset;
    }
};
PUSH_CONSTANT(ImGuiShaderConstants, ShaderConstants);

// SHADER_CONSTANTS_STRUCT_BEGIN()

// SHADER_CONSTANTS_STRUCT_END()

struct ImGuiVSToPS
{
    float4 position : SV_Position;
    float4 color : COLOR0;
    float2 texCoord0 : TEXCOORD0;
};

[shader("vertex")]
void ImGuiVS(uint vertexID : SV_VertexID, out ImGuiVSToPS output)
{
    float2 scale = float2(ShaderConstants.GetScaleX(), ShaderConstants.GetScaleY());
    float2 translate = float2(ShaderConstants.GetTranslateX(), ShaderConstants.GetTranslateY());
    int vertexOffset = ShaderConstants.GetVertexOffset();

    ByteAddressBuffer vertexBuffer = ShaderConstants.GetVertexBufferSRV();
    ImGuiVertex vertex = vertexBuffer.Load<ImGuiVertex>((vertexOffset + vertexID) * sizeof(ImGuiVertex));

    uint4 packedColor = uint4(vertex.color & 0xff, (vertex.color >> 8) & 0xff, (vertex.color >> 16) & 0xff, (vertex.color >> 24) & 0xff);

    output.color = float4(packedColor) / 255.0f;
    output.texCoord0 = vertex.uv;
    output.position = float4(vertex.position * scale + translate, 0.0f, 1.0f);
}

[shader("pixel")]
void ImGuiPS(ImGuiVSToPS input, out float4 color : SV_Target)
{
    Texture2D texture = ShaderConstants.GetImGuiTextureSRV();
    color = input.color * texture.SampleLevel(GlobalSamplerLinearWarp, input.texCoord0, 0);
}