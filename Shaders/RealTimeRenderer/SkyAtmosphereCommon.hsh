    #define RELATED_TO_VIEW 0
    #define USE_PRE_EXPOSURE 0
    #define SAMPLE_TRANSMITTANCE_LUT 0
    #define MULTILE_SCATTERING_APPROX_ENABLED 0
#elif SKY_ATMOSPHERE_MULTIPLE_SCATTERING_LUT_PASS
    #define RELATED_TO_VIEW 0
    #define USE_PRE_EXPOSURE 0
    #define SAMPLE_TRANSMITTANCE_LUT 1
    #define MULTILE_SCATTERING_APPROX_ENABLED 0
#elif SKY_ATMOSPHERE_SKY_VIEW_LUT_PASS
    #define RELATED_TO_VIEW 1
    #define USE_PRE_EXPOSURE 1
    #define SAMPLE_TRANSMITTANCE_LUT 1
    #define MULTILE_SCATTERING_APPROX_ENABLED 1
#elif SKY_ATMOSPHERE_AERIAL_PERSPECTIVE_VOLUME_PASS
    #define RELATED_TO_VIEW 1
    #define USE_PRE_EXPOSURE 1
    #define SAMPLE_TRANSMITTANCE_LUT 1
    #define MULTILE_SCATTERING_APPROX_ENABLED 1
#endif

// Kilometers as unit for computations related to the sky and its atmosphere
#define M_TO_KM (0.001f)
#define KM_TO_M (1.0f / M_TO_KM)

// Float accuracy offset in Sky unit (km, so this is 1m)
#define PLANET_RADIUS_OFFSET 0.001f

#define PLANET_RADIUS_SAFE_TRACE_EDGE 0.01f

// The number of killometer per slice in the aerial pespective camera volume texture. (assuming a uniform depth distribution)
#define AP_KM_PER_SLICE 4.0f

#define AP_SLICE_COUNT 32.0f

static const float InvDistanceToMaxSampleCount = 1.0f / 100.0f;

float3 GetWorldPositionFromUvAndDepth(float2 uv, float depth, float4x4 invViewProjectionMatrix)
{
#if 1
    depth = max(0.000000000001, depth);
#endif
    float4 position = float4(uv * float2(2.0, -2.0) - float2(1.0, -1.0), depth, 1.0);
    position = mul(invViewProjectionMatrix, position);
    return position.xyz / position.w;
}

float AerialPerspectiveSliceToDepth(float slice)
{
    return slice * AP_KM_PER_SLICE;
}

float AerialPerspectiveDepthToSlice(float depth)
{
    return depth * (1.0f / AP_KM_PER_SLICE);
}

struct SkyAtmosphereShaderParameters
{
    float4 transmittanceLutSizeAndInvSize;
    float4 multipleScatteringLutSizeAndInvSize;
    float4 skyViewLutSizeAndInvSize;
    float aerialPerspectiveVolumeSize;
    float transmittanceLutSampleCount;
    float multipleScatteringLutSampleCount;
    float rayMarchMinSPP;
    float rayMarchMaxSPP;

    // Atmosphere
    float bottomRadius;
    float topRadius;
    float3 groundAlbedo;
    float3 rayleighScattering;
    float rayleighDensityExpScale;
    float3 mieScattering;
    float3 mieExtinction;
    float3 mieAbsorption;
    float miePhaseG;
    float mieDensityExpScale;
    float absorptionDensity0LayerWidth;
    float absorptionDensity0ConstantTerm;
    float absorptionDensity0LinearTerm;
    float absorptionDensity1ConstantTerm;
    float absorptionDensity1LinearTerm;
    float3 absorptionExtinction;
};

