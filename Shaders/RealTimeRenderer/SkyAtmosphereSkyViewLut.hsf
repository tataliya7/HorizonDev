
#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#define SKY_ATMOSPHERE_SKY_VIEW_LUT_PASS 1
#include "SkyAtmosphereCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameData, PerFrameData);
BIND_BUFFER_ELEMENT(1, SkyAtmosphereShaderParameters, SkyAtmosphereShaderParameters);
BIND_TEXTURE_2D_SRV(2, TransmittanceLutTexture);
BIND_TEXTURE_2D_SRV(3, MultipleScatteringLutTexture);
BIND_TEXTURE_2D_UAV(4, float3, SkyViewLutTexture);

float3 UvToSkyViewLutParams(in float4 skyViewLutSizeAndInvSize, in float bottomRadius, in float viewHeight, in float2 uv)
{
    // Constrain uvs to valid sub texel range (avoid zenith derivative issue making LUT usage visible)
    uv = FromSubUvsToUnit(uv, skyViewLutSizeAndInvSize);

    float vhorizon = sqrt(viewHeight * viewHeight - bottomRadius * bottomRadius);
    float cosBeta = vhorizon / viewHeight;
    float beta = acos(cosBeta);
    float zenithHorizonAngle = PI - beta;

    float viewZenithAngle;
    if (uv.y < 0.5f)
    {
        float coord = 2.0f * uv.y;
        coord = 1.0f - coord;
        coord *= coord;
        coord = 1.0f - coord;
        viewZenithAngle = zenithHorizonAngle * coord;
    }
    else
    {
        float coord = uv.y * 2.0f - 1.0f;
        coord *= coord;
        viewZenithAngle = zenithHorizonAngle + beta * coord;
    }

    float cosViewZenithAngle = cos(viewZenithAngle);
    //float sinViewZenithAngle = sin(viewZenithAngle);
    float sinViewZenithAngle = sqrt(1.0 - cosViewZenithAngle * cosViewZenithAngle) * (viewZenithAngle > 0.0f ? 1.0f : -1.0f); // Equivalent to sin(viewZenithAngle)

    float longitudeViewAngle = uv.x * 2.0f * PI;

    float cosLongitudeViewAngle = cos(longitudeViewAngle);
    //float sinLongitudeViewAngle = sin(longitudeViewAngle);
    float sinLongitudeViewAngle = sqrt(1.0 - cosLongitudeViewAngle * cosLongitudeViewAngle) * (longitudeViewAngle <= PI ? 1.0f : -1.0f); // Equivalent to sin(longitudeViewAngle)
    float3 viewDir = float3(
        sinViewZenithAngle * cosLongitudeViewAngle,
        sinViewZenithAngle * sinLongitudeViewAngle,
        cosViewZenithAngle);

    return viewDir;
}

[numthreads(8, 8, 1)]
void SkyAtmosphereSkyViewLutCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    PerFrameData perFrameData = GetPerFrameData();
    SkyAtmosphereShaderParameters skyAtmosphereParameters = GetSkyAtmosphereShaderParameters();
    Texture2D transmittanceLutTexture = GetTransmittanceLutTextureSRV();
    Texture2D multipleScatteringLutTexture = GetMultipleScatteringLutTextureSRV();
    RWTexture2D<float3> skyViewLutTexture = GetSkyViewLutTextureUAV();

    float4 skyViewLutSizeAndInvSize = skyAtmosphereParameters.skyViewLutSizeAndInvSize;

    uint2 pixelCoord = DispatchThreadID.xy;
    float2 uv = (float2(pixelCoord) + 0.5f) * skyViewLutSizeAndInvSize.zw;

    float3 worldPos = (perFrameData.cameraPosition * M_TO_KM) - float3(0.0f, 0.0f, -skyAtmosphereParameters.bottomRadius);

    // This is the LUT camera height and position in the local referential
    float viewHeight = length(worldPos);
    worldPos = float3(0.0f, 0.0f, viewHeight);

    float3 worldDir = UvToSkyViewLutParams(skyViewLutSizeAndInvSize, skyAtmosphereParameters.bottomRadius, viewHeight, uv);

    if (!MoveToTopAtmosphere(worldPos, worldDir, skyAtmosphereParameters.topRadius))
    {
        skyViewLutTexture[pixelCoord] = 0.0f;
        return;
    }

    float3x3 localReferencial = perFrameData.skyAtmosphereSkyViewLUTReferential;
    float3 atmosphereLightDirection = perFrameData.atmosphereLightDirection;
    float3 lightDirection = mul(localReferencial, atmosphereLightDirection);

    const bool ground = false;
    const bool variableSampleCount = true;
    const float invalidSampleCount = 0.0f;
    const float minSampleCount = skyAtmosphereParameters.rayMarchMinSPP;
    const float maxSampleCount = skyAtmosphereParameters.rayMarchMaxSPP;
    const float depthBufferValue = FarClipPlaneDepthValue;
    const bool mieRayPhase = true;
    const float3 lightIlluminance = perFrameData.skyAtmosphereLightOuterSpaceIlluminance;

    SingleScatteringResult result = IntegrateSingleScatteredLuminance(
        perFrameData,
        skyAtmosphereParameters,
        transmittanceLutTexture,
        multipleScatteringLutTexture,
        uv,
        worldPos,
        worldDir,
        ground,
        variableSampleCount,
        invalidSampleCount,
        minSampleCount,
        maxSampleCount,
        depthBufferValue,
        mieRayPhase,
        lightDirection,
        lightIlluminance);

    skyViewLutTexture[pixelCoord] = result.L;
}