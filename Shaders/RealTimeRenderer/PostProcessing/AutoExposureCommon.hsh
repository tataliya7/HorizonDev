#define AUTO_EXPOSURE_HISTOGRAM_BIN_COUNT 256

#define AUTO_EXPOSURE_BUILD_HISTOGRAM_CS_NUM_THREADS_X 16
#define AUTO_EXPOSURE_BUILD_HISTOGRAM_CS_NUM_THREADS_Y 16

// See https://en.wikipedia.org/wiki/Middle_gray for more infomation.
static const float MiddleGray = 0.18;

// Since InterlockedAdd only supports int/uint, we need to

uint AutoExposureHistogramPackFloat(float v)
{
    return uint(v * float(1 << 8));
}

float AutoExposureHistogramUnpackFloat(uint v)
{
    return float(v) * (1.0f / float(1 << 8));
}
