#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameData, PerFrameData);
BIND_TEXTURE_2D_SRV(1, ShadowMaskTexture);
BIND_TEXTURE_2D_UAV(2, float4, OutputTexture);

[numthreads(8, 8, 1)]
void VisualizeScreenSpaceShadowMaskCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    PerFrameData perFrameData = GetPerFrameData();
    Texture2D screenSpaceShadowMaskTexture = GetShadowMaskTextureSRV();
    RWTexture2D<float4> outputTexture = GetOutputTextureUAV();

    uint2 pixelCoord = DispatchThreadID.xy;

    uint width, height;
    outputTexture.GetDimensions(width, height);
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    float2 uv = (pixelCoord + 0.5) * float2(1.0 / width, 1.0 / height);

    float shadowMask = screenSpaceShadowMaskTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;

    outputTexture[pixelCoord] = float4(shadowMask, shadowMask, shadowMask, 1.0);
}