#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"
#include "EditorSelectionOutlineCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameData, PerFrameData);
BIND_TEXTURE_2D_SRV(1, InputTexture);
BIND_TEXTURE_2D_UAV(2, float4, OutputTexture);

[numthreads(POST_PROCESS_THREAD_GROUP_SIZE, POST_PROCESS_THREAD_GROUP_SIZE, 1)]
void EditorSelectionOutlineSetupCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    PerFrameData perFrameData = GetPerFrameData();
    uint2 pixelCoord = DispatchThreadID.xy;
    uint width = perFrameData.targetResolutionX;
    uint height = perFrameData.targetResolutionY;
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    Texture2D inputTexture = GetInputTextureSRV();
    RWTexture2D<float4> outputTexture = GetOutputTextureUAV();

    float mask = inputTexture[pixelCoord].r;

    if (mask < 0.99) // exterior
    {
        outputTexture[pixelCoord] = float4(
            EDITOR_SELECTION_OUTLINE_JUMP_FLOOD_INVALID_VALUE,
            EDITOR_SELECTION_OUTLINE_JUMP_FLOOD_INVALID_VALUE,
            EDITOR_SELECTION_OUTLINE_JUMP_FLOOD_INVALID_VALUE,
            mask);
        return;
    }

    float2 invSize = perFrameData.targetResolutionAndInvTargetResolution.zw;
    float2 uv = (pixelCoord + 0.5f) * invSize;
    outputTexture[pixelCoord] = float4(uv, 0, mask);
}