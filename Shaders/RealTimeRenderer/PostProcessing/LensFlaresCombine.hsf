#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameData, PerFrameData);
BIND_TEXTURE_2D_SRV(1, LensFlaresGradiantLUTTexture);
BIND_TEXTURE_2D_SRV(2, LensFlaresGhostTexture);
BIND_TEXTURE_2D_SRV(3, LensFlaresGlareTexture);
BIND_TEXTURE_2D_SRV(4, SceneColorTexture);

static const float2 HaloCenterUV = float2(0.5f, 0.5f);

// https://www.shadertoy.com/view/tstBDl
float2 ComputeFisheyeUV(float2 uv, float f, float zoom)
{
    float2 ndcPos = 2.0f * uv - 1.0f;
    float scale = f * atan(1.0f / f);
    float r_d = length(ndcPos) * scale;
    float r_u = f * tan(r_d / f) * zoom;
    float phi = atan2(ndcPos.y, ndcPos.x);
    return float2(r_u * cos(phi) + 1.0f, r_u * sin(phi) + 1.0f) * 0.5f;
}

[shader("vertex")]
void LensFlaresCombineVS(uint vertexID : SV_VertexID, out float4 outPosition : SV_Position)
{
    outPosition = float4(float2((vertexID << 1) & 2, vertexID & 2) * 2.0f - 1.0f, 0.0f, 1.0f);
}

[shader("pixel")]
void LensFlaresCombinePS(float4 position : SV_Position, out float3 outColor : SV_Target)
{
    PerFrameData perFrameData = GetPerFrameData();
    Texture2D ghostTexture = GetLensFlaresGhostTextureSRV();
    Texture2D glareTexture = GetLensFlaresGlareTextureSRV();
    Texture2D gradientLUTTexture = GetLensFlaresGradiantLUTTextureSRV();
    Texture2D SceneColorTexture = GetSceneColorTextureSRV();
    float outputTextureWidth = SHADER_ARGUMENTS_DATA(0);
    float outputTextureHeight = SHADER_ARGUMENTS_DATA(1);
    float2 outputTextureInvSize = 1.0f / float2(outputTextureWidth, outputTextureHeight);

    float lensFlaresIntensity = perFrameData.lensFlaresIntensity;

    float2 uv = position.xy * outputTextureInvSize;

    float3 lensFlaresColor = 0.0f;

    float3 ghostColor = ghostTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).rgb;
    lensFlaresColor += ghostColor;

    float3 glareColor = 0.0f;
    glareColor.rgb += 0.25f * glareTexture.SampleLevel(GlobalSamplerLinearClamp, (position.xy + float2(-1.0f, -1.0f)) * outputTextureInvSize, 0).rgb;
    glareColor.rgb += 0.25f * glareTexture.SampleLevel(GlobalSamplerLinearClamp, (position.xy + float2(-1.0f,  1.0f)) * outputTextureInvSize, 0).rgb;
    glareColor.rgb += 0.25f * glareTexture.SampleLevel(GlobalSamplerLinearClamp, (position.xy + float2( 1.0f, -1.0f)) * outputTextureInvSize, 0).rgb;
    glareColor.rgb += 0.25f * glareTexture.SampleLevel(GlobalSamplerLinearClamp, (position.xy + float2( 1.0f,  1.0f)) * outputTextureInvSize, 0).rgb;
    lensFlaresColor += glareColor;

    // TODO
    float haloCompression = 0.65f;
    float haloWidth = 0.6f;
    float haloIntensity = 1.0f;
    float chromaticAberrationOffset = 0.015f;

    float2 fisheyeUV = ComputeFisheyeUV(uv, haloCompression , 1.0f);

    float2 haloVector = normalize(HaloCenterUV - uv) * haloWidth;

    float haloMask = distance(uv, HaloCenterUV);
    haloMask = saturate(2.0f * haloMask);
    haloMask = smoothstep(0.5f, 1.0f, haloMask);

    float2 ndcPos = UVToClipSpace(uv);
    float vignette = Vignette(ndcPos);
    vignette *= Vignette(ndcPos * 0.8f);
    vignette = vignette * 0.95 + 0.05;

    float2 chromaticAberrationUV_R = (fisheyeUV - HaloCenterUV) * (1.0f + chromaticAberrationOffset) + haloVector + HaloCenterUV;
    float2 chromaticAberrationUV_G = fisheyeUV + haloVector;
    float2 chromaticAberrationUV_B = (fisheyeUV - HaloCenterUV) * (1.0f - chromaticAberrationOffset) + haloVector + HaloCenterUV;

    float3 haloColor = 0.0f;
    haloColor.r = SceneColorTexture.SampleLevel(GlobalSamplerLinearClamp, chromaticAberrationUV_R, 0).r;
    haloColor.g = SceneColorTexture.SampleLevel(GlobalSamplerLinearClamp, chromaticAberrationUV_G, 0).g;
    haloColor.b = SceneColorTexture.SampleLevel(GlobalSamplerLinearClamp, chromaticAberrationUV_B, 0).b;

    lensFlaresColor += haloColor * haloIntensity * haloMask * vignette;

    float2 gradientLUTTextureUV = float2(saturate(distance(uv, float2(0.5f, 0.5f)) * 2.0f), 0.0f);
    float3 gradient = gradientLUTTexture.SampleLevel(GlobalSamplerLinearClamp, gradientLUTTextureUV, 0).rgb;

    lensFlaresColor = lensFlaresColor * gradient * lensFlaresIntensity * 0.1f;
    outColor = lensFlaresColor;
}