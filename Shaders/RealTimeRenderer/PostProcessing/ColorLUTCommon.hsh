static const uint ColorLUTSize = 32;

static const float ColorLUTLinearRange = 14.0;
static const float ColorLUTLinearGray = 0.18;
static const float ColorLUTExposureGray = 444.0;

float3 LogToLinear(float3 encodedColor)
{
    return exp2((encodedColor - ColorLUTExposureGray / 1023.0) * ColorLUTLinearRange) * ColorLUTLinearGray;
}

float3 LinearToLog(float3 linearColor)
{
    return saturate(log2(linearColor) / ColorLUTLinearRange - log2(ColorLUTLinearGray) / ColorLUTLinearRange + ColorLUTExposureGray / 1023.0);
}
