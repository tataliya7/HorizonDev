#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"
#include "PostProcessingCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameData, PerFrameData);
BIND_TEXTURE_2D_SRV(1, InputTexture);
BIND_TEXTURE_2D_UAV(2, float4, OutputTexture);

[numthreads(POST_PROCESS_THREAD_GROUP_SIZE, POST_PROCESS_THREAD_GROUP_SIZE, 1)]
void LocalExposureComputeWeightsCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    RWTexture2D<float4> outputTexture = GetOutputTextureUAV();
    uint width, height;
    outputTexture.GetDimensions(width, height);
    if (DispatchThreadID.x >= width || DispatchThreadID.y >= height)
    {
        return;
    }

    uint2 pixelCoord = DispatchThreadID.xy;
    float2 uv = (pixelCoord + 0.5) / float2(width, height);

    Texture2D inputTexture = GetInputTextureSRV();

    float sigmaSquare = SHADER_ARGUMENTS_DATA(0);

    float3 diff = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).rgb - 0.5;
    float3 weights = exp(-0.5 * diff * diff * sigmaSquare);
    weights /= dot(weights, 1.0) + 0.00001;

    outputTexture[pixelCoord] = float4(weights, 1.0);
}
