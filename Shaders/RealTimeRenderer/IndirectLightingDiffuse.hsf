#include "../ShaderCommon.hsh"
#include "../BRDFCommon.hsh"
#include "../../PrincipledBSDF.hsh"
#include "../../SphericalHarmonics.hsh"
#include "RealTimeRendererCommon.hsh"
#include "LightingCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameData, PerFrameData);
BIND_TEXTURE_2D_SRV(1, GBuffer0);
BIND_TEXTURE_2D_SRV(2, GBuffer1);
BIND_TEXTURE_2D_SRV(3, GBuffer2);
BIND_TEXTURE_2D_SRV(4, AmbientOcclusionTexture);
BIND_TEXTURE_CUBE_SRV(5, SkyLightIrradianceEnvironmentMap);
BIND_BYTE_ADDRESS_BUFFER_SRV(6, SkyLightIrradianceEnvironmentMapSHBuffer);

[shader("vertex")]
void IndirectLightingDiffuseVS(uint vertexID : SV_VertexID, out float4 outPosition : SV_Position)
{
    outPosition = float4(float2((vertexID << 1) & 2, vertexID & 2) * 2.0f - 1.0f, 0.0f, 1.0f);
}

[shader("pixel")]
void IndirectLightingDiffusePS(float4 position : SV_Position, out float4 outSceneColor : SV_Target0)
{
    PerFrameData perFrameData = GetPerFrameData();
    Texture2D gbuffer0 = GetGBuffer0SRV();
    Texture2D gbuffer1 = GetGBuffer1SRV();
    Texture2D gbuffer2 = GetGBuffer2SRV();
    Texture2D ambientOcclusionTexture = GetAmbientOcclusionTextureSRV();

    const uint2 pixelCoord = uint2(position.xy);
    const float2 uv = (float2(pixelCoord) + 0.5f) * perFrameData.renderResolutionAndInvRenderResolution.zw;

    float4 gbuffer0Data = gbuffer0[pixelCoord];
    float4 gbuffer1Data = gbuffer1[pixelCoord];
    float4 gbuffer2Data = gbuffer2[pixelCoord];
    float ambientOcclusion = ambientOcclusionTexture.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;

    float3 normal = DecodeNormalFromGBuffer(gbuffer0Data.xyz);
    float metallic = gbuffer1Data.x;
    float specular = gbuffer1Data.y;
    float roughness = gbuffer1Data.z;
    float4 baseColor = gbuffer2Data;

    // if (multiBounce > 0)
    // {
    //     ambientOcclusion = GTAOMultiBounce(visibility, baseColor);
    // }

    float3 diffuseBRDF = baseColor.rgb * (1.0 / PI) * (1.0 - metallic);
#if 0
    TextureCube irradianceEnvironmentMap = GetSkyLightIrradianceEnvironmentMapSRV();
    float3 irradiance = irradianceEnvironmentMap.SampleLevel(GlobalSamplerLinearWarp, normal, 0).rgb;
#else
    ByteAddressBuffer irradianceEnvironmentMapSHBuffer = GetSkyLightIrradianceEnvironmentMapSHBufferSRV();
    ThreeBandSHCoefficientsRGB irradianceEnvironmentMapSH = irradianceEnvironmentMapSHBuffer.Load<ThreeBandSHCoefficientsRGB>(0);
    float3 irradiance = EvaluateSHCosineWeighted(irradianceEnvironmentMapSH, normal);
#endif
    float3 indirectDiffuse = diffuseBRDF * irradiance * ambientOcclusion;
    indirectDiffuse *= perFrameData.indirectLightingFactor;
    indirectDiffuse *= perFrameData.sceneColorPreExposure;

    outSceneColor = 0;
    outSceneColor.rgb += indirectDiffuse;
}
