#include "../ShaderCommon.hsh"
#include "../BRDFCommon.hsh"
#include "../Random.hsh"
#include "RealTimeRendererCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameData, PerFrameData);
BIND_TEXTURE_2D_SRV(1, SceneDepth);
BIND_TEXTURE_2D_SRV(2, GBuffer1);
BIND_TEXTURE_2D_SRV(3, GBuffer2);
BIND_TEXTURE_2D_UAV(4, float4, GTAOHorizonSearchAndIntegralOutputTexture);
BIND_TEXTURE_2D_UAV(5, float4, GATODebugTexture);
BIND_TEXTURE_2D_SRV(6, GBuffer0);
BIND_TEXTURE_2D_SRV(7, MotionVectors);
BIND_TEXTURE_2D_SRV(8, HistorySceneDepth);
BIND_TEXTURE_2D_SRV(9, AmbientOcclutionTexture);
BIND_TEXTURE_2D_SRV(10, HistoryAmbientOcclutionTexture);
BIND_TEXTURE_2D_UAV(11, float4, FilteredAmbientOcclutionTexture);
BIND_TEXTURE_2D_SRV(12, SpatialFilteringInputTexture);
BIND_TEXTURE_2D_UAV(13, float4, SpatialFilteringOutputTexture);

/*
 * Based on Practical Real-time Strategies for Accurate Indirect Occlusion
 * http://blog.selfshadow.com/publications/s2016-shading-course/activision/s2016_pbs_activision_occlusion.pdf
 * http://blog.selfshadow.com/publications/s2016-shading-course/activision/s2016_pbs_activision_occlusion.pptx
 */

#define GTAO_PI         3.14159265358979323846
#define GTAO_HALF_PI    1.57079632679489661923

static const uint GTAONumSlices = 2;
static const uint GTAOHorizonSearchNumSteps = 8;

float GTAOFastSqrt(float x)
{
    // [Drobot2014a] Low Level Optimization for GCN
    return asfloat(0x1FBD1DF5 + (asint(x) >> 1));
}

float GTAOFastAcos(float x)
{
    // [Eberly2014] GPGPU Programming for Games and Science
    float result = -0.156583 * abs(x) + (GTAO_PI * 0.5);
    result *= sqrt(1.0 - abs(x));
    return (x >= 0) ? result : GTAO_PI - result;
}

float GTAOMultiBounce(float visibility, float3 albedo)
{
    /* Median luminance. Because colored multibounce looks bad. */
    float luminance = dot(albedo, 0.3333);

    float a =  2.0404 * luminance - 0.3324;
    float b = -4.7951 * luminance + 0.6417;
    float c =  2.7552 * luminance + 0.6903;

    float x = visibility;
    return max(visibility, ((visibility * a + b) * visibility + c) * visibility);
}

float2 GTAONoise(uint spatialIndex, uint temporalIndex)
{
    uint randSeed = RandInit(spatialIndex, temporalIndex);
    return float2(Rand(randSeed), Rand(randSeed));
}

float2 GTAORandomVector(float jitter)
{
    /* Only a quarter of a turn because we integrate using 2 slices. */
    jitter *= GTAO_HALF_PI;
    return float2(cos(jitter), sin(jitter));
}

float2 GTAOSearchForHorizons(
    uint numSteps,
    Texture2D sceneDepth,
    float2 baseUV,
    float4x4 invProjectionMatrix,
    float2 searchDirection,
    float searchRadius,
    float stepNoise,
    float initialOffset,
    float3 viewSpacePosition,
    float3 nomalizedViewVector,
    float thickness,
    float radius, uint2 pixelCoord)
{
    float3 depthVector;
    float depthVectorLengthSquare;
    float invDepthVectorLength;
    float2 offset;
    float4 sampleUV;
    float depth;
    float cosAngle;
    float fallOff;
    float2 horizons = float2(-1.0, -1.0);
    float attenuation = 1.0 / (radius * radius);

#if 1
    PerFrameData perFrameData = GetPerFrameData();
    RWTexture2D<float4> debugOutputTexture = GetGATODebugTextureUAV();
    uint2 coord1 = pixelCoord;
    uint2 coord2 = pixelCoord;
#endif

    [unroll]
    for (uint step = 0; step < numSteps; step++)
    {
        offset = searchDirection * (initialOffset + ((step + stepNoise) / numSteps) * searchRadius);

        sampleUV = float4(baseUV + offset, baseUV - offset);

#if 1
        if (pixelCoord.x == 800 && pixelCoord.y == 500)
        {
            uint2 coord = uint2(sampleUV.x * perFrameData.renderResolutionX, sampleUV.y * perFrameData.renderResolutionY);
            debugOutputTexture[coord + uint2(0, -1)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(0, 0)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(0, 1)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(1, -1)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(1, 0)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(1, 1)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(-1, -1)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(-1, 0)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(-1, 1)] = float4(1, 0, 0, 1);
            coord = uint2(sampleUV.z * perFrameData.renderResolutionX, sampleUV.w * perFrameData.renderResolutionY);
            debugOutputTexture[coord + uint2(0, -1)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(0, 0)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(0, 1)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(1, -1)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(1, 0)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(1, 1)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(-1, -1)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(-1, 0)] = float4(1, 0, 0, 1);
            debugOutputTexture[coord + uint2(-1, 1)] = float4(1, 0, 0, 1);
        }
#endif

        // Positive Direction
        depth = sceneDepth.SampleLevel(GlobalSamplerPointClamp, sampleUV.xy, 0).r;
        depthVector = ReconstructViewSpacePositionFromDepth(sampleUV.xy, depth, invProjectionMatrix) - viewSpacePosition;
        depthVectorLengthSquare = dot(depthVector, depthVector);
        invDepthVectorLength = rsqrt(depthVectorLengthSquare + 0.0001);
        fallOff = saturate(depthVectorLengthSquare * attenuation);

        //if (fallOff < 1.0)
        {
            cosAngle = dot(depthVector, nomalizedViewVector) * invDepthVectorLength;
            cosAngle = lerp(cosAngle, horizons.x, fallOff);
            if (cosAngle > horizons.x)
            {
                coord1 = uint2(sampleUV.x * perFrameData.renderResolutionX, sampleUV.y * perFrameData.renderResolutionY);
            }
            horizons.x = (cosAngle > horizons.x) ? cosAngle : lerp(cosAngle, horizons.x, thickness); // Thickness Heuristic
        }

        // Negative Direction
        depth = sceneDepth.SampleLevel(GlobalSamplerPointClamp, sampleUV.zw, 0).r;
        depthVector = ReconstructViewSpacePositionFromDepth(sampleUV.zw, depth, invProjectionMatrix) - viewSpacePosition;
        depthVectorLengthSquare = dot(depthVector, depthVector);
        invDepthVectorLength = rsqrt(depthVectorLengthSquare + 0.0001);
        fallOff = saturate(depthVectorLengthSquare * attenuation);

        //if (fallOff < 1.0)
        {
            cosAngle = dot(depthVector, nomalizedViewVector) * invDepthVectorLength;
            cosAngle = lerp(cosAngle, horizons.y, fallOff);
            if (cosAngle > horizons.y)
            {
                coord2 = uint2(sampleUV.z * perFrameData.renderResolutionX, sampleUV.w * perFrameData.renderResolutionY);
            }
            horizons.y = (cosAngle > horizons.y) ? cosAngle : lerp(cosAngle, horizons.y, thickness); // Thickness Heuristic
        }
    }

#if 1
        if (pixelCoord.x == 800 && pixelCoord.y == 500)
        {
            float4 color = float4(0, 0, 1, 1);
            uint2 coord = coord1;
            debugOutputTexture[coord + uint2(0, -1)] = color;
            debugOutputTexture[coord + uint2(0, 0)] = color;
            debugOutputTexture[coord + uint2(0, 1)] = color;
            debugOutputTexture[coord + uint2(1, -1)] = color;
            debugOutputTexture[coord + uint2(1, 0)] = color;
            debugOutputTexture[coord + uint2(1, 1)] = color;
            debugOutputTexture[coord + uint2(-1, -1)] = color;
            debugOutputTexture[coord + uint2(-1, 0)] = color;
            debugOutputTexture[coord + uint2(-1, 1)] = color;
            coord = coord2;
            debugOutputTexture[coord + uint2(0, -1)] = color;
            debugOutputTexture[coord + uint2(0, 0)] = color;
            debugOutputTexture[coord + uint2(0, 1)] = color;
            debugOutputTexture[coord + uint2(1, -1)] = color;
            debugOutputTexture[coord + uint2(1, 0)] = color;
            debugOutputTexture[coord + uint2(1, 1)] = color;
            debugOutputTexture[coord + uint2(-1, -1)] = color;
            debugOutputTexture[coord + uint2(-1, 0)] = color;
            debugOutputTexture[coord + uint2(-1, 1)] = color;
        }
#endif

    horizons.x = -GTAOFastAcos(clamp(horizons.x, -1.0, 1.0));
    horizons.y =  GTAOFastAcos(clamp(horizons.y, -1.0, 1.0));

    return horizons;
}

#define TEST_GTAOComputeInnerIntegral 1
float GTAOComputeInnerIntegral(float2 horizons, float2 searchDirection, float3 viewVector, float3 viewSpaceNormal)
{
#if TEST_GTAOComputeInnerIntegral == 1
    // Given the angles found in the slice plane, we need to project View Space Normal onto the defined by
    // the search axis and the View Space View Vector
    float3 slicePlaneNormal = normalize(cross(float3(searchDirection.xy, 0.0), viewVector));
    float3 tangent  = cross(viewVector, slicePlaneNormal);
    float3 projectedNormal = viewSpaceNormal - slicePlaneNormal * dot(viewSpaceNormal, slicePlaneNormal);
    float projectedNormalLength = length(projectedNormal) + 0.000001;

    float cosN = clamp(dot(projectedNormal, viewVector) / projectedNormalLength, -1.0, 1.0);
    float angleN = -sign(dot(projectedNormal, tangent)) * GTAOFastAcos(cosN);
    float sinN = sin(angleN);

    // Clamp horizons to normal hemisphere
    horizons.x = angleN + max(horizons.x - angleN, -(GTAO_HALF_PI));
    horizons.y = angleN + min(horizons.y - angleN,  (GTAO_HALF_PI));

    // IntegrateArc(h1, h2, N)
    float Vd = 0.25 * ((-cos((2.0 * horizons.x) - angleN) + cosN + 2.0 * horizons.x * sinN) +
                        (-cos((2.0 * horizons.y) - angleN) + cosN + 2.0 * horizons.y * sinN));
    Vd *= projectedNormalLength;

    return Vd;
#else
    // Given the angles found in the slice plane, we need to project View Space Normal onto the defined by
    // the search axis and the View Space View Vector
    float3 slicePlaneNormal = normalize(cross(float3(searchDirection.xy, 0.0), viewVector));
    float3 projectedNormal = viewSpaceNormal - slicePlaneNormal * dot(viewSpaceNormal, slicePlaneNormal);
    float projectedNormalLength = length(projectedNormal) + 0.000001;

    float3 perp = cross(viewVector, slicePlaneNormal);
    float cosAngle = dot(projectedNormal, perp) / projectedNormalLength;

    float angleN = GTAOFastAcos(cosAngle) - GTAO_HALF_PI;
    float cosN = dot(projectedNormal, viewVector) / projectedNormalLength;
    float sinN = sin(angleN);
    //float sinN = cosAngle * -2.0f;

    // Clamp horizons to normal hemisphere
    horizons.x = angleN + max(horizons.x - angleN, -GTAO_HALF_PI);
    horizons.y = angleN + min(horizons.y - angleN,  GTAO_HALF_PI);

    // IntegrateArc(h1, h2, N)
    float Vd = 0.25 * ((-cos((2.0 * horizons.x) - angleN) + cosN + 2.0 * horizons.x * sinN) +
                        (-cos((2.0 * horizons.y) - angleN) + cosN + 2.0 * horizons.y * sinN));
    Vd *= projectedNormalLength;

    return Vd;
#endif
}

[numthreads(8, 8, 1)]
void GTAOHorizonSearchAndIntegralCS(uint3 DispatchThreadID : SV_DispatchThreadID, uint2 GroupThreadID : SV_GroupThreadID, uint2 GroupID : SV_GroupID)
{
    PerFrameData perFrameData = GetPerFrameData();
    uint2 pixelCoord = DispatchThreadID.xy;
    uint width = perFrameData.renderResolutionX / 2;
    uint height = perFrameData.renderResolutionY / 2;
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    float2 uv = (pixelCoord + 0.5) / float2(width, height);

    Texture2D sceneDepth = GetSceneDepthSRV();
    Texture2D gbuffer0 = GetGBuffer0SRV();
    Texture2D gbuffer1 = GetGBuffer1SRV();
    RWTexture2D<float4> outputTexture = GetGTAOHorizonSearchAndIntegralOutputTextureUAV();

    float depth = sceneDepth.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;
    if (depth < 0.000001)
    {
        outputTexture[pixelCoord] = 1.0;
        return;
    }

    float3 worldSpaceNormal = DecodeNormalFromONV(gbuffer0[pixelCoord].xy);
    float3 viewSpacePosition = ReconstructViewSpacePositionFromDepth(uv, depth, perFrameData.invProjectionMatrix);
    float3 viewSpaceNormal = normalize(mul((float3x3)perFrameData.viewMatrix, worldSpaceNormal));
    float3 viewVector = normalize(-viewSpacePosition);

    float seachRadius = SHADER_ARGUMENTS_DATA(0);
    float thickness = SHADER_ARGUMENTS_DATA(1);
    float multiBounce = SHADER_ARGUMENTS_DATA(2);
    float aoFactor = SHADER_ARGUMENTS_DATA(3);

    float2 depthBufferTexelSize = perFrameData.renderResolutionAndInvRenderResolution.zw;

    float2 noise = GTAONoise(pixelCoord.x + pixelCoord.y * width, perFrameData.frameIndex);
    float2 searchDirection = GTAORandomVector(noise.x);

    float stepNoise = noise.y;
    // This is the min distance to start sampling from to avoid sampling from the center pixel (no useful data obtained from sampling center pixel)
    float initialOffset = 1.3;

    float visibility = 0.0;
    [unroll]
    for (uint sliceIndex = 0; sliceIndex < GTAONumSlices; sliceIndex++)
    {
        float3 rayStartView = viewSpacePosition;
        float3 rayEndView = viewSpacePosition + seachRadius * float3(searchDirection.xy, 0.0);
        float3 rayStartClip = ViewSpaceToClipSpacePosition(rayStartView, perFrameData.projectionMatrix);
        float3 rayEndClip = ViewSpaceToClipSpacePosition(rayEndView, perFrameData.projectionMatrix);
        rayEndClip.z = rayStartClip.z;

        float2 rayStartScreen = ClipSpaceToUV(rayStartClip.xy);
        float2 rayEndScreen = ClipSpaceToUV(rayEndClip.xy);
        float2 rayStepScreen = rayEndScreen - rayStartScreen;
        bool is_more_vertical = abs(rayStepScreen.x) < abs(rayStepScreen.y);
        rayStepScreen /= is_more_vertical ? abs(rayStepScreen.y) : abs(rayStepScreen.x);
        rayStepScreen *= is_more_vertical ? depthBufferTexelSize.y : depthBufferTexelSize.x;
        float rayLengthSquare = dot(rayEndScreen - rayStartScreen, rayEndScreen - rayStartScreen);
        float rayStepLengthSquare = dot(rayStepScreen, rayStepScreen);
        float stepRadius = GTAOFastSqrt(rayLengthSquare / rayStepLengthSquare);

        float2 horizons = GTAOSearchForHorizons(
            GTAOHorizonSearchNumSteps,
            sceneDepth,
            uv,
            perFrameData.invProjectionMatrix,
            rayStepScreen,
            stepRadius,
            stepNoise,
            initialOffset,
            viewSpacePosition,
            viewVector,
            thickness,
            seachRadius,pixelCoord);

        visibility += GTAOComputeInnerIntegral(horizons, searchDirection, viewVector, viewSpaceNormal);

        // Rotate 90 degrees
        searchDirection = float2(-searchDirection.y, searchDirection.x);
        stepNoise       = frac(stepNoise + 0.617);
    }
    visibility /= ((float)GTAONumSlices);

    if (multiBounce > 0)
    {
        float3 baseColor = gbuffer1.SampleLevel(GlobalSamplerLinearClamp, uv, 0).rgb;
        visibility = GTAOMultiBounce(visibility, baseColor);
    }
    visibility = pow(saturate(visibility), aoFactor);

    outputTexture[pixelCoord] = visibility;
}

#define KERNEL_RADIUS 8
inline float CrossBilateralWeight(float r, float d, float d0)
{
    PerFrameData perFrameData = GetPerFrameData();
    const float BlurSigma = (float)KERNEL_RADIUS * 0.5;
    const float BlurFalloff = 1 / (2 * BlurSigma * BlurSigma);

    float sharpeness = 10.0;
    float dz = (d0 - d) * perFrameData.farClippingPlane * sharpeness;
    return exp2(-r * r * BlurFalloff - dz * dz);
}

inline void FetchAoAndDepth(float2 uv, inout float ao, inout float depth)
{
    Texture2D sceneDepth = GetSceneDepthSRV();
    Texture2D inputTexture = GetSpatialFilteringInputTextureSRV();

    ao = inputTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).r;
    depth = sceneDepth.SampleLevel(GlobalSamplerPointClamp, uv, 0).r;
}

inline void ProcessSample(float2 aoz, float r, float d0, inout float totalAO, inout float totalW)
{
    float w = CrossBilateralWeight(r, d0, aoz.y);
    totalW += w;
    totalAO += w * aoz.x;
}

inline void ProcessRadius(float2 uv0, float2 deltaUV, float d0, inout float totalAO, inout float totalW)
{
    float ao, z;
    float2 uv;
    float r = 1;

    // Use [unroll(n)] instead?
    // [unroll]
    for (; r <= KERNEL_RADIUS / 2; r += 1)
    {
        uv = uv0 + r * deltaUV;
        FetchAoAndDepth(uv, ao, z);
        ProcessSample(float2(ao, z), r, d0, totalAO, totalW);
    }

    // [unroll]
    for (; r <= KERNEL_RADIUS; r += 2)
    {
        uv = uv0 + (r + 0.5) * deltaUV;
        FetchAoAndDepth(uv, ao, z);
        ProcessSample(float2(ao, z), r, d0, totalAO, totalW);
    }

}

[numthreads(8, 8, 1)]
void GTAOSpatialFilteringCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    PerFrameData perFrameData = GetPerFrameData();
    uint2 pixelCoord = DispatchThreadID.xy;
    uint width = perFrameData.renderResolutionX / 2;
    uint height = perFrameData.renderResolutionY / 2;
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    float2 uv = (pixelCoord + 0.5) / float2(width, height);
    float deltaU = SHADER_ARGUMENTS_DATA(0);
    float deltaV = SHADER_ARGUMENTS_DATA(1);
    float2 deltaUV = float2(deltaU, deltaV);

    RWTexture2D<float4> outputTexture = GetSpatialFilteringOutputTextureUAV();

    float totalAO, depth;
    FetchAoAndDepth(uv, totalAO, depth);

    float totalWeight = 1.0;
    ProcessRadius(uv, -deltaUV, depth, totalAO, totalWeight);
    ProcessRadius(uv,  deltaUV, depth, totalAO, totalWeight);

    float result = totalAO / totalWeight;
    outputTexture[pixelCoord] = result;
}

[numthreads(8, 8, 1)]
void GTAOTemporalFilteringCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    PerFrameData perFrameData = GetPerFrameData();
    uint2 pixelCoord = DispatchThreadID.xy;
    uint width = perFrameData.renderResolutionX / 2;
    uint height = perFrameData.renderResolutionY / 2;
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    float2 uv = (pixelCoord + 0.5) / float2(width, height);

    Texture2D sceneDepth = GetSceneDepthSRV();
    Texture2D historySceneDepth = GetHistorySceneDepthSRV();
    Texture2D motionVectors = GetMotionVectorsSRV();
    Texture2D ambientOcclutionTexture = GetAmbientOcclutionTextureSRV();
    Texture2D historyAmbientOcclutionTexture = GetHistoryAmbientOcclutionTextureSRV();
    RWTexture2D<float4> outputTexture = GetFilteredAmbientOcclutionTextureUAV();

    // Sample current frame data
    float currentAO = ambientOcclutionTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).r;
    if (perFrameData.frameIndex == 0)
    {
        outputTexture[pixelCoord] = currentAO;
        return;
    }

    // Reproject current frame sample to previous frame
    float2 motionVector = motionVectors[pixelCoord].rg;
    float motionVectorLength = length(motionVector * float2(perFrameData.renderResolutionX, perFrameData.renderResolutionY));
    float2 historySampleUV = uv + motionVector;

    // Sample hisotry frame data
    float historyAO = historyAmbientOcclutionTexture.SampleLevel(GlobalSamplerLinearClamp, historySampleUV, 0).r;
    motionVectorLength = 0;

    // Reject history
    float currentDepth = LinearDepthNearFar(sceneDepth.SampleLevel(GlobalSamplerPointClamp, uv, 0).r, perFrameData.nearClippingPlane, perFrameData.farClippingPlane);
    float historyDepth = LinearDepthNearFar(historySceneDepth.SampleLevel(GlobalSamplerPointClamp, historySampleUV, 0).r, perFrameData.nearClippingPlane, perFrameData.farClippingPlane);
    if (motionVectorLength > 2.0 || abs(currentDepth - historyDepth) > 0.5)
    {
        outputTexture[pixelCoord] = currentAO;
        return;
    }

    float range = lerp(0.2, 0.0, saturate(motionVectorLength));
    float minAO = saturate(currentAO - range);
    float maxAO = saturate(currentAO + range);

    // Clamp history
    historyAO = clamp(historyAO, minAO, maxAO);

    float blendFactor = lerp(0.05, 0.2, saturate(0.1 * motionVectorLength));
    float outAO = lerp(historyAO, currentAO, blendFactor);
    outputTexture[pixelCoord] = outAO;
}
