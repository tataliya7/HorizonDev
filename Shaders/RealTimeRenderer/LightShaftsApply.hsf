#include "../ShaderCommon.hsh"
#include "RealTimeRendererCommon.hsh"

BIND_BUFFER_ELEMENT(0, PerFrameData, PerFrameData);
BIND_TEXTURE_2D_SRV(1, SceneColorTexture);
BIND_TEXTURE_2D_SRV(2, LightShaftsTexture);
BIND_TEXTURE_2D_UAV(3, float4, OutputTexture);

[shader("compute")]
[numthreads(8, 8, 1)]
void LightShaftsApplyCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    uint2 pixelCoord = DispatchThreadID.xy;
    PerFrameData perFrameData = GetPerFrameData();
    uint width = perFrameData.renderResolutionX;
    uint height = perFrameData.renderResolutionY;
    if (pixelCoord.x >= width || pixelCoord.y >= height)
    {
        return;
    }

    float2 uv = (pixelCoord.xy + 0.5) * float2(1.0 / width, 1.0 / height);

    Texture2D sceneColorTexture = GetSceneColorTextureSRV();
    Texture2D lightShaftsTexture = GetLightShaftsTextureSRV();

    float4 sceneColor = sceneColorTexture[pixelCoord];
    float3 lightShafts = lightShaftsTexture.SampleLevel(GlobalSamplerLinearClamp, uv, 0).rgb;

    RWTexture2D<float4> outputTexture = GetOutputTextureUAV();
    outputTexture[pixelCoord] = float4(sceneColor.rgb + lightShafts, sceneColor.a);
}
